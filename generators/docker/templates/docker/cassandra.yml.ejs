# This configuration is intended for development purpose, it's **your** responsibility to harden it for production
# The cassandra service stores its data in /var/lib/cassandra/data of its Docker container: to keep it in a folder of your machine,
# add to the cassandra service:
#   volumes:
#     - <folder-of-your-machine>:/var/lib/cassandra/data
name: jhipster
services:
  cassandra:
    image: cassandra
    container_name: jhipster-cassandra
    environment:
      - MAX_HEAP_SIZE=2G
      - HEAP_NEWSIZE=512M
    # If you want to expose these ports outside your dev PC,
    # remove the "127.0.0.1:" prefix
    ports:
      - 127.0.0.1:7000:7000
      - 127.0.0.1:7001:7001
      - 127.0.0.1:7199:7199
      - 127.0.0.1:9042:9042
      - 127.0.0.1:9160:9160
    healthcheck:
      test: ['CMD', 'cqlsh', '-e', 'describe keyspaces']
      interval: 5s
      timeout: 25s
      retries: 20
