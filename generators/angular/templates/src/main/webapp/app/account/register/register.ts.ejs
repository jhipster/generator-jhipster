import { HttpErrorResponse } from '@angular/common/http';
import { AfterViewInit, Component, ElementRef, inject, signal, viewChild } from '@angular/core';
import { FormField, FormRoot, email, form, maxLength, minLength, pattern, required, validate } from '@angular/forms/signals';
import { RouterLink } from '@angular/router';

<%_ if (enableTranslation) { _%>
import { TranslatePipe, TranslateService } from '@ngx-translate/core';
<%_ } _%>
import { firstValueFrom } from 'rxjs';

import { EMAIL_ALREADY_USED_TYPE, LOGIN_ALREADY_USED_TYPE } from 'app/shared/jhipster/error.constants';
<%_ if (enableTranslation) { _%>
import { TranslateDirective } from 'app/shared/language';
<%_ } _%>
import PasswordStrengthBar from '../password/password-strength-bar/password-strength-bar';

import { RegisterService } from './register.service';

@Component({
  selector: '<%- jhiPrefixDashed %>-register',
  imports: [
<%_ if (enableTranslation) { _%>
    TranslateDirective,
    TranslatePipe,
<%_ } _%>
    RouterLink,
    FormField,
    FormRoot,
    PasswordStrengthBar,
  ],
  templateUrl: './register.html',
})
export default class Register implements AfterViewInit {
  readonly login = viewChild.required<ElementRef>('login');

  readonly error = signal(false);
  readonly errorEmailExists = signal(false);
  readonly errorUserExists = signal(false);
  readonly success = signal(false);

  readonly registerModel = signal({ login: '', email: '', password: '', confirmPassword: '' });

  readonly registerForm = form(
    this.registerModel,
    path => {
      required(path.login);
      maxLength(path.login, <%- user.fieldsByName.login.fieldValidateRulesMaxlength %>);
      pattern(path.login, /^[a-zA-Z0-9!$&*+=?^_`{|}~.-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$|^[_.@A-Za-z0-9-]+$/);
      required(path.email);
      minLength(path.email, <%- user.fieldsByName.email.fieldValidateRulesMinlength %>);
      maxLength(path.email, <%- user.fieldsByName.email.fieldValidateRulesMaxlength %>);
      email(path.email);
      required(path.password);
      minLength(path.password, 4);
      maxLength(path.password, <%- user.fieldsByName.login.fieldValidateRulesMaxlength %>);
      required(path.confirmPassword);
      minLength(path.confirmPassword, 4);
      maxLength(path.confirmPassword, <%- user.fieldsByName.login.fieldValidateRulesMaxlength %>);
      // The confirmation is the password: an empty one is left to the required validator.
      validate(path.confirmPassword, ({ value, valueOf }) =>
        value() && value() !== valueOf(path.password) ? { kind: 'dontMatch' } : undefined,
      );
    },
    // A submit marks the fields as touched and sends nothing while the form is invalid.
    { submission: { action: async () => this.register() } },
  );

<%_ if (enableTranslation) { _%>
  private readonly translateService = inject(TranslateService);
<%_ } _%>
  private readonly registerService = inject(RegisterService);

  ngAfterViewInit(): void {
    this.login().nativeElement.focus();
  }

  async register(): Promise<void> {
    this.error.set(false);
    this.errorEmailExists.set(false);
    this.errorUserExists.set(false);

    const { login, email: registerEmail, password } = this.registerModel();
    try {
      await firstValueFrom(
        this.registerService.save({ login, email: registerEmail, password, langKey: <%- enableTranslation ? 'this.translateService.getCurrentLang() ?? ' : '' %>'<%- nativeLanguage %>' }),
      );
      this.success.set(true);
    } catch (error_) {
      this.processError(error_ as HttpErrorResponse);
    }
  }

  private processError(response: HttpErrorResponse): void {
    if (response.status === 400 && response.error.type === LOGIN_ALREADY_USED_TYPE) {
      this.errorUserExists.set(true);
    } else if (response.status === 400 && response.error.type === EMAIL_ALREADY_USED_TYPE) {
      this.errorEmailExists.set(true);
    } else {
      this.error.set(true);
    }
  }
}
