import { beforeEach, describe, expect, it, vi } from 'vitest';
import { provideHttpClientTesting } from '@angular/common/http/testing';
import { Type } from '@angular/core';
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { AbstractControl, FormGroup } from '@angular/forms';
import { ActivatedRoute, provideRouter } from '@angular/router';

import { FaIconLibrary } from '@fortawesome/angular-fontawesome';
import { fas } from '@fortawesome/free-solid-svg-icons';
<%_ if (enableTranslation) { _%>
import { provideTranslateService } from '@ngx-translate/core';
<%_ } _%>
import { of } from 'rxjs';

import { Account } from 'app/core/auth/account.model';
import { AccountService } from 'app/core/auth/account.service';

<%_ if (generateUserRegistration) { _%>
import Activate from './activate/activate';
<%_ } _%>
import PasswordResetFinish from './password-reset/finish/password-reset-finish';
import PasswordResetInit from './password-reset/init/password-reset-init';
import PasswordStrengthBar from './password/password-strength-bar/password-strength-bar';
import Password from './password/password';
<%_ if (generateUserRegistration) { _%>
import Register from './register/register';
<%_ } _%>
<%_ if (authenticationTypeSession) { _%>
import { Session } from './sessions/session.model';
import Sessions from './sessions/sessions';
import { SessionsService } from './sessions/sessions.service';
<%_ } _%>
import Settings from './settings/settings';

const account: Account = {
  activated: true,
  authorities: [],
  email: 'user@localhost',
  firstName: 'first',
  langKey: 'en',
  lastName: 'last',
  login: 'user',
  imageUrl: null,
};

const validationErrors = { required: true, minlength: {}, maxlength: {}, pattern: {}, email: true };

describe('Account screens', () => {
  const showValidations = async <T>(fixture: ComponentFixture<T>, form: FormGroup): Promise<void> => {
    for (const control of Object.values<AbstractControl>(form.controls)) {
      control.markAsDirty();
      control.setErrors(validationErrors);
    }
    await fixture.whenStable();
    expect(fixture.nativeElement.querySelector('small.text-danger')).not.toBeNull();

    const controls = Object.values<AbstractControl>(form.controls);
    controls.forEach(control => control.setErrors({ other: true }));
    await fixture.whenStable();
    controls.forEach(control => {
      control.markAsPristine();
      control.markAsTouched();
    });
    await fixture.whenStable();
    controls.forEach(control => control.markAsUntouched());
    await fixture.whenStable();
    expect(fixture.nativeElement.querySelector('small.text-danger')).toBeNull();
  };

  const render = async <T>(component: Type<T>): Promise<ComponentFixture<T>> => {
    const fixture = TestBed.createComponent(component);
    await fixture.whenStable();
    return fixture;
  };

  const submit = async <T>(fixture: ComponentFixture<T>): Promise<void> => {
    fixture.nativeElement.querySelector('form').dispatchEvent(new Event('submit'));
    await fixture.whenStable();
  };

  const showStates = async <T>(fixture: ComponentFixture<T>, states: (keyof T)[]): Promise<void> => {
    for (const state of states) {
      (fixture.componentInstance[state] as any).set(true);
    }
    await fixture.whenStable();
  };

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [
<%_ if (enableTranslation) { _%>
        provideTranslateService(),
<%_ } _%>
        provideHttpClientTesting(),
        provideRouter([]),
        { provide: ActivatedRoute, useValue: { queryParams: of({ key: 'key' }) } },
      ],
    });
    TestBed.inject(FaIconLibrary).addIconPacks(fas);
    const accountService = TestBed.inject(AccountService);
    accountService.authenticate(account);
    vi.spyOn(accountService, 'identity').mockReturnValue(of(account));
  });

<%_ if (generateUserRegistration) { _%>
  it('should show the register form and its messages', async () => {
    const fixture = await render(Register);

    await submit(fixture);
    await showValidations(fixture, fixture.componentInstance.registerForm);
    await showStates(fixture, ['error', 'errorEmailExists', 'errorUserExists']);
    await showStates(fixture, ['success']);

    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

<%_ } _%>
  it('should show the settings form and its messages', async () => {
    const fixture = await render(Settings);

    await submit(fixture);
    await showValidations(fixture, fixture.componentInstance.settingsForm);
    await showStates(fixture, ['success']);

    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

  it('should show the password form and its messages', async () => {
    const fixture = await render(Password);

    await submit(fixture);
    await showValidations(fixture, fixture.componentInstance.passwordForm);
    await showStates(fixture, ['error', 'doNotMatch', 'success']);

    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

  it('should show the form to finish the password reset and its messages', async () => {
    const fixture = await render(PasswordResetFinish);

    await submit(fixture);
    await showValidations(fixture, fixture.componentInstance.passwordForm);
    await showStates(fixture, ['error', 'doNotMatch', 'success']);

    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

  it('should tell when the key of the password reset is missing', async () => {
    TestBed.inject(ActivatedRoute).queryParams = of({});
    const fixture = await render(PasswordResetFinish);

    expect(fixture.nativeElement.querySelector('.alert-danger')).not.toBeNull();
  });

  it('should show the form to request a password reset and its messages', async () => {
    const fixture = await render(PasswordResetInit);

    await submit(fixture);
    await showValidations(fixture, fixture.componentInstance.resetRequestForm);
    await showStates(fixture, ['success']);

    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

<%_ if (generateUserRegistration) { _%>
  it('should show the result of the activation', async () => {
    const fixture = await render(Activate);

    await showStates(fixture, ['success', 'error']);

    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

<%_ } _%>
<%_ if (authenticationTypeSession) { _%>
  it('should show the sessions and invalidate them', async () => {
    const service = TestBed.inject(SessionsService);
    vi.spyOn(service, 'findAll').mockReturnValue(of([new Session('series', new Date(), '127.0.0.1', 'agent')]));
    const remove = vi.spyOn(service, 'delete').mockReturnValue(of({}));
    const fixture = await render(Sessions);

    fixture.nativeElement.querySelector('tbody button').click();
    fixture.componentInstance.error = true;
    fixture.changeDetectorRef.markForCheck();
    await fixture.whenStable();

    expect(remove).toHaveBeenCalledWith('series');
    expect(fixture.nativeElement.querySelector('.alert')).not.toBeNull();
  });

<%_ } _%>
  it('should show the strength of a password', async () => {
    const fixture = TestBed.createComponent(PasswordStrengthBar);

    for (const passwordToCheck of ['', 'a', 'password', 'P4ssw0rd!long-enough-to-be-strong']) {
      fixture.componentRef.setInput('passwordToCheck', passwordToCheck);
      await fixture.whenStable();
    }

    expect(fixture.nativeElement.querySelector('ul')).not.toBeNull();
  });
});
