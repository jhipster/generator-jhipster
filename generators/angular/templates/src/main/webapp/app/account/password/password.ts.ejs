import { Component, inject, signal } from '@angular/core';
import { FormField, FormRoot, form, maxLength, minLength, required } from '@angular/forms/signals';

<%_ if (enableTranslation) { _%>
import { TranslatePipe } from '@ngx-translate/core';
<%_ } _%>
import { firstValueFrom } from 'rxjs';

import { AccountService } from 'app/core/auth';
<%_ if (enableTranslation) { _%>
import { TranslateDirective } from 'app/shared/language';
<%_ } _%>

import PasswordStrengthBar from './password-strength-bar/password-strength-bar';
import { PasswordService } from './password.service';

@Component({
  selector: '<%- jhiPrefixDashed %>-password',
  imports: [
<%_ if (enableTranslation) { _%>
    TranslateDirective,
    TranslatePipe,
<%_ } _%>
    FormField,
    FormRoot,
    PasswordStrengthBar,
  ],
  templateUrl: './password.html',
})
export default class Password {
  readonly doNotMatch = signal(false);
  readonly error = signal(false);
  readonly success = signal(false);
  readonly account = inject(AccountService).account;
  readonly passwordModel = signal({ currentPassword: '', newPassword: '', confirmPassword: '' });

  readonly passwordForm = form(
    this.passwordModel,
    path => {
      required(path.currentPassword);
      required(path.newPassword);
      minLength(path.newPassword, 4);
      maxLength(path.newPassword, 50);
      required(path.confirmPassword);
      minLength(path.confirmPassword, 4);
      maxLength(path.confirmPassword, 50);
    },
    // A submit marks the fields as touched and sends nothing while the form is invalid.
    { submission: { action: async () => this.changePassword() } },
  );

  private readonly passwordService = inject(PasswordService);

  async changePassword(): Promise<undefined> {
    this.error.set(false);
    this.success.set(false);
    this.doNotMatch.set(false);

    const { newPassword, confirmPassword, currentPassword } = this.passwordModel();
    if (newPassword === confirmPassword) {
      try {
        await firstValueFrom(this.passwordService.save(newPassword, currentPassword));
        this.success.set(true);
      } catch {
        this.error.set(true);
      }
    } else {
      this.doNotMatch.set(true);
    }
    return undefined;
  }
}
