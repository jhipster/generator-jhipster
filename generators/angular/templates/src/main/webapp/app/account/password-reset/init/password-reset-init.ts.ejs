import { AfterViewInit, Component, ElementRef, inject, signal, viewChild } from '@angular/core';
import { FormField, FormRoot, email, form, maxLength, minLength, required } from '@angular/forms/signals';

<%_ if (enableTranslation) { _%>
import { TranslatePipe } from '@ngx-translate/core';
<%_ } _%>
import { firstValueFrom } from 'rxjs';

import { AlertError } from 'app/shared/alert';
<%_ if (enableTranslation) { _%>
import { TranslateDirective } from 'app/shared/language';
<%_ } _%>

import { PasswordResetInitService } from './password-reset-init.service';

@Component({
  selector: '<%- jhiPrefixDashed %>-password-reset-init',
  imports: [
<%_ if (enableTranslation) { _%>
    TranslateDirective,
    TranslatePipe,
<%_ } _%>
    AlertError,
    FormField,
    FormRoot,
  ],
  templateUrl: './password-reset-init.html',
})
export default class PasswordResetInit implements AfterViewInit {
  readonly email = viewChild.required<ElementRef>('email');

  readonly success = signal(false);
  readonly resetRequestModel = signal({ email: '' });

  readonly resetRequestForm = form(
    this.resetRequestModel,
    path => {
      required(path.email);
      minLength(path.email, <%- user.fieldsByName.email.fieldValidateRulesMinlength %>);
      maxLength(path.email, <%- user.fieldsByName.email.fieldValidateRulesMaxlength %>);
      email(path.email);
    },
    // A submit marks the fields as touched and sends nothing while the form is invalid.
    { submission: { action: async () => this.requestReset() } },
  );

  private readonly passwordResetInitService = inject(PasswordResetInitService);

  ngAfterViewInit(): void {
    this.email().nativeElement.focus();
  }

  async requestReset(): Promise<void> {
    try {
      await firstValueFrom(this.passwordResetInitService.save(this.resetRequestModel().email));
      this.success.set(true);
    } catch {
      // Ignore error
    }
  }
}
