import { Component, OnInit, inject, signal } from '@angular/core';
import { FormField, FormRoot, email, form, maxLength, minLength, required } from '@angular/forms/signals';

<%_ if (enableTranslation) { _%>
import { TranslatePipe, TranslateService } from '@ngx-translate/core';
<%_ } _%>
import { firstValueFrom } from 'rxjs';

<%_ if (enableTranslation) { _%>
import { LANGUAGES } from 'app/config';
<%_ } _%>
import { Account, AccountService } from 'app/core/auth';
import { AlertError } from 'app/shared/alert';
<%_ if (enableTranslation) { _%>
import { FindLanguageFromKeyPipe, TranslateDirective } from 'app/shared/language';
<%_ } _%>

@Component({
  selector: '<%- jhiPrefixDashed %>-settings',
  imports: [
<%_ if (enableTranslation) { _%>
    TranslateDirective,
    TranslatePipe,
    FindLanguageFromKeyPipe,
<%_ } _%>
    AlertError,
    FormField,
    FormRoot,
  ],
  templateUrl: './settings.html',
})
export default class Settings implements OnInit {
  readonly success = signal(false);
<%_ if (enableTranslation) { _%>
  languages = LANGUAGES;
<%_ } _%>

  readonly settingsModel = signal({ firstName: '', lastName: '', email: '', langKey: '' });

  readonly settingsForm = form(
    this.settingsModel,
    path => {
      maxLength(path.firstName, <%- user.fieldsByName.firstName.fieldValidateRulesMaxlength %>);
      maxLength(path.lastName, <%- user.fieldsByName.firstName.fieldValidateRulesMaxlength %>);
      required(path.email);
      minLength(path.email, <%- user.fieldsByName.email.fieldValidateRulesMinlength %>);
      maxLength(path.email, <%- user.fieldsByName.email.fieldValidateRulesMaxlength %>);
      email(path.email);
    },
    // A submit marks the fields as touched and sends nothing while the form is invalid.
    { submission: { action: async () => this.save() } },
  );

  readonly login = signal<string | undefined>(undefined);

  private account?: Account;
  private readonly accountService = inject(AccountService);
<%_ if (enableTranslation) { _%>
  private readonly translateService = inject(TranslateService);
<%_ } _%>

  ngOnInit(): void {
    this.accountService.identity().subscribe(account => {
      if (account) {
        this.account = account;
        this.login.set(account.login);
        const { firstName, lastName, email: accountEmail, langKey } = account;
        this.settingsModel.set({ firstName: firstName ?? '', lastName: lastName ?? '', email: accountEmail, langKey });
      }
    });
  }

  async save(): Promise<void> {
    this.success.set(false);

    const { firstName, lastName, ...settings } = this.settingsModel();
    const account: Account = {
      ...this.account!,
      ...settings,
      firstName: firstName === '' ? null : firstName,
      lastName: lastName === '' ? null : lastName,
    };
    try {
      await firstValueFrom(this.accountService.save(account));
      this.success.set(true);

      this.accountService.authenticate(account);

<%_ if (enableTranslation) { _%>
      if (account.langKey !== this.translateService.getCurrentLang()) {
        this.translateService.use(account.langKey);
      }
<%_ } _%>
    } catch {
      // Handled by interceptor.
    }
  }
}
