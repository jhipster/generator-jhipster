<%_ const searchType = paginationPagination || paginationInfiniteScroll ? 'SearchWithPagination' : 'Search'; _%>
import { HttpClient, HttpResponse, httpResource } from '@angular/common/http';
import { Service, computed, inject, signal } from '@angular/core';

import {
<%_ if (searchEngineAny) { _%>
  asapScheduler,
  catchError,
<%_ } _%>
  Observable,
<%_ if (searchEngineAny) { _%>
  scheduled,
<%_ } _%>
} from 'rxjs';

import { <%- (applicationTypeGateway || applicationTypeMicroservice) && locals.microserviceName ? 'microserviceContextPath, ' : '' %>serverApiUrl } from 'app/config';
import { createRequestOption<%- searchEngineAny ? `, ${searchType}` : '' %> } from 'app/core/request';
import { I<%- entityAngularName %><% if (!readOnly) { %>, New<%- entityAngularName %><% } %> } from '../<%- entityFileName %>.model';
<%_ if (!readOnly && updatableEntity) { _%>

export type PartialUpdate<%- entityAngularName %> = Partial<I<%- entityAngularName %>> & Pick<I<%- entityAngularName %>, <%- angularPrimaryKeyNames %>>;
<%_ } _%>

@Service()
export class <%- entityAngularNamePlural %>Service {
  readonly <%- entityInstancePlural %>Params = signal<Record<string, string | number | boolean | readonly (string | number | boolean)[]> | undefined>(undefined);
  readonly <%- entityInstancePlural %>Resource = httpResource<I<%- entityAngularName %>[]>(() => {
    const params = this.<%- entityInstancePlural %>Params();
    if (!params) {
      return undefined;
    }
    return { url: <%- searchEngineAny ? 'params.query ? this.resourceSearchUrl : ' : '' %>this.resourceUrl, params };
  });
  /**
   * This signal holds the list of <%- entityInstance %> that have been fetched. It is updated when the <%- entityInstancePlural %>Resource emits a new value.
   * In case of error while fetching the <%- entityInstancePlural %>, the signal is set to an empty array.
   */
  readonly <%- entityInstancePlural %> = computed(() => (this.<%- entityInstancePlural %>Resource.hasValue() ? this.<%- entityInstancePlural %>Resource.value() : []));
  protected readonly resourceUrl = `${serverApiUrl}<% if ((applicationTypeGateway || applicationTypeMicroservice) && locals.microserviceName) { %>${microserviceContextPath}<%- microserviceName.toLowerCase() %>/<% } %>api/<%- entityApiUrl %>`;
<%_ if (searchEngineAny) { _%>
  protected readonly resourceSearchUrl = `${serverApiUrl}<% if ((applicationTypeGateway || applicationTypeMicroservice) && locals.microserviceName) { %>${microserviceContextPath}<%- microserviceName.toLowerCase() %>/<% } %>api/<%- entityApiUrl %>/_search`;
<%_ } _%>
}

@Service()
export class <%- entityAngularName %>Service extends <%- entityAngularNamePlural %>Service {
    protected readonly http = inject(HttpClient);

<%_ if (!readOnly) { _%>
    create(<%- entityInstance %>: New<%- entityAngularName %>): Observable<I<%- entityAngularName %>> {
        return this.http.post<I<%- entityAngularName %>>(this.resourceUrl, <%- entityInstance %>);
    }
<%_ } _%>
<%_ if (!readOnly && updatableEntity) { _%>

    update(<%- entityInstance %>: I<%- entityAngularName %>): Observable<I<%- entityAngularName %>> {
        return this.http.put<I<%- entityAngularName %>>(`${this.resourceUrl}/${<%- primaryKey.composite ? `this.get${entityAngularName}Identifier(${entityInstance})` : `encodeURIComponent(this.get${entityAngularName}Identifier(${entityInstance}))` %>}`, <%- entityInstance %>);
    }

    partialUpdate(<%- entityInstance %>: PartialUpdate<%- entityAngularName %>): Observable<I<%- entityAngularName %>> {
        return this.http.patch<I<%- entityAngularName %>>(`${this.resourceUrl}/${<%- primaryKey.composite ? `this.get${entityAngularName}Identifier(${entityInstance})` : `encodeURIComponent(this.get${entityAngularName}Identifier(${entityInstance}))` %>}`, <%- entityInstance %>);
    }
<%_ } _%>

    find(<%- primaryKey.name %>: <%- tsKeyType %>): Observable<I<%- entityAngularName %>> {
        return this.http.get<I<%- entityAngularName %>>(`${this.resourceUrl}/${<%- primaryKey.composite ? primaryKey.name : `encodeURIComponent(${primaryKey.name})` %>}`);
    }

    query(req?: any): Observable<HttpResponse<I<%- entityAngularName %>[]>> {
        const options = createRequestOption(req);
        return this.http.get<I<%- entityAngularName %>[]>(this.resourceUrl, { params: options, observe: 'response' });
    }

<%_ if (!readOnly) { _%>
    delete(<%- primaryKey.name %>: <%- tsKeyType %>): Observable<undefined> {
        return this.http.delete<undefined>(`${this.resourceUrl}/${<%- primaryKey.composite ? primaryKey.name : `encodeURIComponent(${primaryKey.name})` %>}`);
    }

<%_ } _%>
<%_ if (searchEngineAny) { _%>
    search(req: <%- searchType %>): Observable<I<%- entityAngularName %>[]> {
        const options = createRequestOption(req);
        return this.http.get<I<%- entityAngularName %>[]>(this.resourceSearchUrl, { params: options })
            .pipe(catchError(() => scheduled([], asapScheduler)));
    }
<%_ } _%>

<%_ if (primaryKey.composite) { _%>
    /**
     * The key of the <%- entityInstance %> in its url: the parts of its id, each one encoded, joined by slashes.
     */
<%_ } _%>
    get<%- entityAngularName %>Identifier(<%- entityInstance %>: Pick<I<%- entityAngularName %>, <%- angularPrimaryKeyNames %>>): <%- primaryKey.tsType %> {
<%_ if (primaryKey.composite) { _%>
        return [<%- primaryKey.fields.map(field => `${entityInstance}.${field.fieldName}`).join(', ') %>].map(part => encodeURIComponent(part)).join('/');
<%_ } else { _%>
        return <%- entityInstance %>.<%- primaryKey.name %>;
<%_ } _%>
    }

    compare<%- entityAngularName %>(o1: Pick<I<%- entityAngularName %>, <%- angularPrimaryKeyNames %>> | null, o2: Pick<I<%- entityAngularName %>, <%- angularPrimaryKeyNames %>> | null): boolean {
        return o1 && o2 ? this.get<%- entityAngularName %>Identifier(o1) === this.get<%- entityAngularName %>Identifier(o2) : o1 === o2;
    }

    add<%- entityAngularName %>ToCollectionIfMissing<Type extends Pick<I<%- entityAngularName %>, <%- angularPrimaryKeyNames %>>>(<%- entityInstance %>Collection: Type[], ...<%- entityInstancePlural %>ToCheck: (Type | null | undefined)[]): Type[] {
        const <%- entityInstancePlural %>: Type[] = <%- entityInstancePlural %>ToCheck.filter(<%- entityInstance %>Item => <%- entityInstance %>Item !== null && <%- entityInstance %>Item !== undefined);
        if (<%- entityInstancePlural %>.length > 0) {
            const <%- entityInstance %>CollectionIdentifiers = <%- entityInstance %>Collection.map(<%- entityInstance %>Item => this.get<%- entityAngularName %>Identifier(<%- entityInstance %>Item));
            const <%- entityInstancePlural %>ToAdd = <%- entityInstancePlural %>.filter(<%- entityInstance %>Item => {
                const <%- entityInstance %>Identifier = this.get<%- entityAngularName %>Identifier(<%- entityInstance %>Item);
                if (<%- entityInstance %>CollectionIdentifiers.includes(<%- entityInstance %>Identifier)) {
                    return false;
                }
                <%- entityInstance %>CollectionIdentifiers.push(<%- entityInstance %>Identifier);
                return true;
            });
            return [...<%- entityInstancePlural %>ToAdd, ...<%- entityInstance %>Collection];
        }
        return <%- entityInstance %>Collection;
    }
}
