<%_ const editableId = !primaryKey.autoGenerate && !builtInUserManagement; _%>
<%_ const timedFields = fields.filter(field => field.fieldTypeTimed); _%>
<%_ const booleanFields = fields.filter(field => field.fieldTypeBoolean && !field.transient); _%>
<%_ const emptyValueFields = fields.filter(field => field.angularFormKeepsEmptyValue); _%>
<%_ const collectionRelationships = relationships.filter(relationship => relationship.persistableRelationship && relationship.collection); _%>
<%_ // The blobs of a file with a size to validate, and the sizes in bytes the form accepts and rejects for each one.
    const sizedFileFields = fields.filter(field => field.fieldTypeBinary && !field.blobContentTypeText && (field.fieldValidationMinBytes || field.fieldValidationMaxBytes));
    const minBytes = field => field.fieldValidationMinBytes ? Math.trunc(field.fieldValidateRulesMinbytes) : 0;
    const acceptedSize = field => Math.max(1, minBytes(field));
    const rejectedSizes = sizedFileFields.flatMap(field => [
      ...minBytes(field) > 1 ? [{ field, kind: 'minBytes', size: minBytes(field) - 1 }] : [],
      ...field.fieldValidationMaxBytes ? [{ field, kind: 'maxBytes', size: Math.trunc(field.fieldValidateRulesMaxbytes) + 1 }] : [],
    ]);
    const requiredSizedFileFields = sizedFileFields.filter(field => field.fieldValidationRequired);
_%>
<%_ const requiredCollectionRelationships = collectionRelationships.filter(relationship => relationship.relationshipRequired); _%>
import { beforeEach, describe, expect, it } from 'vitest';
import { signal } from '@angular/core';
import { TestBed } from '@angular/core/testing';

import { sampleWithNewData, sampleWithRequiredData } from '../<%- entityFileName %>.test-samples';

import { <%- rejectedSizes.length > 0 ? `${entityAngularName}Form, ${entityAngularName}FormModel, ` : '' %><%- entityAngularName %>FormService } from './<%- entityFileName %>-form.service';

describe('<%- entityAngularName %> Form Service', () => {
  let service: <%- entityAngularName %>FormService;

  beforeEach(() => {
    service = TestBed.inject(<%- entityAngularName %>FormService);
  });

  describe('Service methods', () => {
    describe('create<%- entityAngularName %>FormModel', () => {
      it('should create the model of a new entity', () => {
        const model = service.create<%- entityAngularName %>FormModel();

        expect(Object.keys(model)).toEqual(
          expect.arrayContaining([
<%_ for (const field of fields) { _%>
            '<%- field.fieldName %>',
<%_ } _%>
<%_ for (const relationship of relationships.filter(relationship => relationship.persistableRelationship)) { _%>
            '<%- relationship.propertyName %>',
<%_ } _%>
          ]),
        );
      });
<%_ if (timedFields.filter(field => !field.fieldTsDefaultValue).length > 0) { _%>

      it('should leave the dates and times of a new entity empty', () => {
        const model = service.create<%- entityAngularName %>FormModel();

  <%_ for (const field of timedFields.filter(field => !field.fieldTsDefaultValue)) { _%>
        expect(model.<%- field.fieldName %>).toBe('');
  <%_ } _%>
      });
<%_ } _%>
<%_ if (timedFields.length > 0 || collectionRelationships.length > 0) { _%>

      it('passing I<%- entityAngularName %> without <%- [timedFields.length > 0 ? 'dates' : '', collectionRelationships.length > 0 ? 'relationships' : ''].filter(Boolean).join(' nor ') %> should create a model with empty values', () => {
        const model = service.create<%- entityAngularName %>FormModel({
          ...sampleWithRequiredData,
  <%_ for (const field of timedFields) { _%>
          <%- field.fieldName %>: null,
  <%_ } _%>
  <%_ for (const relationship of collectionRelationships) { _%>
          <%- relationship.propertyName %>: null,
  <%_ } _%>
        });

  <%_ for (const field of timedFields) { _%>
        expect(model.<%- field.fieldName %>).toBe('');
  <%_ } _%>
  <%_ for (const relationship of collectionRelationships) { _%>
        expect(model.<%- relationship.propertyName %>).toEqual([]);
  <%_ } _%>
      });
<%_ } _%>
    });

    describe('create<%- entityAngularName %>Form', () => {
      it('should create the form of the model', () => {
        const model = signal(service.create<%- entityAngularName %>FormModel(sampleWithRequiredData));

        const form = TestBed.runInInjectionContext(() => service.create<%- entityAngularName %>Form(model<%- editableId ? ', signal(false)' : '' %>));

        expect(form().value()).toEqual(model());
      });
<%_ if (!relationships.some(relationship => relationship.persistableRelationship && relationship.relationshipRequired)) { _%>

      it('should accept the values of an entity with its required data<%- booleanFields.length > 0 ? ', false booleans included' : '' %>', () => {
  <%_ if (booleanFields.length > 0 || requiredSizedFileFields.length > 0) { _%>
        const entity = {
          ...sampleWithRequiredData,
    <%_ for (const field of booleanFields) { _%>
          <%- field.fieldName %>: false,
    <%_ } _%>
    <%_ for (const field of requiredSizedFileFields) { _%>
          <%- field.fieldName %>: btoa('x'.repeat(<%- acceptedSize(field) %>)),
    <%_ } _%>
        };
  <%_ } else { _%>
        const entity = sampleWithRequiredData;
  <%_ } _%>
        const form = TestBed.runInInjectionContext(() =>
          service.create<%- entityAngularName %>Form(signal(service.create<%- entityAngularName %>FormModel(entity))<%- editableId ? ', signal(true)' : '' %>),
        );

        expect(form().errorSummary().map(error => error.kind)).toEqual([]);
        expect(form().valid()).toBe(true);
      });
<%_ } _%>
<%_ if (rejectedSizes.length > 0) { _%>

      it('should reject a file out of its size limits', () => {
        const formOf = (value: Partial<<%- entityAngularName %>FormModel>): <%- entityAngularName %>Form =>
          TestBed.runInInjectionContext(() =>
            service.create<%- entityAngularName %>Form(signal({ ...service.create<%- entityAngularName %>FormModel(sampleWithRequiredData), ...value })<%- editableId ? ', signal(true)' : '' %>),
          );

  <%_ for (const { field, kind, size } of rejectedSizes) { _%>
        expect(formOf({ <%- field.fieldName %>: btoa('x'.repeat(<%- size %>)) }).<%- field.fieldName %>().getError('<%- kind %>')).toBeDefined();
  <%_ } _%>
  <%_ for (const field of sizedFileFields) { _%>
        expect(formOf({ <%- field.fieldName %>: btoa('x'.repeat(<%- acceptedSize(field) %>)) }).<%- field.fieldName %>().valid()).toBe(true);
  <%_ } _%>
      });
<%_ } _%>
<%_ if (requiredCollectionRelationships.length > 0) { _%>

      it('should require an item of a required collection', () => {
        const form = TestBed.runInInjectionContext(() =>
          service.create<%- entityAngularName %>Form(
            signal(
              service.create<%- entityAngularName %>FormModel({
                ...sampleWithRequiredData,
  <%_ for (const relationship of requiredCollectionRelationships) { _%>
                <%- relationship.propertyName %>: [],
  <%_ } _%>
              }),
            ),
  <%_ if (editableId) { _%>
            signal(true),
  <%_ } _%>
          ),
        );

  <%_ for (const relationship of requiredCollectionRelationships) { _%>
        expect(form.<%- relationship.propertyName %>().getError('required')).toBeDefined();
  <%_ } _%>
      });
<%_ } _%>
<%_ if (primaryKey.autoGenerate && !builtInUserManagement) { _%>

      it('should keep the <%- primaryKey.name %> readonly', () => {
        const form = TestBed.runInInjectionContext(() => service.create<%- entityAngularName %>Form(signal(service.create<%- entityAngularName %>FormModel())));

        expect(form.<%- primaryKey.name %>().readonly()).toBe(true);
      });
<%_ } else if (editableId) { _%>

      it('should make the <%- primaryKey.name %> readonly once an entity is edited', () => {
        const editing = signal(false);
        const form = TestBed.runInInjectionContext(() => service.create<%- entityAngularName %>Form(signal(service.create<%- entityAngularName %>FormModel()), editing));

        expect(form.<%- primaryKey.name %>().readonly()).toBe(false);

        editing.set(true);

        expect(form.<%- primaryKey.name %>().readonly()).toBe(true);
      });
<%_ } _%>
    });

    describe('get<%- entityAngularName %>', () => {
      it('should return New<%- entityAngularName %> for default <%- entityAngularName %> initial value', () => {
        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel(sampleWithNewData));

        expect(<%- entityInstance %>).toMatchObject(sampleWithNewData);
      });

      it('should return New<%- entityAngularName %> for empty <%- entityAngularName %> initial value', () => {
        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel());

        expect(<%- entityInstance %>).toMatchObject({});
      });

      it('should return I<%- entityAngularName %>', () => {
        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel(sampleWithRequiredData));

        expect(<%- entityInstance %>).toMatchObject(sampleWithRequiredData);
      });
<%_ if (emptyValueFields.length > 0) { _%>

      it('should keep the empty values of the edited entity', () => {
        const entity = {
          ...sampleWithRequiredData,
  <%_ for (const field of emptyValueFields) { _%>
          <%- field.fieldName %>: <%- field.fieldTypeBoolean ? 'null' : "''" %>,
  <%_ } _%>
        };

        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel(entity), entity);

  <%_ for (const field of emptyValueFields) { _%>
        expect(<%- entityInstance %>.<%- field.fieldName %>).<%- field.fieldTypeBoolean ? 'toBeNull()' : "toBe('')" %>;
  <%_ } _%>
      });

      it('should return the empty values of an entity without them', () => {
        const entity = {
          ...sampleWithRequiredData,
  <%_ for (const field of emptyValueFields) { _%>
          <%- field.fieldName %>: <%- field.fieldTypeBoolean ? 'false' : 'null' %>,
  <%_ } _%>
        };

        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel(entity), entity);

  <%_ for (const field of emptyValueFields) { _%>
        expect(<%- entityInstance %>.<%- field.fieldName %>).<%- field.fieldTypeBoolean ? 'toBe(false)' : 'toBeNull()' %>;
  <%_ } _%>
      });
<%_ } _%>
    });
  });
});
