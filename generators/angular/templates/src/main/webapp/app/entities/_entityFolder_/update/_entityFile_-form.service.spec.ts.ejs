<%_ const editableId = !primaryKey.autoGenerate && !builtInUserManagement; _%>
<%_ const timedFields = fields.filter(field => field.fieldTypeTimed); _%>
<%_ const collectionRelationships = relationships.filter(relationship => relationship.persistableRelationship && relationship.collection); _%>
import { beforeEach, describe, expect, it } from 'vitest';
import { signal } from '@angular/core';
import { TestBed } from '@angular/core/testing';

import { sampleWithNewData, sampleWithRequiredData } from '../<%- entityFileName %>.test-samples';

import { <%- entityAngularName %>FormService } from './<%- entityFileName %>-form.service';

describe('<%- entityAngularName %> Form Service', () => {
  let service: <%- entityAngularName %>FormService;

  beforeEach(() => {
    service = TestBed.inject(<%- entityAngularName %>FormService);
  });

  describe('Service methods', () => {
    describe('create<%- entityAngularName %>FormModel', () => {
      it('should create the model of a new entity', () => {
        const model = service.create<%- entityAngularName %>FormModel();

        expect(Object.keys(model)).toEqual(
          expect.arrayContaining([
<%_ for (const field of fields) { _%>
            '<%- field.fieldName %>',
<%_ } _%>
<%_ for (const relationship of relationships.filter(relationship => relationship.persistableRelationship)) { _%>
            '<%- relationship.propertyName %>',
<%_ } _%>
          ]),
        );
      });
<%_ if (timedFields.length > 0 || collectionRelationships.length > 0) { _%>

      it('passing I<%- entityAngularName %> without <%- [timedFields.length > 0 ? 'dates' : '', collectionRelationships.length > 0 ? 'relationships' : ''].filter(Boolean).join(' nor ') %> should create a model with empty values', () => {
        const model = service.create<%- entityAngularName %>FormModel({
          ...sampleWithRequiredData,
  <%_ for (const field of timedFields) { _%>
          <%- field.fieldName %>: null,
  <%_ } _%>
  <%_ for (const relationship of collectionRelationships) { _%>
          <%- relationship.propertyName %>: null,
  <%_ } _%>
        });

  <%_ for (const field of timedFields) { _%>
        expect(model.<%- field.fieldName %>).toBe('');
  <%_ } _%>
  <%_ for (const relationship of collectionRelationships) { _%>
        expect(model.<%- relationship.propertyName %>).toEqual([]);
  <%_ } _%>
      });
<%_ } _%>
    });

    describe('create<%- entityAngularName %>Form', () => {
      it('should create the form of the model', () => {
        const model = signal(service.create<%- entityAngularName %>FormModel(sampleWithRequiredData));

        const form = TestBed.runInInjectionContext(() => service.create<%- entityAngularName %>Form(model<%- editableId ? ', signal(false)' : '' %>));

        expect(form().value()).toEqual(model());
      });
<%_ if (primaryKey.autoGenerate && !builtInUserManagement) { _%>

      it('should keep the <%- primaryKey.name %> readonly', () => {
        const form = TestBed.runInInjectionContext(() => service.create<%- entityAngularName %>Form(signal(service.create<%- entityAngularName %>FormModel())));

        expect(form.<%- primaryKey.name %>().readonly()).toBe(true);
      });
<%_ } else if (editableId) { _%>

      it('should make the <%- primaryKey.name %> readonly once an entity is edited', () => {
        const editing = signal(false);
        const form = TestBed.runInInjectionContext(() => service.create<%- entityAngularName %>Form(signal(service.create<%- entityAngularName %>FormModel()), editing));

        expect(form.<%- primaryKey.name %>().readonly()).toBe(false);

        editing.set(true);

        expect(form.<%- primaryKey.name %>().readonly()).toBe(true);
      });
<%_ } _%>
    });

    describe('get<%- entityAngularName %>', () => {
      it('should return New<%- entityAngularName %> for default <%- entityAngularName %> initial value', () => {
        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel(sampleWithNewData));

        expect(<%- entityInstance %>).toMatchObject(sampleWithNewData);
      });

      it('should return New<%- entityAngularName %> for empty <%- entityAngularName %> initial value', () => {
        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel());

        expect(<%- entityInstance %>).toMatchObject({});
      });

      it('should return I<%- entityAngularName %>', () => {
        const <%- entityInstance %> = service.get<%- entityAngularName %>(service.create<%- entityAngularName %>FormModel(sampleWithRequiredData));

        expect(<%- entityInstance %>).toMatchObject(sampleWithRequiredData);
      });
    });
  });
});
