<%_ const formDefaultProperties = [
      ...fields.filter(field => field.fieldTypeTimed || field.fieldTypeBoolean || field.id || field.collection || field.fieldTsDefaultValue !== undefined).map(field => field.fieldName),
      ...relationships.filter(relationship => relationship.collection && relationship.persistableRelationship).map(relationship => relationship.propertyName),
    ];
    const containDefaultProperties = formDefaultProperties.length > 0;
    const anyFieldTimed = fields.some(field => field.fieldTypeTimed);
    // How a field is kept in the form: the text ones as strings, empty when the entity has no value.
    const formValueKinds = [
      ['id', field => field.id && field.autoGenerate && field.fieldTypeNumeric],
      ['boolean', field => field.fieldTypeBoolean],
      ['timed', field => field.fieldTypeTimed],
      ['collection', field => field.collection],
      ['nullable', field => field.fieldTypeNumeric || field.fieldTypeLocalDate],
      ['option', field => field.fieldIsEnum || field.clientConstantsAsValues],
    ];
    const formValueKind = field => formValueKinds.find(([, matches]) => matches(field))?.[0] ?? 'text';
    const formFields = fields.flatMap(field => field.fieldTypeBinary && !field.blobContentTypeText
      ? [{ field, fieldName: field.fieldName, kind: 'text' }, { field, fieldName: `${field.fieldName}ContentType`, kind: 'text', contentType: true }]
      : [{ field, fieldName: field.fieldName, kind: formValueKind(field) }]);
    const formRelationships = relationships.filter(relationship => relationship.persistableRelationship);
    const editableId = !primaryKey.autoGenerate && !builtInUserManagement;
    const signalFormsImports = ['FieldTree', 'FormOptions', 'form'];
    if (fields.some(field => field.id && field.autoGenerate) || fields.some(field => field.readonly)) signalFormsImports.push('readonly');
    if (editableId) signalFormsImports.push('readonly');
    if (fields.some(field => field.fieldValidationEmail)) signalFormsImports.push('email');
    if (fields.some(field => field.fieldValidationMax)) signalFormsImports.push('max');
    if (fields.some(field => field.fieldValidationMaxLength)) signalFormsImports.push('maxLength');
    if (fields.some(field => field.fieldValidationMin)) signalFormsImports.push('min');
    if (fields.some(field => field.fieldValidationMinLength)) signalFormsImports.push('minLength');
    if (fields.some(field => field.fieldValidationPattern)) signalFormsImports.push('pattern');
    if (fields.some(field => (field.fieldValidationRequired && !field.fieldTypeBoolean) || (field.id && !field.autoGenerate)) || formRelationships.some(relationship => !relationship.collection && relationship.relationshipRequired)) signalFormsImports.push('required');
    const anchoredPattern = pattern => `${pattern.startsWith('^') ? '' : '^'}${pattern}${pattern.endsWith('$') ? '' : '$'}`;
_%>
import { Service, <%- editableId ? 'Signal, ' : '' %>WritableSignal } from '@angular/core';
import { <%- [...new Set(signalFormsImports)].sort().join(', ') %> } from '@angular/forms/signals';

<%_ if (anyFieldTimed) { _%>
import dayjs from 'dayjs/esm';

import { DATE_TIME_FORMAT } from 'app/config';
<%_ } _%>
import { I<%- entityAngularName %>, New<%- entityAngularName %> } from '../<%- entityFileName %>.model';

/**
 * A partial Type with required key is used as form input.
 */
type PartialWithRequiredKeyOf<T extends { <%- primaryKey.name %>: unknown }> = Partial<Omit<T, '<%- primaryKey.name %>'>> & { <%- primaryKey.name %>: T['<%- primaryKey.name %>'] };

/**
 * Type for the createFormModel argument.
 * It accepts I<%- entityAngularName %> for edit and New<%- entityAngularName %>FormInput for create.
 */
type <%- entityAngularName %>FormInput = I<%- entityAngularName %> | PartialWithRequiredKeyOf<New<%- entityAngularName %>>;
<%_ if (containDefaultProperties) { _%>

type <%- entityAngularName %>FormDefaults = Pick<New<%- entityAngularName %>, '<%- formDefaultProperties.join("' | '") %>'>;
<%_ } _%>

/**
 * The value of the form: the text fields are strings, empty when the entity has no value, and the dates and times
 * are the text of their inputs.
 */
export type <%- entityAngularName %>FormModel = {
<%_ for (const { field, fieldName, kind } of formFields) { _%>
  <%_ if (kind === 'id') { _%>
  <%- fieldName %>: I<%- entityAngularName %>['<%- fieldName %>'] | New<%- entityAngularName %>['<%- fieldName %>'];
  <%_ } else if (kind === 'boolean') { _%>
  <%- fieldName %>: boolean;
  <%_ } else if (kind === 'timed' || kind === 'text') { _%>
  <%- fieldName %>: string;
  <%_ } else if (kind === 'collection') { _%>
  <%- fieldName %>: NonNullable<I<%- entityAngularName %>['<%- fieldName %>']>;
  <%_ } else if (kind === 'option' && field.fieldIsEnum && !field.clientConstantsAsValues) { _%>
  <%- fieldName %>: NonNullable<I<%- entityAngularName %>['<%- fieldName %>']> | '';
  <%_ } else if (kind === 'option') { _%>
  <%- fieldName %>: string;
  <%_ } else { _%>
  <%- fieldName %>: NonNullable<I<%- entityAngularName %>['<%- fieldName %>']> | null;
  <%_ } _%>
<%_ } _%>
<%_ for (const { propertyName, collection } of formRelationships) { _%>
  <%- propertyName %>: NonNullable<I<%- entityAngularName %>['<%- propertyName %>']><%- collection ? '' : ' | null' %>;
<%_ } _%>
};

export type <%- entityAngularName %>Form = FieldTree<<%- entityAngularName %>FormModel>;

@Service()
export class <%- entityAngularName %>FormService {
  create<%- entityAngularName %>FormModel(<%- entityInstance %>?: <%- entityAngularName %>FormInput): <%- entityAngularName %>FormModel {
    const value: Partial<I<%- entityAngularName %>> | Partial<New<%- entityAngularName %>> = <% if (containDefaultProperties) { %>{ ...this.getFormDefaults(), ...<%- entityInstance %> }<% } else { %><%- entityInstance %> ?? {}<% } %>;
    return {
<%_ for (const { fieldName, kind } of formFields) { _%>
  <%_ if (kind === 'id') { _%>
      <%- fieldName %>: value.<%- fieldName %> ?? null,
  <%_ } else if (kind === 'boolean') { _%>
      <%- fieldName %>: value.<%- fieldName %> ?? false,
  <%_ } else if (kind === 'timed') { _%>
      <%- fieldName %>: value.<%- fieldName %> ? value.<%- fieldName %>.format(DATE_TIME_FORMAT) : '',
  <%_ } else if (kind === 'text' || kind === 'option') { _%>
      <%- fieldName %>: value.<%- fieldName %> ?? '',
  <%_ } else if (kind === 'collection') { _%>
      <%- fieldName %>: value.<%- fieldName %> ?? [],
  <%_ } else { _%>
      <%- fieldName %>: value.<%- fieldName %> ?? null,
  <%_ } _%>
<%_ } _%>
<%_ for (const { propertyName, collection } of formRelationships) { _%>
      <%- propertyName %>: value.<%- propertyName %> ?? <%- collection ? '[]' : 'null' %>,
<%_ } _%>
    };
  }

  /**
   * The form of the model, its validation included, created in an injection context.
   */
  create<%- entityAngularName %>Form(model: WritableSignal<<%- entityAngularName %>FormModel>, <%- editableId ? 'editing: Signal<boolean>, ' : '' %>options: FormOptions<<%- entityAngularName %>FormModel> = {}): <%- entityAngularName %>Form {
    return form(
      model,
      path => {
<%_ for (const field of fields) { _%>
  <%_ const { fieldName } = field; _%>
  <%_ if (field.id && field.autoGenerate) { _%>
        readonly(path.<%- fieldName %>);
  <%_ } else if (field.id && editableId) { _%>
        readonly(path.<%- fieldName %>, { when: () => editing() });
  <%_ } else if (field.readonly) { _%>
        readonly(path.<%- fieldName %>);
  <%_ } _%>
  <%_ if ((field.fieldValidationRequired && !field.fieldTypeBoolean) || (field.id && !field.autoGenerate)) { _%>
        required(path.<%- fieldName %>);
  <%_ } _%>
  <%_ if (field.fieldValidationEmail) { _%>
        email(path.<%- fieldName %>);
  <%_ } _%>
  <%_ if (field.fieldValidationMinLength) { _%>
        minLength(path.<%- fieldName %>, <%- field.fieldValidateRulesMinlength %>);
  <%_ } _%>
  <%_ if (field.fieldValidationMaxLength) { _%>
        maxLength(path.<%- fieldName %>, <%- field.fieldValidateRulesMaxlength %>);
  <%_ } _%>
  <%_ if (field.fieldValidationMin) { _%>
        min(path.<%- fieldName %>, <%- field.fieldValidateRulesMin %>);
  <%_ } _%>
  <%_ if (field.fieldValidationMax) { _%>
        max(path.<%- fieldName %>, <%- field.fieldValidateRulesMax %>);
  <%_ } _%>
  <%_ if (field.fieldValidationPattern) { _%>
        pattern(path.<%- fieldName %>, new RegExp('<%- anchoredPattern(field.fieldValidateRulesPatternAngular) %>')); // NOSONAR
  <%_ } _%>
<%_ } _%>
<%_ for (const { propertyName, collection, relationshipRequired } of formRelationships) { _%>
  <%_ if (!collection && relationshipRequired) { _%>
        required(path.<%- propertyName %>);
  <%_ } _%>
<%_ } _%>
      },
      options,
    );
  }

  get<%- entityAngularName %>(model: <%- entityAngularName %>FormModel):<% if (updatableEntity) { %> I<%- entityAngularName %> |<% } %> New<%- entityAngularName %> {
    return {
<%_ for (const { fieldName, kind } of formFields) { _%>
  <%_ if (kind === 'timed') { _%>
      <%- fieldName %>: model.<%- fieldName %> ? dayjs(model.<%- fieldName %>, DATE_TIME_FORMAT) : null,
  <%_ } else if (kind === 'text' || kind === 'option') { _%>
      <%- fieldName %>: model.<%- fieldName %> || null,
  <%_ } else { _%>
      <%- fieldName %>: model.<%- fieldName %>,
  <%_ } _%>
<%_ } _%>
<%_ for (const { propertyName } of formRelationships) { _%>
      <%- propertyName %>: model.<%- propertyName %>,
<%_ } _%>
    }<% if (!updatableEntity) { %> as New<%- entityAngularName %><% } %>;
  }
<%_ if (containDefaultProperties) { _%>

  private getFormDefaults(): <%- entityAngularName %>FormDefaults {
  <%_ if (anyFieldTimed) { _%>
    const currentTime = dayjs();

  <%_ } _%>
    return {
  <%_ for (field of fields) { _%>
    <%_ const { fieldName, fieldTypeBoolean, fieldTypeTimed } = field; _%>
    <%_ if (field.fieldTsDefaultValue) { _%>
      <%- fieldName %>: <%- field.fieldTsDefaultValue %>,
    <%_ } else { _%>
      <%_ if (field.id) { _%>
      <%- fieldName %>: null,
      <%_ } else if (fieldTypeBoolean) { _%>
      <%- fieldName %>: false,
      <%_ } else if (fieldTypeTimed) { _%>
      <%- fieldName %>: currentTime,
      <%_ } else if (field.collection) { _%>
      <%- fieldName %>: [],
      <%_ } _%>
    <%_ } _%>
  <%_ } _%>
  <%_ for (const relationship of formRelationships) { _%>
    <%_ const { propertyName, collection } = relationship; _%>
    <%_ if (collection) { _%>
      <%- propertyName %>: [],
    <%_ } _%>
  <%_ } _%>
    };
  }
<%_ } _%>
}
