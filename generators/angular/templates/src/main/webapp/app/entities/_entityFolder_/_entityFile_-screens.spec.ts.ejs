            queryParamMap: of(convertToParamMap({ page: '1', size: '1', sort: '<%- primaryKeyName %>,desc' })),
            snapshot: { data: { defaultSort: '<%- primaryKeyName %>,asc' }, queryParams: {}, queryParamMap: convertToParamMap({ page: '1', size: '1', sort: '<%- primaryKeyName %>,desc' }) },
          },
