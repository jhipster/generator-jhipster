-%>
<div class="d-flex justify-content-center">
    <div class="col-8">
        <form name="editForm" novalidate [formRoot]="editForm">
            <h2 id="<%- jhiPrefixDashed %>-<%- entityFileName %>-heading" data-cy="<%- entityNameCapitalized %>CreateUpdateHeading">__jhiTranslateTag__('<%- i18nKeyPrefix %>.home.createOrEditLabel')</h2>

            <div>
                <<%- jhiPrefixDashed %>-alert-error />
<%_ for (const field of fields.filter(field => !field.hidden && !(builtInUserManagement && field.readonly))) { _%>
  <%_ const { fieldName, fieldNameHumanized, fieldType, fieldTypeBlobContent } = field; _%>

            <% if (field.autoGenerate) { %>@if (editForm.<%- field.fieldName %>().value() !== <%- field.fieldTypeNumeric || field.fieldTypeBoolean ? 'null' : "''" %>) {<% } %>
                <% if (field.fieldTypeBinary && !field.blobContentTypeText || field.fieldValidate) { %>@let <%- fieldName %>Ref = editForm.<%- fieldName %>();<% } %>
  <%_ const documentationTooltip = enableTranslation ? ` [ngbTooltip]="'${i18nKeyPrefix}.help.${fieldName}' | translate"` : ` ngbTooltip="${field.documentation}"`; _%>
  <%_ const labelTooltip = field.documentation ? documentationTooltip : ''; _%>
                <div class="mb-3<%- field.fieldTypeBoolean ? ' form-check' : '' %>">
  <%_ if (field.fieldTypeBoolean) { _%>
                    <input type="<%- field.htmlInputType %>" class="form-check-input" id="field_<%- fieldName %>"
                           data-cy="<%- fieldName %>" [formField]="editForm.<%- fieldName %>"/>
                    <label class="form-check-label" for="field_<%- fieldName %>"<%- labelTooltip %>>__jhiTranslateTag__('<%- field.propertyTranslationKey %>')</label>
  <%_ } else { _%>
                    <label class="form-label" for="field_<%- fieldName %>"<%- labelTooltip %>>__jhiTranslateTag__('<%- field.propertyTranslationKey %>')</label>
    <%_ if (field.clientConstantsAsValues) { _%>
                    <select class="form-select" [formField]="editForm.<%- fieldName %>" id="field_<%- fieldName %>" data-cy="<%- fieldName %>"<%- field.collection ? ` multiple [${jhiPrefix}SelectOptions]="${fieldName}Values"` : '' %>>
      <%_ if (!field.collection) { _%>
                        <option value=""></option>
      <%_ } _%>
                    @for (<%- field.angularFieldNameSingular %> of <%- fieldName %>Values; track $index) {
                        <option [value]="<%- field.collection ? '$index' : field.angularFieldNameSingular %>">{{ <%- field.angularFieldNameSingular %><%- field.angularFieldClientConstant.angularConstantLabelPipe ? ` | ${field.angularFieldClientConstant.angularConstantLabelPipe.name}` : '' %> }}</option>
                    }
                    </select>
    <%_ } else if (field.fieldIsEnum) { _%>
                    <select class="form-select" [formField]="editForm.<%- fieldName %>" id="field_<%- fieldName %>" data-cy="<%- fieldName %>">
      <%_ const enumPrefix = `${frontendAppName}.${fieldType}`; _%>
                        <option value=""><% if (enableTranslation) { %>{{ '<%- enumPrefix %>.null' | translate }}<% } %></option>
                    @for (<%- field.enumInstance %> of <%- field.enumInstance %>Values; track $index) {
                        <option [value]="<%- field.enumInstance %>">__jhiTranslatePipeEnum__('<%- enumPrefix %>', { "value": "<%- field.enumInstance %>" })</option>
                    }
                    </select>
    <%_ } else { _%>
      <%_ if (field.fieldTypeBinary && !field.blobContentTypeText) { _%>
                    <div>
        <%_ if (field.blobContentTypeImage) { _%>
                    @if (<%- fieldName %>Ref.value()) {
                        <img [src]="'data:' + editForm.<%- fieldName %>ContentType().value() + ';base64,' + <%- fieldName %>Ref.value()" style="max-height: 100px" alt="<%- entityInstance %>"/>
                    }
        <%_ } _%>
                    @if (<%- fieldName %>Ref.value()) {
                        <div class="form-text text-danger clearfix">
        <%_ if (field.blobContentTypeAny) { _%>
                            <a class="pull-start" (click)="openFile(<%- fieldName %>Ref.value(), editForm.<%- fieldName %>ContentType().value())">__jhiTranslateTag__('entity.action.open')</a><br>
        <%_ } _%>
                            <span class="pull-start">{{ editForm.<%- fieldName %>ContentType().value() }}, {{ byteSize(<%- fieldName %>Ref.value()) }}</span>
        <%_ if (field.blobContentTypeImage) { _%>
                            <button type="button" (click)="clearInputImage('<%- fieldName %>', '<%- fieldName %>ContentType', 'file_<%- fieldName %>')" class="btn btn-secondary btn-xs pull-end">
        <%_ } else { _%>
                            <button type="button" (click)="editForm.<%- fieldName %>().value.set(''); editForm.<%- fieldName %>ContentType().value.set('')"
                                    class="btn btn-secondary btn-xs pull-end">
        <%_ } _%>
                                  <fa-icon icon="times" />
                            </button>
                        </div>
                    }
                        <input type="file" id="file_<%- fieldName %>" data-cy="<%- fieldName %>" (change)="setFileData($event, '<%- fieldName %>', <% if (fieldTypeBlobContent === 'image') { %>true)" accept="image/*"<% if (enableTranslation) { %> <%- jhiPrefix %>Translate="entity.action.addimage"<% } %><% } else { %>false)"<% if (enableTranslation) { %> <%- jhiPrefix %>Translate="entity.action.addblob"<% } %><% } %> aria-label="<%- fieldNameHumanized %>"/>
                    </div>
      <%_ } _%>
      <%_ if (field.fieldTypeLocalDate) { _%>
                    <div class="input-group">
                        <input id="field_<%- fieldName %>" data-cy="<%- fieldName %>" type="text" class="form-control" ngbDatepicker #<%- fieldName %>Dp="ngbDatepicker" [formField]="editForm.<%- fieldName %>"/>
                        <button type="button" class="btn btn-secondary" (click)="<%- fieldName %>Dp.toggle()"><fa-icon icon="calendar-alt" /></button>
                    </div>
      <%_ } else if (field.fieldTypeTimed) { _%>
                    <div class="d-flex">
                        <input id="field_<%- fieldName %>" data-cy="<%- fieldName %>" type="<%- field.htmlInputType %>" class="form-control" [formField]="editForm.<%- fieldName %>" placeholder="YYYY-MM-DD HH:mm"/>
                    </div>
      <%_ } else if (field.blobContentTypeText) { _%>
                    <textarea class="form-control" id="field_<%- fieldName %>" data-cy="<%- fieldName %>"
                              [formField]="editForm.<%- fieldName %>"></textarea>
      <%_ } else if (field.fieldTypeLocalTime) { _%>
                    <input type="time" class="form-control" id="field_<%- fieldName %>" data-cy="<%- fieldName %>"
                           [formField]="editForm.<%- fieldName %>"/>
      <%_ } else if (!field.fieldTypeBinary) { _%>
                    <input type="<%- field.htmlInputType %>" class="form-control" id="field_<%- fieldName %>" data-cy="<%- fieldName %>"
                           [formField]="editForm.<%- fieldName %>"/>
      <%_ } _%>
    <%_ } _%>
  <%_ } _%>
  <%_ if (field.fieldValidate) { _%>
                @if (<%- fieldName %>Ref.invalid() && (<%- fieldName %>Ref.dirty() || <%- fieldName %>Ref.touched())) {
                    <div>
    <%_ if (field.fieldValidationRequired) { _%>
                    @if (<%- fieldName %>Ref.getError('required')) {
                        <small class="form-text text-danger">__jhiTranslateTag__('entity.validation.required')</small>
                    }
    <%_ } _%>
    <%_ if (field.fieldValidationMinLength) { _%>
                    @if (<%- fieldName %>Ref.getError('minLength')) {
                        <small class="form-text text-danger">__jhiTranslateValidationTag__('entity.validation.minlength', { "min": <%- field.fieldValidateRulesMinlength %> })</small>
                    }
    <%_ } _%>
    <%_ if (field.fieldValidationMaxLength) { _%>
                    @if (<%- fieldName %>Ref.getError('maxLength')) {
                        <small class="form-text text-danger">__jhiTranslateValidationTag__('entity.validation.maxlength', { "max": <%- field.fieldValidateRulesMaxlength %> })</small>
                    }
    <%_ } _%>
    <%_ if (field.fieldValidationMin) { _%>
                    @if (<%- fieldName %>Ref.getError('min')) {
                        <small class="form-text text-danger">__jhiTranslateValidationTag__('entity.validation.min', { "min": <%- field.fieldValidateRulesMin %> })</small>
                    }
    <%_ } _%>
    <%_ if (field.fieldValidationMax) { _%>
                    @if (<%- fieldName %>Ref.getError('max')) {
                        <small class="form-text text-danger">__jhiTranslateValidationTag__('entity.validation.max', { "max": <%- field.fieldValidateRulesMax %> })</small>
                    }
    <%_ } _%>
    <%_ if (field.fieldValidationPattern) { _%>
                    @if (<%- fieldName %>Ref.getError('pattern')) {
      <%_ if (builtInUserManagement && fieldName === 'login') { _%>
                        <small class="form-text text-danger">__jhiTranslateTag__('entity.validation.patternLogin')</small>
      <%_ } else { _%>
                        <small class="form-text text-danger">__jhiTranslateValidationTag__('entity.validation.pattern', { "pattern": "<%- fieldNameHumanized %>" })</small>
      <%_ } _%>
                    }
    <%_ } _%>
    <%_ if (field.fieldValidationEmail) { _%>
                    @if (<%- fieldName %>Ref.getError('email')) {
                        <small class="form-text text-danger">__jhiTranslateTag__('global.messages.validate.email.invalid')</small>
                    }
    <%_ } _%>
    <%_ if (field.fieldTypeNumeric || field.fieldTypeDuration) { _%>
                        <small class="form-text text-danger"
                            [hidden]="!<%- fieldName %>Ref.getError('parse')">__jhiTranslateTag__('entity.validation.number')</small>
    <%_ } _%>
    <%_ if (field.fieldTypeTimed) { _%>
                        <small class="form-text text-danger"
                            [hidden]="!<%- fieldName %>Ref.getError('parse')">__jhiTranslateTag__('entity.validation.datetimelocal')</small>
    <%_ } _%>
                    </div>
                }
  <%_ } _%>
                </div>
            <%- field.autoGenerate ? '}' : '' %>
<%_ } _%>
<%_ for (const relationship of relationships.filter(rel => rel.otherEntity.primaryKey)) { _%>
  <%_ const { otherEntity, relationshipName, propertyName, otherEntityField, relationshipRequired, otherEntityName, relationshipFieldName, relationshipFieldNamePlural } = relationship; _%>
  <%_ if (relationship.relationshipSerializePrimaryKeyOnly) { _%>

                <div class="mb-3">
                    <label class="form-label" for="field_<%- relationshipName %>">__jhiTranslateTag__('<%- relationship.propertyTranslationKey %>')</label>
                    <select class="form-select" id="field_<%- relationshipName %>"<%- relationship.collection ? ' multiple' : '' %> [formField]="editForm.<%- propertyName %>" [<%- jhiPrefix %>SelectOptions]="<%- propertyName %>()">
    <%_ if (!relationship.collection) { _%>
                        <option value=""></option>
    <%_ } _%>
                    @for (<%- relationshipFieldName %> of <%- propertyName %>(); track $index) {
                        <option [value]="$index">{{ <%- relationshipFieldName %> }}</option>
                    }
                    </select>
                </div>
  <%_ } else if (relationship.persistableRelationship && !relationship.collection) { _%>

                <div class="mb-3">
                    <label class="form-label" for="field_<%- relationshipName %>">__jhiTranslateTag__('<%- relationship.propertyTranslationKey %>')</label>
                    <select class="form-select" id="field_<%- relationshipName %>" data-cy="<%- propertyName %>" [formField]="editForm.<%- propertyName %>" [<%- jhiPrefix %>SelectOptions]="<% if (!relationship.otherRelationship || relationship.relationshipManyToOne) { %><%- otherEntity.entityInstancePlural %>Shared<% } else { %><%- relationshipFieldNamePlural %><% } %>Collection()" [compareWith]="compare<%- otherEntity.entityAngularName %>">
    <%_ if (!relationshipRequired) { _%>
                        <option value=""></option>
    <%_ } else if (relationship.otherRelationship) { _%>
                    @if (editForm.<%- relationship.propertyName %>().value() === null) {
                        <option value=""></option>
                    }
    <%_ } else { _%>
                    @if (!editForm.<%- relationshipName %>().value()) {
                        <option value=""></option>
                    }
    <%_ } _%>
                    @for (<%- otherEntityName %>Option of <% if (!relationship.otherRelationship || relationship.relationshipManyToOne) { %><%- otherEntity.entityInstancePlural %>Shared<% } else { %><%- relationshipFieldNamePlural %><% } %>Collection(); track $index) {
                        <option [value]="$index">{{ <%- otherEntityName %>Option.<%- otherEntityField %> }}</option>
                    }
                    </select>
                </div>
  <%_ } else if (relationship.persistableRelationship) { _%>

                <div class="mb-3">
                    <label for="field_<%- relationshipFieldNamePlural %>">__jhiTranslateTag__('<%- relationship.propertyTranslationKey %>')</label>
                    <select class="form-select" id="field_<%- relationshipFieldNamePlural %>" data-cy="<%- relationshipFieldName %>" multiple [formField]="editForm.<%- propertyName %>" [<%- jhiPrefix %>SelectOptions]="<%- otherEntity.entityInstancePlural %>SharedCollection()" [compareWith]="compare<%- otherEntity.entityAngularName %>">
                    @for (<%- otherEntityName %>Option of <%- otherEntity.entityInstancePlural %>SharedCollection(); track $index) {
                        <option [value]="$index">{{ <%- otherEntityName %>Option.<%- otherEntityField %> }}</option>
                    }
                    </select>
                </div>
  <%_ } _%>
  <%_ if (relationship.relationshipValidate && relationship.persistableRelationship) { _%>
            @let <%- propertyName %>Ref = editForm.<%- propertyName %>();
            @if (<%- propertyName %>Ref.invalid() && (<%- propertyName %>Ref.dirty() || <%- propertyName %>Ref.touched())) {
                <div>
    <%_ if (relationshipRequired) { _%>
                @if (<%- propertyName %>Ref.getError('required')) {
                    <small class="form-text text-danger">__jhiTranslateTag__('entity.validation.required')</small>
                }
    <%_ } _%>
                </div>
            }
  <%_ } _%>
<%_ } _%>
            </div>

            <div>
                <button type="button" id="cancel-save" data-cy="entityCreateCancelButton" class="btn btn-info" (click)="previousState()">
                    <fa-icon icon="arrow-left" />&nbsp;<span>__jhiTranslateTag__('entity.action.back')</span>
                </button>

                <button type="submit" id="save-entity" data-cy="entityCreateSaveButton" [disabled]="isSaving()" class="btn btn-primary">
                    <fa-icon icon="save" />&nbsp;<span>__jhiTranslateTag__('entity.action.save')</span>
                </button>
            </div>
        </form>
    </div>
</div>
