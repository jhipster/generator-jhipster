import { EnvironmentProviders, Provider, effect, inject, provideAppInitializer } from '@angular/core';

import { TranslateService } from '@ngx-translate/core';
import { loadLocale } from 'i18n';

import { AccountService } from 'app/core/auth';

import { loadTranslation } from './index';

const microfrontends: string[] = [<%- microfrontends.filter(remote => !remote.self).map(remote => `'${remote.moduleFederationName}'`).join(', ') %>];

const logTranslationError = (microfrontend: string) => (error: unknown): undefined => {
  console.error(`Error loading ${microfrontend} translations`, error);
  return undefined;
};

/**
 * The translations of a microfrontend without the keys the application defines: it adds its own keys, the ones of the application,
 * like its title, are kept whichever is loaded first.
 */
const withoutDefinedKeys = (translations: Record<string, any>, defined: Record<string, any>): Record<string, any> => {
  const isObject = (value: unknown): boolean => typeof value === 'object' && value !== null && !Array.isArray(value);
  const result: Record<string, any> = {};
  for (const [key, value] of Object.entries(translations)) {
    if (defined[key] === undefined) {
      result[key] = value;
    } else if (isObject(value) && isObject(defined[key])) {
      result[key] = withoutDefinedKeys(value, defined[key]);
    }
  }
  return result;
};

/**
 * Microfrontends are only used by authenticated users: their translations are merged into the ones of the language once the user
 * logs in, after the language is loaded, since its loader replaces them. Reloading the language removes them at logout.
 * Must be provided by the application config: it relies on the federation runtime initialized by the application.
 */
export function provideMicrofrontendTranslation(): (Provider | EnvironmentProviders)[] {
  return [
    provideAppInitializer(() => {
      const translateService = inject(TranslateService);
      const accountService = inject(AccountService);
      const mergedLanguages = new Set<string>();
      const mergeTranslations = async (lang: string): Promise<void> => {
        const applicationTranslations = await loadLocale(lang as any);
        await Promise.all(
          microfrontends.map(microfrontend =>
            loadTranslation(microfrontend, lang)
              .then(translations => translateService.setTranslation(lang, withoutDefinedKeys(translations, applicationTranslations), true))
              .catch(logTranslationError(microfrontend)),
          ),
        );
      };
      effect(() => {
        const lang = translateService.getCurrentLang();
        const authenticated = accountService.account() !== null;
        if (!lang || translateService.isLoading()) {
          return;
        }
        if (authenticated && !mergedLanguages.has(lang)) {
          mergedLanguages.add(lang);
          void mergeTranslations(lang);
        } else if (!authenticated && mergedLanguages.delete(lang)) {
          translateService.reloadLang(lang).subscribe();
        }
      });
    }),
  ];
}
