import { EnvironmentProviders, Injectable, Provider, effect, inject, provideAppInitializer, signal, untracked } from '@angular/core';
import { TranslateLoader, TranslateService } from '@ngx-translate/core';
import { Observable, from } from 'rxjs';
import { loadLocale } from 'i18n';

import { AccountService } from 'app/core/auth';

import { loadTranslation } from './index';

const microfrontends: string[] = [<%- microfrontends.filter(remote => !remote.self).map(remote => `'${remote.moduleFederationName}'`).join(', ') %>];

const mergeTranslations = (target: Record<string, any>, source: Record<string, any>): Record<string, any> => {
  for (const [key, value] of Object.entries(source)) {
    target[key] = value && typeof value === 'object' && typeof target[key] === 'object' ? mergeTranslations({ ...target[key] }, value) : value;
  }
  return target;
};

const logTranslationError = (microfrontend: string) => (error: unknown): undefined => {
  console.error(`Error loading ${microfrontend} translations`, error);
  return undefined;
};

/**
 * Loads the application translations, merged with the microfrontends translations when enabled.
 */
@Injectable({ providedIn: 'root' })
export class MicrofrontendTranslationLoader implements TranslateLoader {
  /** Microfrontends are only used by authenticated users, their translations are loaded once enabled. */
  readonly loadMicrofrontends = signal(false);

  getTranslation(lang: string): Observable<any> {
    return from(this.loadTranslations(lang));
  }

  private async loadTranslations(lang: string): Promise<Record<string, any>> {
    const translations = await Promise.all([
      loadLocale(lang as any),
      ...(this.loadMicrofrontends()
        ? microfrontends.map(microfrontend => loadTranslation(microfrontend, lang).catch(logTranslationError(microfrontend)))
        : []),
    ]);
    return translations.reduce<Record<string, any>>((merged, translation) => mergeTranslations(merged, translation ?? {}), {});
  }
}

/**
 * Replaces the translation loader with the microfrontends aware one and reloads the translations once the user logs in.
 * Must be provided by the application config: the loader relies on the federation runtime initialized by the application.
 */
export function provideMicrofrontendTranslation(): (Provider | EnvironmentProviders)[] {
  return [
    { provide: TranslateLoader, useClass: MicrofrontendTranslationLoader },
    provideAppInitializer(() => {
      const translateService = inject(TranslateService);
      const translateLoader = inject(TranslateLoader) as MicrofrontendTranslationLoader;
      const accountService = inject(AccountService);
      effect(() => {
        const loadMicrofrontends = accountService.account() !== null;
        if (untracked(translateLoader.loadMicrofrontends) !== loadMicrofrontends) {
          translateLoader.loadMicrofrontends.set(loadMicrofrontends);
          const lang = translateService.getCurrentLang();
          if (lang) {
            translateService.reloadLang(lang).subscribe();
          }
        }
      });
    }),
  ];
}
