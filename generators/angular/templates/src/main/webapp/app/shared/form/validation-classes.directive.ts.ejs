import { Directive, inject } from '@angular/core';
import { NgControl } from '@angular/forms';

/**
 * Marks a field of a reactive form with the validation classes of Bootstrap, the ones the clients have in common:
 * `is-invalid` or `is-valid` once the user touched or changed it, and `is-touched` once touched. An untouched field has
 * no mark.
 */
@Directive({
  // Every field of a reactive form, as the classes of Angular itself (ng-invalid).
  // eslint-disable-next-line @angular-eslint/directive-selector
  selector: '[formControlName]',
  host: {
    '[class.is-invalid]': 'marked && control.invalid',
    '[class.is-valid]': 'marked && control.valid',
    '[class.is-touched]': 'control.touched',
  },
})
export class ValidationClassesDirective {
  protected readonly control = inject(NgControl, { self: true });

  protected get marked(): boolean {
    return this.control.touched === true || this.control.dirty === true;
  }
}
