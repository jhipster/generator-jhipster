import { describe, expect, it } from 'vitest';

import { keepEmptyBoolean, keepEmptyText } from './form-values';

describe('keepEmptyText', () => {
  it('should give the text of the form', () => {
    expect(keepEmptyText('text', '')).toBe('text');
  });

  it('should keep the empty string of the edited entity', () => {
    expect(keepEmptyText('', '')).toBe('');
  });

  it('should give null for an edited entity without a value', () => {
    expect(keepEmptyText('', null)).toBeNull();
    expect(keepEmptyText('', undefined)).toBeNull();
  });

  it('should give null when the edited text was cleared', () => {
    expect(keepEmptyText('', 'text')).toBeNull();
  });
});

describe('keepEmptyBoolean', () => {
  it('should give true when checked', () => {
    expect(keepEmptyBoolean(true, null)).toBe(true);
  });

  it('should keep the null of the edited entity', () => {
    expect(keepEmptyBoolean(false, null)).toBeNull();
  });

  it('should give false for an edited entity with a value or without one', () => {
    expect(keepEmptyBoolean(false, true)).toBe(false);
    expect(keepEmptyBoolean(false, false)).toBe(false);
    expect(keepEmptyBoolean(false, undefined)).toBe(false);
  });
});
