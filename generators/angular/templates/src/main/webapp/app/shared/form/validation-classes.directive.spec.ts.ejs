import { describe, expect, it } from 'vitest';
import { Component } from '@angular/core';
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { FormControl, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';

import { ValidationClassesDirective } from './validation-classes.directive';

@Component({
  imports: [ReactiveFormsModule, ValidationClassesDirective],
  template: '<form [formGroup]="form"><input formControlName="name" /></form>',
})
class Host {
  readonly form = new FormGroup({ name: new FormControl('', { nonNullable: true, validators: [Validators.required] }) });
}

describe('ValidationClassesDirective', () => {
  const render = async (): Promise<{ fixture: ComponentFixture<Host>; input: HTMLInputElement }> => {
    const fixture = TestBed.createComponent(Host);
    await fixture.whenStable();
    return { fixture, input: fixture.nativeElement.querySelector('input') as HTMLInputElement };
  };

  it('should not mark an untouched field', async () => {
    const { input } = await render();

    expect(input.classList).not.toContain('is-invalid');
    expect(input.classList).not.toContain('is-valid');
    expect(input.classList).not.toContain('is-touched');
  });

  it('should mark a touched field as invalid, then as valid once filled', async () => {
    const { fixture, input } = await render();

    input.dispatchEvent(new Event('blur'));
    fixture.detectChanges();
    expect(input.classList).toContain('is-invalid');
    expect(input.classList).toContain('is-touched');

    input.value = 'name';
    input.dispatchEvent(new Event('input'));
    fixture.detectChanges();
    expect(input.classList).toContain('is-valid');
    expect(input.classList).not.toContain('is-invalid');
  });

  it('should mark a changed field before it is touched', async () => {
    const { fixture, input } = await render();

    input.value = 'name';
    input.dispatchEvent(new Event('input'));
    fixture.detectChanges();

    expect(input.classList).toContain('is-valid');
    expect(input.classList).not.toContain('is-touched');
  });
});
