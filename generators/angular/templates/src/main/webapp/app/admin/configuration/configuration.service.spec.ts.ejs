import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';

import { ConfigProps, ConfigurationSection, Env } from 'app/shared/jhipster/configuration';

import { ConfigurationService } from './configuration.service';

describe('Configuration Service', () => {
  let service: ConfigurationService;
  let httpMock: HttpTestingController;
  let expectedResult: ConfigurationSection[] | null;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideHttpClientTesting()],
    });

    expectedResult = null;
    service = TestBed.inject(ConfigurationService);
    httpMock = TestBed.inject(HttpTestingController);
  });

  afterEach(() => {
    httpMock.verify();
  });

  describe('Service methods', () => {
    it('should get the configuration', () => {
      const configProps: ConfigProps = {
        contexts: { jhipster: { beans: { bean: { prefix: 'jhipster', properties: { name: 'app' } } } } },
      };
      const env: Env = { propertySources: [{ name: 'server.ports', properties: { 'local.server.port': { value: '8080' } } }] };
      service.getConfiguration().subscribe(received => (expectedResult = received));

      httpMock.expectOne(req => req.url.endsWith('management/configprops')).flush(configProps);
      httpMock.expectOne(req => req.url.endsWith('management/env')).flush(env);
      expect(expectedResult).toEqual([
        expect.objectContaining({ label: { text: 'Spring configuration' }, rows: [{ key: 'jhipster', properties: [{ key: 'name', value: 'app' }] }] }),
        expect.objectContaining({ label: { text: 'server.ports' }, rows: [{ key: 'local.server.port', value: '8080' }] }),
      ]);
    });
  });
});
