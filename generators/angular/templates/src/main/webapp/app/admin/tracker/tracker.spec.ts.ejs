import { beforeEach, describe, expect, it, vi } from 'vitest';
import { ComponentFixture, TestBed } from '@angular/core/testing';

<%_ if (enableTranslation) { _%>
import { provideTranslateService } from '@ngx-translate/core';
<%_ } _%>
import { Observer, Subject } from 'rxjs';

import { TrackerActivity } from 'app/core/tracker/tracker-activity.model';
import { TrackerService } from 'app/core/tracker/tracker.service';

import Tracker from './tracker';

// The specs share their modules: the tracker service is loaded with the same mock of the web socket as in its own spec.
vi.mock('sockjs-client', () => ({ default: vi.fn(() => ({})) }));

describe('Tracker', () => {
  let comp: Tracker;
  let fixture: ComponentFixture<Tracker>;
  let activities: Subject<TrackerActivity>;
  let trackerService: Pick<TrackerService, 'subscribe' | 'sendActivity'>;

  const activity = (sessionId: string, page: string): TrackerActivity =>
    new TrackerActivity(sessionId, 'user', '127.0.0.1', page, '2026-01-02T03:04:05');

  beforeEach(() => {
    activities = new Subject();
    trackerService = {
      subscribe: vi.fn((observer: Partial<Observer<TrackerActivity>>) => activities.subscribe(observer)),
      sendActivity: vi.fn(),
    };
    TestBed.configureTestingModule({
      providers: [<%- enableTranslation ? 'provideTranslateService(), ' : '' %>{ provide: TrackerService, useValue: trackerService }],
    });
    fixture = TestBed.createComponent(Tracker);
    comp = fixture.componentInstance;
  });

  it('should subscribe to the activities and send its own on init', () => {
    comp.ngOnInit();

    expect(trackerService.subscribe).toHaveBeenCalled();
    expect(trackerService.sendActivity).toHaveBeenCalled();
  });

  it('should show the activity of a new session', () => {
    comp.ngOnInit();

    activities.next(activity('1', 'home'));

    expect(comp.activities()).toEqual([activity('1', 'home')]);
  });

  it('should update the activity of a known session', () => {
    comp.ngOnInit();
    activities.next(activity('1', 'home'));

    activities.next(activity('1', 'admin'));

    expect(comp.activities()).toEqual([activity('1', 'admin')]);
  });

  it('should remove a session at its logout', () => {
    comp.ngOnInit();
    activities.next(activity('1', 'home'));
    activities.next(activity('2', 'home'));

    activities.next(activity('1', 'logout'));

    expect(comp.activities()).toEqual([activity('2', 'home')]);
  });

  it('should ignore the logout of an unknown session', () => {
    comp.ngOnInit();

    activities.next(activity('1', 'logout'));

    expect(comp.activities()).toEqual([]);
  });

  it('should unsubscribe on destroy', () => {
    comp.ngOnInit();

    comp.ngOnDestroy();
    activities.next(activity('1', 'home'));

    expect(comp.activities()).toEqual([]);
  });

  it('should be destroyed before init', () => {
    expect(() => comp.ngOnDestroy()).not.toThrow();
  });

  it('should list the activities', async () => {
    comp.activities.set([activity('1', 'home')]);

    await fixture.whenStable();

    const cells = Array.from<HTMLElement>(fixture.nativeElement.querySelectorAll('tbody td')).map(cell => cell.textContent.trim());
    expect(cells).toEqual(['user', '127.0.0.1', 'home', '2026-01-02 03:04:05']);
  });
});
