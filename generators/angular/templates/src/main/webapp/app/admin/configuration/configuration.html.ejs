@if (allSections()) {
  <div>
    <h2 id="configuration-page-heading" data-cy="configurationPageHeading">__jhiTranslateTag__('configuration.title')</h2>

    <label for="configuration-filter">__jhiTranslateTag__('configuration.filter')</label>
    <input
      #filterInput
      id="configuration-filter"
      type="text"
      [value]="filter()"
      (input)="filter.set(filterInput.value)"
      class="form-control"
    />

    @for (section of sections(); track section.label; let i = $index) {
      <div>
        <h3 [id]="'configuration-section-' + i">{{ section.label }}</h3>

        <table class="table table-striped table-bordered table-responsive d-table" [attr.aria-describedby]="'configuration-section-' + i">
          <thead>
            <tr <%- jhiPrefix %>Sort [(sortState)]="sortState">
              <th <%- jhiPrefix %>SortBy="key" scope="col" class="w-40">
                <span>{{ section.columns[0] }}</span> <fa-icon icon="sort" />
              </th>
              <th scope="col" class="w-60"><span>{{ section.columns[1] }}</span></th>
            </tr>
          </thead>
          <tbody>
            @for (row of section.rows; track row.key) {
              <tr>
                <td class="break">
                  <span>{{ row.key }}</span>
                </td>
                <td class="break">
                  @if (row.properties) {
                    @for (property of row.properties; track property.key) {
                      <div class="row">
                        <div class="col-md-4 break">{{ property.key }}</div>
                        <div class="col-md-8">
                          <span class="float-end bg-secondary break">{{ property.value }}</span>
                        </div>
                      </div>
                    }
                  } @else {
                    <span class="float-end bg-secondary break">{{ row.value }}</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
}
