import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { ComponentFixture, TestBed } from '@angular/core/testing';

import { FaIconLibrary } from '@fortawesome/angular-fontawesome';
<%_ if (enableTranslation) { _%>
import { provideTranslateService } from '@ngx-translate/core';
<%_ } _%>

import { fontAwesomeIcons } from 'app/config/font-awesome-icons';

import Gateway from './gateway';
import { GatewayRoute } from './gateway-route.model';

const routes: GatewayRoute[] = [
  {
    path: 'services/blog/**',
    serviceId: 'blog',
    serviceInstances: [
<%_ if (locals.serviceDiscoveryConsul) { _%>
      { uri: 'http://blog-up', healthService: { checks: [{ status: 'PASSING' }] }, metadata: { zone: 'primary' } },
      { uri: 'http://blog-down', healthService: { checks: [{ status: 'PASSING' }, { status: 'CRITICAL' }] } },
<%_ } else { _%>
      { uri: 'http://blog-up', instanceInfo: { status: 'UP' }, metadata: { zone: 'primary' } },
      { uri: 'http://blog-down', instanceInfo: { status: 'DOWN' } },
<%_ } _%>
      { uri: 'http://blog-unknown' },
    ],
  },
  { path: 'services/store/**', serviceId: 'store', serviceInstances: [] },
];

describe('Gateway', () => {
  let comp: Gateway;
  let fixture: ComponentFixture<Gateway>;
  let httpMock: HttpTestingController;

  const count = (selector: string): number => (fixture.nativeElement as HTMLElement).querySelectorAll(selector).length;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideHttpClientTesting()<%- enableTranslation ? ', provideTranslateService()' : '' %>],
    });
    TestBed.inject(FaIconLibrary).addIcons(...fontAwesomeIcons);
    httpMock = TestBed.inject(HttpTestingController);
    fixture = TestBed.createComponent(Gateway);
    comp = fixture.componentInstance;
  });

  afterEach(() => {
    httpMock.verify();
  });

  it('should show the routes and the status of their servers', () => {
    fixture.detectChanges();
    expect(comp.updatingRoutes()).toBe(true);

    httpMock.expectOne({ method: 'GET' }).flush(routes);
    fixture.detectChanges();

    expect(comp.updatingRoutes()).toBe(false);
    expect(count('tbody a')).toBe(3);
    expect(count('.badge.bg-success')).toBe(1);
    expect(count('.badge.bg-danger')).toBe(2);
    expect(count('.badge.bg-warning')).toBe(1);
    expect(count('.badge.bg-info')).toBe(1);
  });

  it('should load the routes again on refresh', () => {
    fixture.detectChanges();
    httpMock.expectOne({ method: 'GET' }).flush(routes);
    fixture.detectChanges();

    fixture.nativeElement.querySelector('button').click();
    httpMock.expectOne({ method: 'GET' }).flush([]);
    fixture.detectChanges();

    expect(comp.gatewayRoutes()).toEqual([]);
    expect(count('tbody a')).toBe(0);
  });
});
