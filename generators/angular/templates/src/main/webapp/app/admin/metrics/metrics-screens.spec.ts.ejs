import { beforeEach, describe, expect, it, vi } from 'vitest';
import { ComponentFixture, TestBed } from '@angular/core/testing';

import { FaIconLibrary } from '@fortawesome/angular-fontawesome';
import { fas } from '@fortawesome/free-solid-svg-icons';
import { NgbActiveModal, NgbModal } from '@ng-bootstrap/ng-bootstrap/modal';
<%_ if (enableTranslation) { _%>
import { provideTranslateService } from '@ngx-translate/core';
<%_ } _%>
import { of } from 'rxjs';

import { MetricsModalThreads } from './blocks/metrics-modal-threads/metrics-modal-threads';
import Metrics from './metrics';
import { MetricsModel, Thread, ThreadState } from './metrics.model';
import { MetricsService } from './metrics.service';

const percentiles = { '0.0': 1, '1.0': 2, max: 3, totalTime: 4, mean: 5, '0.5': 6, count: 7, '0.99': 8, '0.75': 9, '0.95': 10 };
const maxMeanCount = { max: 1, mean: 2, count: 3 };
const metrics: MetricsModel = {
  jvm: { Heap: { committed: 10, max: 20, used: 5 }, 'Non Heap': { committed: 10, max: -1, used: 5 } },
  databases: {
    min: { value: 1 },
    idle: { value: 1 },
    max: { value: 1 },
    usage: percentiles,
    pending: { value: 1 },
    active: { value: 1 },
    acquire: percentiles,
    creation: percentiles,
    connections: { value: 1 },
  },
  'http.server.requests': { all: { count: 10 }, percode: { '200': maxMeanCount, '500': maxMeanCount } },
  cache: { users: { 'cache.gets.miss': 1, 'cache.puts': 2, 'cache.gets.hit': 3, 'cache.removals': 4, 'cache.evictions': 5 } },
  garbageCollector: {
    'jvm.gc.max.data.size': 1,
    'jvm.gc.pause': percentiles,
    'jvm.gc.memory.promoted': 1,
    'jvm.gc.memory.allocated': 1,
    classesLoaded: 1,
    'jvm.gc.live.data.size': 1,
    classesUnloaded: 1,
  },
  services: { '/api/foo': { POST: maxMeanCount, GET: maxMeanCount, PUT: maxMeanCount, PATCH: maxMeanCount, DELETE: maxMeanCount } },
  processMetrics: {
    'system.cpu.usage': 0.5,
    'system.cpu.count': 8,
    'system.load.average.1m': 1,
    'process.cpu.usage': 0.1,
    'process.files.max': 100,
    'process.files.open': 10,
    'process.start.time': 1000,
    'process.uptime': 200_000_000,
  },
};
const thread = (threadState: ThreadState, lockName?: string): Thread =>
  ({
    threadName: threadState,
    threadId: 1,
    blockedTime: 1,
    blockedCount: 1,
    waitedTime: 1,
    waitedCount: 1,
    lockName,
    lockOwnerName: lockName,
    threadState,
    stackTrace: [{ className: 'Foo', methodName: 'bar', fileName: 'Foo.java', lineNumber: 1 }],
  }) as unknown as Thread;
const threads = [
  thread(ThreadState.Runnable, 'lock'),
  thread(ThreadState.Waiting),
  thread(ThreadState.TimedWaiting),
  thread(ThreadState.Blocked),
  thread(ThreadState.New),
];

describe('Metrics screens', () => {
  const clickAll = (fixture: ComponentFixture<unknown>, selector: string): void => {
    fixture.nativeElement.querySelectorAll(selector).forEach((element: HTMLElement) => {
      element.click();
      fixture.detectChanges();
    });
  };

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [
<%_ if (enableTranslation) { _%>
        provideTranslateService(),
<%_ } _%>
        NgbActiveModal,
        { provide: NgbModal, useValue: { open: vi.fn(() => ({ componentInstance: {}, closed: of() })) } },
      ],
    });
    TestBed.inject(FaIconLibrary).addIconPacks(fas);
  });

  describe('page', () => {
    const render = (value: Partial<MetricsModel>): ComponentFixture<Metrics> => {
      const service = TestBed.inject(MetricsService);
      vi.spyOn(service, 'getMetrics').mockReturnValue(of(value as MetricsModel));
      vi.spyOn(service, 'threadDump').mockReturnValue(of({ threads }));
      const fixture = TestBed.createComponent(Metrics);
      fixture.detectChanges();
      return fixture;
    };

    it('should show every block', () => {
      const fixture = render(metrics);

      expect(fixture.nativeElement.querySelector('<%- jhiPrefixDashed %>-jvm-memory')).not.toBeNull();
      expect(fixture.nativeElement.querySelector('<%- jhiPrefixDashed %>-metrics-datasource')).not.toBeNull();
    });

    it('should tell when the optional metrics are missing', () => {
      const processMetrics = { ...metrics.processMetrics };
      delete processMetrics['system.load.average.1m'];
      delete processMetrics['process.files.max'];
      delete processMetrics['process.files.open'];
      const fixture = render({ ...metrics, processMetrics, databases: {} as MetricsModel['databases'] });

      expect(fixture.nativeElement.querySelector('<%- jhiPrefixDashed %>-metrics-datasource')).toBeNull();
    });

    it('should show no block without metrics', () => {
      const fixture = render({});

      expect(fixture.nativeElement.querySelector('<%- jhiPrefixDashed %>-metrics-cache')).toBeNull();
    });

    it('should open the thread dump and refresh', () => {
      const fixture = render(metrics);

      clickAll(fixture, 'button');

      expect(TestBed.inject(NgbModal).open).toHaveBeenCalled();
    });

    it('should show that the metrics are updating', () => {
      const fixture = render(metrics);

      fixture.componentInstance.updatingMetrics.set(true);
      fixture.detectChanges();

      expect(fixture.nativeElement.querySelector('.alert-info')).not.toBeNull();
    });
  });

  describe('threads', () => {
    it('should filter the threads and show their stack', () => {
      const fixture = TestBed.createComponent(MetricsModalThreads);
      fixture.componentInstance.threads = threads;
      fixture.detectChanges();

      clickAll(fixture, 'button, a');

      expect(fixture.componentInstance.getBadgeClass(ThreadState.New)).toBe('');
    });
  });
});
