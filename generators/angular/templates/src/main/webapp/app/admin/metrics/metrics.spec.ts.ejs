import { beforeEach, describe, expect, it, vi } from 'vitest';
import { ComponentFixture, TestBed } from '@angular/core/testing';

import { NgbModal } from '@ng-bootstrap/ng-bootstrap/modal';
<%_ if (enableTranslation) { _%>
import { provideTranslateService } from '@ngx-translate/core';
<%_ } _%>
import { of } from 'rxjs';

import { MetricsResponse, Thread } from 'app/shared/jhipster/metrics';

import { MetricsModalThreads } from './blocks/metrics-modal-threads/metrics-modal-threads';
import Metrics from './metrics';
import { MetricsService } from './metrics.service';

const metrics = { jvm: {}, processMetrics: {} } as MetricsResponse;
const threads = [{ threadName: 'thread 1' } as Thread];

describe('Metrics', () => {
  let comp: Metrics;
  let fixture: ComponentFixture<Metrics>;
  let service: MetricsService;

<%_ if (enableTranslation) { _%>
  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideTranslateService()],
    });
  });

<%_ } _%>
  beforeEach(() => {
    fixture = TestBed.createComponent(Metrics);
    comp = fixture.componentInstance;
    service = TestBed.inject(MetricsService);
    vi.spyOn(service, 'getMetrics').mockReturnValue(of(metrics));
    vi.spyOn(service, 'threadDump').mockReturnValue(of({ threads }));
  });

  describe('ngOnInit', () => {
    it('should load the sections on init', () => {
      // WHEN
      comp.ngOnInit();

      // THEN
      expect(service.getMetrics).toHaveBeenCalled();
      expect(comp.sections().map(section => section.id)).toEqual(['jvmMetrics']);
      expect(comp.threads()).toEqual(threads);
      expect(comp.updatingMetrics()).toBe(false);
    });
  });

  describe('openThreadDump', () => {
    it('should open the threads in a modal', () => {
      // GIVEN
      const modalRef = { componentInstance: {} };
      const open = vi.spyOn(TestBed.inject(NgbModal), 'open').mockReturnValue(modalRef as never);
      comp.ngOnInit();

      // WHEN
      comp.openThreadDump();

      // THEN
      expect(open).toHaveBeenCalledWith(MetricsModalThreads);
      expect(modalRef.componentInstance).toEqual({ threads });
    });
  });
});
