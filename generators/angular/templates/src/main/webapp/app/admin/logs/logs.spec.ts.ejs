import { beforeEach, describe, expect, it, vi } from 'vitest';
import { provideHttpClientTesting } from '@angular/common/http/testing';
import { ComponentFixture, DeferBlockBehavior, DeferBlockState, TestBed } from '@angular/core/testing';

import { FaIconLibrary } from '@fortawesome/angular-fontawesome';

<%_ if (enableTranslation) { _%>
import { provideTranslateService } from '@ngx-translate/core';
<%_ } _%>
import { of, throwError } from 'rxjs';

import { fontAwesomeIcons } from 'app/config/font-awesome-icons';
import { Log } from 'app/shared/jhipster/logs.model';
<%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
import { GatewayRoutesService } from '../gateway/gateway-routes.service';
<%_ } _%>

import Logs from './logs';
import { LogsService } from './logs.service';

const loggers: Log[] = [
  { name: 'ROOT', level: 'INFO' },
  { name: 'main', level: 'WARN' },
];
const loggersOfEveryLevel: Log[] = (['TRACE', 'DEBUG', 'INFO', 'WARN', 'ERROR', 'OFF'] as const).map(level => ({ name: level, level }));

describe('Logs', () => {
  let comp: Logs;
  let fixture: ComponentFixture<Logs>;
  let service: LogsService;

  const renderLoggers = async (): Promise<void> => {
    fixture.detectChanges();
    const [deferBlock] = await fixture.getDeferBlocks();
    await deferBlock.render(DeferBlockState.Loading);
    await deferBlock.render(DeferBlockState.Complete);
  };

  beforeEach(
    async () => {
      await TestBed.configureTestingModule({
        imports: [Logs],
        deferBlockBehavior: DeferBlockBehavior.Manual,
        providers: [provideHttpClientTesting()<%- enableTranslation ? ', provideTranslateService()' : '' %>, LogsService<%- applicationTypeGateway && gatewayServicesApiAvailable ? ', GatewayRoutesService' : '' %>],
      }).compileComponents();
    }
  );

  beforeEach(() => {
    TestBed.inject(FaIconLibrary).addIcons(...fontAwesomeIcons);
    fixture = TestBed.createComponent(Logs);
    comp = fixture.componentInstance;
    service = TestBed.inject(LogsService);
  });

  describe('OnInit', () => {
    it('should set all default values correctly', () => {
      expect(comp.filter()).toBe('');
      expect(comp.sortState().predicate).toBe('name');
      expect(comp.sortState().order).toBe('asc');
    });

    it('should call load all on init', () => {
      // GIVEN
      vi.spyOn(service, 'findAll').mockReturnValue(of(loggers));

      // WHEN
      comp.ngOnInit();

      // THEN
      expect(service.findAll).toHaveBeenCalled();
      expect(comp.loggers()).toEqual(loggers);
    });
  });

  describe('change log level', () => {
    it('should change log level correctly', () => {
      // GIVEN
      vi.spyOn(service, 'changeLevel').mockReturnValue(of({}));
      vi.spyOn(service, 'findAll').mockReturnValue(of(loggers));

      // WHEN
      comp.changeLevel('main', 'ERROR');

      // THEN
      expect(service.changeLevel).toHaveBeenCalled();
      expect(service.findAll).toHaveBeenCalled();
      expect(comp.loggers()).toEqual(loggers);
    });
  });

  describe('view', () => {
    const names = (): string[] =>
      Array.from<HTMLElement>(fixture.nativeElement.querySelectorAll('tbody small')).map(cell => cell.textContent.trim());

    beforeEach(async () => {
      vi.spyOn(service, 'findAll').mockReturnValue(of(loggers.map(logger => ({ ...logger }))));
      vi.spyOn(service, 'changeLevel').mockReturnValue(of({}));
      await renderLoggers();
    });

    it('should render the loggers and their levels', () => {
      const element = fixture.nativeElement as HTMLElement;
      expect(names()).toEqual(['main', 'ROOT']);
      expect(element.querySelectorAll('.btn-info')).toHaveLength(1);
      expect(element.querySelectorAll('.btn-warning')).toHaveLength(1);
    });

    it('should filter and order the loggers', () => {
      const element = fixture.nativeElement as HTMLElement;
      const input = element.querySelector<HTMLInputElement>('#logs-filter')!;
      input.value = 'ro';
      input.dispatchEvent(new Event('input'));
      fixture.detectChanges();
      expect(names()).toEqual(['ROOT']);

      comp.filter.set('');
      element.querySelector<HTMLElement>('th')!.click();
      fixture.detectChanges();
      expect(names()).toEqual(['ROOT', 'main']);

      comp.sortState.set({});
      fixture.detectChanges();
      expect(names()).toHaveLength(2);
    });

    it('should change the level from its buttons', () => {
      const buttons = (fixture.nativeElement as HTMLElement).querySelectorAll<HTMLButtonElement>('tbody tr:first-child button');
      buttons.forEach(button => button.click());

      expect(vi.mocked(service.changeLevel).mock.calls.map(([, level]) => level)).toEqual(['TRACE', 'DEBUG', 'INFO', 'WARN', 'ERROR', 'OFF']);
    });
  });

  it('should highlight the level of each logger', async () => {
    vi.spyOn(service, 'findAll').mockReturnValue(of(loggersOfEveryLevel));
    await renderLoggers();

    const highlighted = Array.from<HTMLButtonElement>(
      fixture.nativeElement.querySelectorAll('tbody button:not(.btn-light)'),
    ).map(button => button.textContent.trim());
    expect(highlighted.sort()).toEqual(['DEBUG', 'ERROR', 'INFO', 'OFF', 'TRACE', 'WARN']);
  });

  it('should have no loggers before they load', () => {
    expect(comp.filteredAndOrderedLoggers()).toEqual([]);
  });

  it('should have no loggers when they fail to load', () => {
    vi.spyOn(service, 'findAll').mockReturnValue(throwError(() => new Error('failed')));

    comp.ngOnInit();

    expect(comp.loggers()).toEqual([]);
    expect(comp.isLoading()).toBe(false);
  });
});
