import { AfterViewInit, Component, ElementRef, OnInit, inject, signal, viewChild } from '@angular/core';
import { FormField, FormRoot, form, required } from '@angular/forms/signals';
import { Router<%- generateUserManagement ? ', RouterLink' : '' %> } from '@angular/router';

<%_ if (enableTranslation) { _%>
import { TranslatePipe } from '@ngx-translate/core';
<%_ } _%>
import { firstValueFrom } from 'rxjs';

import { AccountService } from 'app/core/auth';
import { LoginService } from 'app/login/login.service';
<%_ if (enableTranslation) { _%>
import { TranslateDirective } from 'app/shared/language';
<%_ } _%>

@Component({
  selector: '<%- jhiPrefixDashed %>-login',
  imports: [
<%_ if (enableTranslation) { _%>
    TranslateDirective,
    TranslatePipe,
<%_ } _%>
    FormField,
    FormRoot,
<%_ if (generateUserManagement) { _%>
    RouterLink,
<%_ } _%>
  ],
  templateUrl: './login.html',
})
export default class Login implements OnInit, AfterViewInit {
  readonly username = viewChild.required<ElementRef>('username');

  readonly authenticationError = signal(false);

  readonly loginModel = signal({ username: '', password: ''<%- authenticationUsesRememberMe ? ', rememberMe: false' : '' %> });

  readonly loginForm = form(
    this.loginModel,
    path => {
      required(path.username);
      required(path.password);
    },
    // A submit marks the fields as touched and sends nothing while the form is invalid.
    { submission: { action: async () => this.login() } },
  );

  private readonly accountService = inject(AccountService);
  private readonly loginService = inject(LoginService);
  private readonly router = inject(Router);

  ngOnInit(): void {
    // if already authenticated then navigate to home page
    this.accountService.identity().subscribe(() => {
      if (this.accountService.isAuthenticated()) {
        void this.router.navigate(['']);
      }
    });
  }

  ngAfterViewInit(): void {
    this.username().nativeElement.focus();
  }

  async login(): Promise<void> {
    try {
      await firstValueFrom(this.loginService.login(this.loginModel()));
      this.authenticationError.set(false);
      if (!this.router.currentNavigation()) {
        // There were no routing during login (e.g. from navigationToStoredUrl)
        void this.router.navigate(['']);
      }
    } catch {
      this.authenticationError.set(true);
    }
  }
}
