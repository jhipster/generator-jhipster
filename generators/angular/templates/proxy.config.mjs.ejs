const backendHost = '127.0.0.1';
const backendPort = <%- applicationTypeMicroservice ? gatewayServerPort : serverPort %>;

/**
 * @type {import('vite').CommonServerOptions['proxy']}
 */
export default {
<%_ if (communicationSpringWebsocket) { _%>
  '/websocket': {
    target: `ws://${backendHost}:${backendPort}`,
    ws: true,
  },
<%_ } _%>
  '^/(api|management|v3/api-docs<%- locals.databaseTypeSql && locals.devDatabaseTypeH2Any ? '|h2-console' : '' %><%- authenticationTypeOauth2 ? '|oauth2|login' : '' %><%- authenticationTypeSession ? '|login' : '' %><%- applicationTypeGateway || applicationTypeMicroservice ? '|services' : '' %>)': {
    target: `http://${backendHost}:${backendPort}`,
    xfwd: true,
  },
};
