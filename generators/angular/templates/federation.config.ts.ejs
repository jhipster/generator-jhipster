import { mappingsFromWorkspace, <%- enableTranslation ? 'share, ' : '' %>shareAll, withNativeFederation } from '@angular-architects/native-federation/config';

<%_ if (enableTranslation) { _%>
// Angular locales are loaded dynamically by the translation loader.
// Unlike shareAngularLocales(), the entry points are inferred by node resolution, so hoisted node_modules (npm workspaces) work.
const shareAngularLocales = (locales: string[]) =>
  share(
    Object.fromEntries(
      locales.map(locale => [
        `@angular/common/locales/${locale}`,
        { singleton: true, strictVersion: true, requiredVersion: 'auto', includeSecondaries: false },
      ]),
    ),
  );

<%_ } _%>
export default withNativeFederation({
  name: '<%- lowercaseBaseName.replaceAll('-', '_') %>',

<%_ if (applicationTypeMicroservice || exposeMicrofrontend) { _%>
  exposes: {
    './entity-navbar-items': './<%- this.relativeDir(clientRootDir, clientSrcDir) %>app/entities/entity-navbar-items.ts',
    './entity-routes': './<%- this.relativeDir(clientRootDir, clientSrcDir) %>app/entities/entity.routes.ts',
  <%_ if (enableTranslation) { _%>
    './i18n': './<%- this.relativeDir(clientRootDir, clientI18nDir) %>index.ts',
  <%_ } _%>
    // jhipster-needle-expose
  },

<%_ } _%>
  shared: {
    ...shareAll(
      { singleton: true, strictVersion: true, requiredVersion: 'auto' },
      {
        overrides: {
          // includeSecondaries is an opt-out of ignoreUnusedDeps, so all of @angular/core is shared to prevent mismatches.
          '@angular/core': { singleton: true, strictVersion: true, requiredVersion: 'auto', includeSecondaries: { keepAll: true } },
        },
      },
    ),
<%_ if (enableTranslation) { _%>
    ...shareAngularLocales([<%- languagesDefinition.filter(lang => lang.angularLocale).map(lang => `'${lang.angularLocale}'`).join(', ') %>]),
<%_ } _%>
  },

  // Application modules shared as singletons across the gateway and the microfrontends, see tsconfig.json paths.
  sharedMappings: mappingsFromWorkspace({ singleton: true, strictVersion: false })
    .filter([
      'app/config',
      'app/core/auth',
      'app/core/request',
      'app/core/util',
      'app/shared/alert',
      'app/shared/auth',
      'app/shared/date',
<%_ if (enableTranslation) { _%>
      'app/shared/language',
<%_ } _%>
      'app/shared/pagination',
      'app/shared/sort',
    ])
    .get(),

  skip: [
    '@angular/localize',
    'es-module-shims',
    'rxjs/ajax',
    'rxjs/fetch',
    'rxjs/testing',
    'rxjs/webSocket',
    // Add further packages you don't need at runtime
  ],

  features: {
    // Application modules are not versioned libraries.
    mappingVersion: false,
    denseChunking: true,
  },
});
