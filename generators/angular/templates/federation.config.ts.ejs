import { mappingsFromWorkspace, share, shareAll, withNativeFederation } from '@angular-architects/native-federation/config';

const singleton = { singleton: true, strictVersion: true, requiredVersion: 'auto', includeSecondaries: false };

// The application imports the dayjs esm entry points, which are not covered by sharing the dayjs package.
// They must be shared explicitly so the shared mappings (app/shared/date, app/shared/language) use the same dayjs instance
// the plugins and locales are registered in (app/config/dayjs). Plugins and locales are only used by app/config/dayjs,
// which the unused dependencies scan (started from the exposed modules) does not reach, so they opt out of it.
const shareDayjs = (locales: string[]) =>
  share(
    Object.fromEntries(
      ['dayjs/esm', 'dayjs/esm/plugin/customParseFormat', 'dayjs/esm/plugin/duration', 'dayjs/esm/plugin/relativeTime']
        .concat(locales.map(locale => `dayjs/esm/locale/${locale}`))
        .map(entryPoint => [entryPoint, { ...singleton, includeSecondaries: { keepAll: true } }]),
    ),
  );

// The Angular locale app.ts registers, and the ones the translation loader loads dynamically. Every subpath of the shared
// @angular/common is external, so a locale must be shared too; app.ts is not an exposed module, the unused dependencies
// scan starts from, so the locale opts out of it (keepAll), skipping the secondaries of @angular/common it would expand.
// The entry points are inferred by node resolution, so hoisted node_modules (npm workspaces) work.
const shareAngularLocales = (locales: string[]) =>
  share(
    Object.fromEntries(
      locales.map(locale => [
        `@angular/common/locales/${locale}`,
        { ...singleton, includeSecondaries: { keepAll: true, skip: [`@angular/common/locales/${locale}/*`] } },
      ]),
    ),
  );

export default withNativeFederation({
  name: '<%- lowercaseBaseName.replaceAll('-', '_') %>',

<%_ if (applicationTypeMicroservice || exposeMicrofrontend) { _%>
  exposes: {
    './entity-navbar-items': './<%- relativeDir(clientRootDir, clientSrcDir) %>app/entities/entity-navbar-items.ts',
    './entity-routes': './<%- relativeDir(clientRootDir, clientSrcDir) %>app/entities/entity.routes.ts',
  <%_ if (enableTranslation) { _%>
    './i18n': './<%- relativeDir(clientRootDir, clientI18nDir) %>index.ts',
  <%_ } _%>
    // jhipster-needle-expose
  },

<%_ } _%>
  shared: {
    ...shareAll(
      { singleton: true, strictVersion: true, requiredVersion: 'auto' },
      {
        overrides: {
          // includeSecondaries is an opt-out of ignoreUnusedDeps, so all of @angular/core is shared to prevent mismatches.
          '@angular/core': { singleton: true, strictVersion: true, requiredVersion: 'auto', includeSecondaries: { keepAll: true } },
        },
      },
    ),
    ...shareDayjs([<%- [...new Set(languagesDefinition.map(lang => lang.dayjsLocale))].map(locale => `'${locale}'`).join(', ') %>]),
    ...shareAngularLocales([<%- [angularLocaleId].concat(languagesDefinition.map(lang => lang.angularLocale)).filter((locale, index, locales) => locale && locales.indexOf(locale) === index).map(locale => `'${locale}'`).join(', ') %>]),
  },

  // Application modules shared as singletons across the gateway and the microfrontends, see tsconfig.json paths.
  sharedMappings: mappingsFromWorkspace({ singleton: true, strictVersion: false })
    .filter([
      'app/config',
      'app/core/auth',
      'app/core/request',
      'app/core/util',
      'app/shared/alert',
      'app/shared/auth',
      'app/shared/date',
<%_ if (enableTranslation) { _%>
      'app/shared/language',
<%_ } _%>
      'app/shared/pagination',
      'app/shared/sort',
    ])
    .get(),

  skip: [
    '@angular/localize',
    'es-module-shims',
    'rxjs/ajax',
    'rxjs/fetch',
    'rxjs/testing',
    'rxjs/webSocket',
    // Add further packages you don't need at runtime
  ],

  features: {
    // Application modules are not versioned libraries.
    mappingVersion: false,
    denseChunking: true,
  },
});
