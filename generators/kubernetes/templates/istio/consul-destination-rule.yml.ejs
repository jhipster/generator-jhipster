# The Istio sidecar load-balances the consul-ui Service itself and ignores its sessionAffinity.
# Hashing on the source IP sends all of a pod's requests, including the deregistration at shutdown,
# to the Consul server that received its registration.
apiVersion: <%- KUBERNETES_ISTIO_NETWORKING_API_VERSION %>
kind: DestinationRule
metadata:
  name: consul-destinationrule
  namespace: <%- kubernetesNamespace %>
spec:
  host: consul-ui.<%- kubernetesNamespace %>.svc.cluster.local
  trafficPolicy:
    loadBalancer:
      consistentHash:
        useSourceIp: true
