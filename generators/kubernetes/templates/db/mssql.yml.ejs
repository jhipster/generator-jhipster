<%_
  const lowercaseBaseName = app.baseName.toLowerCase();
  // SQL Server rejects passwords without 3 of the 4 character categories, and the random password is lowercase hex
  const mssqlPassword = `${dbRandomPassword}-Aa1`;
  const sqlcmd = '/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -C -b';
_%>
<%_ if (kubernetesUseDynamicStorage) { _%>
apiVersion: <%- KUBERNETES_CORE_API_VERSION %>
kind: PersistentVolumeClaim
metadata:
  name: <%- lowercaseBaseName %>-mssql-pvc
  namespace: <%- kubernetesNamespace %>
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 2Gi
  <%_ if (kubernetesStorageClassName) { _%>
  storageClassName: <%- kubernetesStorageClassName %>
  <%_ } _%>
---
<%_ } _%>
apiVersion: <%- KUBERNETES_CORE_API_VERSION %>
kind: Secret
metadata:
  name: <%- lowercaseBaseName %>-mssql
  namespace: <%- kubernetesNamespace %>
  labels:
    app: <%- lowercaseBaseName %>-mssql
type: Opaque
data:
  mssql-password: <%- Buffer.from(mssqlPassword).toString('base64') %>
---
apiVersion: <%- KUBERNETES_DEPLOYMENT_API_VERSION %>
kind: Deployment
metadata:
  name: <%- lowercaseBaseName %>-mssql
  namespace: <%- kubernetesNamespace %>
spec:
  replicas: 1
  selector:
    matchLabels:
      app: <%- lowercaseBaseName %>-mssql
  template:
    metadata:
      labels:
        app: <%- lowercaseBaseName %>-mssql
<%_ if (istio) { _%>
      annotations:
        sidecar.istio.io/inject: "false"
<%_ } _%>
    spec:
      securityContext:
        # the mssql user of the image, so that it can write to the volume
        fsGroup: 10001
      volumes:
      - name: data
<%_ if (kubernetesUseDynamicStorage) { _%>
        persistentVolumeClaim:
          claimName: <%- lowercaseBaseName %>-mssql-pvc
<%_ } else { _%>
        emptyDir: {}
<%_ } _%>
      containers:
      - name: mssql
        image: <%- dockerContainers.mssql %>
        env:
        - name: MSSQL_PID
          value: "Express"
        - name: ACCEPT_EULA
          value: "Y"
        - name: MSSQL_DATABASE
          value: <%- lowercaseBaseName %>
        - name: MSSQL_SA_PASSWORD
          valueFrom:
            secretKeyRef:
              name: <%- lowercaseBaseName %>-mssql
              key: mssql-password
        # SQL Server doesn't create a database at startup, so create the one of the application once the server accepts connections
        command: ["/bin/bash", "-c"]
        args:
        - |
          /opt/mssql/bin/sqlservr &
          until <%- sqlcmd %> -Q "SELECT 1" -o /dev/null; do kill -0 $! || exit 1; sleep 2; done
          <%- sqlcmd %> -Q "IF DB_ID('$MSSQL_DATABASE') IS NULL CREATE DATABASE [$MSSQL_DATABASE]"
          wait
        ports:
        - containerPort: 1433
        readinessProbe:
          exec:
            command: ["/bin/bash", "-c", '<%- sqlcmd %> -Q "USE [$MSSQL_DATABASE]" -o /dev/null']
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 5
        volumeMounts:
        - name: data
          mountPath: /var/opt/mssql
        resources:
          # SQL Server doesn't start with less than 2000 MB of memory
          requests:
            memory: "2Gi"
            cpu: "500m"
          limits:
            memory: "2Gi"
            cpu: "1"
---
apiVersion: <%- KUBERNETES_CORE_API_VERSION %>
kind: Service
metadata:
  name: <%- lowercaseBaseName %>-mssql
  namespace: <%- kubernetesNamespace %>
spec:
  selector:
    app: <%- lowercaseBaseName %>-mssql
  ports:
  - port: 1433
