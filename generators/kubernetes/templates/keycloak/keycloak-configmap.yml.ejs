apiVersion: <%- KUBERNETES_CORE_API_VERSION %>
kind: ConfigMap
metadata:
  name: keycloak-config
  namespace: <%- kubernetesNamespace %>
#common configuration shared between all applications
data:
  jhipster-realm.json: |
<%- include('../../../docker/templates/docker/realm-config/jhipster-realm.partial.json.ejs', {
      realmGateway: includesApplicationTypeGateway,
      realmRootPort: entryPort,
      realmRedirectUris: [
        ...keycloakWebAppRedirectUris,
        'http://localhost:8100/*',
        'http://127.0.0.1:8761/*',
        ...(locals.keycloakAppSchemes ?? []).map(appScheme => `${appScheme}:*`),
        'dev.localhost.ionic:*',
      ],
      realmWebOrigins: [
        ...keycloakWebAppRedirectUris.map(redirectUri => redirectUri.replace(/\/\*/g, '')),
        'http://localhost:8100',
        'http://127.0.0.1:8761',
      ],
    }).replace(/^(?=.)/gm, '    ')
-%>
