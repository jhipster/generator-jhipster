// This function is called when a project is opened or re-opened (e.g. due to
// the project's config changing)
import installLogsPrinter from "cypress-terminal-report/src/installLogsPrinter";
<%_ if (cypressAudit) { _%>
import { existsSync, mkdirSync, writeFileSync } from 'node:fs';
import { pa11y, prepareAudit } from 'cypress-audit';

const VALID_CATEGORIES = new Set(['performance', 'accessibility', 'best-practices', 'seo']);
<%_ } _%>

export default <%- cypressCoverage ? 'async ' : '' %>(on: Cypress.PluginEvents, config: Cypress.PluginConfigOptions) => {
  installLogsPrinter(on);
<%_ if (cypressCoverage) { _%>
  let remoteDebuggingPort: number | undefined;
<%_ } _%>
  on('before:browser:launch', (browser, launchOptions) => {
<%_ if (cypressAudit) { _%>
    prepareAudit(launchOptions);
<%_ } _%>
<%_ if (cypressCoverage) { _%>
    // Cypress controls Chrome through this port, the coverage client reuses it to collect v8 coverage.
    const remoteDebuggingArg = launchOptions.args.find(arg => arg.startsWith('--remote-debugging-port='));
    remoteDebuggingPort = remoteDebuggingArg ? Number(remoteDebuggingArg.split('=')[1]) : undefined;
<%_ } _%>
    if (browser.name === 'chrome' && browser.isHeadless) {
      launchOptions.args.push('--disable-gpu', '--no-sandbox', '--disable-dev-shm-usage');
    }
    if (browser.family === 'chromium' && browser.name !== 'electron') {
      launchOptions.args.push(
        // Forces Chrome/Edge to open a large window so the viewport doesn't scale down
        '--window-size=1920,1080',
      );
    }
    return launchOptions;
  });

  // Allows logging with cy.task('log', 'message') or cy.task('table', object)
  on('task', {
    log(message) {
      console.log(message);
      return null;
    },
    table(message) {
      console.table(message);
      return null;
    },
  });

<%_ if (cypressAudit) { _%>
  on('task', {
    // cypress-audit's built-in lighthouse task connects to Cypress's Chrome tab, which crashes Chrome 147+.
    // We use a dedicated Chrome instance via chrome-launcher instead.
    lighthouse: async ({ url, thresholds }: { url: string; thresholds: Record<string, number> }) => {
      const { launch } = await import('chrome-launcher');
      const lighthouseFn = ((await import('lighthouse')) as unknown as { default: (url: string, options?: Record<string, unknown>, config?: Record<string, unknown>) => Promise<import('lighthouse').RunnerResult> }).default;
      const { ReportGenerator } = await import('lighthouse/report/generator/report-generator.js');

      const chrome = await launch({
        chromeFlags: ['--headless=new', '--disable-gpu', '--no-sandbox', '--disable-dev-shm-usage'],
      });

      try {
        const { lhr } = await lighthouseFn(
          url,
          {
            port: chrome.port,
            onlyCategories: Object.keys(thresholds).filter(k => VALID_CATEGORIES.has(k)),
            disableStorageReset: true,
            formFactor: 'desktop',
            throttlingMethod: 'provided',
            screenEmulation: { mobile: false, width: 1350, height: 940, deviceScaleFactor: 1, disabled: false },
          },
          { extends: 'lighthouse:default' },
        );

        if (!existsSync('target/cypress/')) {
          mkdirSync('target/cypress/', { recursive: true });
        }
        writeFileSync('target/cypress/lhreport.html', ReportGenerator.generateReport(lhr, 'html'));

        const errors: string[] = [];
        const results: string[] = [];
        for (const [key, threshold] of Object.entries(thresholds)) {
          if (!VALID_CATEGORIES.has(key)) continue;
          const score = (lhr.categories[key]?.score ?? 0) * 100;
          if (threshold > score) {
            errors.push(`${key} record is ${score} and is under the ${threshold} threshold`);
          } else {
            results.push(`${key} record is ${score} and threshold was ${threshold}`);
          }
        }
        return { errors, results };
      } finally {
        chrome.kill();
      }
    },
    pa11y: pa11y(),
  });
<%_ } _%>
<%_ if (cypressCoverage) { _%>
  if (config.env.CYPRESS_COVERAGE) {
    // cypress-monocart-coverage collects css coverage too, and its `CSS.enable` CDP call breaks Cypress's
    // privileged channel: cy.task and cy.env then fail with `must only be invoked from the spec file or
    // support file`. Only js entries are reported here, so monocart-coverage-reports is driven directly
    // with js coverage only.
    const MCR = (await import('monocart-coverage-reports')).default;
    const coverageReport = MCR({
      name: 'Cypress Coverage Report',
      entryFilter: {
        '**/node_modules/**': false,
        '**/swagger-ui/**': false,
        '**/polyfills.js': false,
        // Cypress runner scripts.
        '**/__cypress/**': false,
        '**/__/**': false,
  <%_ if (microfrontend) { _%>
        // Shared dependencies bundled individually by native federation in dev mode.
        '**/*-dev.js': false,
  <%_ } _%>
        '**/*.js': true,
      },
      sourceFilter: {
        '**/<%- clientSrcDir %>**': true,
      },
      outputDir: './<%- temporaryDir %>/cypress-coverage-reports',
      reports: ['v8', 'console-details'],
    });
    coverageReport.cleanCache();

    let coverageClient: Awaited<ReturnType<typeof MCR.CDPClient>>;

    on('task', {
      coverageBefore: async () => {
        if (coverageClient || !remoteDebuggingPort) return null;
        coverageClient = await MCR.CDPClient({ port: remoteDebuggingPort });
        await coverageClient?.startJSCoverage();
        return null;
      },
      coverageAfter: async () => {
        if (!coverageClient) return null;
        await coverageReport.add(await coverageClient.stopJSCoverage());
        await coverageClient.close();
        coverageClient = undefined;
        return null;
      },
    });

    on('after:run', async () => {
      if (coverageReport.hasCache()) {
        await coverageReport.generate();
      }
    });
  }
<%_ } _%>
  return config;
}
