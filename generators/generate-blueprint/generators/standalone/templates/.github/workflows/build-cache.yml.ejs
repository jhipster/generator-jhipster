name: build-cache
on:
  workflow_dispatch:
  schedule:
    - cron: '0 0 * * 0'
permissions:
  contents: read
jobs:
  build-cache:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ${{ github.workspace }}/app
    steps:
      - uses: <%- githubActions['actions/checkout'] %>
        with:
          path: generator-jhipster-<%- baseName %>
      - uses: <%- githubActions['jhipster/actions/setup-runner'] %>
        with:
          node-version: <%- nodeVersion.split('.', 2)[0] %>
          binary-dir: ${{ github.workspace }}/generator-jhipster-<%- baseName %>/cli/
      - uses: <%- githubActions['jhipster/actions/cache-npm-dependencies'] %>
        with:
          generator-path: generator-jhipster-<%- baseName %>
        if: always()
      # Every sample, each one in a folder of its name, then the dependencies of each one in the cache.
      - run: <%- blueprintCliName %> generate-sample --all --skip-install
        continue-on-error: true
      - run: for sample in */; do (cd "$sample" && npm install && npm run backend:build-cache --if-present) || true; done
        continue-on-error: true
      - uses: <%- githubActions['jhipster/actions/save-cache'] %>
        if: always()
        with:
          key: -${{ github.run_id }}
          npm: true
          maven: true
          gradle: true
      - uses: <%- githubActions['jhipster/actions/restore-cache'] %>
        with:
          npm: true
          maven: true
          gradle: true
