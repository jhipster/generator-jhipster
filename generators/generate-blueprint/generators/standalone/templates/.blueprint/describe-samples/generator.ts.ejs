import BaseCoreGenerator from 'generator-jhipster/generators/base-core';
import { type SampleDescription, formatSample, formatSamplesList, getGithubSamples } from 'generator-jhipster/ci';

import { SAMPLES_GROUP_FOLDER, describeSamples } from './support/describe-samples.ts';

export default class extends BaseCoreGenerator {
  sampleName?: string;
  samplesGroup?: string;
  json?: boolean;
  samples!: SampleDescription[];

  get [BaseCoreGenerator.WRITING]() {
    return this.asAnyTaskGroup({
      async describe() {
        const { sampleName, samplesGroup } = this;
        if (!samplesGroup) {
          // A sample is generated by its name alone: fail for a name two groups share.
          await getGithubSamples(SAMPLES_GROUP_FOLDER);
        }
        const samples = await describeSamples(samplesGroup ? [samplesGroup] : undefined);
        this.samples = sampleName ? samples.filter(sample => sample.name === sampleName || sample.jobName === sampleName) : samples;
        if (sampleName && this.samples.length === 0) {
          throw new Error(`Sample ${sampleName} not found in the ${samplesGroup ? `${samplesGroup} samples group` : 'samples groups'}`);
        }
        // Print on stdout so `--json` can be piped; `this.log` writes to stderr.
        process.stdout.write(`${this.format()}\n`);
      },
    });
  }

  format(): string {
    if (this.json) {
      return JSON.stringify(this.sampleName ? this.samples[0] : this.samples, null, 2);
    }
    return this.sampleName ? this.samples.map(formatSample).join('\n\n') : formatSamplesList(this.samples);
  }
}
