import { readdirSync, statSync } from 'node:fs';
import { basename, dirname, extname, join, relative } from 'node:path';

import { type SampleDescription, describeGithubSamples, getGithubSamples, getGithubSamplesGroups } from 'generator-jhipster/ci';

export type { SampleDescription } from 'generator-jhipster/ci';

/** The folder of the samples groups, the ones generate-sample generates. */
export const SAMPLES_GROUP_FOLDER = join(import.meta.dirname, '../../generate-sample/templates/');

/** The root of the blueprint, the paths of the files are relative to. */
const ROOT = join(import.meta.dirname, '../../../');

/** A samples group with the names of its samples; an object, to grow with more data. */
export type SampleGroupSummary = {
  samples: string[];
};

/** A jdl of a sample: a file of the blueprint, or the content of an inline jdl. */
export type SampleJDL = { file: string } | { content: string };

/** A sample: how to generate it, and the files generate-sample copies to the project. */
export type SampleSummary = {
  workflow: string;
  jobName: string;
  /** The command that generates the sample. */
  command: string;
  disabled?: boolean;
  /** The files copied to the project but the jdl ones: the path in the project, relative to it, to the file of the blueprint. */
  files: Record<string, string>;
  /** The jdl the sample is generated from, by their name in the project: a file of the blueprint, or an inline jdl. */
  jdls: Record<string, SampleJDL>;
};

/** The samples of a samples group by name; an object, to grow with more data. */
export type SampleGroupDescription = {
  samples: Record<string, SampleSummary>;
};

/** The descriptions of the samples of the groups, every group when omitted, as the describe-samples command prints them. */
export const describeSamples = (groups?: string[]): Promise<SampleDescription[]> =>
  describeGithubSamples({ samplesGroupFolder: SAMPLES_GROUP_FOLDER, groups, root: ROOT, cli: './cli/<%- blueprintCliName %>' });

const isDirectory = (path: string): boolean => {
  try {
    return statSync(path).isDirectory();
  } catch {
    return false;
  }
};

/** The files generate-sample copies to the project for a sample, by destination, the jdl ones included. */
const copiedFilesOf = (sample: SampleDescription): [string, string][] => {
  if (sample.generator === 'jdl') return sample.jdlSampleFiles.map(file => [basename(file), file]);
  if (sample.generator !== 'app' || !sample.yoRcFile) return [];
  // A yo-rc sample copies every file of its folder.
  const folder = join(ROOT, dirname(sample.yoRcFile));
  if (!isDirectory(folder)) return [];
  return readdirSync(folder, { recursive: true, withFileTypes: true })
    .filter(entry => entry.isFile())
    .map(entry => {
      const file = join(entry.parentPath, entry.name);
      return [relative(folder, file), relative(ROOT, file)];
    });
};

const isJDL = ([destination]: [string, string]): boolean => extname(destination) === '.jdl';

const summaryOf = (sample: SampleDescription): SampleSummary => ({
  workflow: sample.workflow,
  jobName: sample.jobName,
  command: sample.command,
  disabled: sample.disabled,
  files: Object.fromEntries(copiedFilesOf(sample).filter(file => !isJDL(file))),
  jdls: Object.fromEntries([
    ...(sample.generator === 'jdl' && sample.jdl ? [[`${sample.name}.jdl`, { content: sample.jdl }] as [string, SampleJDL]] : []),
    ...copiedFilesOf(sample)
      .filter(isJDL)
      .map(([destination, file]) => [destination, { file }] as [string, SampleJDL]),
  ]),
});

/** The samples of a samples group, by name. */
export const describeSampleGroup = async (group: string): Promise<SampleGroupDescription> => {
  const groups = await getGithubSamplesGroups(SAMPLES_GROUP_FOLDER);
  if (!groups.includes(group)) {
    throw new Error(`Samples group ${group} not found, expected one of ${groups.join(', ')}`);
  }
  return { samples: Object.fromEntries((await describeSamples([group])).map(sample => [sample.name, summaryOf(sample)])) };
};

/** The samples groups by name, with the names of their samples. */
export const describeSampleGroups = async (): Promise<Record<string, SampleGroupSummary>> => {
  const groups: Record<string, SampleGroupSummary> = {};
  for (const name of await getGithubSamplesGroups(SAMPLES_GROUP_FOLDER)) {
    groups[name] = { samples: Object.keys((await describeSampleGroup(name)).samples) };
  }
  return groups;
};

/** A sample, by its name or its job name; a sample is generated by its name alone, a name two groups share fails. */
export const describeSample = async (name: string): Promise<SampleSummary> => {
  await getGithubSamples(SAMPLES_GROUP_FOLDER);
  const samples = await describeSamples();
  const sample = samples.find(description => description.name === name || description.jobName === name);
  if (!sample) {
    // The names, so the caller, an AI agent too, can correct the name by itself.
    throw new Error(`Sample ${name} not found, expected one of ${samples.map(description => description.name).join(', ')}`);
  }
  return summaryOf(sample);
};
