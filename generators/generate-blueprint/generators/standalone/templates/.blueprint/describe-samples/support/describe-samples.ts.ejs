import { existsSync, statSync } from 'node:fs';
import { basename, extname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import {
  type GitHubMatrixGroup,
  type GitHubMatrixOutput,
  type SampleDescription,
  convertToGitHubMatrix,
  describeGithubSamplesGroup,
  getGithubSamplesFolderGroup,
  getGithubSamplesGroupSync,
  getGithubSamplesGroupsSync,
} from 'generator-jhipster/ci';

export { formatSample, formatSamplesList } from 'generator-jhipster/ci';

export type { SampleDescription };
export type SampleJDL = SampleDescription['jdls'][string];

// Synchronous, without top-level await, like the describe-samples of generator-jhipster: tools load this module with
// require (requireSibling('support') of yeoman-environment), which refuses a module with a top-level await.

const root = fileURLToPath(new URL('../../../', import.meta.url));

/** The folder of the samples groups and of their samples. */
export const samplesGroupFolder = fileURLToPath(new URL('../../generate-sample/templates/', import.meta.url));

const samplesGroupNames = getGithubSamplesGroupsSync(samplesGroupFolder, true);
const samplesGroupModules = samplesGroupNames.filter(name => extname(name)).map(name => basename(name, extname(name)));

/**
 * Every described workflow, the samples groups of the blueprint: the `<group>` modules of the folder, whose folders, like
 * `samples`, are then the files of their samples, which no workflow runs; the folders of samples when it has no module.
 */
export const WORKFLOWS: string[] = samplesGroupModules.length > 0 ? samplesGroupModules : samplesGroupNames;

/**
 * The samples of each workflow, read synchronously by generator-jhipster (getGithubSamplesGroupSync), each sample tagged
 * with its group.
 */
export const samplesGroups: Record<string, GitHubMatrixGroup> = Object.fromEntries(
  WORKFLOWS.map(group => [group, getGithubSamplesGroupSync(samplesGroupFolder, group).samples]),
);

/**
 * The samples of a samples group: a workflow, else a folder of samples, which no workflow runs.
 */
export const samplesGroupOf = (group: string): GitHubMatrixGroup | undefined => {
  if (samplesGroups[group]) return samplesGroups[group];
  const folder = join(samplesGroupFolder, group);
  // A folder of samples, without code: a sample by jdl file or by .yo-rc.json folder, with the options of its samples.json.
  return existsSync(folder) && statSync(folder).isDirectory() ? getGithubSamplesFolderGroup(samplesGroupFolder, group) : undefined;
};

/**
 * The GitHub matrix of a samples group, the jobs of its workflow: the one of github-build-matrix, which the CI runs, and of
 * describeChangedSamples.
 */
export const samplesGroupMatrix = (group: string): GitHubMatrixOutput => convertToGitHubMatrix(samplesGroupOf(group) ?? {});

let descriptions: SampleDescription[] | undefined;

/**
 * The CI samples of the blueprint, described like the ones of generator-jhipster (its `.blueprint/describe-samples`):
 * the samples groups are the workflows of the CI, a sample is generated by its name alone (`generate-sample <name>`).
 * Described at the first call.
 */
const describeAllSamples = (): SampleDescription[] => {
  descriptions ??= WORKFLOWS.flatMap(group =>
    describeGithubSamplesGroup({ samplesGroupFolder, group, samples: samplesGroups[group], root }),
  );
  return descriptions;
};

/**
 * Describe the CI samples: what each job generates and the environment it runs on.
 */
export const describeSamples = ({ workflow }: { workflow?: string } = {}): SampleDescription[] =>
  workflow ? describeAllSamples().filter(sample => sample.workflow === workflow) : describeAllSamples();

/**
 * The samples of a workflow, every workflow when omitted, or the sample of a name or a job name.
 */
export const findSamples = ({ sampleName, workflow }: { sampleName?: string; workflow?: string } = {}): SampleDescription[] => {
  const samples = describeSamples({ workflow });
  if (!sampleName) return samples;
  const found = samples.filter(sample => sample.name === sampleName || sample.jobName === sampleName);
  if (found.length === 0) {
    // The names, so the caller, an AI agent too, can correct the name by itself.
    throw new Error(`Sample ${sampleName} not found, expected one of ${samples.map(sample => sample.name).join(', ')}`);
  }
  return found;
};

/** A samples group, a workflow, with the names of its samples; an object, to grow with more data. */
export type SampleGroupSummary = { samples: string[] };

/**
 * A sample, generated by its name only (`generate-sample <name>`): the command generating it, the files and the jdl
 * generate-sample copies to the project.
 */
export type SampleSummary = Pick<SampleDescription, 'workflow' | 'jobName' | 'disabled' | 'defaultCommand' | 'files' | 'jdls'>;

/** The samples of a samples group by name; an object, to grow with more data. */
export type SampleGroupDescription = { samples: Record<string, SampleSummary> };

const summaryOf = ({ workflow, jobName, disabled, defaultCommand, files, jdls }: SampleDescription): SampleSummary => ({
  workflow,
  jobName,
  disabled,
  defaultCommand,
  files,
  jdls,
});

/**
 * The samples of a samples group, a workflow, by name.
 */
export const describeSampleGroup = (group: string): SampleGroupDescription => {
  if (!WORKFLOWS.includes(group)) {
    throw new Error(`Samples group ${group} not found, expected one of ${WORKFLOWS.join(', ')}`);
  }
  return { samples: Object.fromEntries(describeSamples({ workflow: group }).map(sample => [sample.name, summaryOf(sample)])) };
};

/**
 * The samples groups, the workflows, by name, with the names of their samples.
 */
export const describeSampleGroups = (): Record<string, SampleGroupSummary> =>
  Object.fromEntries(WORKFLOWS.map(group => [group, { samples: describeSamples({ workflow: group }).map(sample => sample.name) }]));

/**
 * A sample, by its name or its job name, the names being unique across the samples groups.
 */
export const describeSample = (name: string): SampleSummary => summaryOf(findSamples({ sampleName: name })[0]);

/**
 * The samples the CI runs for changed files, by samples group (workflow), like the describeChangedSamples of
 * generator-jhipster: the CI of the blueprint runs every sample of its matrix on any pull request, whatever the files, so
 * it is the matrix of each workflow (github-build-matrix), the groups without samples left out.
 * @param _files the changed files, relative to the repository root
 */
export const describeChangedSamples = async (_files: string[]): Promise<Record<string, string[]>> =>
  Object.fromEntries(
    WORKFLOWS.map(group => [group, samplesGroupMatrix(group).include.map(job => job.sample)] as const).filter(
      ([, samples]) => samples.length > 0,
    ),
  );
