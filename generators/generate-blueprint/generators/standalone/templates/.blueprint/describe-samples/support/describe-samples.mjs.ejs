import { join } from 'node:path';

import { describeGithubSamples, getGithubSamples, getGithubSamplesGroups } from 'generator-jhipster/ci';

/** @typedef {import('generator-jhipster/ci').SampleDescription} SampleDescription */
/** @typedef {{ samples: string[] }} SampleGroupSummary A samples group with the names of its samples; an object, to grow with more data. */
/** @typedef {SampleDescription['jdls'][string]} SampleJDL A jdl of a sample: a file of the blueprint, or the content of an inline jdl. */
/**
 * A sample: how to generate it, the files generate-sample copies to the project but the jdl ones (the path in the project
 * to the file of the blueprint), and the jdl it is generated from, by their name in the project.
 * @typedef {Pick<SampleDescription, 'workflow' | 'jobName' | 'disabled' | 'files' | 'jdls'>} SampleSummary
 */
/** @typedef {{ samples: Record<string, SampleSummary> }} SampleGroupDescription The samples of a samples group by name; an object, to grow with more data. */

/** The folder of the samples groups, the ones generate-sample generates. */
const SAMPLES_GROUP_FOLDER = join(import.meta.dirname, '../../generate-sample/templates/');

/** The root of the blueprint, the paths of the files are relative to. */
const ROOT = join(import.meta.dirname, '../../../');

/**
 * The descriptions of the samples of the groups, every group when omitted, as the describe-samples command prints them.
 * @param {string[]} [groups]
 * @returns {Promise<SampleDescription[]>}
 */
const describeSamples = groups =>
  describeGithubSamples({ samplesGroupFolder: SAMPLES_GROUP_FOLDER, groups, root: ROOT });

/**
 * The descriptions of the samples of a group, every group when omitted, or of the sample of a name or a job name.
 * A sample is generated by its name alone: without a group, a name two groups share fails.
 * @param {{ sampleName?: string; samplesGroup?: string }} [options]
 * @returns {Promise<SampleDescription[]>}
 */
export const findSamples = async ({ sampleName, samplesGroup } = {}) => {
  if (!samplesGroup) await getGithubSamples(SAMPLES_GROUP_FOLDER);
  const samples = await describeSamples(samplesGroup ? [samplesGroup] : undefined);
  if (!sampleName) return samples;
  const found = samples.filter(sample => sample.name === sampleName || sample.jobName === sampleName);
  if (found.length === 0) {
    // The names, so the caller, an AI agent too, can correct the name by itself.
    throw new Error(`Sample ${sampleName} not found, expected one of ${samples.map(sample => sample.name).join(', ')}`);
  }
  return found;
};

/**
 * @param {SampleDescription} sample
 * @returns {SampleSummary}
 */
const summaryOf = ({ workflow, jobName, disabled, files, jdls }) => ({ workflow, jobName, disabled, files, jdls });

/**
 * The samples groups by name, with the names of their samples.
 * @returns {Promise<Record<string, SampleGroupSummary>>}
 */
export const describeSampleGroups = async () => {
  const samples = await findSamples();
  return Object.fromEntries(
    (await getGithubSamplesGroups(SAMPLES_GROUP_FOLDER)).map(group => [
      group,
      { samples: samples.filter(sample => sample.workflow === group).map(sample => sample.name) },
    ]),
  );
};

/**
 * The samples of a samples group, by name.
 * @param {string} group
 * @returns {Promise<SampleGroupDescription>}
 */
export const describeSampleGroup = async group => {
  const groups = await getGithubSamplesGroups(SAMPLES_GROUP_FOLDER);
  if (!groups.includes(group)) {
    throw new Error(`Samples group ${group} not found, expected one of ${groups.join(', ')}`);
  }
  return { samples: Object.fromEntries((await findSamples({ samplesGroup: group })).map(sample => [sample.name, summaryOf(sample)])) };
};

/**
 * A sample, by its name or its job name.
 * @param {string} name
 * @returns {Promise<SampleSummary>}
 */
export const describeSample = async name => summaryOf((await findSamples({ sampleName: name }))[0]);
