import { readFileSync } from 'node:fs';
import { extname } from 'node:path';
import { fileURLToPath } from 'node:url';

import { defaultGithubEnvironment, extractSampleFiles } from 'generator-jhipster/ci';
import { EnvironmentBuilder } from 'generator-jhipster/cli';
import BaseCoreGenerator from 'generator-jhipster/generators/base-core';

import { findSamples } from '../describe-samples/support/describe-samples.mjs';

const GENERATOR_JDL = 'jdl';

/**
 * The secrets of a sample, the same at each generation, like the samples of generator-jhipster: derived from the creation
 * timestamp, the jwt secret key of a jdl sample shared by its applications (a gateway and its microservices).
 */
const sampleSecrets = ({ jdl }) => ({
  reproducibleSecrets: true,
  ...(jdl ? { jwtSecretKey: defaultGithubEnvironment['jwt-secret-key'] } : {}),
});

const packageRoot = fileURLToPath(new URL('../../', import.meta.url));
const packageJson = JSON.parse(readFileSync(new URL('../../package.json', import.meta.url), 'utf-8'));

/**
 * Generates a sample by its name alone, like generate-sample of generator-jhipster: the sample of describe-samples, its
 * files copied to the project, generated by its command.
 */
export default class extends BaseCoreGenerator {
  /** @type {string} */
  sampleName;
  /** @type {boolean | undefined} */
  all;
  /** @type {string | undefined} */
  workflow;
  /** @type {import('generator-jhipster/ci').SampleDescription | undefined} */
  sample;
  /** @type {import('generator-jhipster/ci').SampleFile[]} */
  sampleFiles = [];
  /** @type {string[]} The jdl files of the project, the jdl generator generating them. */
  jdlFiles = [];

  get [BaseCoreGenerator.WRITING]() {
    return this.asAnyTaskGroup({
      async copySample() {
        if (this.all) return;
        if (extname(this.sampleName) === '.jdl') {
          this.jdlFiles = [this.sampleName];
          this.copyTemplate(`samples/${this.sampleName}`, this.sampleName, { noGlob: true });
        } else {
          const [sample] = findSamples({ sampleName: this.sampleName });
          this.sample = sample;
          this.sampleFiles = extractSampleFiles(sample, { root: packageRoot });
          for (const file of this.sampleFiles) {
            const destination = this.destinationPath(file.destination);
            if ('source' in file) {
              this.fs.copy(file.source, destination);
            } else {
              this.fs.write(destination, file.contents);
            }
          }
          this.jdlFiles = this.sampleFiles.map(file => file.destination).filter(destination => extname(destination) === '.jdl');
        }
      },
    });
  }

  get [BaseCoreGenerator.END]() {
    return this.asAnyTaskGroup({
      async generateSample() {
        if (this.all) {
          // Every sample (of the workflow, when given) generated by its name, each one in a folder of its name.
          for (const { name } of findSamples({ workflow: this.workflow }).filter(sample => !sample.disabled)) {
            await this.composeWithJHipster('@jhipster/jhipster-dev:generate-sample', {
              generatorArgs: [name],
              // The sample alone, with the blueprints of the cli: they are not given to a generator of another folder.
              generatorOptions: { destinationRoot: name, all: false, workflow: undefined, blueprints: this.options.blueprints },
            });
          }
          return;
        }
        const generatorOptions = {
          projectVersion: `${packageJson.version}-git`,
          skipJhipsterDependencies: true,
        };
        const { sample, jdlFiles } = this;
        // The jdl generator generates the applications of a workspace in environments of their own: they find this
        // blueprint, which the JDL gives to the applications that use it, in this checkout.
        const workspaceOptions = {
          createEnvBuilder: (options, prepareOptions) =>
            EnvironmentBuilder.create(options).prepare({ lookups: [{ packagePaths: [packageRoot] }], ...prepareOptions }),
        };
        if (!sample) {
          await this.composeWithJHipster(GENERATOR_JDL, {
            generatorArgs: jdlFiles,
            generatorOptions: { ...generatorOptions, ...sampleSecrets({ jdl: true }) },
          });
          return;
        }

        await this.composeWithJHipster(jdlFiles.length > 0 ? GENERATOR_JDL : sample.defaultCommand, {
          generatorArgs: jdlFiles,
          generatorOptions: {
            ...generatorOptions,
            ...sampleSecrets({ jdl: sample.defaultCommand === GENERATOR_JDL }),
            ...(sample.environment ? { defaultEnvironment: sample.environment } : {}),
            ...sample.generatorOptions,
            ...(sample.generatorOptions?.workspaces ? workspaceOptions : {}),
          },
        });
      },
      async info() {
        if (this.all) return;
        await this.composeWithJHipster('info');
      },
    });
  }
}
