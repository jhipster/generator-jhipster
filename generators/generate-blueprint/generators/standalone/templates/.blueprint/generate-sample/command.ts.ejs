import type { JHipsterCommandDefinition } from 'generator-jhipster';

import { describeSampleGroups } from '../describe-samples/support.ts';

import type Generator from './generator.js';

/** The choice of the samples of every workflow. */
const ALL_WORKFLOWS = '*';

export default {
  configs: {
    workflow: {
      description: 'Workflow of the sample, to choose it from',
      cli: {
        type: String,
      },
      prompt: gen => ({
        when: !gen.all && !gen.sampleName && !gen.workflow,
        type: 'select',
        message: 'Which workflow is the sample of?',
        choices: () => [{ name: 'All workflows', value: ALL_WORKFLOWS }, ...Object.keys(describeSampleGroups())],
        default: ALL_WORKFLOWS,
      }),
      scope: 'generator',
    },
    sampleName: {
      argument: {
        type: String,
      },
      prompt: gen => ({
        when: !gen.all && !gen.sampleName,
        type: 'select',
        message: 'Which sample do you want to generate?',
        choices: (answers: any) => {
          const groups = describeSampleGroups();
          const workflow = answers.workflow ?? gen.workflow ?? ALL_WORKFLOWS;
          return workflow === ALL_WORKFLOWS ? Object.values(groups).flatMap(group => group.samples) : groups[workflow].samples;
        },
      }),
      scope: 'generator',
    },
    all: {
      description: 'Generate every sample (of --workflow, when given), each one in a folder of its name',
      cli: {
        type: Boolean,
      },
      scope: 'generator',
    },
  },
  import: ['app'],
} as const satisfies JHipsterCommandDefinition<Generator>;
