<%_ const pm = nodePackageManager === 'pnpm' ? 'pnpm' : 'npm'; _%>
import java.nio.file.Files
import java.nio.file.Path

plugins {
    id "com.github.node-gradle.node"
}

if (project.hasProperty("nodeInstall")) {
    node {
        version = "<%- nodeVersion %>"
        <%- pm %>Version = "<%- nodeDependencies[pm] %>"
        download = true
    }

    // Link local node and <%- pm %> to a fixed location for <%- pm %>w.
    // They are linked instead of copied, because a copy dereferences symlinks, and bin/npm and
    // bin/npx must stay symlinks to lib/node_modules/npm/bin/*-cli.js: as plain extension-less
    // files they are resolved against the wrong directory, and parsed as ESM since the closest
    // package.json is the project one, which declares "type": "module".
    def isWindows = System.getProperty("os.name").toLowerCase(Locale.ROOT).contains("windows")
    def nodeDir = tasks.named("nodeSetup").flatMap { it.nodeDir }
    def <%- pm %>Dir = tasks.named("<%- pm %>Setup").flatMap { it.<%- pm %>Dir }
    def fixedNodeDir = layout.buildDirectory.dir("node")

    // Link (in the fixed location) to target pairs, relative targets being resolved from the link
    def nodeLinks = { ->
        def fixed = fixedNodeDir.get().asFile.toPath()
        def links = [:]
        if (isWindows) {
            links[fixed.resolve("bin/node.exe")] = nodeDir.get().file("node.exe").asFile.toPath()
<%_ if (pm === 'pnpm') { _%>
            links[fixed.resolve("bin/pnpm.cmd")] = pnpmDir.get().file("pnpm.cmd").asFile.toPath()
            links[fixed.resolve("lib/node_modules/pnpm")] = pnpmDir.get().dir("node_modules/pnpm").asFile.toPath()
<%_ } else { _%>
            links[fixed.resolve("bin/npm.cmd")] = npmDir.get().file("npm.cmd").asFile.toPath()
            links[fixed.resolve("bin/npx.cmd")] = npmDir.get().file("npx.cmd").asFile.toPath()
            links[fixed.resolve("lib/node_modules/npm")] = npmDir.get().dir("node_modules/npm").asFile.toPath()
<%_ } _%>
        } else {
            links[fixed.resolve("bin/node")] = nodeDir.get().file("bin/node").asFile.toPath()
<%_ if (pm === 'pnpm') { _%>
            links[fixed.resolve("bin/pnpm")] = Path.of("../lib/node_modules/pnpm/bin/pnpm.mjs")
            links[fixed.resolve("lib/node_modules/pnpm")] = pnpmDir.get().dir("lib/node_modules/pnpm").asFile.toPath()
<%_ } else { _%>
            links[fixed.resolve("bin/npm")] = Path.of("../lib/node_modules/npm/bin/npm-cli.js")
            links[fixed.resolve("bin/npx")] = Path.of("../lib/node_modules/npm/bin/npx-cli.js")
            links[fixed.resolve("lib/node_modules/npm")] = npmDir.get().dir("lib/node_modules/npm").asFile.toPath()
<%_ } _%>
        }
        links
    }

    def linkNode = tasks.register("linkNode") {
        description = "Link the local node and <%- pm %> installations to a fixed location for <%- pm %>w."
        onlyIf {
            nodeLinks().any { link, target -> !Files.isSymbolicLink(link) || Files.readSymbolicLink(link) != target }
        }
        doLast {
            nodeLinks().each { link, target ->
                Files.createDirectories(link.parent)
                if (Files.isDirectory(link) && !Files.isSymbolicLink(link)) {
                    link.toFile().deleteDir()
                } else {
                    Files.deleteIfExists(link)
                }
                Files.createSymbolicLink(link, target)
            }
        }
    }
    tasks.named("nodeSetup").configure { finalizedBy(linkNode) }
    tasks.named("<%- pm %>Setup").configure { finalizedBy(linkNode) }
}

<%_ if (!skipClient) { _%>
def webapp_test = tasks.register('webapp_test', <%- pm === 'pnpm' ? 'PnpmTask' : 'NpmTask' %>) {
    inputs.property('appVersion', project.version)
    inputs.files("build.gradle")
        .withPropertyName('build.gradle')
        .withPathSensitivity(PathSensitivity.RELATIVE)
    inputs.files(<%- javaNodeBuildPaths.filter(file => !file.endsWith('/')).map(file => `'${file}'`).join(', ') %>)
        .withPropertyName('<%- clientFramework %>-build')
        .withPathSensitivity(PathSensitivity.RELATIVE)
  <%_ for (const file of javaNodeBuildPaths.filter(file => file.endsWith('/'))) { _%>
    inputs.dir("<%- file %>")
        .withPropertyName("<%- file %>")
        .withPathSensitivity(PathSensitivity.RELATIVE)
  <%_ } _%>

  <%_ if (clientFramework === 'angular') { _%>
    outputs.file("build/test-results/TESTS-results-sonar-vitest.xml")
        .withPropertyName("vitest-result")
    outputs.file("build/test-results/lcov.info")
        .withPropertyName("coverage-result")
  <%_ } else { _%>
    outputs.file("build/test-results/TESTS-results-vitest.xml")
        .withPropertyName("vitest-result")
    outputs.dir("<%- clientFramework === 'vue' ? 'build/vite-coverage/' : 'build/test-results/lcov-report/' %>")
        .withPropertyName("coverage-result")
  <%_ } _%>

    dependsOn(<%- pm %>Install, compileTestJava)
    args = ["run", "webapp:test"]
}

tasks.named('test').configure { dependsOn(webapp_test) }

<%_ } _%>
