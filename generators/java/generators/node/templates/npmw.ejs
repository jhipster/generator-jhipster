#!/bin/sh
<%_ const pm = nodePackageManager === 'pnpm' ? 'pnpm' : 'npm'; _%>

basedir=$(dirname "$0")

<%_ if (buildToolMaven) { _%>
if [ -f "$basedir/mvnw" ]; then
  bindir="$basedir/target/node"
  repodir="$basedir/target/node/node_modules"
  installCommand="$basedir/mvnw --batch-mode -ntp -Pwebapp frontend:install-node-and-<%- pm %>@install-node-and-<%- pm %>"
<%_ } else if (buildToolGradle) { _%>
if [ -f "$basedir/gradlew" ]; then
  bindir="$basedir/build/node/bin"
  repodir="$basedir/build/node/lib/node_modules"
  installCommand="$basedir/gradlew <%- pm %>Setup --no-daemon"
<%_ } _%>
else
  echo "Using <%- pm %> installed globally"
  exec <%- pm %> "$@"
fi

<%_ if (pm === 'pnpm') { _%>
NPM_EXE="$repodir/pnpm/bin/pnpm.mjs"
<%_ } else { _%>
NPM_EXE="$repodir/npm/bin/npm-cli.js"
<%_ } _%>
NODE_EXE="$bindir/node"

if [ ! -f "$NPM_EXE" ] || [ ! -x "$NODE_EXE" ]; then
  $installCommand || true
fi

if [ -x "$NODE_EXE" ]; then
  echo "Using node installed locally $($NODE_EXE --version)"
  PATH="$bindir:$PATH"
else
  NODE_EXE='node'
fi

if [ ! -f "$NPM_EXE" ]; then
  echo "Local <%- pm %> not found, using <%- pm %> installed globally"
  <%- pm %> "$@"
else
  echo "Using <%- pm %> installed locally $($NODE_EXE $NPM_EXE --version)"
  $NODE_EXE $NPM_EXE "$@"
fi
