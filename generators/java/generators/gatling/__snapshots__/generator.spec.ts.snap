            Map.<String, Object>of("body", "{\\"name\\":\\"7b0efb46-4b1c-49dd-9a3d-a2881096989f\\"}"),
            Map.<String, Object>of("body", "{\\"name\\":\\"deafb238-3db8-45e2-95e9-0697d3751e6a\\"}")
        )
    ).circular();

    ChainBuilder scn = exec(http("First unauthenticated request")
        .get("/api/account")
        .headers(headersHttp)
        .check(status().is(401))
        ).exitHereIfFailed()
        .pause(10)
        .exec(http("Authentication")
        .post("/api/authenticate")
        .headers(headersHttpAuthentication)
        .body(StringBody("{\\"username\\":\\"admin\\", \\"password\\":\\"admin\\"}")).asJson()
        .check(header("Authorization").saveAs("access_token"))).exitHereIfFailed()
        .pause(2)
        .exec(http("Authenticated request")
        .get("/api/account")
        .headers(headersHttpAuthenticated)
        .check(status().is(200)))
        .pause(10)
        .repeat(2).on(
            feed(authorityFeeder).exec(http("Get all authorities")
            .get("/api/authorities")
            .headers(headersHttpAuthenticated)
            .check(status().is(200)))
            .pause(Duration.ofSeconds(10), Duration.ofSeconds(20))
            .exec(http("Create new authority")
            .post("/api/authorities")
            .headers(headersHttpAuthenticated)
            .body(StringBody("#{body}")).asJson()
            .check(status().is(201))
            .check(headerRegex("Location", "(.*)").saveAs("new_authority_url"))).exitHereIfFailed()
            .pause(10)
            .repeat(5).on(
                exec(http("Get created authority")
                .get("\${new_authority_url}")
                .headers(headersHttpAuthenticated))
                .pause(10)
            )
            .exec(http("Delete created authority")
            .delete("\${new_authority_url}")
            .headers(headersHttpAuthenticated))
            .pause(10)
        );

    ScenarioBuilder users = scenario("Test the Authority entity").exec(scn);

    {
        setUp(
            users.injectOpen(rampUsers(Integer.getInteger("users", 100)).during(Duration.ofMinutes(Integer.getInteger("ramp", 1))))
        ).protocols(httpConf);
    }
}
",
    "stateCleared": "modified",
  },
}
`;
