        .check(header("Authorization").saveAs("access_token"))).exitHereIfFailed()
        .pause(2)
        .exec(http("Authenticated request")
        .get("/api/account")
        .headers(headersHttpAuthenticated)
        .check(status().is(200)))
        .pause(10)
        .repeat(2).on(
            exec(http("Get all authorities")
            .get("/api/authorities")
            .headers(headersHttpAuthenticated)
            .check(status().is(200)))
            .pause(Duration.ofSeconds(10), Duration.ofSeconds(20))
            .exec(http("Create new authority")
            .post("/api/authorities")
            .headers(headersHttpAuthenticated)
            .body(StringBody("{" +
                "\\"name\\": \\"SAMPLE_TEXT\\"" +
                "}")).asJson()
            .check(status().is(201))
            .check(headerRegex("Location", "(.*)").saveAs("new_authority_url"))).exitHereIfFailed()
            .pause(10)
            .repeat(5).on(
                exec(http("Get created authority")
                .get("\${new_authority_url}")
                .headers(headersHttpAuthenticated))
                .pause(10)
            )
            .exec(http("Delete created authority")
            .delete("\${new_authority_url}")
            .headers(headersHttpAuthenticated))
            .pause(10)
        );

    ScenarioBuilder users = scenario("Test the Authority entity").exec(scn);

    {
        setUp(
            users.injectOpen(rampUsers(Integer.getInteger("users", 100)).during(Duration.ofMinutes(Integer.getInteger("ramp", 1))))
        ).protocols(httpConf);
    }
}
",
    "stateCleared": "modified",
  },
}
`;
