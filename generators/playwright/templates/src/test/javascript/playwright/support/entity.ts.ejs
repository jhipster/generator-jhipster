import { readFile } from 'node:fs/promises';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import type { Locator, Page } from '@playwright/test';

// ***********************************************
// Begin Specific Selector Attributes
// ***********************************************

// Entity
export const entityTableSelector = '[data-cy="entityTable"]';
export const entityCreateButtonSelector = '[data-cy="entityCreateButton"]';
export const entityCreateSaveButtonSelector = '[data-cy="entityCreateSaveButton"]';
export const entityCreateCancelButtonSelector = '[data-cy="entityCreateCancelButton"]';
export const entityDetailsButtonSelector = '[data-cy="entityDetailsButton"]'; // can return multiple elements
export const entityDetailsBackButtonSelector = '[data-cy="entityDetailsBackButton"]';
export const entityEditButtonSelector = '[data-cy="entityEditButton"]';
export const entityDeleteButtonSelector = '[data-cy="entityDeleteButton"]';
export const entityConfirmDeleteButtonSelector = '[data-cy="entityConfirmDeleteButton"]';

// ***********************************************
// End Specific Selector Attributes
// ***********************************************

const fixturesDir = join(dirname(fileURLToPath(import.meta.url)), '..', 'fixtures');

/** Ports the Cypress entity commands; every selector is the one the clients already render. */
export class EntityHelper {
  constructor(private readonly page: Page) {}

  getEntityHeading(entityName: string): Locator {
    return this.page.locator(`[data-cy="${entityName}Heading"]`);
  }

  getEntityCreateUpdateHeading(entityName: string): Locator {
    return this.page.locator(`[data-cy="${entityName}CreateUpdateHeading"]`);
  }

  getEntityDetailsHeading(entityInstanceName: string): Locator {
    return this.page.locator(`[data-cy="${entityInstanceName}DetailsHeading"]`);
  }

  getEntityDeleteDialogHeading(entityInstanceName: string): Locator {
    return this.page.locator(`[data-cy="${entityInstanceName}DeleteDialogHeading"]`);
  }

  /** Ports `setFieldImageAsBytesOfEntity`: Playwright sets the file on the input directly. */
  async setFieldImageAsBytesOfEntity(fieldName: string, fileName: string, mimeType: string): Promise<void> {
    const buffer = await readFile(join(fixturesDir, fileName));
    // The blob widget renders more than one element with the field's data-cy; the cypress command used el[0].
    await this.page.locator(`[data-cy="${fieldName}"]`).first().setInputFiles({ name: fileName, mimeType, buffer });
  }

  /**
   * Ports `setFieldSelectToLastOfEntity`: selects the last option when the control has any, otherwise falls back to
   * the keyboard, which is what the Cypress command does for comboboxes that populate asynchronously.
   */
  async setFieldSelectToLastOfEntity(fieldName: string): Promise<void> {
    const select = this.page.locator(`[data-cy="${fieldName}"]`).first();
    const optionCount = await select.locator('option').count();
    if (optionCount > 0) {
      await select.selectOption({ index: optionCount - 1 });
    } else {
      await select.press('ArrowDown');
    }
  }
}
