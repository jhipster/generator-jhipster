<%- include('/liquibase-changelog-header') -%>
<%_ if (!applicationTypeMicroservice && generateBuiltInUserEntity) { _%>

    <!--
        JHipster core tables.
        The initial schema has the '00000000000000' id, so that it is over-written if we re-generate it.
    -->
    <changeSet id="00000000000000" author="jhipster">
        <createTable tableName="user">
            <column name="id" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="login" type="text"/>
            <column name="password" type="text"/>
            <column name="firstname" type="text"/>
            <column name="lastname" type="text"/>
            <column name="email" type="text"/>
            <column name="activated" type="boolean"/>
            <column name="lang_key" type="text"/>
            <column name="activation_key" type="text"/>
            <column name="reset_key" type="text"/>
            <column name="reset_date" type="timestamp"/>
            <column name="authorities" type="set&lt;text&gt;"/>
        </createTable>
        <createTable tableName="user_by_login">
            <column name="login" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="id" type="text">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
        <createTable tableName="user_by_email">
            <column name="email" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="id" type="text">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
  <%_ if (generateUserManagement) { _%>
        <createTable tableName="user_by_activation_key">
            <column name="activation_key" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="id" type="text">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
        <createTable tableName="user_by_reset_key">
            <column name="reset_key" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="id" type="text">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
        <createTable tableName="activation_key_by_creation_date">
            <column name="creation_date" type="timeuuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="activation_key" type="text">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
  <%_ } _%>
  <%_ if (generateUserManagement && authenticationTypeSession && !reactive) { _%>
        <createTable tableName="persistent_token">
            <column name="series" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="token_date" type="timestamp"/>
            <column name="user_agent" type="text"/>
            <column name="token_value" type="text"/>
            <column name="login" type="text"/>
            <column name="user_id" type="text"/>
            <column name="ip_address" type="text"/>
        </createTable>
        <createTable tableName="persistent_token_by_user">
            <column name="user_id" type="text">
                <constraints primaryKey="true"/>
            </column>
            <column name="persistent_token_series" type="text">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
  <%_ } _%>
    </changeSet>
  <%_ if (generateUserManagement) { _%>

    <!--
        Default users.
    -->
    <changeSet id="00000000000001" author="jhipster">
        <loadData
                  file="config/liquibase/data/user.csv"
                  separator=";"
                  tableName="user"
                  usePreparedStatements="false">
            <column name="activated" type="boolean"/>
            <column name="authorities" type="computed"/>
        </loadData>
        <loadData
                  file="config/liquibase/data/user_by_login.csv"
                  separator=";"
                  tableName="user_by_login"
                  usePreparedStatements="false"/>
        <loadData
                  file="config/liquibase/data/user_by_email.csv"
                  separator=";"
                  tableName="user_by_email"
                  usePreparedStatements="false"/>
    </changeSet>
  <%_ } _%>
<%_ } _%>

</databaseChangeLog>
