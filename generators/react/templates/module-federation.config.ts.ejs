import { fileURLToPath } from 'node:url';

import type { createModuleFederationConfig } from '@module-federation/sdk';

import packageJson from './package.json' with { type: 'json' };

// Microfrontend API, should match across gateway and microservices.
const apiVersion = '0.0.1';

const sharedDefaults = { singleton: true, strictVersion: true, requiredVersion: apiVersion };
// Application modules are not installed packages, `import` points the federation plugin to the source file.
// The path is absolute because the dev server resolves it from a virtual module.
const shareMappings = (...mappings: string[]) =>
  Object.fromEntries(
    mappings.map(map => [
      map,
      {
        ...sharedDefaults,
        version: apiVersion,
        import: fileURLToPath(new URL(`./<%- relativeDir(clientRootDir, clientSrcDir) %>${map}`, import.meta.url)),
      },
    ]),
  );

const shareDependencies = ({ skipList = [] }: { skipList?: string[] } = {}) =>
  Object.fromEntries(
    Object.entries(packageJson.dependencies)
      .filter(([dependency]) => !skipList.includes(dependency))
      .map(([dependency, version]) => [dependency, { ...sharedDefaults, version, requiredVersion: version }]),
  );

const applicationModules = shareMappings(
  'app/config/constants',
  'app/config/store',
  'app/shared/error/error-boundary-routes',
  'app/shared/layout/menus/menu-components',
  'app/shared/layout/menus/menu-item',
  'app/shared/reducers',
  // `app/shared/reducers/locale` is not shared: its `registerTranslations` loads the translations of the application
  // it is bundled with, so a microfrontend keeps its own copy to register its translations into the host.
  'app/shared/reducers/reducer.utils',
  'app/shared/util/date-utils',
  'app/shared/util/entity-utils',
);

<%_ if (applicationTypeMicroservice) { _%>
const development = process.env.NODE_ENV !== 'production';

<%_ } _%>
export default {
  name: '<%- lowercaseBaseName.replaceAll('-', '_') %>',
  exposes: {
<%_ if (applicationTypeMicroservice || exposeMicrofrontend) { _%>
    './entities-menu': './app/entities/menu',
    './entities-routes': './app/entities/routes',
<%_ } _%>
    // jhipster-needle-expose
  },
  filename: 'remoteEntry.js',
  shareScope: 'default',
  shared: {
    ...shareDependencies(),
<%_ if (applicationTypeMicroservice) { _%>
    // The dev server runs the microfrontend on its own, so there is no host to share the application modules with.
    // Sharing them there also breaks the start: @module-federation/vite evaluates them before the shared packages they import,
    // see https://github.com/module-federation/vite/issues/1507.
    ...(development ? {} : applicationModules),
<%_ } else { _%>
    ...applicationModules,
<%_ } _%>
  },
  dts: false,
  manifest: true,
} as const satisfies Parameters<typeof createModuleFederationConfig>[0];
