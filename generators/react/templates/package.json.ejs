{
  "name": "<%- dasherizedBaseName %>",
  "version": "0.0.1-SNAPSHOT",
  "description": "<%- projectDescription %>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "<%- nodeDependencies['@fortawesome/fontawesome-svg-core'] %>",
    "@fortawesome/free-solid-svg-icons": "<%- nodeDependencies['@fortawesome/free-solid-svg-icons'] %>",
    "@fortawesome/react-fontawesome": "<%- nodeDependencies['@fortawesome/react-fontawesome'] %>",
    "@reduxjs/toolkit": "<%- nodeDependencies['@reduxjs/toolkit'] %>",
    "axios": "<%- nodeDependencies.axios %>",
    "bootstrap": "<%- nodeDependencies.bootstrap %>",
<%_ if (!clientThemeNone) { _%>
    "bootswatch": "<%- nodeDependencies.bootswatch %>",
<%_ } _%>
    "dayjs": "<%- nodeDependencies.dayjs %>",
    "react": "<%- nodeDependencies.react %>",
    "react-dom": "<%- nodeDependencies['react-dom'] %>",
    "react-hook-form": "<%- nodeDependencies['react-hook-form'] %>",
    "react-jhipster": "<%- nodeDependencies['react-jhipster'] %>",
    "react-redux": "<%- nodeDependencies['react-redux'] %>",
    "react-router": "<%- nodeDependencies['react-router'] %>",
    "react-toastify": "<%- nodeDependencies['react-toastify'] %>",
    "react-top-loading-bar": "<%- nodeDependencies['react-top-loading-bar'] %>",
    "react-bootstrap": "<%- nodeDependencies['react-bootstrap'] %>",
    "redux": "<%- nodeDependencies.redux %>",
    "tslib": "<%- nodeDependencies.tslib %>"
  },
  "devDependencies": {
    "@eslint/js": null,
    "@eslint-react/eslint-plugin": "<%- nodeDependencies['@eslint-react/eslint-plugin'] %>",
    "@testing-library/react": "<%- nodeDependencies['@testing-library/react'] %>",
    "@types/node": "<%- nodeDependencies['@types/node'] %>",
    "@types/react": "<%- nodeDependencies['@types/react'] %>",
    "@types/react-dom": "<%- nodeDependencies['@types/react-dom'] %>",
    "@vitejs/plugin-react": "<%- nodeDependencies['@vitejs/plugin-react'] %>",
    "@vitest/coverage-v8": "<%- nodeDependencies.vitest %>",
    "autoprefixer": "<%- nodeDependencies.autoprefixer %>",
    "eslint": "<%- nodeDependencies.eslint %>",
    "eslint-config-prettier": "<%- nodeDependencies['eslint-config-prettier'] %>",
    "eslint-plugin-prettier": "<%- nodeDependencies['eslint-plugin-prettier'] %>",
    "happy-dom": "<%- nodeDependencies['happy-dom'] %>",
<%_ if (enableTranslation) { _%>
    "deepmerge": null,
<%_ } _%>
<%_ if (enableI18nRTL) { _%>
    "postcss-rtlcss": "<%- nodeDependencies['postcss-rtlcss'] %>",
<%_ } _%>
    "react-infinite-scroll-component": "<%- nodeDependencies['react-infinite-scroll-component'] %>",
    "rimraf": "<%- nodeDependencies.rimraf %>",
    "sass": "<%- nodeDependencies.sass %>",
<%_ if (skipServer) { _%>
    "sonar-scanner": "<%- nodeDependencies['sonar-scanner'] %>",
<%_ } _%>
    "swagger-ui-dist": "<%- nodeDependencies['swagger-ui-dist'] %>",
    "typescript": "<%- nodeDependencies.typescript %>",
    "typescript-eslint": "<%- nodeDependencies['typescript-eslint'] %>",
    "vite": "<%- nodeDependencies.vite %>",
    "vite-plugin-static-copy": null,
    "vitest": "<%- nodeDependencies.vitest %>",
    "vitest-sonar-reporter": "<%- nodeDependencies['vitest-sonar-reporter'] %>"
  },
  <%# An unknown dependency pulls in outdated react and react-dom, override them -%>
  <%# Use literal versions, npm 10 fails to resolve $ references https://github.com/npm/cli/issues/5730 -%>
  "overrides": {
    "react": "<%- nodeDependencies.react %>",
    "react-dom": "<%- nodeDependencies['react-dom'] %>"
  },
  "engines": {
    "node": ">=<%- nodeVersion %>"
  },
  "config": {
    "default_environment": "prod"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "<%- nodePackageManager %> run lint -- --fix",
    "cleanup": "rimraf <%- this.relativeDir(clientRootDir, temporaryDir) %>",
    "clean-www": "rimraf <%- this.relativeDir(clientRootDir, clientDistDir) %>",
    "build": "<%- nodePackageManager %> run webapp:prod --",
    "build-watch": "concurrently 'npm run webapp:build:dev -- --watch'<%- skipServer ? '' : ' npm:backend:start' %>",
    "start": "<%- nodePackageManager %> run webapp:dev --",
<%_ if (skipServer) { _%>
    "sonar": "sonar-scanner",
<%_ } _%>
    "pretest": "<%- nodePackageManager %> run lint",
    "test": "<%- nodePackageManager %> run vitest-run --",
    "test:watch": "<%- nodePackageManager %> run vitest --",
    "vitest": "vitest",
    "vitest-run": "vitest run --coverage",
    "watch": "concurrently 'npm run start' npm:backend:start",
    "webapp:build": "<%- nodePackageManager %> run clean-www && <%- nodePackageManager %> run webapp:build:dev --",
    "webapp:build:dev": "vite build",
    "webapp:build:prod": "vite build",
    "webapp:dev": "vite",
    "webapp:prod": "<%- nodePackageManager %> run clean-www && <%- nodePackageManager %> run webapp:build:prod --",
    "webapp:test": "<%- nodePackageManager %> run test --"
  }
}
