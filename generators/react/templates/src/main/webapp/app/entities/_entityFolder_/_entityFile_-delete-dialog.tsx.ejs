import { useEffect, useState } from 'react';
import { Button, Modal, ModalBody, ModalFooter, ModalHeader } from 'react-bootstrap';
import { Translate } from 'react-jhipster';

import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';

import { useAppDispatch, useAppSelector } from 'app/config/store';

import { deleteEntity } from './<%- entityFileName %>.reducer';

export const <%- entityReactName %>DeleteDialog = ({
  id,
  onClose,
  onDeleted,
}: {
  /** The identifier of the entity to delete. */
  id: string | number;
  onClose: () => void;
  onDeleted: () => void;
}) => {
  const dispatch = useAppDispatch();

  const [deleting, setDeleting] = useState(false);

  const updateSuccess = useAppSelector(state => state.<%- entityReactState %>.updateSuccess);

  useEffect(() => {
    if (updateSuccess && deleting) {
      setDeleting(false);
      onDeleted();
    }
  }, [updateSuccess]);

  const confirmDelete = () => {
    setDeleting(true);
    dispatch(deleteEntity(id));
  };

  return (
    <Modal show onHide={onClose}>
    <ModalHeader data-cy="<%- entityInstance %>DeleteDialogHeading" closeButton>
      <Modal.Title><Translate contentKey="entity.delete.title">Confirm delete operation</Translate></Modal.Title>
    </ModalHeader>
    <ModalBody id="<%- i18nKeyPrefix %>.delete.question">
      <p>
        <Translate contentKey="<%- i18nKeyPrefix %>.delete.question" interpolate={{ <%- builtInUserManagement ? 'login' : 'id' %>: id }}>
          Are you sure you want to delete this <%- entityNameCapitalized %>?
        </Translate>
      </p>
    </ModalBody>
    <ModalFooter>
      <Button variant="secondary" onClick={onClose}>
        <FontAwesomeIcon icon="ban" />&nbsp;
        <Translate contentKey="entity.action.cancel">Cancel</Translate>
      </Button>
      <Button id="<%- jhiPrefixDashed %>-confirm-delete-<%- entityInstance %>" data-cy="entityConfirmDeleteButton" variant="danger" onClick={confirmDelete}>
        <FontAwesomeIcon icon="trash" />&nbsp;
        <Translate contentKey="entity.action.delete">Delete</Translate>
      </Button>
    </ModalFooter>
  </Modal>
  );
};

export default <%- entityReactName %>DeleteDialog;
