    const optionalNumberFields = readOnly ? [] : fields.filter(field => field.fieldTypeNumeric && !field.fieldValidationRequired && !field.id && !field.hidden && !field.readonly);
    const emptyNumbers = optionalNumberFields.map(field => `${field.fieldName}: ''`).join(', ');
    const nullNumbers = optionalNumberFields.map(field => `${field.fieldName}: null`).join(', ');
    const booleanFields = fields.filter(field => field.fieldTypeBoolean && !field.transient && !field.hidden);
    const fileFields = fields.filter(field => field.fieldTypeBinary && !field.blobContentTypeText && !field.transient && !field.hidden);
    const requiredCollections = readOnly ? [] : screenRelationships.filter(rel => rel.collection && rel.relationshipRequired);
