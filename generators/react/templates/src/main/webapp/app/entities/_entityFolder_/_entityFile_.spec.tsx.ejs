const selectAllOptions = (container: HTMLElement, name: string) => {
  const select = container.querySelector<HTMLSelectElement>(`[name="${name}"]`)!;
  for (const option of select.options) {
    // The attribute is what tells jsdom that the selected options changed.
    option.setAttribute('selected', '');
    option.selected = true;
  }
  fireEvent.change(select);
};

