 See the License for the specific language governing permissions and
 limitations under the License.
-%>
<%_ const formFields = fields.filter(field => (!field.id || builtInUserManagement || !field.autoGenerate) && !field.hidden && !(builtInUserManagement && field.readonly));
    // A primary key the user gives, like the name of an authority, is a field of the form, read only once created.
    const userProvidedPrimaryKey = !builtInUserManagement && formFields.some(field => field.id);
    const formFieldsNoId = formFields.filter(field => !field.id);
    const clientConstantImports = [...new Set(formFields.map(field => field.reactFieldClientConstant?.reactConstantImport).filter(Boolean))];
_%>
import { useEffect } from 'react';
import {
  Button,
  Col,
  FormText,
<%_ if (anyFieldHasDocumentation) { _%>
  OverlayTrigger,
<%_ } _%>
  Row,
<%_ if (anyFieldHasDocumentation) { _%>
  Tooltip,
<%_ } _%>
} from 'react-bootstrap';
import {
  Translate,
<%_ if (anyFieldHasFileBasedContentType) { _%>
  ValidatedBlobField,
<%_ } _%>
  ValidatedField,
  ValidatedForm,
<%_ if (builtInUserManagement) { _%>
  isEmail,
<%_ } _%>
  isNumber,
  translate,
} from 'react-jhipster';
import { Link, useNavigate, useParams } from 'react-router';

import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';

<%_ for (const clientConstantImport of clientConstantImports) { _%>
<%- clientConstantImport %>
<%_ } _%>
import { useAppDispatch, useAppSelector } from 'app/config/store';
import { convertDateTimeFromServer, convertDateTimeToServer, displayDefaultDateTime } from 'app/shared/util/date-utils';
<%_ if (relationships.filter(e => e.relationshipManyToMany) !== undefined) { _%>
import { mapIdList } from 'app/shared/util/entity-utils';
<%_ } _%>

<%_ const otherEntityActions = new Set(); _%>
<%_ for (const otherEntity of otherEntitiesWithPersistableRelationship.filter(otherEntity => !otherEntity.embedded)) { _%>
  <%_ otherEntityActions.add({
        action: `get${otherEntity.entityNamePlural}`,
        instance: otherEntity.entityInstancePlural,
        entity: otherEntity.entityAngularName,
        reducer: otherEntity.builtInUser ? `users.${otherEntity.entityInstancePlural}` : `${otherEntity.entityReactState}.entities`,
      });
  _%>
  <%_ if (otherEntity.builtInUser) { _%>
import { getUsers } from 'app/shared/reducers/user-management';
  <%_ } else { _%>
import { getEntities as get<%- otherEntity.entityNamePlural %> } from 'app/entities/<%- otherEntity.entityFolderName %>/<%- otherEntity.entityFileName %>.reducer';
  <%_ } _%>
<%_ } _%>
<%_ const enumImports = entityClientEnumImports; _%>
<%_ for (const [importedType, importedPath] of enumImports) { _%>
import { <%- importedType %> } from '<%- importedPath %>';
<%_ } _%>
import {
  getEntity,
  updateEntity,
  createEntity,
  reset
} from './<%- entityFileName %>.reducer';

export const <%- entityReactName %>Update = () => {
  const dispatch = useAppDispatch();

  const navigate = useNavigate();

  const { id } = useParams<'id'>();
  const isNew = id === undefined;

<%_ for (const val of otherEntityActions) { _%>
  const <%- val.instance %> = useAppSelector(state => state.<%- val.reducer %>);
<%_ } _%>
  const <%- entityInstance %>Entity = useAppSelector(state => state.<%- entityReactState %>.entity);
  const loading = useAppSelector(state => state.<%- entityReactState %>.loading);
  const updating = useAppSelector(state => state.<%- entityReactState %>.updating);
  const updateSuccess = useAppSelector(state => state.<%- entityReactState %>.updateSuccess);
<%_ for (const enumField of enumTypeFields) { _%>
  const <%- enumField.enumInstance %>Values = Object.keys(<%- enumField.fieldType %>);
<%_ } _%>
<%_ for (const field of formFields.filter(field => field.clientConstantsAsValues)) { _%>
  const <%- field.fieldName %>Values = <%- field.reactFieldClientConstant.reactConstantValues %>;
<%_ } _%>

  const handleClose = () => {
    navigate('/<%- entityPage %>'<%- paginationPagination ? ' + location.search' : '' %>);
  };

  useEffect(() => {
<%_ if (paginationInfiniteScroll) { _%>
    if (!isNew) {
      dispatch(getEntity(id));
    }
<%_ } else { _%>
    if (isNew) {
      dispatch(reset());
    } else {
      dispatch(getEntity(id));
    }
<%_ } _%>

<%_ for (const val of otherEntityActions) { _%>
    dispatch(<%- val.action %>({}));
<%_ } _%>
  }, []);

  useEffect(() => {
    if (updateSuccess) {
      handleClose();
    }
  }, [updateSuccess]);

  const saveEntity = values => {
<%_ for (field of formFields) { _%>
  <%_ const { fieldName } = field; _%>
  <%_ if (field.fieldTypeTimed) { _%>
    values.<%- fieldName %> = convertDateTimeToServer(values.<%- fieldName %>);
  <%_ } else if (field.fieldTypeNumeric) { _%>
    if (values.<%- fieldName %> !== undefined && typeof values.<%- fieldName %> !== 'number') {
      values.<%- fieldName %> = Number(values.<%- fieldName %>);
    }
  <%_ } _%>
<%_ } _%>

    const entity = {
      ...<%- entityInstance %>Entity,
      ...values,
<%_ for (const rel of persistableRelationships.filter(rel => !rel.otherEntity.embedded && !rel.relationshipSerializePrimaryKeyOnly)) { _%>
  <%_ if (rel.collection) { _%>
      <%- rel.propertyName %>: mapIdList(values.<%- rel.propertyName %>),
  <%_ } else { _%>
      <%- rel.propertyName %>: <%- rel.otherEntity.entityInstancePlural %>.find(it => it.<%- rel.otherEntity.primaryKey.name %>.toString() === values.<%- rel.propertyName %>?.toString()),
  <%_ } _%>
<%_ } _%>
    };

    if (isNew) {
      dispatch(createEntity(entity));
    } else {
      dispatch(updateEntity(entity));
    }
  };

  const defaultValues = () =>
    isNew
      ? {
<%_ for (field of formFieldsNoId) { _%>
  <%_ const { fieldName } = field; _%>
  <%_ if (field.fieldTypeTimed) { _%>
          <%- fieldName %>: displayDefaultDateTime(),
  <%_ } else if (field.fieldTypeBoolean && (field.fieldTsDefaultValue === 'true' || field.defaultValue === true)) { _%>
          <%- fieldName %>: true,
  <%_ } else if (field.clientConstantsAsValues && field.defaultValue) { _%>
          <%- fieldName %>: '<%- field.defaultValue %>',
  <%_ } _%>
<%_ } _%>
        }
      : {
<%_ for (field of formFieldsNoId) { _%>
  <%_ const { fieldName } = field; _%>
  <%_ if (field.fieldIsEnum && !field.clientConstantsAsValues) { _%>
    <%_ const { enumValues } = field; _%>
<%- fieldName %>: '<%- enumValues[0].name %>',
  <%_ } _%>
<%_ } _%>
          ...<%- entityInstance %>Entity,
<%_ for (field of formFieldsNoId) { _%>
  <%_ const { fieldName } = field; _%>
  <%_ if (field.fieldTypeTimed) { _%>
          <%- fieldName %>: convertDateTimeFromServer(<%- entityInstance %>Entity.<%- fieldName %>),
  <%_ } _%>
<%_ } _%>
<%_ for (const rel of persistableRelationships.filter(rel => !rel.otherEntity.embedded)) { _%>
  <%_ const otherEntityPkName = rel.otherEntity.primaryKey && rel.otherEntity.primaryKey.name || 'id';
      const { relationshipFieldName, relationshipFieldNamePlural } = rel;
  _%>
  <%_ if (rel.relationshipSerializePrimaryKeyOnly) { _%>
          <%- relationshipFieldNamePlural %>: <%- entityInstance %>Entity?.<%- relationshipFieldNamePlural %>,
  <%_ } else if (rel.collection) { _%>
          <%- relationshipFieldNamePlural %>: <%- entityInstance %>Entity?.<%- relationshipFieldNamePlural %>?.map(e => e.<%- otherEntityPkName %>.toString()),
  <%_ } else { _%>
          <%- relationshipFieldName %>: <%- entityInstance %>Entity?.<%- relationshipFieldName %>?.<%- otherEntityPkName %>,
  <%_ } _%>
<%_ } _%>
        };

  return (
    <div>
    <Row className="justify-content-center">
      <Col md="8">
        <h2 id="<%- i18nKeyPrefix %>.home.createOrEditLabel" data-cy="<%- entityNameCapitalized %>CreateUpdateHeading">
          <Translate contentKey="<%- i18nKeyPrefix %>.home.createOrEditLabel">Create or edit a <%- entityNameCapitalized %></Translate>
        </h2>
      </Col>
    </Row>
    <Row className="justify-content-center">
      <Col md="8">
        { loading ? <p>Loading...</p> :
        <ValidatedForm mode="all" defaultValues={defaultValues()} onSubmit={saveEntity}>
<%_ if (!builtInUserManagement && !userProvidedPrimaryKey) { _%>
          { !isNew &&
            <ValidatedField
              name="<%- primaryKey.fields[0].fieldName %>" required readOnly
              id="<%- entityFileName %>-<%- primaryKey.fields[0].fieldName %>"
              label={translate('<%- primaryKey.fields[0].propertyTranslationKey %>')}
              validate={{ required: true }}
            />
          }
<%_ } _%>
<%_ for (field of formFields) { _%>
  <%_ const { fieldType, fieldName, fieldNameHumanized } = field; _%>
  <%_ if (field.fieldTypeBinary && !field.blobContentTypeText) { _%>
          <ValidatedBlobField
  <%_ } else { _%>
          <ValidatedField
  <%_ } _%>
  <%_ if (enableTranslation) { _%>
            label={translate('<%- field.propertyTranslationKey %>')}
  <%_ } else { _%>
            label="<%- fieldNameHumanized %>"
  <%_ } _%>
            id="<%- entityFileName %>-<%- fieldName %>"
            name="<%- fieldName %>"
            data-cy="<%- fieldName %>"
  <%_ if (field.clientConstantsAsValues) { _%>
    <%_ if (userProvidedPrimaryKey && field.id) { _%>
            disabled={!isNew}
    <%_ } _%>
            type="select"
    <%_ if (field.collection) { _%>
            multiple
    <%_ } _%>
          >
            {<%- field.fieldName %>Values.map(value => (
              <option value={value} key={value}>
                {value}
              </option>
            ))}
          </ValidatedField>
  <%_ } else if (field.fieldTypeBoolean) { _%>
            check
            type="checkbox"
          />
  <%_ } else if (field.fieldTypeTimed) { _%>
            type="datetime-local"
            placeholder="YYYY-MM-DD HH:mm"
            <%- include('react_validators') %>
          />
  <%_ } else if (field.fieldTypeLocalDate) { _%>
            type="date"
            <%- include('react_validators') %>
          />
  <%_ } else if (field.fieldTypeLocalTime) { _%>
            type="time"
            placeholder="HH:mm"
            <%- include('react_validators') %>
          />
  <%_ } else if (field.fieldIsEnum) { _%>
            type="select"
          >
    <%_ const enumPrefix = `${frontendAppName}.${fieldType}`; _%>
          {<%- field.enumInstance %>Values.map(<%- field.enumInstance %> => (
              <option value={<%- field.enumInstance %>} key={<%- field.enumInstance %>}>
    <%_ if (enableTranslation) { _%>
                {translate("<%- enumPrefix %>."+<%- field.enumInstance %>)}
    <%_ } else { _%>
                {<%- field.enumInstance %>}
    <%_ } _%>
              </option>))}
          </ValidatedField>
  <%_ } else if (field.fieldTypeNumeric) { _%>
            type="text"
            <%- include('react_validators') %>
          />
  <%_ } else if (field.fieldTypeBinary) { _%>
    <%_ if (field.blobContentTypeText) { _%>
            inputTag="textarea"
            <%- include('react_validators') %>
          />
    <%_ } else { _%>
      <%_ if (field.blobContentTypeImage) { _%>
            isImage accept="image/*"
      <%_ } else { _%>
            openActionLabel={translate('entity.action.open')}
      <%_ } _%>
            <%- include('react_validators') %>
          />
    <%_ } _%>
  <%_ } else { _%>
    <%_ if (userProvidedPrimaryKey && field.id) { _%>
           readOnly={!isNew}
    <%_ } _%>
           type="text"
           <%- include('react_validators') %>
        />
  <%_ } _%>
  <%_ if (field.documentation) { _%>
          <OverlayTrigger overlay={<Tooltip>
    <%_ if (enableTranslation) { _%>
            <Translate contentKey="<%- i18nKeyPrefix %>.help.<%- fieldName %>"/>
    <%_ } else { _%>
            <%- field.documentation %>
    <%_ } _%>
          </Tooltip>}>
            <span id="<%- fieldName %>Label" className="d-inline-block">?</span>
          </OverlayTrigger>
  <%_ } _%>
<%_ } _%>
<%_ for (const rel of persistableRelationships.filter(rel => !rel.otherEntity.embedded)) { _%>
  <%_ const otherEntityPkName = rel.otherEntity.primaryKey && rel.otherEntity.primaryKey.name || 'id';
      const { relationshipName, relationshipNameHumanized, relationshipFieldName, relationshipFieldNamePlural, otherEntityField, relationshipRequired } = rel;
      const translationKey = rel.propertyTranslationKey;
  _%>
  <%_ if (rel.collection) { _%>
          <ValidatedField
    <%_ if (enableTranslation) { _%>
            label={translate('<%- translationKey %>')}
    <%_ } else { _%>
            label="<%- relationshipNameHumanized %>"
    <%_ } _%>
            id="<%- entityFileName %>-<%- relationshipName %>"
            data-cy="<%- relationshipFieldName %>"
            type="select"
            multiple
            name="<%- relationshipFieldNamePlural %>"
            >
    <%_ if (!rel.relationshipSerializePrimaryKeyOnly) { _%>
              <option value="" key="0" />
    <%_ } _%>
              {<%- rel.otherEntity.entityInstancePlural %>.map(otherEntity =>
                <option
                    value={otherEntity.<%- otherEntityPkName %>}
                    key={otherEntity.<%- otherEntityPkName %>}>
                    {otherEntity.<%- otherEntityField %>}
                </option>
              )}
          </ValidatedField>
  <%_ } else { _%>
          <ValidatedField
            id="<%- entityFileName %>-<%- relationshipName %>"
            name="<%- relationshipFieldName %>"
            data-cy="<%- relationshipFieldName %>"
    <%_ if (enableTranslation) { _%>
            label={translate('<%- translationKey %>')}
    <%_ } else { _%>
            label="<%- relationshipNameHumanized %>"
    <%_ } _%>
            type="select"
    <%_ if (relationshipRequired) { _%>
            required
    <%_ } _%>
          >
              <option value="" key="0" />
              {<%- rel.otherEntity.entityInstancePlural %>.map(otherEntity =>
                  <option
                    value={otherEntity.<%- otherEntityPkName %>}
                    key={otherEntity.<%- otherEntityPkName %>}>
                    {otherEntity.<%- otherEntityField %>}
                  </option>
              )}
          </ValidatedField>
    <%_ if (relationshipRequired) { _%>
            <FormText><Translate contentKey="entity.validation.required">This field is required.</Translate></FormText>
    <%_ } _%>
  <%_ } _%>
<%_ } _%>
          <Link id="cancel-save" data-cy="entityCreateCancelButton" to="/<%- entityPage %>" replace className="btn btn-secondary">
            <FontAwesomeIcon icon="ban" />&nbsp;
            <Translate contentKey="entity.action.cancel">Cancel</Translate>
          </Link>
          &nbsp;
          <Button variant="primary" id="save-entity" data-cy="entityCreateSaveButton" type="submit" disabled={updating}>
            <FontAwesomeIcon icon="save" />&nbsp;
            <Translate contentKey="entity.action.save">Save</Translate>
          </Button>
        </ValidatedForm>
        }
      </Col>
    </Row>
  </div>
  );
};

export default <%- entityReactName %>Update;
