import { ReactElement } from 'react';
import { Provider } from 'react-redux';
import { MemoryRouter } from 'react-router';

import { ReducersMapObject, <%- microfrontend || applicationTypeGateway ? 'combineReducers, ' : '' %>configureStore } from '@reduxjs/toolkit';
import { fireEvent, render } from '@testing-library/react';
import dayjs from 'dayjs';

import { APP_LOCAL_DATETIME_FORMAT } from 'app/config/constants';
import 'app/config/dayjs';
import entitiesReducers from 'app/entities/reducers';
import sharedReducers from 'app/shared/reducers';

/**
 * Renders an element within a router at the given location and a store of its own.
 */
export const renderWithStore = (element: ReactElement, location: string, preloadedState?: Record<string, unknown>) => {
  const store = configureStore({
<%_ if (microfrontend || applicationTypeGateway) { _%>
    reducer: { ...sharedReducers, <%- lowercaseBaseName %>: combineReducers(entitiesReducers as ReducersMapObject) } as ReducersMapObject,
<%_ } else { _%>
    reducer: { ...sharedReducers, ...entitiesReducers } as ReducersMapObject,
<%_ } _%>
    preloadedState,
    middleware: getDefaultMiddleware => getDefaultMiddleware({ immutableCheck: false, serializableCheck: false }),
  });
<%_ if (microfrontend || applicationTypeGateway) { _%>
  Object.assign(store, { injectReducer: () => undefined });
<%_ } _%>
  return {
    store,
    ...render(
      <Provider store={store}>
        <MemoryRouter initialEntries={[location]}>{element}</MemoryRouter>
      </Provider>,
    ),
  };
};

const toInputValue = (input: HTMLInputElement, value: unknown) => {
  if (dayjs.isDayjs(value)) {
    return value.format(input.type === 'date' ? 'YYYY-MM-DD' : APP_LOCAL_DATETIME_FORMAT);
  }
  return String(value);
};

/**
 * Fills the fields of a form with the values of the same name.
 */
export const fillForm = (container: HTMLElement, values: Record<string, unknown>) => {
  for (const [name, value] of Object.entries(values)) {
    const input = container.querySelector<HTMLInputElement>(`[name="${name}"]`);
    if (input && input.type !== 'file' && !(input as unknown as HTMLSelectElement).multiple) {
      fireEvent.change(input, { target: { value: toInputValue(input, value) } });
    }
  }
};
