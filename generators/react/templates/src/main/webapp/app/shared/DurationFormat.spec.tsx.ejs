import { afterEach, describe, expect, it } from 'vitest';
import { TranslatorContext } from 'react-jhipster';

import { render } from '@testing-library/react';

import 'app/config/dayjs';

import { DurationFormat } from './DurationFormat';

describe('DurationFormat', () => {
  const locale = TranslatorContext.context.locale;

  afterEach(() => {
    TranslatorContext.context.locale = locale;
  });

  it('should show a duration in the locale given', () => {
    const { container } = render(<DurationFormat value="PT1H" locale="en" />);

    expect(container.textContent).toBe('an hour');
  });

  it('should show a duration in the current locale, or in english without one', () => {
    TranslatorContext.context.locale = 'en';
    expect(render(<DurationFormat value="PT1H" />).container.textContent).toBe('an hour');

    TranslatorContext.context.locale = null;
    expect(render(<DurationFormat value="PT1H" />).container.textContent).toBe('an hour');
  });

  it('should show nothing for a blank value when asked to', () => {
    expect(render(<DurationFormat value="" blankOnInvalid />).container.textContent).toBe('');
  });
});
