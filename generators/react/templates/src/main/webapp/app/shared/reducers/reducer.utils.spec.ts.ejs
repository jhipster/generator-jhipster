import { describe, expect, it } from 'vitest';

import { AxiosError } from 'axios';

import { isFulfilledAction, isRejectedAction, serializeAxiosError } from './reducer.utils';

describe('reducer utils', () => {
  it('should tell the rejected and the fulfilled actions', () => {
    expect(isRejectedAction({ type: 'entity/fetch/rejected' })).toBe(true);
    expect(isRejectedAction({ type: 'entity/fetch/fulfilled' })).toBe(false);
    expect(isFulfilledAction({ type: 'entity/fetch/fulfilled' })).toBe(true);
    expect(isFulfilledAction({ type: 'entity/fetch/pending' })).toBe(false);
  });

  it('should keep an axios error', () => {
    const error = new AxiosError('Request failed');

    expect(serializeAxiosError(error)).toBe(error);
  });

  it('should keep the string properties of an error', () => {
    expect(serializeAxiosError({ name: 'Error', message: 'Failed', stack: 1 })).toEqual({ name: 'Error', message: 'Failed' });
  });

  it('should take any other value as the message', () => {
    expect(serializeAxiosError('Failed')).toEqual({ message: 'Failed' });
    expect(serializeAxiosError(null)).toEqual({ message: 'null' });
  });
});
