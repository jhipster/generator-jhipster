import { AUTHENTICATION_TOKEN_KEY } from 'app/shared/jhipster/constants';

/** Removes the authentication token from the browser. */
export const clearAuthenticationToken = (): void => {
  sessionStorage.removeItem(AUTHENTICATION_TOKEN_KEY);
  localStorage.removeItem(AUTHENTICATION_TOKEN_KEY);
};

/** Stores the authentication token for the session of the browser, or beyond it to remember the user. */
export const storeAuthenticationToken = (authenticationToken: string, rememberMe?: boolean): void => {
  clearAuthenticationToken();
  if (rememberMe) {
    localStorage.setItem(AUTHENTICATION_TOKEN_KEY, authenticationToken);
  } else {
    sessionStorage.setItem(AUTHENTICATION_TOKEN_KEY, authenticationToken);
  }
};

/** The authentication token the browser stores, if any. */
export const getAuthenticationToken = (): string | null =>
  localStorage.getItem(AUTHENTICATION_TOKEN_KEY) ?? sessionStorage.getItem(AUTHENTICATION_TOKEN_KEY);
