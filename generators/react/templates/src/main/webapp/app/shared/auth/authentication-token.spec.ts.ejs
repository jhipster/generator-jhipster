import { beforeEach, describe, expect, it } from 'vitest';

import { AUTHENTICATION_TOKEN_KEY } from 'app/shared/jhipster/constants';

import { clearAuthenticationToken, getAuthenticationToken, storeAuthenticationToken } from './authentication-token';

describe('authentication token', () => {
  beforeEach(() => {
    sessionStorage.clear();
    localStorage.clear();
  });

  it('should have no token before a login', () => {
    expect(getAuthenticationToken()).toBeNull();
  });

  it('should store the token as text for the session of the browser', () => {
    storeAuthenticationToken('token');

    expect(sessionStorage.getItem(AUTHENTICATION_TOKEN_KEY)).toBe('token');
    expect(localStorage.getItem(AUTHENTICATION_TOKEN_KEY)).toBeNull();
    expect(getAuthenticationToken()).toBe('token');
  });

  it('should store the token as text beyond the session to remember the user', () => {
    storeAuthenticationToken('session token');
    storeAuthenticationToken('token', true);

    expect(localStorage.getItem(AUTHENTICATION_TOKEN_KEY)).toBe('token');
    expect(sessionStorage.getItem(AUTHENTICATION_TOKEN_KEY)).toBeNull();
    expect(getAuthenticationToken()).toBe('token');
  });

  it('should clear the token of both storages', () => {
    sessionStorage.setItem(AUTHENTICATION_TOKEN_KEY, 'token');
    localStorage.setItem(AUTHENTICATION_TOKEN_KEY, 'token');

    clearAuthenticationToken();

    expect(getAuthenticationToken()).toBeNull();
  });
});
