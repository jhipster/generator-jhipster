import { createAsyncThunk, createSlice, isPending, isRejected } from '@reduxjs/toolkit';
import axios from 'axios';

import { AppThunk } from 'app/config/store';
<%_ if (withAdminUi) { _%>
import { configurationEndpoints, toConfiguration } from 'app/shared/jhipster/configuration';
import { type ConfigurationSection } from 'app/shared/jhipster/configuration.model';
import { healthEndpoint, toHealthChecks } from 'app/shared/jhipster/health';
import { type HealthCheck } from 'app/shared/jhipster/health.model';
import { loggersEndpoint, toLevelChange, toLogs } from 'app/shared/jhipster/logs';
import { type Level, type Log } from 'app/shared/jhipster/logs.model';
import { metricsEndpoints, toMetrics } from 'app/shared/jhipster/metrics';
import { type MetricsSection } from 'app/shared/jhipster/metrics.model';
<%_ } _%>
import { serializeAxiosError } from 'app/shared/reducers/reducer.utils';

const initialState = {
  loading: false,
  errorMessage: null as string | null,
<%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
  gateway: {
    routes: [] as any[],
  },
<%_ } _%>
<%_ if (withAdminUi) { _%>
  logs: {
    loggers: [] as Log[],
  },
  health: [] as HealthCheck[],
  metrics: [] as MetricsSection[],
  configuration: [] as ConfigurationSection[],
<%_ } _%>
<%_ if (communicationSpringWebsocket) { _%>
  tracker: {
    activities: [] as { sessionId: string; page: string }[],
  },
<%_ } _%>
  totalItems: 0,
};

export type AdministrationState = Readonly<typeof initialState>;

// Actions
<%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
export const getGatewayRoutes = createAsyncThunk('administration/fetch_gateway_route', async () => axios.get<any>('api/gateway/routes'), {
  serializeError: serializeAxiosError,
});
<%_ } _%>

<%_ if (withAdminUi) { _%>
export const getSystemHealth = createAsyncThunk(
  'administration/fetch_health',
  // An unhealthy application answers with 503 and its health.
  async () => axios.get<unknown>(healthEndpoint, { validateStatus: status => status === 200 || status === 503 }),
  {
    serializeError: serializeAxiosError,
  },
);

export const getSystemMetrics = createAsyncThunk(
  'administration/fetch_metrics',
  async () => {
    const responses = await Promise.all(metricsEndpoints.map(endpoint => axios.get(endpoint)));
    return toMetrics(responses.map(({ data }) => data));
  },
  {
    serializeError: serializeAxiosError,
  },
);

export const getLoggers = createAsyncThunk('administration/fetch_logs', async () => axios.get<unknown>(loggersEndpoint), {
  serializeError: serializeAxiosError,
});

export const setLoggers = createAsyncThunk(
  'administration/fetch_logs_change_level',
  async ({ name, level }: { name: string; level: Level }) => {
    const { url, body } = toLevelChange(name, level);
    return axios.post(url, body);
  },
  {
    serializeError: serializeAxiosError,
  },
);

export const changeLogLevel: (name: string, level: Level) => AppThunk = (name, level) => async dispatch => {
  await dispatch(setLoggers({ name, level }));
  dispatch(getLoggers());
};

export const getConfiguration = createAsyncThunk(
  'administration/fetch_configuration',
  async () => {
    const responses = await Promise.all(configurationEndpoints.map(endpoint => axios.get(endpoint)));
    return toConfiguration(responses.map(({ data }) => data));
  },
  {
    serializeError: serializeAxiosError,
  },
);
<%_ } _%>

export const AdministrationSlice = createSlice({
  name: 'administration',
  initialState,
  reducers: {
<%_ if (communicationSpringWebsocket) { _%>
    websocketActivityMessage(state, action) {
      // filter out activities from the same session
      const uniqueActivities = state.tracker.activities.filter(
        (activity: { sessionId: string }) => activity.sessionId !== action.payload.sessionId,
      );
      // remove any activities with the page of logout
      const activities = [...uniqueActivities, action.payload].filter((activity: { page: string }) => activity.page !== 'logout');
      state.tracker = { activities };
    },
<%_ } _%>
  },
  extraReducers(<%- withAdminUi || applicationTypeGateway && gatewayServicesApiAvailable ? 'builder' : '' %>) {
<%_ if (withAdminUi || applicationTypeGateway && gatewayServicesApiAvailable) { _%>
    builder
  <%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
      .addCase(getGatewayRoutes.fulfilled, (state, action) => {
        state.loading = false;
        state.gateway = {
          routes: action.payload.data,
        };
      })
  <%_ } _%>
  <%_ if (withAdminUi) { _%>
      .addCase(getSystemHealth.fulfilled, (state, action) => {
        state.loading = false;
        state.health = toHealthChecks(action.payload.data);
      })
      .addCase(getSystemMetrics.fulfilled, (state, action) => {
        state.loading = false;
        state.metrics = action.payload;
      })
      .addCase(getLoggers.fulfilled, (state, action) => {
        state.loading = false;
        state.logs = {
          loggers: toLogs(action.payload.data),
        };
      })
      .addCase(getConfiguration.fulfilled, (state, action) => {
        state.loading = false;
        state.configuration = action.payload;
      })
  <%_ } _%>
      .addMatcher(
        isPending(
  <%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
          getGatewayRoutes,
  <%_ } _%>
  <%_ if (withAdminUi) { _%>
          getSystemHealth,
          getSystemMetrics,
          getLoggers,
          getConfiguration
  <%_ } _%>
        ),
        state => {
          state.errorMessage = null;
          state.loading = true;
        },
      )
      .addMatcher(
        isRejected(
  <%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
          getGatewayRoutes,
  <%_ } _%>
  <%_ if (withAdminUi) { _%>
          getSystemHealth,
          getSystemMetrics,
          getLoggers,
          getConfiguration
  <%_ } _%>
        ),
        (state, action) => {
          state.errorMessage = action.error.message!;
          state.loading = false;
        },
      );
<%_ } _%>
  },
});

<%_ if (communicationSpringWebsocket) { _%>
export const { websocketActivityMessage } = AdministrationSlice.actions;
<%_ } _%>

// Reducer
export default AdministrationSlice.reducer;
