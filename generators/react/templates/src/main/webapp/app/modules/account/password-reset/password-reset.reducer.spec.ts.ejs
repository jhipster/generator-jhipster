import { beforeEach, describe, expect, it, vi } from 'vitest';

import axios from 'axios';

import passwordReset, { handlePasswordResetFinish, handlePasswordResetInit, reset } from './password-reset.reducer';

describe('Password reset reducer tests', () => {
  const initialState = {
    loading: false,
    resetPasswordSuccess: false,
    resetPasswordFailure: false,
    successMessage: null,
  };

  it('should return the initial state', () => {
    expect(passwordReset(undefined, { type: '' })).toEqual(initialState);
  });

  it('should detect a request', () => {
    expect(passwordReset(undefined, { type: handlePasswordResetInit.pending.type })).toMatchObject({ loading: true });
    expect(passwordReset(undefined, { type: handlePasswordResetFinish.pending.type })).toMatchObject({ loading: true });
  });

  it('should detect a success', () => {
    expect(passwordReset(undefined, { type: handlePasswordResetInit.fulfilled.type })).toMatchObject({
      resetPasswordSuccess: true,
      successMessage: expect.any(String),
    });
    expect(passwordReset(undefined, { type: handlePasswordResetFinish.fulfilled.type })).toMatchObject({
      resetPasswordSuccess: true,
      successMessage: expect.any(String),
    });
  });

  it('should detect a failure', () => {
    expect(passwordReset(undefined, { type: handlePasswordResetInit.rejected.type })).toMatchObject({ resetPasswordFailure: true });
    expect(passwordReset(undefined, { type: handlePasswordResetFinish.rejected.type })).toMatchObject({ resetPasswordFailure: true });
  });

  it('should reset the state', () => {
    expect(passwordReset({ ...initialState, loading: true }, reset())).toEqual(initialState);
  });

  describe('Actions', () => {
    const dispatch = vi.fn();
    const getState = vi.fn();

    beforeEach(() => {
      axios.post = vi.fn().mockResolvedValue({});
    });

    it('posts the mail on init', async () => {
      const result = await handlePasswordResetInit('user@localhost')(dispatch, getState, {});

      expect(handlePasswordResetInit.fulfilled.match(result)).toBe(true);
      expect(axios.post).toHaveBeenCalledWith(expect.stringContaining('/init'), 'user@localhost', expect.any(Object));
    });

    it('posts the new password on finish', async () => {
      const data = { key: 'key', newPassword: 'password' };
      const result = await handlePasswordResetFinish(data)(dispatch, getState, {});

      expect(handlePasswordResetFinish.fulfilled.match(result)).toBe(true);
      expect(axios.post).toHaveBeenCalledWith(expect.stringContaining('/finish'), data);
    });
  });
});
