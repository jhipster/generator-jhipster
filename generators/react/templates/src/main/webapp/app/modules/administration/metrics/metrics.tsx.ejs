import { useEffect, useMemo, useState } from 'react';
import { Button, Col, ProgressBar, Row, Table } from 'react-bootstrap';
import { ThreadsModal, Translate<%- enableTranslation ? ', translate' : '' %> } from 'react-jhipster';

import { faSync } from '@fortawesome/free-solid-svg-icons';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';

import { useAppDispatch, useAppSelector } from 'app/config/store';
import { type Label } from 'app/shared/jhipster/label';
import { type MetricGauge, toMetrics } from 'app/shared/jhipster/metrics';
import { getSystemMetrics, getSystemThreadDump } from '../administration.reducer';

<%_ if (enableTranslation) { _%>
const labelText = ({ text, translationKey }: Label): string => {
  const translated: string | undefined = translationKey && translate(translationKey);
  return !translated || translated.startsWith('translation-not-found') ? text : translated;
};
<%_ } else { _%>
const labelText = ({ text }: Label): string => text;
<%_ } _%>

const Gauge = ({ gauge }: { gauge: MetricGauge }) => (
  <ProgressBar animated={false} striped now={gauge.percent} label={gauge.text} variant={gauge.status} />
);

export const MetricsPage = () => {
  const dispatch = useAppDispatch();
  const metrics = useAppSelector(state => state.administration.metrics);
  const isFetching = useAppSelector(state => state.administration.loading);
  const threadDump = useAppSelector(state => state.administration.threadDump);
  const [showThreadDump, setShowThreadDump] = useState(false);

  const sections = useMemo(
    () => (metrics?.jvm && threadDump?.threads ? toMetrics(metrics, threadDump.threads) : []),
    [metrics, threadDump],
  );

  useEffect(() => {
    dispatch(getSystemMetrics());
    dispatch(getSystemThreadDump());
  }, []);

  const getMetrics = () => {
    if (!isFetching) {
      dispatch(getSystemMetrics());
      dispatch(getSystemThreadDump());
    }
  };

  return (
    <div>
      <h2>
        <span id="metrics-page-heading" data-cy="metricsPageHeading">
          <Translate contentKey="metrics.title">Application Metrics</Translate>
        </span>
        <Button onClick={getMetrics} variant="primary" className="float-end" disabled={isFetching}>
          <FontAwesomeIcon icon={faSync} />
          &nbsp;
          <Translate component="span" contentKey="metrics.refresh.button">
            Refresh
          </Translate>
        </Button>
      </h2>

      {isFetching && (
        <div className="alert alert-info">
          <Translate contentKey="metrics.updating">Updating...</Translate>
        </div>
      )}

      {sections.map(section => (
        <div key={section.id}>
          <h3 id={section.id}>{labelText(section.label)}</h3>

          {section.blocks.length > 0 && (
            <Row>
              {section.blocks.map((block, blockIndex) => (
                <Col md="4" key={blockIndex}>
                  {block.label && <h4>{labelText(block.label)}</h4>}

                  {block.items.map((item, itemIndex) => (
                    <div key={itemIndex}>
                      <div className="d-flex flex-wrap justify-content-between column-gap-2">
                        <span>{labelText(item.label)}</span>
                        <span>{item.value}</span>
                      </div>
                      {item.note && <div>{item.note}</div>}
                      {item.gauge && <Gauge gauge={item.gauge} />}
                    </div>
                  ))}

                  {block.threadDump && (
                    <Button className="hand mt-2" size="sm" variant="primary" onClick={() => setShowThreadDump(true)}>
                      <span>Expand</span>
                    </Button>
                  )}
                </Col>
              ))}
            </Row>
          )}

          {section.tables.map((table, tableIndex) => (
            <Table key={tableIndex} responsive striped aria-describedby={section.id}>
              <thead>
                <tr>
                  {table.columns.map((column, columnIndex) => (
                    <th key={columnIndex} scope="col" className={column.numeric ? 'text-end' : undefined}>
                      {labelText(column.label)}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {table.rows.map((row, rowIndex) => (
                  <tr key={rowIndex}>
                    {row.map((cell, cellIndex) => (
                      <td key={cellIndex} className={table.columns[cellIndex].numeric ? 'text-end' : undefined}>
                        {cell.gauge ? <Gauge gauge={cell.gauge} /> : cell.text}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </Table>
          ))}
        </div>
      ))}

      <ThreadsModal showModal={showThreadDump} handleClose={() => setShowThreadDump(false)} threadDump={threadDump} />
    </div>
  );
};

export default MetricsPage;
