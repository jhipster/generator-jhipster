import { describe, expect, it, vi } from 'vitest';
import { fireEvent, render, screen } from '@testing-library/react';
import { MemoryRouter, Route, Routes } from 'react-router';
import { configureStore } from '@reduxjs/toolkit';
import { Provider } from 'react-redux';

import { deleteUser, getUser } from './user-management.reducer';
import UserManagementDeleteDialog from './user-management-delete-dialog';

vi.mock('./user-management.reducer', () => ({
  __esModule: true,
  default: (state = { user: { login: 'user' } }) => state,
  getUser: vi.fn(() => ({ type: 'userManagement/getUser' })),
  deleteUser: vi.fn(() => ({ type: 'userManagement/deleteUser' })),
}));

const store = configureStore({
  reducer: {
    userManagement: (state = { user: { login: 'user' } }) => state,
  },
});

const renderDialog = () =>
  render(
    <Provider store={store}>
      <MemoryRouter initialEntries={['/admin/user-management/user/delete']}>
        <Routes>
          <Route path="/admin/user-management" element={<div>user-management-list</div>} />
          <Route path="/admin/user-management/:login/delete" element={<UserManagementDeleteDialog />} />
        </Routes>
      </MemoryRouter>
    </Provider>,
  );

describe('UserManagementDeleteDialog', () => {
  it('should load the user on init', () => {
    renderDialog();

    expect(getUser).toHaveBeenCalledWith('user');
  });

  it('should navigate to the user management list after confirming the deletion', () => {
    renderDialog();

    fireEvent.click(document.querySelector('[data-cy="entityConfirmDeleteButton"]')!);

    expect(deleteUser).toHaveBeenCalledWith('user');
    expect(screen.getByText('user-management-list')).toBeTruthy();
  });
});
