import { useEffect, useState } from 'react';
import { Badge, Col, FormControl, Row, Table } from 'react-bootstrap';
import { Translate } from 'react-jhipster';

import { useAppDispatch, useAppSelector } from 'app/config/store';
import { getConfiguration } from '../administration.reducer';

export const ConfigurationPage = () => {
  const [filter, setFilter] = useState('');
  const dispatch = useAppDispatch();

  const sections = useAppSelector(state => state.administration.configuration);

  useEffect(() => {
    dispatch(getConfiguration());
  }, []);

  const changeFilter = evt => setFilter(evt.target.value);

  const filterFn = row => row.key.toUpperCase().includes(filter.toUpperCase());

  return (
    <div>
      <h2 id="configuration-page-heading" data-cy="configurationPageHeading">
        <Translate contentKey="configuration.title">Configuration</Translate>
      </h2>
      <span>
        <Translate contentKey="configuration.filter">Filter</Translate>
      </span>{' '}
      <FormControl type="search" value={filter} onChange={changeFilter} name="search" id="search" />
      {sections.map(section => (
        <div key={section.label}>
          <h3>{section.label}</h3>
          <Table className="table table-striped table-bordered table-responsive d-table">
            <thead>
              <tr>
                <th className="w-40">{section.columns[0]}</th>
                <th className="w-60">{section.columns[1]}</th>
              </tr>
            </thead>
            <tbody>
              {section.rows.filter(filterFn).map(row => (
                <tr key={row.key}>
                  <td className="break">{row.key}</td>
                  <td className="break">
                    {row.properties ? (
                      row.properties.map(property => (
                        <Row key={property.key}>
                          <Col md="4">{property.key}</Col>
                          <Col md="8">
                            <Badge className="float-end bg-secondary break">{property.value}</Badge>
                          </Col>
                        </Row>
                      ))
                    ) : (
                      <span className="float-end badge bg-secondary break">{row.value}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      ))}
    </div>
  );
};

export default ConfigurationPage;
