import { describe, expect, it, vi } from 'vitest';

import axios from 'axios';

<%_ if (authenticationTypeJwt) { _%>
import { AUTHENTICATION_TOKEN_KEY } from 'app/shared/jhipster/constants';
<%_ } _%>

import setupAxiosInterceptors from './axios-interceptor';

describe('Axios Interceptor', () => {
  describe('setupAxiosInterceptors', () => {
    const onUnauthenticated = vi.fn();
    setupAxiosInterceptors(onUnauthenticated);

    it('onRequestSuccess is called on fulfilled request', () => {
      expect((axios.interceptors.request as any).handlers[0].fulfilled({ data: 'foo', url: '/test' })).toMatchObject({
        data: 'foo',
      });
    });
    it('onResponseSuccess is called on fulfilled response', () => {
      expect((axios.interceptors.response as any).handlers[0].fulfilled({ data: 'foo' })).toEqual({ data: 'foo' });
    });
    it('onResponseError is called on rejected response', async () => {
      const rejectError = {
        response: {
          statusText: 'NotFound',
          status: 401,
          data: { message: 'Page not found' },
        },
      };
      await expect((axios.interceptors.response as any).handlers[0].rejected(rejectError)).rejects.toEqual(rejectError);
      expect(onUnauthenticated).toHaveBeenCalledTimes(1);
    });
    it('onResponseError does not call onUnauthenticated for other errors', async () => {
      onUnauthenticated.mockClear();
      const serverError = { status: 500 };
      await expect((axios.interceptors.response as any).handlers[0].rejected(serverError)).rejects.toBe(serverError);
      const networkError = {};
      await expect((axios.interceptors.response as any).handlers[0].rejected(networkError)).rejects.toBe(networkError);
      expect(onUnauthenticated).not.toHaveBeenCalled();
    });
<%_ if (authenticationTypeJwt) { _%>
    it('onRequestSuccess adds the token of the session', () => {
      sessionStorage.setItem(AUTHENTICATION_TOKEN_KEY, 'token');
      expect((axios.interceptors.request as any).handlers[0].fulfilled({ headers: {} })).toMatchObject({
        headers: { Authorization: 'Bearer token' },
      });
      sessionStorage.removeItem(AUTHENTICATION_TOKEN_KEY);
    });
<%_ } _%>
  });
});
