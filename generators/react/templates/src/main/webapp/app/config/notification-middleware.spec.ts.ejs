import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';
<%_ if (enableTranslation) { _%>
import { TranslatorContext } from 'react-jhipster';
<%_ } _%>

import { configureStore } from '@reduxjs/toolkit';
import { toast } from 'react-toastify';

import { MESSAGE_ALERT_HEADER_NAME, MESSAGE_ERROR_HEADER_NAME, MESSAGE_PARAM_HEADER_NAME } from 'app/shared/jhipster/constants';
import { CONSTRAINT_VIOLATION_TYPE, INVALID_PASSWORD_TYPE } from 'app/shared/jhipster/error.constants';
import { ProblemWithMessageType } from 'app/shared/jhipster/problem-details';

import notificationMiddleware, { getFieldErrorMessage } from './notification-middleware';

vi.mock('react-toastify', () => ({
  toast: {
    error: vi.fn(),
    success: vi.fn(),
  },
}));

describe('Notification Middleware', () => {
  let store: ReturnType<typeof makeStore>;

  const SUCCESS_TYPE = 'SUCCESS/fulfilled';
  const ERROR_TYPE = 'ERROR/rejected';

  // Default action for use in local tests
  const DEFAULT = {
    type: SUCCESS_TYPE,
    payload: 'foo',
  };
  const HEADER_SUCCESS = {
    type: SUCCESS_TYPE,
    payload: {
      status: 201,
      statusText: 'Created',
      headers: { [MESSAGE_ALERT_HEADER_NAME]: 'foo.created', [MESSAGE_PARAM_HEADER_NAME]: 'foo' },
    },
  };

  const DEFAULT_ERROR = {
    type: ERROR_TYPE,
    error: { message: 'foo' },
  };
  const VALIDATION_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        data: {
          type: CONSTRAINT_VIOLATION_TYPE,
          title: 'Method argument not valid',
          status: 400,
          path: '/api/foos',
          message: 'error.validation',
          fieldErrors: [{ objectName: 'foos', field: 'minField', message: 'must be greater than or equal to 1', code: 'Min' }],
        },
        status: 400,
        statusText: 'Bad Request',
        headers: { expires: '0' },
      },
    },
  };
  const HEADER_ERRORS = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        status: 400,
        statusText: 'Bad Request',
        headers: { [MESSAGE_ERROR_HEADER_NAME]: 'foo.creation', [MESSAGE_PARAM_HEADER_NAME]: 'foo' },
      },
    },
  };
  const NOT_FOUND_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        data: {
          status: 404,
          message: 'Not found',
        },
        status: 404,
      },
    },
  };
  const NO_SERVER_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        status: 0,
      },
    },
  };
  const GENERIC_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        data: {
          message: 'Error',
        },
      },
    },
  };
  const LOGIN_REJECTED_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        data: '',
        config: {
          url: 'api/authenticate',
        },
        status: 401,
      },
    },
  };

  const TITLE_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        data: {
          title: 'Incorrect password',
          status: 400,
          type: INVALID_PASSWORD_TYPE,
        },
        status: 400,
      },
    },
  };

  const STRING_DATA_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        data: 'Incorrect password string',
        status: 400,
      },
    },
  };

  const UNKNOWN_400_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
      response: {
        status: 400,
      },
    },
  };

  const UNKNOWN_ERROR = {
    type: ERROR_TYPE,
    error: {
      isAxiosError: true,
    },
  };

  const makeStore = () =>
    configureStore({
      reducer: (state = {}) => state,
      middleware: getDefaultMiddleware => getDefaultMiddleware().concat(notificationMiddleware),
    });

<%_ if (enableTranslation) { _%>
  beforeAll(() => {
    TranslatorContext.registerTranslations('<%- nativeLanguage %>', {});
    // As the application does, a missing key is not rendered as the given text.
    TranslatorContext.setRenderInnerTextForMissingKeys(false);
  });

  afterAll(() => {
    TranslatorContext.setRenderInnerTextForMissingKeys(true);
  });

<%_ } _%>
  beforeEach(() => {
    store = makeStore();
    // ignore console errors
    vi.spyOn(globalThis.console, 'error').mockImplementation(() => {});
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('should not trigger a toast message but should return action', () => {
    expect(store.dispatch(DEFAULT).payload).toEqual('foo');
    expect(toast.error).not.toHaveBeenCalled();
    expect(toast.success).not.toHaveBeenCalled();
  });

  it('should trigger a success toast message for header alerts', () => {
    expect(store.dispatch(HEADER_SUCCESS).payload.status).toEqual(201);
    expect(toast.success).toHaveBeenCalledWith(expect.stringContaining('foo.created'));
  });

  it('should trigger an error toast message and return error', () => {
    expect(store.dispatch(DEFAULT_ERROR).error.message).toEqual('foo');
    expect(toast.error).toHaveBeenCalledWith('foo');
  });

  it('should trigger an error toast message and return error for generic message', () => {
    expect(store.dispatch(GENERIC_ERROR).error.response.data.message).toEqual('Error');
    expect(toast.error).toHaveBeenCalledWith('Error');
  });

  it('should trigger an error toast message and return error for 400 response code', () => {
    expect(store.dispatch(VALIDATION_ERROR).error.response.data.message).toEqual('error.validation');
    expect(toast.error).toHaveBeenCalledWith('<%- enableTranslation ? 'minField' : 'MinField' %>: must be greater than or equal to 1');
  });

  it('should trigger an error toast message and return error for 404 response code', () => {
    expect(store.dispatch(NOT_FOUND_ERROR).error.response.data.message).toEqual('Not found');
    expect(toast.error).toHaveBeenCalledWith('Not found');
  });

  it('should trigger an error toast message and return error for 0 response code', () => {
    expect(store.dispatch(NO_SERVER_ERROR).error.response.status).toEqual(0);
    expect(toast.error).toHaveBeenCalledWith('Server not reachable');
  });

  it('should not trigger a toast message for an entity not found, whose screen leaves for the page not found', () => {
    store.dispatch({ type: 'foo/fetch_entity/rejected', error: { isAxiosError: true, config: { url: 'api/foos/1' }, response: { status: 404, data: {} } } });
    expect(toast.error).not.toHaveBeenCalled();
  });

  it('should trigger an access denied toast message for 403 response code', () => {
    store.dispatch({ type: ERROR_TYPE, error: { isAxiosError: true, config: { url: 'api/foos' }, response: { status: 403, data: '' } } });
    expect(toast.error).toHaveBeenCalledWith('You are not authorized to access this page.');
  });

  it('should trigger an error toast message for a network error without response', () => {
    store.dispatch({ type: ERROR_TYPE, error: { isAxiosError: true, code: 'ERR_NETWORK', message: 'Network Error', config: { url: 'api/foos' } } });
    expect(toast.error).toHaveBeenCalledWith('Server not reachable');
  });

  it('should trigger an error toast message and return error for headers containing errors', () => {
    expect(store.dispatch(HEADER_ERRORS).error.response.status).toEqual(400);
    expect(toast.error).toHaveBeenCalledWith(expect.stringContaining('foo.creation'));
  });

  it('should not trigger an error toast message and return error for 401 response code', () => {
    expect(store.dispatch(LOGIN_REJECTED_ERROR).error.response.status).toEqual(401);
    expect(toast.error).not.toHaveBeenCalled();
    expect(toast.success).not.toHaveBeenCalled();
  });

  it('should trigger an error toast message with the problem title and return error for 400 response code', () => {
    expect(store.dispatch(TITLE_ERROR).error.response.status).toEqual(400);
    expect(toast.error).toHaveBeenCalledWith('Incorrect password');
  });

  it('should trigger an error toast message and return error for string in data', () => {
    expect(store.dispatch(STRING_DATA_ERROR).error.response.status).toEqual(400);
    expect(toast.error).toHaveBeenCalledWith('Incorrect password string');
  });

  it('should trigger an error toast message and return error for unknown 400 error', () => {
    expect(store.dispatch(UNKNOWN_400_ERROR).error.response.status).toEqual(400);
    expect(toast.error).toHaveBeenCalledWith('Unknown error!');
  });

  it('should trigger an error toast message and return error for unknown error', () => {
    expect(store.dispatch(UNKNOWN_ERROR).error.isAxiosError).toEqual(true);
    expect(toast.error).toHaveBeenCalledWith('Unknown error!');
  });

  it('should not trigger a toast message for headers without alert', () => {
    store.dispatch({ type: SUCCESS_TYPE, payload: { headers: { expires: '0' } } });
    expect(toast.success).not.toHaveBeenCalled();
  });

  it('should trigger an error toast message for each invalid field', () => {
    store.dispatch({
      type: ERROR_TYPE,
      error: {
        isAxiosError: true,
        response: {
          status: 400,
          data: {
            type: CONSTRAINT_VIOLATION_TYPE,
            message: 'error.validation',
            fieldErrors: [{ objectName: 'foos', field: 'name', message: 'NotNull' }],
          },
        },
      },
    });
    expect(toast.error).toHaveBeenCalledWith('<%- enableTranslation ? 'name' : 'Name' %>: NotNull');
  });

<%_ if (enableTranslation) { _%>
  it('should name the field of a user by the key of the user management', () => {
    const { locale } = TranslatorContext.context;
    TranslatorContext.registerTranslations('<%- nativeLanguage %>', { userManagement: { login: 'Login' }, error: { NotNull: 'Field {{ fieldName }} cannot be empty!' } });
    TranslatorContext.setLocale('<%- nativeLanguage %>');
    store.dispatch({
      type: ERROR_TYPE,
      error: {
        isAxiosError: true,
        response: {
          status: 400,
          data: {
            type: ConstraintViolationType,
            message: 'error.validation',
            fieldErrors: [{ objectName: 'userManagement', field: 'login', message: 'must not be null', code: 'NotNull' }],
          },
        },
      },
    });
    TranslatorContext.setLocale(locale as string);
    expect(toast.error).toHaveBeenCalledWith('Field Login cannot be empty!');
  });

<%_ } _%>
  it('should trigger an error toast message for each invalid field of a constraint violation', () => {
    store.dispatch({
      type: ERROR_TYPE,
      error: {
        isAxiosError: true,
        response: {
          status: 400,
          data: {
            type: ConstraintViolationType,
            status: 400,
            message: 'error.validation',
            detail: 'Unexpected runtime exception',
            fieldErrors: [
              { objectName: 'foos', field: 'name', message: 'must not be null', code: 'NotNull' },
              { objectName: 'foos', field: 'name', message: 'must match "^[A-Z].*$"', code: 'Pattern' },
            ],
          },
        },
      },
    });
    expect(toast.error).toHaveBeenCalledTimes(2);
    expect(toast.error).toHaveBeenCalledWith('<%- enableTranslation ? 'name' : 'Name' %>: must not be null');
    expect(toast.error).toHaveBeenCalledWith('<%- enableTranslation ? 'name' : 'Name' %>: must match "^[A-Z].*$"');
  });

  it('should give the field and the message of the server for a field error without translation', () => {
    expect(getFieldErrorMessage({ objectName: 'foos', field: 'name', message: 'must match "^[A-Z].*$"', code: 'Pattern' })).toBe(
      '<%- enableTranslation ? 'name' : 'Name' %>: must match "^[A-Z].*$"',
    );
  });

  it('should trigger a success toast message for header messages', () => {
    store.dispatch({ type: SUCCESS_TYPE, payload: { headers: { [MESSAGE_ALERT_HEADER_NAME]: 'A foo is created' } } });
    expect(toast.success).toHaveBeenCalledWith('A foo is created');
  });

  it('should trigger an error toast message for header messages', () => {
    store.dispatch({
      type: ERROR_TYPE,
      error: { isAxiosError: true, response: { status: 400, headers: { [MESSAGE_ERROR_HEADER_NAME]: 'A foo cannot be created' } } },
    });
    expect(toast.error).toHaveBeenCalledWith('A foo cannot be created');
  });

  it('should trigger an error toast message for the message of a problem', () => {
    store.dispatch({
      type: ERROR_TYPE,
      error: {
        isAxiosError: true,
        response: { status: 400, data: { type: ProblemWithMessageType, status: 400, message: 'error.http.400', detail: 'Bad foo' } },
      },
    });
    expect(toast.error).toHaveBeenCalledWith('Bad foo');
  });

  it('should trigger an error toast message for a validation failure without field errors', () => {
    store.dispatch({
      type: ERROR_TYPE,
      error: {
        isAxiosError: true,
        response: {
          status: 400,
          data: { type: CONSTRAINT_VIOLATION_TYPE, status: 400, message: 'error.validation', detail: 'Validation failed', fieldErrors: [] },
        },
      },
    });
    expect(toast.error).toHaveBeenCalledWith('Validation failed');
  });

  it('should trigger an error toast message with the detail of a wrong password, whose message is the one of its status', () => {
    store.dispatch({
      type: ERROR_TYPE,
      error: {
        isAxiosError: true,
        response: {
          status: 400,
          data: { type: INVALID_PASSWORD_TYPE, status: 400, message: 'error.http.400', detail: 'Incorrect password' },
        },
      },
    });
    expect(toast.error).toHaveBeenCalledWith('Incorrect password');
  });

  it('should not trigger an error toast message for the failures of the account', () => {
    store.dispatch({ type: ERROR_TYPE, error: { isAxiosError: true, config: { url: 'api/account' }, response: { status: 500 } } });
    expect(toast.error).not.toHaveBeenCalled();
  });

  it('should trigger an error toast message for an error without a message', () => {
    store.dispatch({ type: ERROR_TYPE, error: {} });
    expect(toast.error).toHaveBeenCalledWith('Unknown error!');
  });

  it('should only log the failure of the account without a response', () => {
    const log = vi.spyOn(globalThis.console, 'log').mockImplementation(() => undefined);
    store.dispatch({
      type: ERROR_TYPE,
      error: { isAxiosError: true, message: 'Network Error', config: { url: 'api/account', method: 'get' } },
    });
    expect(log).toHaveBeenCalled();
    expect(toast.error).not.toHaveBeenCalled();
  });
});
