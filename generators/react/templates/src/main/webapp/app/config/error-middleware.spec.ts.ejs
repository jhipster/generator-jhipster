import { afterEach, describe, expect, it, vi } from 'vitest';

import errorMiddleware from './error-middleware';
import loggerMiddleware from './logger-middleware';

describe('development middlewares', () => {
  afterEach(() => {
    vi.unstubAllGlobals();
    vi.restoreAllMocks();
  });

  const run = (middleware: typeof errorMiddleware, action: Record<string, unknown>) => {
    const next = vi.fn().mockReturnValue('next');
    expect(middleware()(next)(action)).toBe('next');
    expect(next).toHaveBeenCalledWith(action);
  };

  it('should only pass the actions on outside of development', () => {
    const error = vi.spyOn(console, 'error').mockImplementation(() => {});
    const groupCollapsed = vi.spyOn(console, 'groupCollapsed').mockImplementation(() => {});

    run(errorMiddleware, { type: 'entity/fetch/rejected', error: new Error('Failed') });
    run(loggerMiddleware, { type: 'entity/fetch/rejected', error: new Error('Failed') });

    expect(error).not.toHaveBeenCalled();
    expect(groupCollapsed).not.toHaveBeenCalled();
  });

  it('should log the errors and their field errors in development', () => {
    vi.stubGlobal('DEVELOPMENT', true);
    const error = vi.spyOn(console, 'error').mockImplementation(() => {});

    run(errorMiddleware, { type: 'entity/fetch/fulfilled' });
    run(errorMiddleware, { type: 'entity/fetch/rejected', error: { message: 'Failed' } });
    run(errorMiddleware, { type: 'entity/fetch/rejected', error: { message: 'Failed', response: { data: { message: 'Invalid' } } } });
    run(errorMiddleware, {
      type: 'entity/fetch/rejected',
      error: {
        message: 'Failed',
        response: { data: { message: 'Invalid', fieldErrors: [{ field: 'name', objectName: 'entity', message: 'NotNull' }] } },
      },
    });

    expect(error).toHaveBeenCalledTimes(5);
    expect(error).toHaveBeenLastCalledWith(expect.stringContaining('field: name, Object: entity, message: NotNull'));
  });

  it('should log the actions in development', () => {
    vi.stubGlobal('DEVELOPMENT', true);
    vi.spyOn(console, 'groupCollapsed').mockImplementation(() => {});
    vi.spyOn(console, 'groupEnd').mockImplementation(() => {});
    const log = vi.spyOn(console, 'log').mockImplementation(() => {});

    run(loggerMiddleware, { type: 'entity/fetch/fulfilled', payload: 'payload' });
    run(loggerMiddleware, { type: 'entity/fetch/rejected', error: 'error' });

    expect(log).toHaveBeenCalledWith('Payload:', 'payload');
    expect(log).toHaveBeenCalledWith('Error:', 'error');
  });
});
