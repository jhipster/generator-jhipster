import { describe, expect, it, vi } from 'vitest';

import loadingBar, { hideLoading, showLoading } from 'app/shared/reducers/loading-bar';

import loadingBarMiddleware from './loading-bar-middleware';

describe('loading bar middleware', () => {
  const run = (type: string) => {
    const dispatch = vi.fn();
    const next = vi.fn();
    loadingBarMiddleware({ dispatch, getState: vi.fn() })(next)({ type });
    expect(next).toHaveBeenCalledWith({ type });
    return dispatch;
  };

  it('should show the loading bar while an action is pending', () => {
    expect(run('entity/fetch/pending')).toHaveBeenCalledWith(showLoading());
  });

  it('should hide the loading bar once an action is fulfilled or rejected', () => {
    expect(run('entity/fetch/fulfilled')).toHaveBeenCalledWith(hideLoading());
    expect(run('entity/fetch/rejected')).toHaveBeenCalledWith(hideLoading());
  });

  it('should leave the loading bar for other actions', () => {
    expect(run('entity/reset')).not.toHaveBeenCalled();
  });

  it('should count the actions in progress', () => {
    const shown = loadingBar(undefined, showLoading());

    expect(shown).toEqual({ count: 1 });
    expect(loadingBar(shown, hideLoading())).toEqual({ count: 0 });
    expect(loadingBar({ count: 0 }, hideLoading())).toEqual({ count: 0 });
  });
});
