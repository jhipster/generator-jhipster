{
  "extends": "./tsconfig.json",
  "exclude": [],
  "compilerOptions": {
    "composite": true,
<%_ if (microfrontend) { _%>
    // The declarations of @module-federation/sdk import webpack, which the app does not install, so they are not checked.
    "skipLibCheck": true,
<%_ } _%>
    "tsBuildInfoFile": "./<%- relativeDir(clientRootDir, temporaryDir) %>tsconfig.vitest.tsbuildinfo",
    "types": ["node"]
  }
}
