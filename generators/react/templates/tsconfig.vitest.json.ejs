{
  "extends": "./tsconfig.json",
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    // The declarations of some libraries import packages the app does not install,
    // like @module-federation/sdk importing webpack, so they are not checked.
    "skipLibCheck": true,
    "tsBuildInfoFile": "./<%- relativeDir(clientRootDir, temporaryDir) %>tsconfig.vitest.tsbuildinfo",
    "types": ["node"]
  }
}
