package <%- packageName %>.web.rest;

import static org.assertj.core.api.Assertions.assertThat;

import <%- packageName %>.domain.Sortable;
import org.junit.jupiter.api.Test;
import org.springframework.data.domain.Sort;

/**
 * Test class for the {@link SortValidator} utility class.
 */
class SortValidatorTest {

    static class Related {}

    static class Base {

        @Sortable
        private Long id;
    }

    static class Sample extends Base {

        @Sortable
        private String name;

        private String secret;

        @Sortable({ "id", "name" })
        private Related related;
    }

    @Test
    void acceptsTheSortableProperties() {
        assertThat(SortValidator.isSortable(Sample.class, Sort.by("id", "name", "related.id", "related.name"))).isTrue();
    }

    @Test
    void acceptsNoSort() {
        assertThat(SortValidator.isSortable(Sample.class, Sort.unsorted())).isTrue();
    }

    @Test
    void rejectsAPropertyThatIsNotSortable() {
        assertThat(SortValidator.isSortable(Sample.class, Sort.by("name", "secret"))).isFalse();
    }

    @Test
    void rejectsAPropertyThatDoesNotExist() {
        assertThat(SortValidator.isSortable(Sample.class, Sort.by("doesNotExist"))).isFalse();
    }

    @Test
    void rejectsARelationshipAlone() {
        assertThat(SortValidator.isSortable(Sample.class, Sort.by("related"))).isFalse();
    }

    @Test
    void rejectsAPropertyOfARelationshipThatIsNotSortable() {
        assertThat(SortValidator.isSortable(Sample.class, Sort.by("related.secret"))).isFalse();
    }
}
