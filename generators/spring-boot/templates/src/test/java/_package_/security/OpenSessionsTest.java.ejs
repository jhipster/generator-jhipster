package <%- packageName %>.security;

import static org.assertj.core.api.Assertions.assertThat;

import jakarta.servlet.http.HttpSessionEvent;
import org.junit.jupiter.api.Test;
import org.springframework.mock.web.MockHttpSession;

class OpenSessionsTest {

    private final OpenSessions openSessions = new OpenSessions();

    @Test
    void invalidatesAnOpenSession() {
        MockHttpSession session = new MockHttpSession(null, "session-1");
        openSessions.sessionCreated(new HttpSessionEvent(session));

        openSessions.invalidate("session-1");

        assertThat(session.isInvalid()).isTrue();
    }

    @Test
    void followsTheChangeOfTheSessionId() {
        MockHttpSession session = new MockHttpSession(null, "old-id");
        openSessions.sessionCreated(new HttpSessionEvent(session));
        String newId = session.changeSessionId();
        openSessions.sessionIdChanged(new HttpSessionEvent(session), "old-id");

        openSessions.invalidate("old-id");
        assertThat(session.isInvalid()).isFalse();

        openSessions.invalidate(newId);
        assertThat(session.isInvalid()).isTrue();
    }

    @Test
    void ignoresAnEndedSession() {
        MockHttpSession session = new MockHttpSession(null, "ended");
        openSessions.sessionCreated(new HttpSessionEvent(session));
        openSessions.sessionDestroyed(new HttpSessionEvent(session));

        openSessions.invalidate("ended");
        openSessions.invalidate("unknown");

        assertThat(session.isInvalid()).isFalse();
    }

    @Test
    void ignoresASessionAlreadyInvalidated() {
        MockHttpSession session = new MockHttpSession(null, "invalidated");
        openSessions.sessionCreated(new HttpSessionEvent(session));
        session.invalidate();

        openSessions.invalidate("invalidated");

        assertThat(session.isInvalid()).isTrue();
    }
}
