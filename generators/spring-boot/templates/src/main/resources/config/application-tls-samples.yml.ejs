# ===================================================================
# Spring Boot configuration for the "tls-samples" profile, used with the "tls" profile.
#
# The keystore is a self-signed sample generated by JHipster for development and tests: its password is public, so it
# gives a working https endpoint, not secrecy. Do not use it in production.
#
# As your browser will not trust its certificate, you will need to import it, or, with Chrome, enable the
# "allow-insecure-localhost" flag at chrome://flags/#allow-insecure-localhost
# ===================================================================
server:
  ssl:
    key-store: classpath:config/tls/keystore-samples.p12
    key-store-password: password
    key-store-type: PKCS12
    key-alias: selfsigned
