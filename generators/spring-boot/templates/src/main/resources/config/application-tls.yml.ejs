# ===================================================================
# Activate this profile to enable TLS and HTTP/2.
#
# Provide your own keystore, for example through the environment:
#   SERVER_SSL_KEY_STORE, SERVER_SSL_KEY_STORE_PASSWORD, SERVER_SSL_KEY_STORE_TYPE, SERVER_SSL_KEY_ALIAS
# In development, add the "tls-samples" profile instead: it uses the self-signed sample keystore generated by JHipster,
# whose password is public.
# ===================================================================
server:
  ssl:
    enabled: true
    # key-store: file:/path/to/keystore.p12
    # key-store-password:
    # key-store-type: PKCS12
    # key-alias:
    ciphers:
      - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
      - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
      - TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA
      - TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA
      - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
      - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
      - TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA
      - TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA
    enabled-protocols: TLSv1.2
  http2:
    enabled: true
