package <%- entityAbsolutePackage %>.service.mapper;

<%_ // Relationships exposed by the DTO. Embedded entities are copied whole by MapStruct and need no mapping of their own.
    const dtoRelationships = restProperties.filter(property => property.relationshipName && !property.otherEntity.embedded);
    const ownerSideRelationships = dtoRelationships.filter(relationship => relationship.ownerSide);

    // Entity -> DTO: one shallow mapping per related entity and display field, copying only the id and that field.
    // A display field is an object of its related entity, so it identifies the mapping on its own.
    const displayFieldOfCollections = new Set(
      dtoRelationships.filter(relationship => relationship.collection).map(relationship => relationship.relatedField.originalField ?? relationship.relatedField),
    );
    const toDtoMappings = this._.uniqWith(
      dtoRelationships.map(relationship => ({ otherEntity: relationship.otherEntity, displayField: relationship.relatedField })),
      (a, b) =>
        a.otherEntity === b.otherEntity && (a.displayField.originalField ?? a.displayField) === (b.displayField.originalField ?? b.displayField),
      ).map(mapping => ({
        ...mapping,
        name: `${mapping.otherEntity.entityInstance}${this._.upperFirst(mapping.displayField.propertyName)}`,
        // A Set variant is needed when any relationship using this mapping is a collection.
        collection: displayFieldOfCollections.has(mapping.displayField.originalField ?? mapping.displayField),
      }));

      // DTO -> entity: one mapping per related entity copying only the id. A relationship is persisted by the id of the
      // related entity, so nothing else may flow from the DTO into it.
      const toEntityMappings = this._.uniq(ownerSideRelationships.map(relationship => relationship.otherEntity)).map(otherEntity => ({
        otherEntity,
        name: `${otherEntity.entityInstance}FromId`,
        collection: ownerSideRelationships.some(relationship => relationship.otherEntity === otherEntity && relationship.collection),
      }));

      // The named mapping each relationship is mapped with, by relationship.
      const qualifiedBy = new Map(
        dtoRelationships.map(relationship => [
          relationship,
          {
            toDto: `${relationship.otherEntity.entityInstance}${this._.upperFirst(relationship.relatedField.propertyName)}${relationship.collection ? 'Set' : ''}`,
            toEntity: `${relationship.otherEntity.entityInstance}FromId${relationship.collection ? 'Set' : ''}`,
          },
        ]),
      );

      const expressionFields = fields.filter(field => field.mapstructExpression);
      const hasUuidDisplayField = restProperties.some(property => property.relatedField?.fieldTypeUUID);
      const hasBytesDisplayField = restProperties.some(property => property.relatedField?.fieldTypeBytes);
      const hasCollectionMapping = toDtoMappings.some(mapping => mapping.collection) || toEntityMappings.some(mapping => mapping.collection);
      const overridesToDto = dtoRelationships.length > 0 || expressionFields.length > 0;
      const overridesToEntity = dtoRelationships.length > 0 || primaryKey.ids.length > 1;
      // With every nested bean covered by a named mapping, a relationship a mapping forgets must be a compile error
      // instead of a mapping forged by MapStruct. Embedded entities and composite ids still rely on forged mappings.
      const disableSubMappingMethodsGeneration
        = !embedded && primaryKey.ids.length === 1 && !restProperties.some(property => property.relationshipName && property.otherEntity.embedded);
_%>
<%_ if (hasCollectionMapping) { _%>
import java.util.Set;
import java.util.stream.Collectors;
<%_ } _%>
<%_ if (hasUuidDisplayField || toEntityMappings.some(mapping => mapping.collection)) { _%>
import java.util.Objects;
<%_ } _%>
<%_ if (hasUuidDisplayField) { _%>
import java.util.UUID;
<%_ } _%>

import <%- entityAbsoluteClass %>;
import <%- entityAbsolutePackage %>.service.dto.<%- dtoClass %>;

<%_ for (const otherEntity of this._.uniq(dtoRelationships.map(relationship => relationship.otherEntity).filter(otherEntity => otherEntity.entityClass !== entityClass))) { _%>
import <%- otherEntity.entityAbsoluteClass %>;
import <%- otherEntity.entityAbsolutePackage %>.service.dto.<%- otherEntity.dtoClass %>;
<%_ } _%>

import org.mapstruct.*;

/**
 * Mapper for the entity {@link <%- persistClass %>} and its DTO {@link <%- dtoClass %>}.
 */
@Mapper(componentModel = "spring"<%- disableSubMappingMethodsGeneration ? ', disableSubMappingMethodsGeneration = true' : '' %>)
public interface <%- entityClass %>Mapper extends EntityMapper<<%- dtoClass %>, <%- persistClass %>> {
<%_ if (!embedded) { _%>
  <%_ if (overridesToDto) { _%>
    <%_ for (const relationship of dtoRelationships) { _%>
    @Mapping(target = "<%- relationship.propertyName %>", source = "<%- relationship.propertyName %>", qualifiedByName = "<%- qualifiedBy.get(relationship).toDto %>")
    <%_ } _%>
    <%_ for (const field of expressionFields) { _%>
    @Mapping(target = "<%- field.propertyName %>", expression = "<%- field.mapstructExpression %>")
    <%_ } _%>
    <%- dtoClass %> toDto(<%- persistClass %> s);
  <%_ } _%>
  <%_ if (overridesToEntity) { _%>

    <%_ if (primaryKey.ids.length > 1) { _%>
      <%_ for (const id of primaryKey.ids) { _%>
    @Mapping(target = "id.<%- id.name %>", source = "<%- id.nameDotted %>")
      <%_ } _%>
    <%_ } _%>
    <%_ for (const relationship of dtoRelationships) { _%>
      <%_ if (relationship.ownerSide) { _%>
    @Mapping(target = "<%- relationship.propertyName %>", source = "<%- relationship.propertyName %>", qualifiedByName = "<%- qualifiedBy.get(relationship).toEntity %>")
      <%_ } else { _%>
    @Mapping(target = "<%- relationship.propertyName %>", ignore = true)
      <%_ } _%>
      <%_ if (relationship.collection && fluentMethods) { _%>
    @Mapping(target = "remove<%- relationship.relationshipNameCapitalized %>", ignore = true)
      <%_ } _%>
    <%_ } _%>
    <%- persistClass %> toEntity(<%- dtoClass %> <%- dtoInstance %>);
  <%_ } _%>
  <%_ for (const { otherEntity, displayField, collection, name: mappingName } of toDtoMappings) { _%>

    @Named("<%- mappingName %>")
    @BeanMapping(ignoreByDefault = true)
    <%_ for (const field of otherEntity.primaryKey.fields) { _%>
    @Mapping(target = "<%- field.propertyName %>", source = "<%- field.propertyName %>")
    <%_ } _%>
    <%_ if (!displayField.id && displayField.mapstructExpression) { _%>
    @Mapping(target = "<%- displayField.propertyName %>", expression = "<%- displayField.mapstructExpression %>")
    <%_ } else if (!displayField.id) { _%>
    @Mapping(target = "<%- displayField.propertyName %>", source = "<%- displayField.propertyName %>")
    <%_ } _%>
    <%- otherEntity.dtoClass %> toDto<%- this._.upperFirst(mappingName) %>(<%- otherEntity.persistClass %> <%- displayField.mapstructExpression ? 's' : otherEntity.persistInstance %>);
    <%_ if (collection) { _%>

    @Named("<%- mappingName %>Set")
    default Set<<%- otherEntity.dtoClass %>> toDto<%- this._.upperFirst(mappingName) %>Set(Set<<%- otherEntity.persistClass %>> <%- otherEntity.persistInstance %>) {
        return <%- otherEntity.persistInstance %>.stream().map(this::toDto<%- this._.upperFirst(mappingName) %>).collect(Collectors.toSet());
    }
    <%_ } _%>
  <%_ } _%>
  <%_ for (const { otherEntity, collection, name: mappingName } of toEntityMappings) { _%>

    @Named("<%- mappingName %>")
    @BeanMapping(ignoreByDefault = true)
    <%_ if (otherEntity.primaryKey.ids.length > 1) { _%>
      <%_ for (const id of otherEntity.primaryKey.ids) { _%>
    @Mapping(target = "id.<%- id.name %>", source = "<%- id.nameDotted %>")
      <%_ } _%>
    <%_ } else { _%>
      <%_ for (const field of otherEntity.primaryKey.fields) { _%>
    @Mapping(target = "<%- field.propertyName %>", source = "<%- field.propertyName %>")
      <%_ } _%>
    <%_ } _%>
    <%- otherEntity.persistClass %> toEntity<%- this._.upperFirst(mappingName) %>(<%- otherEntity.dtoClass %> <%- otherEntity.dtoInstance %>);
    <%_ if (collection) { _%>

    @Named("<%- mappingName %>Set")
    default Set<<%- otherEntity.persistClass %>> toEntity<%- this._.upperFirst(mappingName) %>Set(Set<<%- otherEntity.dtoClass %>> dtos) {
        return dtos == null ? null : dtos.stream().filter(Objects::nonNull).map(this::toEntity<%- this._.upperFirst(mappingName) %>).collect(Collectors.toSet());
    }
    <%_ } _%>
  <%_ } _%>
  <%_ if (hasUuidDisplayField) { _%>

    default String map(UUID value) {
        return Objects.toString(value, null);
    }
  <%_ } _%>
  <%_ if (hasBytesDisplayField) { _%>

    default String map(byte[] value) {
        return new String(value);
    }
  <%_ } _%>
<%_ } _%>
}
