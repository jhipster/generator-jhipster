<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity <%- entityClass %>.
    -->
    <changeSet id="<%- changelogDate %>-1" author="jhipster">
        <createTable tableName="<%- entityInstance %>">
<%_ for (const field of fields) { _%>
  <%_ const { fieldName, fieldNameUnderscored } = field;
      let columnType;
  _%>
  <%_ if (field.fieldTypeUUID) { _%>
    <%_ columnType = 'uuid'; _%>
  <%_ } else if (field.fieldTypeString || field.fieldIsEnum || field.fieldTypeDuration) { _%>
    <%_ columnType = 'text'; _%>
  <%_ } else if (field.fieldTypeInteger) { _%>
    <%_ columnType = 'int'; _%>
  <%_ } else if (field.fieldTypeLong) { _%>
    <%_ columnType = 'bigint'; _%>
  <%_ } else if (field.fieldTypeFloat) { _%>
    <%_ columnType = 'float'; _%>
  <%_ } else if (field.fieldTypeDouble) { _%>
    <%_ columnType = 'double'; _%>
  <%_ } else if (field.fieldTypeBigDecimal) { _%>
    <%_ columnType = 'decimal'; _%>
  <%_ } else if (field.fieldTypeLocalDate) { _%>
    <%_ columnType = 'date'; _%>
  <%_ } else if (field.fieldTypeInstant) { _%>
    <%_ columnType = 'timestamp'; _%>
  <%_ } else if (field.fieldTypeZonedDateTime) { _%>
    <%_ columnType = 'tuple&lt;timestamp,varchar&gt;'; _%>
  <%_ } else if (field.fieldTypeLocalTime) { _%>
    <%_ columnType = 'time'; _%>
  <%_ } else if (field.fieldTypeBoolean) { _%>
    <%_ columnType = 'boolean'; _%>
  <%_ } else if (field.fieldTypeByteBuffer) { _%>
    <%_ columnType = field.blobContentTypeText ? 'text' : 'blob'; _%>
  <%_ } _%>
  <%_ if (columnType) { _%>
    <%_ if (field.id) { _%>
            <column name="<%- fieldName %>" type="<%- columnType %>">
                <constraints primaryKey="true"/>
            </column>
    <%_ } else { _%>
            <column name="<%- fieldName %>" type="<%- columnType %>"/>
    <%_ } _%>
    <%_ if (field.fieldTypeByteBuffer && !field.blobContentTypeText) { _%>
            <column name="<%- fieldNameUnderscored %>_content_type" type="text"/>
    <%_ } _%>
  <%_ } _%>
<%_ } _%>
        </createTable>
<%_ if (fields.some(field => field.fieldTypeUUID)) { _%>
        <!-- Liquibase has no Cassandra uuid data type and renders it as char(36) -->
        <modifySql>
            <replace replace="char(36)" with="uuid"/>
        </modifySql>
<%_ } _%>
    </changeSet>

</databaseChangeLog>
