package <%- packageName %>.config;

import static org.assertj.core.api.Assertions.assertThat;

import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import org.assertj.core.api.InstanceOfAssertFactories;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.data.annotation.Id;
import org.springframework.data.couchbase.core.convert.CouchbaseCustomConversions;
import org.springframework.data.couchbase.core.convert.MappingCouchbaseConverter;
import org.springframework.data.couchbase.core.mapping.CouchbaseDocument;
import org.springframework.data.couchbase.core.mapping.CouchbaseMappingContext;

class EntityReferencesMappingCouchbaseConverterTest {

    public static class Child {

        @Id
        private String id;

        private String label;

        private Set<Parent> parents = new HashSet<>();

        public Child() {}

        Child(String id, String label) {
            this.id = id;
            this.label = label;
        }
    }

    public static class Address {

        private String city;
    }

    public static class Parent {

        @Id
        private String id;

        private Child child;

        private Set<Child> children = new HashSet<>();

        private Address address;

        public Parent() {}
    }

    private MappingCouchbaseConverter converter;

    @BeforeEach
    void setUp() throws Exception {
        CouchbaseMappingContext mappingContext = new CouchbaseMappingContext();
        CouchbaseCustomConversions conversions = new CouchbaseCustomConversions(List.of());
        mappingContext.setSimpleTypeHolder(conversions.getSimpleTypeHolder());
        converter = new EntityReferencesMappingCouchbaseConverter(mappingContext, "type", conversions);
        converter.afterPropertiesSet();
    }

    private Parent parent() {
        Parent parent = new Parent();
        parent.id = "p1";
        parent.child = new Child("c1", "first");
        parent.children = new HashSet<>(Set.of(new Child("c1", "first"), new Child("c2", "second")));
        parent.address = new Address();
        parent.address.city = "a city";
        return parent;
    }

    private CouchbaseDocument write(Object entity) {
        CouchbaseDocument document = new CouchbaseDocument();
        converter.write(entity, document);
        return document;
    }

    @Test
    void shouldStoreTheRelationshipsAsKeysAndTheEmbeddedEntitiesAsDocuments() {
        Map<String, Object> document = write(parent()).export();

        assertThat(document).containsEntry("child", "c1");
        assertThat(document.get("children")).asInstanceOf(InstanceOfAssertFactories.LIST).containsExactlyInAnyOrder("c1", "c2");
        assertThat(document.get("address")).isEqualTo(Map.of("city", "a city"));
    }

    @Test
    void shouldNotWriteTheRelatedEntities() {
        Parent parent = parent();
        parent.children.forEach(child -> child.parents.add(parent));

        assertThat(write(parent).export().get("children"))
            .asInstanceOf(InstanceOfAssertFactories.LIST)
            .containsExactlyInAnyOrder("c1", "c2");
        assertThat(write(parent.children.iterator().next()).export().get("parents"))
            .asInstanceOf(InstanceOfAssertFactories.LIST)
            .containsExactly("p1");
    }

    @Test
    void shouldStoreAnEmptyCollectionAndNoKeyForAMissingEntity() {
        Parent parent = new Parent();
        parent.id = "p1";
        Map<String, Object> document = write(parent).export();

        assertThat(document.get("children")).asInstanceOf(InstanceOfAssertFactories.LIST).isEmpty();
        assertThat(document).doesNotContainKey("child");
    }

    @Test
    void shouldReadTheKeysAsEntitiesWithTheirIds() {
        Parent read = converter.read(Parent.class, write(parent()));

        assertThat(read.child.id).isEqualTo("c1");
        assertThat(read.children)
            .extracting(child -> child.id)
            .containsExactlyInAnyOrder("c1", "c2");
        assertThat(read.address.city).isEqualTo("a city");
    }

    @Test
    void shouldReadTheEntitiesOfAJoinAsEntities() {
        CouchbaseDocument document = new CouchbaseDocument();
        document.put("id", "p1");
        CouchbaseDocument child = new CouchbaseDocument();
        child.put("id", "c1");
        child.put("label", "first");
        document.put("child", child);

        Parent read = converter.read(Parent.class, document);

        assertThat(read.child.id).isEqualTo("c1");
        assertThat(read.child.label).isEqualTo("first");
    }
}
