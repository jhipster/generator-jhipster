package <%- packageName %>.repository;

import com.couchbase.client.java.query.QueryScanConsistency;
import org.springframework.data.core.PropertyPath;
import org.springframework.data.couchbase.repository.*;
import org.springframework.data.domain.*;
import org.springframework.data.repository.NoRepositoryBean;

<%_ if (reactive) { _%>
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;
<%_ } else { _%>
import java.util.List;
<%_ } _%>

/**
 * Couchbase specific {@link org.springframework.data.repository.Repository} interface.
 * The sort of the listings is checked against the properties of the entity, and the queries by ids can use the KV first approach.
 */
@NoRepositoryBean
@ScanConsistency(query = QueryScanConsistency.REQUEST_PLUS)
public interface JHipsterCouchbaseRepository<T, ID> extends <%- reactivePrefix %>CouchbaseRepository<T, ID> {

    String FIND_IDS_QUERY = "SELECT meta().id as __id, 0 as __cas FROM #{#n1ql.bucket}.#{#n1ql.scope}.#{#n1ql.collection} WHERE #{#n1ql.filter}";

    /**
     * The sort as N1QL orders by it: the properties of the entity written as the fields of its documents, quoted, and the id as the
     * key of the document.
     *
     * @param prefix the alias of the entity in the query, empty when it has none
     * @throws org.springframework.data.core.PropertyReferenceException for a property the entity does not have
     */
    static Sort sortByProperties(Class<?> domainType, Sort sort, String prefix) {
        return Sort.by(
            sort
                .stream()
                .map(order -> {
                    String field = PropertyPath.from(order.getProperty(), domainType).toDotPath().replace(".", "`.`");
                    if ("id".equals(field)) {
                        return order.withProperty("meta(%s).id".formatted(prefix));
                    }
                    return order.withProperty(prefix.isEmpty() ? "`%s`".formatted(field) : "%s.`%s`".formatted(prefix, field));
                })
                .toList()
        );
    }

    default Sort sortByProperties(Sort sort, String prefix) {
        return sortByProperties(getEntityInformation().getJavaType(), sort, prefix);
    }

    /**
     * The pageable with its sort written as {@link #sortByProperties(Sort, String)} does, for the queries given a pageable:
     * Spring Data writes the properties of its sort to the query as they are.
     */
    default Pageable sortedByProperties(Pageable pageable, String prefix) {
        Sort sort = sortByProperties(pageable.getSort(), prefix);
        return pageable.isPaged() ? PageRequest.of(pageable.getPageNumber(), pageable.getPageSize(), sort) : Pageable.unpaged(sort);
    }

    default String sortStatement(Sort sort, String prefix) {
        return new org.springframework.data.couchbase.core.query.Query().with(sortByProperties(sort, prefix)).export();
    }

    default String pageableStatement(Pageable pageable, String prefix) {
        return new org.springframework.data.couchbase.core.query.Query()
            .limit(pageable.getPageSize())
            .skip(pageable.getOffset())
            .with(sortByProperties(pageable.getSort(), prefix))
            .export();
    }

    /**
     * The entities of the query, one query as Spring Data does it. The sort is checked against the properties of the entity.
     */
    private <%- listOrFlux %><T> findAllSorted(Sort sort, Pageable pageable) {
        var query = new org.springframework.data.couchbase.core.query.Query().with(sortByProperties(sort, ""));
        return getOperations()
            .findByQuery(getEntityInformation().getJavaType())
            .withConsistency(QueryScanConsistency.REQUEST_PLUS)
            .matching(pageable.isPaged() ? query.limit(pageable.getPageSize()).skip(pageable.getOffset()) : query)
            .all();
    }

<%_ if (reactive) { _%>
    default Flux<T> findAllBy(Pageable pageable) {
        return findAllSorted(pageable.getSort(), pageable);
    }

    default Flux<T> findAll(Sort sort) {
        return findAllSorted(sort, Pageable.unpaged());
    }
<%_ } else { _%>
    default Page<T> findAll(Pageable pageable) {
        return new PageImpl<>(findAllSorted(pageable.getSort(), pageable), pageable, count());
    }

    default List<T> findAll(Sort sort) {
        return findAllSorted(sort, Pageable.unpaged());
    }
<%_ } _%>

    @SuppressWarnings("unchecked")
    default <%- listOrFlux %><ID> toIds(<%- listOrFlux %><T> entities) {
<%_ if (reactive) { _%>
        return entities.mapNotNull(entity -> (ID) getEntityInformation().getId(entity));
<%_ } else { _%>
        return entities.stream()
            .map(entity -> (ID) getEntityInformation().getId(entity))
            .toList();
<%_ } _%>
    }
}
