package <%- packageName %>.security;

import static <%- packageName %>.security.SecurityUtils.CREDENTIALS_CLAIM;

import <%- packageName %>.security.DomainUserDetailsService.UserWithId;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import org.springframework.security.core.AuthenticationException;
<%_ if (reactive) { _%>
import org.springframework.security.core.userdetails.ReactiveUserDetailsService;
<%_ } else { _%>
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.security.core.userdetails.UserDetailsService;
<%_ } _%>
import org.springframework.security.oauth2.jwt.BadJwtException;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.stereotype.Component;
<%_ if (reactive) { _%>
import reactor.core.publisher.Mono;
<%_ } _%>

/**
 * Rejects the token of a user whose credentials changed since it was issued, or who can no longer log in:
 * the token carries the credentials stamp of the user at the login.
 *
 * <p>The stamp of a user is kept in memory for a short time, so the user is not read on each request. A change of
 * the user evicts it in this instance; another instance follows when its own copy expires.
 */
@Component
public class JwtCredentialsValidator {

    /** How long the stamp of a user is kept: the longest another instance accepts a token after a change. */
    static final Duration STAMP_VALIDITY = Duration.ofSeconds(30);

    private static final int MAX_STAMPS = 10_000;

    private final Map<String, CachedStamp> stamps = new ConcurrentHashMap<>();

    private final <%- reactive ? 'ReactiveUserDetailsService' : 'UserDetailsService' %> userDetailsService;

    public JwtCredentialsValidator(<%- reactive ? 'ReactiveUserDetailsService' : 'UserDetailsService' %> userDetailsService) {
        this.userDetailsService = userDetailsService;
    }

    /**
     * Validates the credentials stamp of a token against the user.
     *
     * @param jwt the decoded token.
     * @return the token, when the credentials of its user did not change.
     */
<%_ if (reactive) { _%>
    public Mono<Jwt> validate(Jwt jwt) {
        return credentialsStamp(jwt.getSubject())
            .filter(stamp -> stamp.equals(jwt.getClaimAsString(CREDENTIALS_CLAIM)))
            .switchIfEmpty(Mono.error(() -> new BadJwtException("The credentials of the token changed")))
            .thenReturn(jwt);
    }
<%_ } else { _%>
    public Jwt validate(Jwt jwt) {
        if (!credentialsStamp(jwt.getSubject()).equals(jwt.getClaimAsString(CREDENTIALS_CLAIM))) {
            throw new BadJwtException("The credentials of the token changed");
        }
        return jwt;
    }
<%_ } _%>

    /**
     * Forgets the stamp of a user, to be called when the user changes.
     *
     * @param login the login of the user.
     */
    public void evict(String login) {
        stamps.remove(login);
    }

<%_ if (reactive) { _%>
    private Mono<String> credentialsStamp(String login) {
        CachedStamp cached = stamps.get(login);
        if (cached != null && cached.expiry().isAfter(Instant.now())) {
            return Mono.just(cached.stamp());
        }
        return userDetailsService
            .findByUsername(login)
            .onErrorMap(AuthenticationException.class, e -> new BadJwtException("The user of the token can no longer log in", e))
            .ofType(UserWithId.class)
            .map(UserWithId::getCredentialsStamp)
            .doOnNext(stamp -> keep(login, stamp));
    }
<%_ } else { _%>
    private String credentialsStamp(String login) {
        CachedStamp cached = stamps.get(login);
        if (cached != null && cached.expiry().isAfter(Instant.now())) {
            return cached.stamp();
        }
        UserDetails user;
        try {
            user = userDetailsService.loadUserByUsername(login);
        } catch (AuthenticationException e) {
            throw new BadJwtException("The user of the token can no longer log in", e);
        }
        if (!(user instanceof UserWithId userWithId)) {
            throw new BadJwtException("The credentials of the token changed");
        }
        keep(login, userWithId.getCredentialsStamp());
        return userWithId.getCredentialsStamp();
    }
<%_ } _%>

    private void keep(String login, String stamp) {
        if (stamps.size() >= MAX_STAMPS) {
            stamps.clear();
        }
        stamps.put(login, new CachedStamp(stamp, Instant.now().plus(STAMP_VALIDITY)));
    }

    private record CachedStamp(String stamp, Instant expiry) {}
}
