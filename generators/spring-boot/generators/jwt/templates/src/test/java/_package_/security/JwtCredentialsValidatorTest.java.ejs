package <%- packageName %>.security;

import static <%- packageName %>.security.SecurityUtils.CREDENTIALS_CLAIM;
import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import <%- packageName %>.security.DomainUserDetailsService.UserWithId;
import java.util.List;
import org.junit.jupiter.api.Test;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
<%_ if (reactive) { _%>
import org.springframework.security.core.userdetails.ReactiveUserDetailsService;
import org.springframework.security.core.userdetails.UserDetails;
<%_ } else { _%>
import org.springframework.security.core.userdetails.UserDetailsService;
<%_ } _%>
import org.springframework.security.core.userdetails.UsernameNotFoundException;
import org.springframework.security.oauth2.jwt.BadJwtException;
import org.springframework.security.oauth2.jwt.Jwt;
<%_ if (reactive) { _%>
import reactor.core.publisher.Mono;
<%_ } _%>

class JwtCredentialsValidatorTest {

    private static final String LOGIN = "user";

    private final <%- reactive ? 'ReactiveUserDetailsService' : 'UserDetailsService' %> userDetailsService = mock(<%- reactive ? 'ReactiveUserDetailsService' : 'UserDetailsService' %>.class);

    private final JwtCredentialsValidator validator = new JwtCredentialsValidator(userDetailsService);

    @Test
    void readsTheUserOnceForSeveralRequests() {
        UserWithId user = user("password");
        when(userDetailsService.<%- reactive ? 'findByUsername' : 'loadUserByUsername' %>(LOGIN)).thenReturn(<%- reactive ? 'Mono.<UserDetails>just(user)' : 'user' %>);
        Jwt jwt = jwt(user.getCredentialsStamp());

        assertThat(validate(jwt)).isSameAs(jwt);
        assertThat(validate(jwt)).isSameAs(jwt);

        verify(userDetailsService, times(1)).<%- reactive ? 'findByUsername' : 'loadUserByUsername' %>(LOGIN);
    }

    @Test
    void readsTheUserAgainOnceEvicted() {
        UserWithId user = user("password");
        UserWithId changedUser = user("changed");
        when(userDetailsService.<%- reactive ? 'findByUsername' : 'loadUserByUsername' %>(LOGIN)).thenReturn(<%- reactive ? 'Mono.<UserDetails>just(user), Mono.<UserDetails>just(changedUser)' : 'user, changedUser' %>);
        Jwt jwt = jwt(user.getCredentialsStamp());
        validate(jwt);

        validator.evict(LOGIN);

        assertThatExceptionOfType(BadJwtException.class).isThrownBy(() -> validate(jwt));
        assertThat(validate(jwt(changedUser.getCredentialsStamp()))).isNotNull();
    }

    @Test
    void rejectsATokenWithoutStamp() {
        UserWithId user = user("password");
        when(userDetailsService.<%- reactive ? 'findByUsername' : 'loadUserByUsername' %>(LOGIN)).thenReturn(<%- reactive ? 'Mono.<UserDetails>just(user)' : 'user' %>);

        assertThatExceptionOfType(BadJwtException.class).isThrownBy(() -> validate(jwt(null)));
    }

    @Test
    void rejectsTheTokenOfAUserThatCannotLogIn() {
        UserWithId user = user("password");
<%_ if (reactive) { _%>
        when(userDetailsService.findByUsername(LOGIN)).thenReturn(Mono.error(new UsernameNotFoundException(LOGIN)));
<%_ } else { _%>
        when(userDetailsService.loadUserByUsername(LOGIN)).thenThrow(new UsernameNotFoundException(LOGIN));
<%_ } _%>

        assertThatExceptionOfType(BadJwtException.class).isThrownBy(() -> validate(jwt(user.getCredentialsStamp())));
    }

    private Jwt validate(Jwt jwt) {
        return validator.validate(jwt)<%- reactive ? '.block()' : '' %>;
    }

    private static UserWithId user(String password) {
        return new UserWithId(LOGIN, password, List.of(new SimpleGrantedAuthority(AuthoritiesConstants.USER)), null);
    }

    private static Jwt jwt(String credentialsStamp) {
        Jwt.Builder builder = Jwt.withTokenValue("token").header("alg", "HS512").subject(LOGIN);
        if (credentialsStamp != null) {
            builder.claim(CREDENTIALS_CLAIM, credentialsStamp);
        }
        return builder.build();
    }
}
