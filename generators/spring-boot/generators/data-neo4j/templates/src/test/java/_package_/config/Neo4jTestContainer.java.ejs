package <%- packageName %>.config;

import java.time.Duration;

import org.springframework.boot.test.context.TestConfiguration;
import org.springframework.context.annotation.Bean;
import org.springframework.test.context.DynamicPropertyRegistrar;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.testcontainers.containers.output.Slf4jLogConsumer;
import org.testcontainers.containers.Neo4jContainer;
import org.testcontainers.utility.DockerImageName;
import org.testcontainers.junit.jupiter.Container;

@TestConfiguration(proxyBeanMethods = false)
public class Neo4jTestContainer {
    private static final Neo4jContainer NEO4J_CONTAINER = (Neo4jContainer) new Neo4jContainer(DockerImageName.parse("<%- dockerContainers.neo4j %>"))
        .withoutAuthentication()
        .withLogConsumer(new Slf4jLogConsumer(LoggerFactory.getLogger(Neo4jTestContainer.class)));

    @Bean
    @ServiceConnection
    Neo4jContainer<?> neo4jContainer() {
        return NEO4J_CONTAINER;
    }
<%_ if (databaseMigrationLiquibase) { _%>

    @Bean
    DynamicPropertyRegistrar neo4jProperties(Neo4jContainer<?> neo4jContainer) {
        return registry ->
            registry.add(
                "spring.liquibase.url",
                () -> "jdbc:neo4j:" + neo4jContainer.getBoltUrl()
            );
    }
<%_ } _%>
}
