    private final ElasticsearchTemplate elasticsearchTemplate;
    private final <%- entityClass %>Repository repository;
    private final ApplicationEventPublisher events;

    <%- entityClass %>SearchRepositoryInternalImpl(ElasticsearchTemplate elasticsearchTemplate, <%- entityClass %>Repository repository, ApplicationEventPublisher events) {
