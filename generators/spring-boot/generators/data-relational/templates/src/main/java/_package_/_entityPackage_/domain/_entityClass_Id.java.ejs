package <%- entityAbsolutePackage %>.domain;

import jakarta.persistence.Column;
import jakarta.persistence.Embeddable;
<%_ if (primaryKey.fields.some(field => field.fieldTypeUUID) && (prodDatabaseTypeMysql || prodDatabaseTypeMariadb)) { _%>
import org.hibernate.annotations.JdbcTypeCode;
import org.hibernate.type.SqlTypes;
<%_ } _%>
import java.io.Serial;
import java.io.Serializable;
<%_ if (primaryKey.fields.some(field => field.fieldTypeUUID)) { _%>
import java.util.UUID;
<%_ } _%>
import java.util.Objects;

/**
 * A composite key for the {@link <%- persistClass %>} entity.
 */
@Embeddable
public class <%- primaryKey.type %> implements Serializable {

    @Serial
    private static final long serialVersionUID = 1L;

<%_ for (const field of primaryKey.fields) { _%>
  <%_ if (field.fieldTypeUUID && (prodDatabaseTypeMysql || prodDatabaseTypeMariadb)) { _%>
    @JdbcTypeCode(SqlTypes.VARCHAR)
    @Column(name = "<%- field.fieldNameAsDatabaseColumn %>", length = 36, nullable = false)
  <%_ } else { _%>
    @Column(name = "<%- field.fieldNameAsDatabaseColumn %>", nullable = false)
  <%_ } _%>
    private <%- field.javaFieldType %> <%- field.fieldName %>;
<%_ } _%>

    public <%- primaryKey.type %>() {
        // Empty constructor required by JPA.
    }

    public <%- primaryKey.type %>(<% for (const [index, field] of primaryKey.fields.entries()) { %><%- index === 0 ? '' : ', ' %><%- field.javaFieldType %> <%- field.fieldName %><% } %>) {
<%_ for (const field of primaryKey.fields) { _%>
        this.<%- field.fieldName %> = <%- field.fieldName %>;
<%_ } _%>
    }

<%_ for (const field of primaryKey.fields) { _%>
    public <%- field.javaFieldType %> <%- field.propertySupplierName %>() {
        return <%- field.fieldName %>;
    }

    public void <%- field.propertyConsumerName %>(<%- field.javaFieldType %> <%- field.fieldName %>) {
        this.<%- field.fieldName %> = <%- field.fieldName %>;
    }

<%_ } _%>
    /**
     * Decodes a key part: a literal '%' is escaped as '%25' and a literal ',' as '%2C' in the string representation.
     */
    private static String decode(String value) {
        StringBuilder decoded = new StringBuilder();
        for (int i = 0; i < value.length(); i++) {
            if (value.startsWith("%2C", i)) {
                decoded.append(',');
                i += 2;
            } else if (value.startsWith("%25", i)) {
                decoded.append('%');
                i += 2;
            } else {
                decoded.append(value.charAt(i));
            }
        }
        return decoded.toString();
    }

    private static String encode(String value) {
        return value.replace("%", "%25").replace(",", "%2C");
    }

    /**
     * Creates a key from its comma separated string representation.
     *
     * @param value the comma separated key parts.
     * @return the key.
     */
    public static <%- primaryKey.type %> valueOf(String value) {
        String[] values = value.split(",");
        if (values.length != <%- primaryKey.fields.length %>) {
            throw new IllegalArgumentException("Invalid <%- primaryKey.type %>: " + value);
        }
        return new <%- primaryKey.type %>(<% for (const [index, field] of primaryKey.fields.entries()) { %><%- index === 0 ? '' : ', ' %><%- field.javaFieldType === 'String' ? `decode(values[${index}])` : javaStringToTypeExpressions[field.javaFieldType](`values[${index}]`) %><% } %>);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) {
            return true;
        }
        if (!(o instanceof <%- primaryKey.type %>)) {
            return false;
        }
        <%- primaryKey.type %> that = (<%- primaryKey.type %>) o;
        return <% for (const [index, field] of primaryKey.fields.entries()) { %><%- index === 0 ? '' : ' && ' %>Objects.equals(<%- field.fieldName %>, that.<%- field.fieldName %>)<% } %>;
    }

    @Override
    public int hashCode() {
        return Objects.hash(<%- primaryKey.fields.map(field => field.fieldName).join(', ') %>);
    }

    @Override
    public String toString() {
        return <% for (const [index, field] of primaryKey.fields.entries()) { %><%- index === 0 ? '' : ' + "," + ' %><%- field.javaFieldType === 'String' ? `encode(${field.fieldName})` : field.fieldName %><% } %>;
    }
}
