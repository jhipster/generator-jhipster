<%_ const toOneRelationships = relationships.filter(rel => rel.ownerSide && !rel.collection);
    const eagerToOneRelationships = toOneRelationships.filter(rel => rel.relationshipEagerLoad);
    const referencedRelationships = toOneRelationships.filter(rel => !rel.relationshipEagerLoad);
    const joinTableRelationships = relationships.filter(rel => rel.shouldWriteJoinTable);
    const eagerJoinTableRelationships = joinTableRelationships.filter(rel => rel.relationshipEagerLoad);
    const populateRelations = toOneRelationships.length > 0 || eagerJoinTableRelationships.length > 0;
    const populateCount = eagerToOneRelationships.length + eagerJoinTableRelationships.length;
    const joinTableConstant = rel => `${rel.relationshipName.replace(/[A-Z]/g, letter => `_${letter}`).toUpperCase()}_JOIN_TABLE`;
    const ownDomainImport = `${entityAbsolutePackage}.domain.${persistClass}`;
    const otherDomainImports = [
      ...new Set(
        [...toOneRelationships, ...joinTableRelationships]
          .map(rel => `${rel.otherEntity.entityAbsolutePackage}.domain.${rel.otherEntity.persistClass}`)
          .filter(domainImport => domainImport !== ownDomainImport),
      ),
    ].sort();
_%>
package <%- entityAbsolutePackage %>.repository;

<%_ if (populateRelations || joinTableRelationships.length > 0) { _%>
import java.util.List;
<%_ } _%>
<%_ if (toOneRelationships.length > 0) { _%>
import java.util.Map;
<%_ } _%>
<%_ if (primaryKey.typeUUID) { _%>
import java.util.UUID;
<%_ } _%>

<%_ if (jpaMetamodelFiltering) { _%>
import org.springframework.data.domain.Pageable;
<%_ } _%>
import org.springframework.data.r2dbc.convert.R2dbcConverter;
import org.springframework.data.r2dbc.core.R2dbcEntityTemplate;
import org.springframework.data.r2dbc.dialect.R2dbcDialect;
<%_ if (jpaMetamodelFiltering) { _%>
import org.springframework.data.relational.core.query.Criteria;
<%_ } _%>

import <%- entityAbsolutePackage %>.domain.<%- persistClass %>;
<%_ if (jpaMetamodelFiltering) { _%>
import <%- entityAbsolutePackage %>.domain.criteria.<%- entityClass %>Criteria;
<%_ } _%>
<%_ for (const domainImport of otherDomainImports) { _%>
import <%- domainImport %>;
<%_ } _%>
<%_ if (packageName !== entityAbsolutePackage) { _%>
import <%- packageName %>.repository.AbstractR2dbcRepository;
  <%_ if (jpaMetamodelFiltering) { _%>
import <%- packageName %>.repository.CriteriaBuilder;
  <%_ } _%>
<%_ } _%>
<%_ if (jpaMetamodelFiltering) { _%>

import reactor.core.publisher.Flux;
<%_ } _%>
<%_ if (populateRelations || isUsingMapsId || jpaMetamodelFiltering) { _%>
import reactor.core.publisher.Mono;
<%_ } _%>

/**
 * <%- springDataDescription %> custom repository implementation for the <%- persistClass %> entity.
 */
@SuppressWarnings("unused")
class <%- entityClass %>RepositoryInternalImpl extends AbstractR2dbcRepository<<%- persistClass %>, <%- primaryKey.type %>> implements <%- entityClass %>RepositoryInternal {
<%_ if (toOneRelationships.length > 0) { _%>

    private static final String SELECT_WITH_RELATIONS_SQL =
        "SELECT e.* FROM <%- entityTableName %> e"<% for (const rel of eagerToOneRelationships) { %> +
        " LEFT JOIN <%- rel.otherEntity.entityTableName %> <%- rel.relationshipSqlSafeName %> ON e.<%- rel.joinColumnNames[0] %> = <%- rel.relationshipSqlSafeName %>.<%- rel.otherEntity.primaryKey.fields[0].columnName %>"<% } %>;

    // The clients sort by the related entity display field, with the entity id as secondary sort.
    private static final Map<String, String> SORT_COLUMNS = Map.ofEntries(
        Map.entry("<%- primaryKey.name %>", "e.<%- primaryKey.fields[0].columnName %>")<% for (const rel of toOneRelationships) { %>,
        Map.entry("<%- rel.relationshipName %>.<%- rel.otherEntity.primaryKey.name %>", "<% if (rel.relationshipEagerLoad) { %><%- rel.relationshipSqlSafeName %>.<%- rel.otherEntity.primaryKey.fields[0].columnName %><% } else { %>e.<%- rel.joinColumnNames[0] %><% } %>")<% if (rel.relationshipEagerLoad && rel.relatedField?.fieldSupportsSortBy && rel.relatedField.fieldName !== rel.otherEntity.primaryKey.name) { %>,
        Map.entry("<%- rel.relationshipName %>.<%- rel.relatedField.fieldName %>", "<%- rel.relationshipSqlSafeName %>.<%- rel.relatedField.fieldNameAsDatabaseColumn %>")<% } %><% } %>
    );
<%_ } _%>
<%_ if (joinTableRelationships.length > 0) { _%>

  <%_ for (const rel of joinTableRelationships) { _%>
    private static final JoinTable<<%- persistClass %>> <%- joinTableConstant(rel) %> = new JoinTable<>("<%- rel.joinTable.name %>", "<%- entityTableName %>_<%- primaryKey.hibernateSnakeCaseName %>", "<%- rel.joinColumnNames[0] %>", <%- entityInstance %> -> <%- entityInstance %>.<%- rel.propertySupplierName %>().stream().map(<%- rel.otherEntity.persistClass %>::<%- rel.otherEntity.primaryKey.propertySupplierName %>).toList());
  <%_ } _%>

    private static final List<JoinTable<<%- persistClass %>>> JOIN_TABLES = List.of(<%- joinTableRelationships.map(joinTableConstant).join(', ') %>);
<%_ } _%>

    public <%- entityClass %>RepositoryInternalImpl(R2dbcEntityTemplate template, R2dbcConverter converter, R2dbcDialect dialect) {
        super(<%- persistClass %>.class, template, converter, dialect);
    }
<%_ if (toOneRelationships.length > 0) { _%>

    @Override
    protected String selectWithRelationsSql() {
        return SELECT_WITH_RELATIONS_SQL;
    }

    @Override
    protected Map<String, String> sortColumns() {
        return SORT_COLUMNS;
    }
<%_ } _%>
<%_ if (populateRelations) { _%>

    @Override
    protected Mono<List<<%- persistClass %>>> populateRelationships(List<<%- persistClass %>> entities) {
  <%_ for (const rel of referencedRelationships) { _%>
        reference(entities, <%- persistClass %>::<%- rel.id ? primaryKey.propertySupplierName : `${rel.propertySupplierName}Id` %>, <%- rel.otherEntity.persistClass %>::new, <%- rel.otherEntity.persistClass %>::<%- rel.otherEntity.primaryKey.propertyConsumerName %>, <%- persistClass %>::<%- rel.propertyConsumerName %>);
  <%_ } _%>
        return Mono.just(entities)<%- populateCount === 0 ? ';' : '' %>
  <%_ let populateIndex = 0; _%>
  <%_ for (const rel of eagerToOneRelationships) { _%>
    <%_ populateIndex++; _%>
            .flatMap(populated -> populate(populated, <%- persistClass %>::<%- rel.id ? primaryKey.propertySupplierName : `${rel.propertySupplierName}Id` %>, <%- rel.otherEntity.persistClass %>.class, <%- rel.otherEntity.persistClass %>::<%- rel.otherEntity.primaryKey.propertySupplierName %>, <%- persistClass %>::<%- rel.propertyConsumerName %>))<%- populateIndex === populateCount ? ';' : '' %>
  <%_ } _%>
  <%_ for (const rel of eagerJoinTableRelationships) { _%>
    <%_ populateIndex++; _%>
            .flatMap(populated -> populate(populated, <%- joinTableConstant(rel) %>, <%- rel.otherEntity.persistClass %>.class, <%- rel.otherEntity.persistClass %>::<%- rel.otherEntity.primaryKey.propertySupplierName %>, <%- persistClass %>::<%- rel.propertyConsumerName %>))<%- populateIndex === populateCount ? ';' : '' %>
  <%_ } _%>
    }
<%_ } _%>
<%_ if (joinTableRelationships.length > 0) { _%>

    @Override
    protected List<JoinTable<<%- persistClass %>>> joinTables() {
        return JOIN_TABLES;
    }
<%_ } _%>
<%_ if (isUsingMapsId) { _%>

    @Override
    public <S extends <%- persistClass %>> Mono<S> save(S entity) {
        if (entity.<%- primaryKey.propertySupplierName %>() == null && entity.<%- mapsIdAssoc.propertySupplierName %>() != null) {
            entity.<%- primaryKey.propertyConsumerName %>(entity.<%- mapsIdAssoc.propertySupplierName %>().<%- mapsIdAssoc.otherEntity.primaryKey.propertySupplierName %>());
            return template.insert(entity);
        }
        return super.save(entity);
    }
<%_ } _%>
<%_ if (jpaMetamodelFiltering) { _%>

    @Override
    public Flux<<%- persistClass %>> findByCriteria(<%- entityClass %>Criteria criteria, Pageable page) {
        return findAllBy(buildCriteria(criteria), page);
    }

    @Override
    public Mono<Long> countByCriteria(<%- entityClass %>Criteria criteria) {
        return countBy(buildCriteria(criteria));
    }

    private Criteria buildCriteria(<%- entityClass %>Criteria criteria) {
        CriteriaBuilder builder = new CriteriaBuilder();
        if (criteria != null) {
  <%_ for (const field of fields) { _%>
    <%_ if (field.transient) continue; _%>
    <%_ if (field.filterableField) { _%>
            if (criteria.<%- field.propertyFilterSupplierName %>() != null) {
                builder.buildFilterCriteriaForField(criteria.<%- field.propertyFilterSupplierName %>(), "<%- field.fieldName %>");
            }
    <%_ } _%>
  <%_ } _%>
  <%_ for (const relationship of toOneRelationships) { _%>
            if (criteria.<%- relationship.propertyFilterSupplierName %>() != null) {
                builder.buildFilterCriteriaForField(criteria.<%- relationship.propertyFilterSupplierName %>(), "<%- relationship.id ? primaryKey.name : `${relationship.relationshipFieldName}Id` %>");
            }
  <%_ } _%>
        }
        return builder.buildCriteria();
    }
<%_ } _%>
}
