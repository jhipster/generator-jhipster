package <%- packageName %>.config;

import org.slf4j.LoggerFactory;
import org.springframework.boot.test.context.TestConfiguration;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.springframework.context.annotation.Bean;
<%_ if (reactive) { _%>
import org.springframework.test.context.DynamicPropertyRegistrar;
<%_ } _%>
import <%- testcontainerClassPackage %>.<%- testcontainerClass %>;
import org.testcontainers.containers.output.Slf4jLogConsumer;

<%_ const containerType = `${testcontainerClass}${useTestcontainersV1 ? '<?>' : ''}`; _%>
@TestConfiguration(proxyBeanMethods = false)
public class DatabaseTestcontainer {

    private static final <%- containerType %> DATABASE_CONTAINER = <%- useTestcontainersV1 ? `(${testcontainerClass}) ` : '' %>new <%- testcontainerClass %><%- useTestcontainersV1 ? '<>' : '' %>("<%- testcontainerDockerImageName %>")
        .withDatabaseName("<%- baseName %>")
        <%- testcontainerClassInitialization %>
        .withLogConsumer(new Slf4jLogConsumer(LoggerFactory.getLogger(DatabaseTestcontainer.class)))
        .withReuse(true);

    @Bean
    @ServiceConnection
    <%- containerType %> databaseContainer() {
        return DATABASE_CONTAINER;
    }
<%_ if (reactive) { _%>

    @Bean
    DynamicPropertyRegistrar databaseProperties(<%- containerType %> databaseContainer) {
        return registry -> {
  <%_ if (prodDatabaseExtraOptions) { _%>
            registry.add("spring.liquibase.url", () -> databaseContainer.getJdbcUrl() + "<%- prodDatabaseExtraOptions %>");
  <%_ } else { _%>
            registry.add("spring.liquibase.url", databaseContainer::getJdbcUrl);
  <%_ } _%>
            registry.add("spring.liquibase.user", databaseContainer::getUsername);
            registry.add("spring.liquibase.password", databaseContainer::getPassword);
        };
    }
<%_ } _%>
}
