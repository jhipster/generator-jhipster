package <%- entityAbsolutePackage %>.domain;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

<%_ if (primaryKey.fields.some(field => field.fieldTypeUUID)) { _%>
import java.util.UUID;
<%_ } _%>
import org.junit.jupiter.api.Test;

class <%- primaryKey.type %>Test {

    @Test
    void shouldEscapeKeyPartsInStringRepresentation() {
<%_ const sampleValues = { String: '"a,b%c"', Integer: '1', Long: '1L', UUID: 'UUID.randomUUID()' }; _%>
        <%- primaryKey.type %> key = new <%- primaryKey.type %>(<% for (const [index, field] of primaryKey.fields.entries()) { %><%- index === 0 ? '' : ', ' %><%- sampleValues[field.javaFieldType] %><% } %>);
        assertThat(<%- primaryKey.type %>.valueOf(key.toString())).isEqualTo(key);
    }

    @Test
    void shouldRejectInvalidStringRepresentation() {
        assertThatThrownBy(() -> <%- primaryKey.type %>.valueOf("invalid")).isInstanceOf(IllegalArgumentException.class);
    }
}
