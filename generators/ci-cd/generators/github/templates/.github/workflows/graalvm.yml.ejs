name: Native CI
on:
  push:
    branches: main
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  pipeline:
    name: jhipster native pipeline
    runs-on: ${{ matrix.os }}
    if: "!contains(github.event.head_commit.message, '[ci skip]') && !contains(github.event.head_commit.message, '[skip ci]') && !contains(github.event.pull_request.title, '[skip ci]') && !contains(github.event.pull_request.title, '[ci skip]')"
    timeout-minutes: 90
    env:
<%_ if (!skipClient) { _%>
      NODE_VERSION: <%- nodeVersion %>
<%_ } _%>
<%_ if (!skipServer) { _%>
      SPRING_OUTPUT_ANSI_ENABLED: DETECT
<%_ } _%>
<%_ if (!databaseTypeNo && !skipServer) { _%>
      SPRING_JPA_SHOW_SQL: false
<%_ } _%>
<%_ if (locals.clientFrameworkAngular) { _%>
      NG_CLI_ANALYTICS: false
<%_ } _%>
<%_ if (enableGradleDevelocity) { _%>
      GRADLE_DEVELOCITY_ACCESS_KEY: ${{ secrets.GRADLE_DEVELOCITY_ACCESS_KEY }}
<%_ } _%>
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest]
        java-version: ['25']
        include:
          - os: ubuntu-latest
            executable-suffix: ''
          - os: macos-latest
            executable-suffix: ''
            e2e: false
          - os: windows-latest
            executable-suffix: '.exe'
            # e2e is disabled due to unstable docker step
            e2e: false
    steps:
      - uses: <%- githubActions['actions/checkout'] %>
      - uses: <%- githubActions['actions/setup-node'] %>
        with:
          node-version: <%- nodeVersion %>
      # Make sure that the script-shell is set to bash, otherwise npm scripts will fail on Windows runners
      - run: npm config -L project set script-shell=bash
      - name: Set up GraalVM (Java ${{ matrix.java-version }})
        uses: graalvm/setup-graalvm@v1
        with:
          java-version: '${{ matrix.java-version }}'
          distribution: 'graalvm-community'
          github-token: ${{ secrets.GITHUB_TOKEN }}
          cache: '<%- buildTool %>'
<%_ if (!skipClient) { _%>
      - name: Install node.js packages
        run: npm install
<%_ } _%>
      - name: 'E2E: Package'
        run: npm run native-package
      - name: Archive binary
        uses: <%- githubActions['actions/upload-artifact'] %>
        with:
          name: native-executable${{ matrix.executable-suffix }}
          path: <%- buildToolGradle ? 'build/native/nativeCompile/' : 'target/' %>native-executable${{ matrix.executable-suffix }}
      - name: 'E2E: Prepare'
        if: runner.os == 'Linux'
        run: npm run ci:e2e:prepare
      - name: 'E2E: Run'
        if: runner.os == 'Linux'
        run: npm run native-e2e
