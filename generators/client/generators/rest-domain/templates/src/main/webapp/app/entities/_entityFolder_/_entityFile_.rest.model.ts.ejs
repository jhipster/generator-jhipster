<%_ const entityDir = `${clientSrcDir}app/entities/${entityFolderName}/`;
    const restRelationships = relationships.filter(relationship => relationship.persistableRelationship || relationship.relationshipEagerLoad);
    const restDateTypes = [
      anyFieldIsDuration && `${restDomainPrefix}Duration`,
      anyFieldIsInstant && `${restDomainPrefix}Instant`,
      anyFieldIsLocalDate && `${restDomainPrefix}LocalDate`,
      anyFieldIsLocalTime && `${restDomainPrefix}LocalTime`,
      anyFieldIsZonedDateTime && `${restDomainPrefix}ZonedDateTime`,
    ].filter(Boolean);
    const otherEntities = [...new Set(restRelationships
      .filter(relationship => !relationship.relationshipSerializePrimaryKeyOnly && relationship.otherEntity.entityAngularName !== entityAngularName)
      .map(relationship => relationship.otherEntity))];
    const enumFields = fields.filter((field, index) =>
      field.restDomainEnumTypeName && fields.findIndex(other => other.fieldType === field.fieldType) === index);
    // The imports in the order of their paths, as the linter sorts them.
    const restImports = [
      ...restDateTypes.length > 0 ? [{ names: restDateTypes.join(', '), path: `${relativeDir(entityDir, `${clientSrcDir}app/shared/jhipster/`)}rest.model` }] : [],
      ...otherEntities.map(otherEntity => ({
        names: otherEntity.restDomainTypeName,
        path: `${relativeDir(entityDir, `${clientSrcDir}app/entities/${otherEntity.entityFolderName}/`)}${otherEntity.entityFileName}.rest.model`,
      })),
      ...enumFields.map(field => ({ names: field.restDomainEnumTypeName, path: `${relativeDir(entityDir, `${clientSrcDir}app/entities/enumerations/`)}${field.enumFileName}.rest.model` })),
    ].sort((a, b) => a.path.localeCompare(b.path));
_%>
<%_ for (const { names, path } of restImports) { _%>
import type { <%- names %> } from '<%- path %>';
<%_ } _%>
<%_ if (restImports.length > 0) { _%>

<%_ } _%>
/**
 * The <%- entityAngularName %> entity, as the REST API sends it.
 */
export interface <%- restDomainTypeName %> {
<%_ for (const field of fields) { _%>
  <%_ if (field.fieldWithContentType) { _%>
  <%- field.fieldName %>ContentType: <%- field.restDomainNullable ? 'string | null' : 'string' %>;
  <%_ } _%>
  <%- field.fieldName %>: <%- field.restDomainType %>;
<%_ } _%>
<%_ for (const relationship of restRelationships) { _%>
  <%- relationship.propertyName %>: <%- relationship.restDomainType %>;
<%_ } _%>
}
<%_ if (primaryKey && !readOnly) { _%>

  <%_ if (restDomainNewProperties.length > 0) { _%>
/**
 * A new <%- entityAngularName %>, sent to the REST API without the values the server generates.
 */
export type New<%- restDomainTypeName %> = Omit<<%- restDomainTypeName %>, <%- restDomainNewProperties.map(({ name }) => `'${name}'`).join(' | ') %>> & { <%- restDomainNewProperties.map(({ name, type }) => `${name}: ${type}`).join('; ') %> };
  <%_ } else { _%>
/**
 * A new <%- entityAngularName %>, sent to the REST API with its primary key, which the server does not generate.
 */
export type New<%- restDomainTypeName %> = <%- restDomainTypeName %>;
  <%_ } _%>
  <%_ if (updatableEntity) { _%>

/**
 * The fields of a <%- entityAngularName %> a partial update sends, with its primary key.
 */
export type PartialUpdate<%- restDomainTypeName %> = Partial<<%- restDomainTypeName %>> & Pick<<%- restDomainTypeName %>, '<%- primaryKey.name %>'>;
  <%_ } _%>
<%_ } _%>
