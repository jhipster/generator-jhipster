// The dates and times of the REST API, as the server sends them in ISO 8601.

/** A `LocalDate`, like `2026-11-18`. */
export type <%- restDomainPrefix %>LocalDate = string;
/** An `Instant`, in UTC, like `2026-11-18T10:00:00Z`. */
export type <%- restDomainPrefix %>Instant = string;
/** A `ZonedDateTime`, with its offset, like `2026-11-18T10:00:00-03:00`. */
export type <%- restDomainPrefix %>ZonedDateTime = string;
/** A `Duration`, like `PT1H30M`. */
export type <%- restDomainPrefix %>Duration = string;
/** A `LocalTime`, like `10:00:00`. */
export type <%- restDomainPrefix %>LocalTime = string;
