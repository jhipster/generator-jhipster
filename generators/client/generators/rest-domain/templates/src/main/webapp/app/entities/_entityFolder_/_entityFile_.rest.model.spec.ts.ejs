<%_ const writeNew = primaryKey && !readOnly; _%>
import { describe, expectTypeOf, it } from 'vitest';

import type { <%- writeNew ? `New${restDomainTypeName}, ` : '' %><%- restDomainTypeName %> } from './<%- entityFileName %>.rest.model';

describe('<%- restDomainTypeName %>', () => {
  it('should be null only for the fields the database may have no value of', () => {
<%_ for (const field of fields) { _%>
    expectTypeOf<<%- restDomainTypeName %>['<%- field.fieldName %>']>()<%- field.restDomainNullable ? '' : '.not' %>.toBeNullable();
<%_ } _%>
  });
<%_ if (writeNew && restDomainNewProperties.length > 0) { _%>

  it('should send a new entity with the values the server generates as null', () => {
  <%_ for (const { name, type } of restDomainNewProperties) { _%>
    <%_ if (type === 'null') { _%>
    expectTypeOf<New<%- restDomainTypeName %>['<%- name %>']>().toEqualTypeOf<null>();
    <%_ } else { _%>
    expectTypeOf<New<%- restDomainTypeName %>['<%- name %>']>().toEqualTypeOf<<%- restDomainTypeName %>['<%- name %>'] | null>();
    <%_ } _%>
  <%_ } _%>
  });
<%_ } else if (writeNew) { _%>

  it('should send a new entity with the primary key the server does not generate', () => {
    expectTypeOf<New<%- restDomainTypeName %>>().toEqualTypeOf<<%- restDomainTypeName %>>();
  });
<%_ } _%>
});
