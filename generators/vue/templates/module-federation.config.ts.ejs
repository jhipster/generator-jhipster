import type { createModuleFederationConfig } from '@module-federation/sdk';

import packageJson from './package.json' with { type: 'json' };

// Microfrontend API, should match across gateway and microservices.
const apiVersion = '0.0.1';

const sharedDefaults = { singleton: true, strictVersion: true, requiredVersion: apiVersion };
// Application modules are not installed packages, `import` points the federation plugin to the source file, relative to
// the root of the bundler: it provides the module even when only a lazy chunk or another shared module imports it.
const shareMappings = (...mappings: string[]) =>
  Object.fromEntries(
    mappings.map(map => [
      map,
      { ...sharedDefaults, version: apiVersion, import: `./<%- clientBundlerVite ? relativeDir(clientRootDir, clientSrcDir) : '' %>${map.replace('@/', 'app/')}` },
    ]),
  );

const shareDependencies = ({ skipList = [] }: { skipList?: string[] } = {}) =>
  Object.fromEntries(
    Object.entries(packageJson.dependencies)
      .filter(([dependency]) => !skipList.includes(dependency))
      .map(([dependency, version]) => [dependency, { ...sharedDefaults, version, requiredVersion: version }]),
  );

export default {
  name: '<%- lowercaseBaseName.replaceAll('-', '_') %>',
  exposes: {
<%_ if (applicationTypeMicroservice || exposeMicrofrontend) { _%>
    './entities-router': './app/entities/entities.routes.ts',
    './entities-menu': './app/entities/entities-menu.vue',
<%_ } _%>
    // jhipster-needle-expose
  },
  filename: 'remoteEntry.js',
  shareScope: 'default',
  shared: {
    ...shareDependencies(),
    // Application modules shared as singletons across the gateway and the microfrontends, from app/shared.
    ...shareMappings(
      '@/shared/jhipster/constants',
      '@/shared/jhipster/data-utils',
<%_ if (communicationSpringWebsocket) { _%>
      '@/shared/jhipster/encode-csrf-token',
<%_ } _%>
      '@/shared/jhipster/error.constants',
      '@/shared/jhipster/headers',
      '@/shared/jhipster/link-header',
      '@/shared/jhipster/problem-details',
      '@/shared/alert/alert.service',
      '@/shared/language/translation.service',
    ),
  },
  dts: false,
  manifest: true,
} as const satisfies Parameters<typeof createModuleFederationConfig>[0];
