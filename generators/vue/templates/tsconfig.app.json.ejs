{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["<%- relativeDir(clientRootDir, clientSrcDir) %>**/*", "<%- relativeDir(clientRootDir, clientSrcDir) %>app/**/*.vue"],
  "exclude": ["<%- relativeDir(clientRootDir, clientSrcDir) %>app/**/*.spec.ts"],
  "compilerOptions": {
    "composite": true,
    "outDir": "<%- relativeDir(clientRootDir, temporaryDir) %>out-tsc/dist",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./<%- relativeDir(clientRootDir, clientSrcDir) %>app/*"]
    }
  }
}
