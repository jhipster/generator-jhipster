const compareString = (a: string, b: string): number => a.localeCompare(b);

const asString = (val: unknown): string => (typeof val === 'string' ? val : `${val}`);

const compareAny = (a: unknown, b: unknown): number => {
  if (b == null) return 1;
  if (a == null) return -1;

  return (a as number) - (b as number);
};

const property = (el: object, prop: string): unknown => (el as Record<string, unknown>)[prop];

export type OrderByOptions = { orderByProp: string; reverse?: boolean };

export const orderBy = <T extends object>(array: T[] | undefined, opts: OrderByOptions): T[] | undefined => {
  if (!Array.isArray(array)) return array;

  const { orderByProp, reverse = false } = opts;
  let sorted: T[];
  if (array.some(el => typeof property(el, orderByProp) === 'string')) {
    sorted = array.sort((a, b) => compareString(asString(property(a, orderByProp)), asString(property(b, orderByProp))));
  } else {
    sorted = array.sort((a, b) => compareAny(property(a, orderByProp), property(b, orderByProp)));
  }
  if (reverse) {
    return sorted.slice().reverse();
  }
  return sorted;
};

export type FilterByOptions = { filterByTerm: string; filterMaxDepth?: number };

const filterObject = (val: unknown, opts: FilterByOptions): boolean => {
  const { filterByTerm, filterMaxDepth = 2 } = opts;
  if (typeof val === 'string') {
    return val.toLocaleLowerCase().startsWith(filterByTerm);
  }
  if (val !== null && typeof val === 'object') {
    if (filterMaxDepth < 0) return false;
    for (const value of Object.values(val)) {
      if (filterObject(value, { filterByTerm, filterMaxDepth: filterMaxDepth - 1 })) return true;
    }
    return false;
  }
  return `${val}`.toLocaleLowerCase().startsWith(filterByTerm);
};

export const filterBy = <T>(array: T[] | undefined, opts: FilterByOptions): T[] | undefined => {
  return Array.isArray(array) && opts.filterByTerm
    ? array.filter(el => filterObject(el, { ...opts, filterByTerm: opts.filterByTerm.toLocaleLowerCase() }))
    : array;
};

export const orderAndFilterBy = <T extends object>(array: T[] | undefined, opts: FilterByOptions & OrderByOptions): T[] | undefined =>
  orderBy(filterBy(array, opts), opts);
