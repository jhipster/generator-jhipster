import { format } from 'node:util';
import { afterEach, beforeAll, beforeEach, vi } from 'vitest'
<%_ if (enableTranslation) { _%>
import { createI18n } from 'vue-i18n';
<%_ } _%>

<%_ if (enableTranslation) { _%>
import { config } from '@vue/test-utils';
<%_ } _%>
import axios from 'axios';

beforeAll(() => {
  globalThis.location.href = 'https://jhipster.tech/';

  // Make sure axios is never executed.
  axios.interceptors.request.use(request => {
    throw new Error(`Error axios should be mocked ${request.url}`);
  });
<%_ if (enableTranslation) { _%>

  config.global.plugins.push(
    createI18n({
      legacy: false,
      missingWarn: false,
      fallbackWarn: false,
    }),
  );
<%_ } _%>
});

// A warning or an error printed, of Vue or of the application, fails the test that prints it: a test that expects one mocks the console.
// The test fails once it ends: an error thrown by the console would stop Vue in the middle of its warning, which would hide its next ones.
let printed: Error[] = [];

beforeEach(() => {
  printed = [];
  for (const method of ['warn', 'error'] as const) {
    vi.spyOn(console, method).mockImplementation((...args: unknown[]) => {
      printed.push(new Error(format(...args)));
    });
  }
});

afterEach(() => {
  if (printed.length > 0) {
    throw printed[0];
  }
});
