import { beforeEach, describe, expect, it, vi } from 'vitest';
import { ref } from 'vue';

import { RouterLinkStub, type VueWrapper, shallowMount } from '@vue/test-utils';

<%_ if (authenticationTypeOauth2) { _%>
import { loginServiceKey } from '@/account/login.service';
<%_ } _%>
import { authenticatedKey, currentUsernameKey } from '@/config/injection-keys';

import Home from './home.vue';

type HomeComponentType = InstanceType<typeof Home>;

describe('Home', () => {
  let home: HomeComponentType;
  let wrapper: VueWrapper<HomeComponentType>;
  let authenticated;
  let currentUsername;

<%_ if (authenticationTypeOauth2) { _%>
  const loginService = { login: vi.fn(), logout: vi.fn() };
<%_ } _%>
  beforeEach(() => {
    authenticated = ref(false);
    currentUsername = ref('');
    wrapper = shallowMount(Home, {
      global: {
        stubs: {
          'router-link': RouterLinkStub,
        },
        provide: {
<%_ if (authenticationTypeOauth2) { _%>
          [loginServiceKey as symbol]: loginService,
<%_ } _%>
          [authenticatedKey as symbol]: authenticated,
          [currentUsernameKey as symbol]: currentUsername,
        },
      },
    });
    home = wrapper.vm;
  });

  it('should not have user data set', () => {
    expect(home.authenticated).toBeFalsy();
    expect(home.username).toBe('');
  });

  it('should have user data set after authentication', () => {
    authenticated.value = true;
    currentUsername.value = 'test';

    expect(home.authenticated).toBeTruthy();
    expect(home.username).toBe('test');
  });

<%_ if (authenticationTypeOauth2) { _%>
  it('should use login service', () => {
    home.login();
    expect(loginService.login).toHaveBeenCalled();
  });

  it('should log in from the link of the page', async () => {
    await wrapper.find('a.alert-link').trigger('click');

    expect(loginService.login).toHaveBeenCalled();
  });
<%_ } else { _%>
  it('should link to the login page', () => {
    expect(wrapper.findAllComponents(RouterLinkStub).map(link => link.props('to'))).toContain('/login');
  });
<%_ } _%>
});
