<%_ if (!authenticationTypeOauth2) { _%>
import { type Router } from 'vue-router';

<%_ } _%>
import { type AxiosError } from 'axios';

import type AccountService from './account.service';

/**
 * What an error of the server does to the session: a 401 signs the user out and asks for a new authentication.
 */
export const createUnauthorizedHandler =
  ({ accountService<%- authenticationTypeOauth2 ? '' : ', router' %> }: { accountService: AccountService<%- authenticationTypeOauth2 ? '' : '; router: Router' %> }) =>
  (error: AxiosError) => {
    const url = error.response?.config?.url;
    const status = error.status || error.response?.status;
    if (status === 401) {
      accountService.logout();
      if (!url?.endsWith('api/account') && !url?.endsWith('api/<%- authenticationTypeSession ? 'authentication' : 'authenticate' %>')) {
        // Ask for a new authentication
<%_ if (authenticationTypeOauth2) { _%>
        window.location.reload();
<%_ } else { _%>
        const { fullPath, path } = router.currentRoute.value;
        if (path !== '/login') {
          router.push({ path: '/login', query: { redirect: fullPath } });
        }
<%_ } _%>
      }
    }
    // The caller fails, a 401 left out of its alerts.
    return Promise.reject(error);
  };
