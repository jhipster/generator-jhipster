import { beforeEach, describe, expect, it, vi } from 'vitest';

import { defineComponent, h } from 'vue';

import { flushPromises, shallowMount } from '@vue/test-utils';
import axios from 'axios';

import { metricsEndpoints, toMetrics } from '@/shared/jhipster/metrics';
import { type MetricsSection } from '@/shared/jhipster/metrics.model';

import MetricsService, { metricsServiceKey } from './metrics.service';
import Metrics from './metrics.vue';

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
};

vi.mock('@/shared/jhipster/metrics', () => ({ metricsEndpoints: ['metrics', 'threads'], toMetrics: vi.fn() }));

// Each endpoint answers with its own name.
const respond = (url?: string) => Promise.resolve({ data: url });

const sections: MetricsSection[] = [
  {
    id: 'memory',
    label: { text: 'Memory' },
    blocks: [
      {
        label: { text: 'Heap' },
        items: [{ label: { text: 'Used' }, value: '10 MB', gauge: { percent: 10, text: '10%', status: 'success' } }],
        details: {
          label: { text: 'Heap' },
          showLines: { text: 'Show' },
          hideLines: { text: 'Hide' },
          columns: [{ text: 'Value' }],
          filters: [],
          items: [{ title: 'Item', value: 'value', status: 'info', lines: [], cells: ['cell'] }],
        },
      },
    ],
    tables: [{ columns: [{ label: { text: 'Pool' } }, { label: { text: 'Used' }, numeric: true }], rows: [[{ text: 'Eden' }, { text: '1' }]] }],
  },
  { id: 'empty', label: { text: 'Empty' }, blocks: [], tables: [] },
];

describe('Metrics Component', () => {
  const show = vi.fn();
  const contentStub = defineComponent({
    setup(_props, { slots }) {
      return () => h('div', [slots.title?.(), slots.default?.(), slots.footer?.()]);
    },
    methods: {
      show,
    },
  });

  const mountMetrics = () =>
    shallowMount(Metrics, {
      global: {
        stubs: { bModal: contentStub, bProgress: contentStub, bProgressBar: true, 'font-awesome-icon': true, MetricsModal: true },
        provide: { [metricsServiceKey as symbol]: new MetricsService() },
      },
    });

  beforeEach(() => {
    vi.mocked(toMetrics).mockReturnValue(sections);
    axiosStub.get.mockImplementation(respond);
  });

  it('should load the sections on init', async () => {
    // WHEN
    const wrapper = mountMetrics();
    await flushPromises();

    // THEN
    for (const endpoint of metricsEndpoints) {
      expect(axiosStub.get).toHaveBeenCalledWith(endpoint);
    }
    expect(toMetrics).toHaveBeenCalledWith(metricsEndpoints);
    expect(wrapper.vm.sections).toEqual(sections);
    expect(wrapper.vm.updatingMetrics).toBe(false);
  });

  it('should render the sections and open the details of a block', async () => {
    // GIVEN
    const wrapper = mountMetrics();
    await flushPromises();

    // WHEN
    await wrapper.find('button.btn-sm').trigger('click');

    // THEN
    expect(wrapper.findAll('h3')).toHaveLength(wrapper.vm.sections.length);
    expect(wrapper.find('table').exists()).toBe(true);
    expect(show).toHaveBeenCalled();
  });

  it('should stop updating when a request fails', async () => {
    // GIVEN
    axiosStub.get.mockRejectedValue(new Error('failed'));

    // WHEN
    const wrapper = mountMetrics();
    await flushPromises();

    // THEN
    expect(wrapper.vm.updatingMetrics).toBe(false);
  });

  it('should use the default service', async () => {
    // WHEN
    shallowMount(Metrics, { global: { stubs: { bModal: true, bProgress: true, bProgressBar: true, 'font-awesome-icon': true, MetricsModal: true } } });
    await flushPromises();

    // THEN
    expect(axiosStub.get).toHaveBeenCalledWith(metricsEndpoints[0]);
  });
});
