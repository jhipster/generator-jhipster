import { type Mock, type MockInstance, beforeEach, describe, expect, it, vi } from 'vitest';
import { type Router, createMemoryHistory, createRouter } from 'vue-router';

import { type VueWrapper, shallowMount } from '@vue/test-utils';
import axios from 'axios';
import { Subject, type Subscription } from 'rxjs';

import <%- jhiPrefixCapitalized %>Tracker from './tracker.vue';
import { type TrackerActivity, trackerServiceKey } from './tracker.service';

type <%- jhiPrefixCapitalized %>TrackerComponentType = InstanceType<typeof <%- jhiPrefixCapitalized %>Tracker>;

const trackerActivity = (sessionId: string, page: string): TrackerActivity => ({
  sessionId,
  userLogin: 'user',
  ipAddress: '127.0.0.1',
  page,
  time: '2020-01-01',
});

let router: Router;

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
};

describe('<%- jhiPrefixCapitalized %>Tracker', () => {
  let wrapper: VueWrapper<<%- jhiPrefixCapitalized %>TrackerComponentType>;
  let trackerView: <%- jhiPrefixCapitalized %>TrackerComponentType;

  let subject: Subject<Partial<TrackerActivity>>;
  let subscription: Subscription;
  let subscriptionSpy: MockInstance;
  let trackerServiceStub: { subscribe: Mock; sendActivity: Mock };

  beforeEach(() => {
    axiosStub.get.mockResolvedValue({ data: {} });
    subject = new Subject<Partial<TrackerActivity>>();
    trackerServiceStub = {
      subscribe: vi.fn().mockImplementation(observer => {
        subscription = subject.subscribe(observer);
        subscriptionSpy = vi.spyOn(subscription, 'unsubscribe');
        return subscription;
      }),
      sendActivity: vi.fn(),
    };

    router = createRouter({ history: createMemoryHistory(), routes: [] });

    wrapper = shallowMount(<%- jhiPrefixCapitalized %>Tracker, {
      global: {
        plugins: [router],
        stubs: {
          'font-awesome-icon': true,
        },
        provide: {
          [trackerServiceKey as symbol]: trackerServiceStub,
        },
      },
    });
    trackerView = wrapper.vm;
  });

  it('should subscribe', () => {
    expect(trackerServiceStub.subscribe).toHaveBeenCalledOnce();
  });

  it('should unsubscribe at unmount', () => {
    // WHEN
    wrapper.unmount();

    // THEN
    expect(subscriptionSpy).toHaveBeenCalledOnce();
  });

  it('should add new activity', () => {
    // GIVEN
    const activity1 = trackerActivity('123', 'login');
    trackerView.activities = [activity1];

    // WHEN
    const activity2 = trackerActivity('456', 'login');
    subject.next(activity2);

    // THEN
    expect(trackerView.activities).toEqual([activity1, activity2]);
  });

  it('should not add logout activity', () => {
    // WHEN
    subject.next(trackerActivity('123', 'logout'));

    // THEN
    expect(trackerView.activities).toEqual([]);
  });

  it('should update user activity', () => {
    // GIVEN
    trackerView.activities = [trackerActivity('123', 'login')];

    // WHEN
    const activity = trackerActivity('123', 'login');
    subject.next(activity);

    // THEN
    expect(trackerView.activities).toEqual([activity]);
  });

  it('should remove user activity', () => {
    // GIVEN
    trackerView.activities = [trackerActivity('123', 'login')];

    // WHEN
    subject.next(trackerActivity('123', 'logout'));

    // THEN
    expect(trackerView.activities).toEqual([]);
  });
});
