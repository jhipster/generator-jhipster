import axios from 'axios';

/** A bean of the configuration properties endpoint. */
export interface ConfigurationBean {
  prefix: string;
  properties?: Record<string, unknown>;
}

interface ConfigProps {
  contexts: Record<string, { beans: Record<string, ConfigurationBean> }>;
}

interface Env {
  propertySources: { name: string; properties: Record<string, { value: unknown }> }[];
}

/** The properties of each property source of the environment endpoint. */
export type EnvConfiguration = Record<string, { key: string; val: unknown }[]>;

export default class ConfigurationService {
  async loadConfiguration(): Promise<ConfigurationBean[]> {
    const res = await axios.get<ConfigProps>('management/configprops');
    const properties = Object.values(this.getConfigPropertiesObjects(res.data));
    properties.sort((propertyA, propertyB) => {
      const comparePrefix = propertyA.prefix < propertyB.prefix ? -1 : 1;
      return propertyA.prefix === propertyB.prefix ? 0 : comparePrefix;
    });
    return properties;
  }

  async loadEnvConfiguration(): Promise<EnvConfiguration> {
    const res = await axios.get<Env>('management/env');
    return Object.fromEntries(
      res.data.propertySources.map(({ name, properties }) => [
        name,
        Object.entries(properties).map(([key, property]) => ({ key, val: property.value })),
      ]),
    );
  }

  private getConfigPropertiesObjects(res: ConfigProps): Record<string, ConfigurationBean> {
    // The ApplicationContext ID, not a bootstrap one: the baseName for an application, baseName-1 for a microservice.
    const contextKey = Object.keys(res.contexts).find(key => !key.startsWith('bootstrap') || key === '<%- baseName %>');
    return res.contexts[contextKey as string].beans;
  }
}
