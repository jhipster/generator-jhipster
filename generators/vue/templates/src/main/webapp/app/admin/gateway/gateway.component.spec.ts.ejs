import { describe, expect, it, vi } from 'vitest';

import { flushPromises, shallowMount } from '@vue/test-utils';
import axios from 'axios';

import Gateway from './gateway.vue';

const routes = [
  { path: '/services/a/**', serviceId: 'a', serviceInstances: [] },
  {
    path: '/services/b/**',
    serviceId: 'b',
    serviceInstances: [
      { uri: 'http://b1', metadata: { zone: 'one' }, healthService: { checks: [{ status: 'PASSING' }] }, instanceInfo: { status: 'UP' } },
      { uri: 'http://b2', metadata: {}, healthService: { checks: [{ status: 'PASSING' }, { status: 'CRITICAL' }] }, instanceInfo: { status: 'DOWN' } },
      { uri: 'http://b3', metadata: {} },
    ],
  },
];

describe('Gateway Component', () => {
  it('should list the routes and their instances, refreshing them', async () => {
    // GIVEN
    const get = vi.spyOn(axios, 'get').mockImplementation(async () => ({ data: structuredClone(routes) }));
    const wrapper = shallowMount(Gateway, {
      global: {
        stubs: {
          'font-awesome-icon': true,
        },
      },
    });
    await flushPromises();

    // WHEN
    await wrapper.find('button').trigger('click');
    await flushPromises();

    // THEN
    expect(wrapper.find('#gateway-page-heading').exists()).toBe(true);
    expect(get).toHaveBeenCalledTimes(2);
    expect(wrapper.vm.gatewayRoutes[1].serviceInstances.map(instance => instance.instanceInfo?.status)).toEqual(['UP', 'DOWN', undefined]);
    expect(wrapper.text()).toContain('http://b1');
    get.mockRestore();
  });
});
