<template>
  <div>
    <h2>
      <span id="metrics-page-heading" data-cy="metricsPageHeading">{{ t$('metrics.title') }}</span>
      <button class="btn btn-primary float-end" :disabled="updatingMetrics" @click="refresh()">
        <font-awesome-icon icon="sync"></font-awesome-icon> <span>{{ t$('metrics[\'refresh.button\']') }}</span>
      </button>
    </h2>

    <div v-if="updatingMetrics" class="alert alert-info">{{ t$('metrics.updating') }}</div>

    <template v-for="section of sections" :key="section.id">
      <h3 :id="section.id">{{ labelText(section.label) }}</h3>

      <div v-if="section.blocks.length > 0" class="row">
        <div v-for="(block, blockIndex) of section.blocks" :key="blockIndex" class="col-md-4">
          <h4 v-if="block.label">{{ labelText(block.label) }}</h4>

          <template v-for="(item, itemIndex) of block.items" :key="itemIndex">
            <div class="d-flex flex-wrap justify-content-between column-gap-2">
              <span>{{ labelText(item.label) }}</span>
              <span>{{ item.value }}</span>
            </div>
            <div v-if="item.note">{{ item.note }}</div>
            <b-progress v-if="item.gauge" :max="100">
              <b-progress-bar :variant="item.gauge.status" striped :value="item.gauge.percent" :label="item.gauge.text"></b-progress-bar>
            </b-progress>
          </template>

          <button v-if="block.details" class="hand btn btn-primary btn-sm mt-2" @click="openModal(block.details)">
            <span>Expand</span>
          </button>
        </div>
      </div>

      <div v-for="(table, tableIndex) of section.tables" :key="tableIndex" class="table-responsive">
        <table class="table table-striped" :aria-describedby="section.id">
          <thead>
            <tr>
              <th v-for="(column, columnIndex) of table.columns" :key="columnIndex" scope="col" :class="{ 'text-end': column.numeric }">
                {{ labelText(column.label) }}
              </th>
            </tr>
          </thead>
          <tbody>
            <tr v-for="(row, rowIndex) of table.rows" :key="rowIndex">
              <td v-for="(cell, cellIndex) of row" :key="cellIndex" :class="{ 'text-end': table.columns[cellIndex].numeric }">
                <b-progress v-if="cell.gauge" :max="100">
                  <b-progress-bar :variant="cell.gauge.status" striped :value="cell.gauge.percent" :label="cell.gauge.text"></b-progress-bar>
                </b-progress>
                <template v-else>{{ cell.text }}</template>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </template>

    <b-modal ref="metricsModal" size="lg" ok-only>
      <template #title>
        <h4 class="modal-title" id="showMetricsLabel">{{ details ? labelText(details.label) : '' }}</h4>
      </template>
      <MetricsModal v-if="details" :details="details"></MetricsModal>
    </b-modal>
  </div>
</template>

<script setup lang="ts">
import { inject, onMounted, ref } from 'vue';
<%_ if (enableTranslation) { _%>
import { useI18n } from 'vue-i18n';
<%_ } _%>

import { type Label } from '@/shared/jhipster/label';
import { type MetricDetails, type MetricsSection } from '@/shared/jhipster/metrics';

import MetricsModal from './metrics-modal.vue';
import MetricsService, { metricsServiceKey } from './metrics.service';

defineOptions({ name: '<%- jhiPrefixCapitalized %>Metrics' });

<%_ if (enableTranslation) { _%>
const { t: t$, te } = useI18n();
<%_ } _%>
const metricsService = inject(metricsServiceKey, () => new MetricsService(), true);

<%_ if (enableTranslation) { _%>
const labelText = ({ text, translationKey }: Label): string => (translationKey && te(translationKey) ? t$(translationKey) : text);
<%_ } else { _%>
const labelText = ({ text }: Label): string => text;
<%_ } _%>

const sections = ref<MetricsSection[]>([]);
const details = ref<MetricDetails>();
const updatingMetrics = ref(true);

const metricsModal = ref<{ show: () => void } | null>(null);

const refresh = (): Promise<void> => {
  updatingMetrics.value = true;
  return metricsService
    .getMetrics()
    .then(res => {
      sections.value = res;
    })
    .catch(() => undefined)
    .finally(() => {
      updatingMetrics.value = false;
    });
};

const openModal = (blockDetails: MetricDetails): void => {
  details.value = blockDetails;
  metricsModal.value?.show();
};

onMounted(() => {
  refresh();
});
</script>
