import { describe, expect, it } from 'vitest';

import { shallowMount } from '@vue/test-utils';

import { type MetricDetails } from '@/shared/jhipster/metrics.model';

import MetricsModal from './metrics-modal.vue';

const details: MetricDetails = {
  label: { text: 'Details' },
  showLines: { text: 'Show' },
  hideLines: { text: 'Hide' },
  columns: [{ text: 'Column' }],
  filters: [
    { label: { text: 'All' }, count: 2, status: 'primary' },
    { label: { text: 'One' }, value: 'ONE', count: 1, status: 'success' },
  ],
  items: [
    { title: 'first', value: 'ONE', status: 'success', lines: ['a line'], cells: ['a cell'] },
    { title: 'second', value: 'TWO', status: 'danger', lines: [], cells: [] },
  ],
};

describe('MetricsModal', () => {
  it('should filter the items by value and by title', async () => {
    const wrapper = shallowMount(MetricsModal, { props: { details } });
    const filters = wrapper.findAll('.hand');
    expect(wrapper.findAll('h6')).toHaveLength(2);

    await filters[1].trigger('click');
    expect(wrapper.findAll('h6')).toHaveLength(1);

    await filters[0].trigger('click');
    await wrapper.find('input').setValue('SECOND');
    expect(wrapper.text()).toContain('second');
    expect(wrapper.text()).not.toContain('first');
  });

  it('should show and hide the lines of an item', async () => {
    const wrapper = shallowMount(MetricsModal, { props: { details } });
    expect(wrapper.text()).not.toContain('a line');

    await wrapper.find('a').trigger('click');
    expect(wrapper.text()).toContain('a line');
    expect(wrapper.find('a').text()).toBe('Hide');

    await wrapper.find('a').trigger('click');
    expect(wrapper.text()).not.toContain('a line');
  });

  it('should show the cells of the items', () => {
    const wrapper = shallowMount(MetricsModal, { props: { details } });

    expect(wrapper.text()).toContain('Column');
    expect(wrapper.text()).toContain('a cell');
  });
});
