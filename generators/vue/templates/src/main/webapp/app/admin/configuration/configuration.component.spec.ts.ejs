import { beforeEach, describe, expect, it, vi } from 'vitest';

import { flushPromises, shallowMount } from '@vue/test-utils';
import axios from 'axios';

import Configuration from './configuration.vue';

type ConfigurationComponentType = InstanceType<typeof Configuration>;

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
};

describe('Configuration Component', () => {
  let configuration: ConfigurationComponentType;

  beforeEach(() => {
    axiosStub.get.mockResolvedValue({
      data: { contexts: [{ beans: [{ prefix: 'A' }, { prefix: 'B' }] }], propertySources: [{ properties: { key1: { value: 'value' } } }] },
    });
    const wrapper = shallowMount(Configuration, {
      global: {
        stubs: {
          'jhi-sort-indicator': true,
        },
      },
    });
    configuration = wrapper.vm;
  });

  describe('OnRouteEnter', () => {
    it('should set all default values correctly', () => {
      expect(configuration.configKeys).toEqual([]);
      expect(configuration.filtered).toBe('');
      expect(configuration.orderProp).toBe('prefix');
      expect(configuration.reverse).toBe(false);
    });
    it('Should call load all on init', async () => {
      // WHEN
      configuration.init();
      await configuration.$nextTick();

      // THEN
      expect(axiosStub.get).toHaveBeenCalledWith('management/env');
      expect(axiosStub.get).toHaveBeenCalledWith('management/configprops');
    });
  });

  describe('keys method', () => {
    it('should return the keys of an Object', () => {
      // GIVEN
      const data = {
        key1: 'test',
        key2: 'test2',
      };

      // THEN
      expect(configuration.keys(data)).toEqual(['key1', 'key2']);
      expect(configuration.keys(undefined)).toEqual([]);
    });
  });

  describe('changeOrder function', () => {
    it('should change order', () => {
      // GIVEN
      const rev = configuration.reverse;

      // WHEN
      configuration.changeOrder('prefix');

      // THEN
      expect(configuration.orderProp).toBe('prefix');
      expect(configuration.reverse).toBe(!rev);
    });
  });
});

describe('Configuration view', () => {
  it('should list the configuration, sort it and filter it', async () => {
    // GIVEN
    vi.spyOn(axios, 'get').mockImplementation((url?: string) =>
      Promise.resolve({
        data:
          url === 'management/env'
            ? { propertySources: [{ name: 'source', properties: { key1: { value: 'value1' } } }] }
            : {
                contexts: {
                  bootstrap: { beans: {} },
                  jhipsterVue: {
                    beans: {
                      b: { prefix: 'B', properties: { key2: 'value2' } },
                      a: { prefix: 'A', properties: { key3: 'value3' } },
                      a2: { prefix: 'A' },
                    },
                  },
                },
              },
      }),
    );
    const wrapper = shallowMount(Configuration, { global: { stubs: { 'jhi-sort-indicator': true } } });
    await flushPromises();

    // WHEN
    for (const element of wrapper.findAll('th')) {
      await element.trigger('click');
    }
    await wrapper.find('input').setValue('b');

    // THEN
    expect(wrapper.vm.configuration.map(({ prefix }) => prefix)).toEqual(['A', 'A', 'B']);
    expect(wrapper.vm.configKeys).toEqual([['key3'], ['key2']]);
    expect(wrapper.vm.allConfiguration).toEqual({ source: [{ key: 'key1', val: 'value1' }] });
    expect(wrapper.vm.filteredConfiguration).toEqual([expect.objectContaining({ prefix: 'B' })]);
    expect(wrapper.text()).toContain('value2');
  });
});
