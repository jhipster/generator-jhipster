import { describe, expect, it } from 'vitest';

import { shallowMount } from '@vue/test-utils';

import HealthModal from './health-modal.vue';

describe('Health Modal view', () => {
  it('should show the details and the error of a health', () => {
    // WHEN
    const wrapper = shallowMount(HealthModal, {
      props: {
        currentCheck: {
          id: 'db',
          label: { text: 'db' },
          status: { text: 'DOWN' },
          healthy: false,
          details: [{ key: 'database', value: 'H2' }],
          error: 'failed',
        },
      },
    });

    // THEN
    expect(wrapper.text()).toContain('H2');
    expect(wrapper.text()).toContain('failed');
  });

  it('should show nothing without a health', () => {
    // WHEN
    const wrapper = shallowMount(HealthModal);

    // THEN
    expect(wrapper.text()).not.toContain('failed');
  });
});
