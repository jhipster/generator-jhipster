import { beforeEach, describe, expect, it, vi } from 'vitest';

import { defineComponent, h } from 'vue';

import { flushPromises, shallowMount } from '@vue/test-utils';
import axios from 'axios';

import { loggersResponse } from '@/shared/jhipster/admin.samples';
import { loggersEndpoint, toLogs } from '@/shared/jhipster/logs';
import JhiSortHeader from '@/shared/sort/jhi-sort-header.vue';

import Logs from './logs.vue';

type LogsComponentType = InstanceType<typeof Logs>;

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
  post: vi.spyOn(axios, 'post'),
};

describe('Logs Component', () => {
  let logs: LogsComponentType;

  beforeEach(() => {
    axiosStub.get.mockResolvedValue({});
    const wrapper = shallowMount(Logs, {
      global: {
        stubs: {
          'jhi-sort-header': JhiSortHeader, 'font-awesome-icon': true,
          BButton: true,
          BButtonGroup: true,
        },
      },
    });
    logs = wrapper.vm;
  });

  describe('OnInit', () => {
    it('should set all default values correctly', () => {
      expect(logs.filtered).toBe('');
      expect(logs.orderProp).toBe('name');
      expect(logs.reverse).toBe(false);
    });

    it('Should call load all on init', async () => {
      // WHEN
      logs.init();
      await logs.$nextTick();

      // THEN
      expect(axiosStub.get).toHaveBeenCalledWith(loggersEndpoint);
    });
  });

  describe('change log level', () => {
    it('should change log level correctly', async () => {
      axiosStub.post.mockResolvedValue({});

      // WHEN
      logs.updateLevel('main', 'ERROR');
      await logs.$nextTick();

      // THEN
      expect(axiosStub.post).toHaveBeenCalledWith(`${loggersEndpoint}/main`, { configuredLevel: 'ERROR' });
      expect(axiosStub.get).toHaveBeenCalledWith(loggersEndpoint);
    });
  });

  describe('change order', () => {
    it('should change order and invert reverse', () => {
      // WHEN
      logs.changeOrder('dummy-order');

      // THEN
      expect(logs.orderProp).toEqual('dummy-order');
      expect(logs.reverse).toBe(true);
    });
  });
});

describe('Logs view', () => {
  // eslint-disable-next-line vue/one-component-per-file
  const buttonStub = defineComponent({
    setup(_props, { slots }) {
      return () => h('button', slots.default?.());
    },
  });
  // eslint-disable-next-line vue/one-component-per-file
  const contentStub = defineComponent({
    setup(_props, { slots }) {
      return () => h('div', slots.default?.());
    },
  });

  it('should list the loggers and change their level', async () => {
    // GIVEN
    const levels = ['TRACE', 'DEBUG', 'INFO', 'WARN', 'ERROR', 'OFF'];
    const [logger, ...otherLoggers] = toLogs(loggersResponse);
    vi.spyOn(axios, 'get').mockResolvedValue({ data: loggersResponse });
    const post = vi.spyOn(axios, 'post').mockResolvedValue({});
    const wrapper = shallowMount(Logs, {
      global: {
        stubs: {
          'jhi-sort-header': JhiSortHeader, 'font-awesome-icon': true,
          BButton: buttonStub,
          BButtonGroup: contentStub,
        },
      },
    });
    await flushPromises();

    // WHEN
    for (const element of wrapper.findAll('th, button')) {
      await element.trigger('click');
    }
    await wrapper.find('input').setValue(logger.name);
    await flushPromises();

    // THEN
    expect(post).toHaveBeenCalledTimes(levels.length * (otherLoggers.length + 1));
    expect(wrapper.vm.filteredLoggers).toEqual([logger]);
  });

  it('should use the default service', async () => {
    // GIVEN
    const get = vi.spyOn(axios, 'get').mockResolvedValue({ data: loggersResponse });

    // WHEN
    shallowMount(Logs, { global: { stubs: { 'jhi-sort-header': JhiSortHeader, 'font-awesome-icon': true, BButton: true, BButtonGroup: true } } });
    await flushPromises();

    // THEN
    expect(get).toHaveBeenCalledWith(loggersEndpoint);
  });
});
