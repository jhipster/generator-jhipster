<template>
  <div>
    <h2>
      <span id="health-page-heading" data-cy="healthPageHeading">{{ t$('health.title') }}</span>
      <button class="btn btn-primary float-end" @click="refresh()" :disabled="updatingHealth">
        <font-awesome-icon icon="sync"></font-awesome-icon> <span>{{ t$('health[\'refresh.button\']') }}</span>
      </button>
    </h2>
    <div class="table-responsive">
      <table id="healthCheck" class="table table-striped" aria-describedby="health-page-heading">
        <thead>
          <tr>
            <th scope="col">{{ t$('health.table.service') }}</th>
            <th class="text-center" scope="col">{{ t$('health.table.status') }}</th>
            <th class="text-center" scope="col">{{ t$('health.details.details') }}</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="check of checks" :key="check.id">
            <td>
              <span>{{ labelText(check.label) }}</span>{{ check.sublabel ? ` - ${check.sublabel}` : '' }}
            </td>
            <td class="text-center">
              <span class="badge" :class="check.healthy ? 'bg-success' : 'bg-danger'">{{ labelText(check.status) }}</span>
            </td>
            <td class="text-center">
              <a class="hand" @click="showHealth(check)" v-if="check.details || check.error">
                <font-awesome-icon icon="eye"></font-awesome-icon>
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <b-modal ref="healthModal" ok-only ok-title="Done" ok-variant="secondary">
      <template #title>
        <h4 v-if="currentCheck" class="modal-title" id="showHealthLabel">
          <span>{{ labelText(currentCheck.label) }}</span>{{ currentCheck.sublabel ? ` - ${currentCheck.sublabel}` : '' }}
        </h4>
      </template>
      <HealthModal :current-check="currentCheck"></HealthModal>
    </b-modal>
  </div>
</template>

<script setup lang="ts">
import { type Ref, inject, onMounted, ref } from 'vue';
<%_ if (enableTranslation) { _%>
import { useI18n } from 'vue-i18n';
<%_ } _%>

import { type HealthCheck } from '@/shared/jhipster/health.model';
import { type Label } from '@/shared/jhipster/label';

import HealthModal from './health-modal.vue';
import HealthService, { healthServiceKey } from './health.service';

defineOptions({ name: '<%- jhiPrefixCapitalized %>Health' });

const healthService = inject(healthServiceKey, () => new HealthService(), true);
<%_ if (enableTranslation) { _%>
const { t: t$, te } = useI18n();
<%_ } _%>

<%_ if (enableTranslation) { _%>
const labelText = ({ text, translationKey }: Label): string => (translationKey && te(translationKey) ? t$(translationKey) : text);
<%_ } else { _%>
const labelText = ({ text }: Label): string => text;
<%_ } _%>

const checks: Ref<HealthCheck[] | null> = ref(null);
const currentCheck: Ref<HealthCheck | null> = ref(null);
const updatingHealth = ref(false);

const healthModal = ref<{ show: () => void } | null>(null);

const refresh = (): void => {
  updatingHealth.value = true;
  healthService
    .checkHealth()
    .then(res => {
      checks.value = res;
    })
    .catch(() => {})
    .finally(() => {
      updatingHealth.value = false;
    });
};
const showHealth = (check: HealthCheck): void => {
  currentCheck.value = check;
  healthModal.value?.show();
};

onMounted(() => {
  refresh();
});

</script>
