import { beforeEach, describe, expect, it, vi } from 'vitest';

import { defineComponent, h } from 'vue';

import { flushPromises, shallowMount } from '@vue/test-utils';
import axios from 'axios';

import HealthService, { healthServiceKey } from './health.service';
import Health from './health.vue';

type HealthComponentType = InstanceType<typeof Health>;

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
};

describe('Health Component', () => {
  let health: HealthComponentType;

  beforeEach(() => {
    axiosStub.get.mockResolvedValue({ data: { status: 'UP' } });
    const wrapper = shallowMount(Health, {
      global: {
        stubs: {
          bModal: true,
          'font-awesome-icon': true,
          'health-modal': true,
        },
        directives: {
          'b-modal': {},
        },
        provide: {
          [healthServiceKey as symbol]: new HealthService(),
        },
      },
    });
    health = wrapper.vm;
  });

  describe('refresh', () => {
    it('should call refresh on init', async () => {
      // GIVEN
      axiosStub.get.mockResolvedValue({ data: { status: 'UP' } });

      // WHEN
      health.refresh();
      await health.$nextTick();

      // THEN
      expect(axiosStub.get).toHaveBeenCalledWith('management/health', expect.anything());
      await vi.waitFor(() => expect(health.updatingHealth).toEqual(false));
    });
    it('should stop updating when the request fails', async () => {
      // GIVEN
      axiosStub.get.mockRejectedValue({});

      // WHEN
      health.refresh();
      await health.$nextTick();

      // THEN
      expect(axiosStub.get).toHaveBeenCalledWith('management/health', expect.anything());
      await vi.waitFor(() => expect(health.updatingHealth).toEqual(false));
    });
    it('should show the checks of the response', async () => {
      // GIVEN
      const data = { status: 'DOWN', components: { db: { status: 'DOWN' } } };
      axiosStub.get.mockResolvedValue({ data });

      // WHEN
      health.refresh();
      await vi.waitFor(() => expect(health.checks).toContainEqual(expect.objectContaining({ id: 'db', healthy: false })));

      // THEN
      expect(health.updatingHealth).toEqual(false);
    });
  });
});

describe('Health view', () => {
  const show = vi.fn();
  const modalStub = defineComponent({
    setup(_props, { slots }) {
      return () => h('div', [slots.title?.(), slots.default?.()]);
    },
    methods: {
      show,
    },
  });

  it('should list the health of the components and show their details', async () => {
    // GIVEN
    const get = vi.spyOn(axios, 'get').mockResolvedValue({
      data: { components: { db: { status: 'UP', details: { database: 'H2' } }, mail: { status: 'DOWN', details: { error: 'failed' } }, ping: { status: 'UP' } } },
    });
    const wrapper = shallowMount(Health, {
      global: {
        stubs: { bModal: modalStub, 'font-awesome-icon': true, 'health-modal': true },
      },
    });
    await flushPromises();

    // WHEN
    for (const element of wrapper.findAll('button, a')) {
      await element.trigger('click');
    }
    await flushPromises();

    // THEN
    expect(get).toHaveBeenCalledTimes(2);
    expect(show).toHaveBeenCalledTimes(2);
    expect(wrapper.vm.currentCheck).toEqual(expect.objectContaining({ id: 'mail' }));
    expect(wrapper.find('#showHealthLabel').exists()).toBe(true);
  });
});
