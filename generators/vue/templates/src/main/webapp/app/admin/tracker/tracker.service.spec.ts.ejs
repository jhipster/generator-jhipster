import { type Mock, afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { type Component, type Ref, nextTick, ref } from 'vue';
import { type Router, createMemoryHistory, createRouter } from 'vue-router';

import { RxStomp, type RxStompConfig, RxStompState } from '@stomp/rx-stomp';
import { shallowMount } from '@vue/test-utils';
import { Subject, of } from 'rxjs';
import SockJS from 'sockjs-client';

<%_ if (authenticationTypeJwt) { _%>
import { clearAuthenticationToken, storeAuthenticationToken } from '@/account/authentication-token';
<%_ } _%>
import { authenticatedKey } from '@/config/injection-keys';
<%_ if (authenticationUsesCsrf) { _%>
import { CSRF_TOKEN_COOKIE_NAME, CSRF_TOKEN_HEADER_NAME } from '@/shared/jhipster/constants';
<%_ } _%>

import type TrackerService from './tracker.service';
import { type TrackerActivity, useTrackerService } from './tracker.service';

vi.mock('sockjs-client', () => ({ default: vi.fn() }));

describe('Tracker Service', () => {
  let trackerService: TrackerService;
  let authenticated: Ref<boolean>;

  let mockStomp: { publish: Mock; watch: Mock; configure: Mock; activate: Mock; deactivate: Mock; connectionState$: Subject<number> };
  let router: Router;

  const mountTracker = (options: { stomp?: RxStomp } = { stomp: mockStomp as unknown as RxStomp }) => {
    const TrackerApp: Component = {
      name: 'TrackerApp',
      render: () => null,
      setup() {
        trackerService = useTrackerService(options);
      },
    };
    return shallowMount(TrackerApp, {
      global: {
        plugins: [router],
        provide: {
          [authenticatedKey as symbol]: authenticated,
        },
      },
    });
  };
  const configured = (): RxStompConfig =>
    Object.assign({}, ...mockStomp.configure.mock.calls.map(([config]) => config as RxStompConfig)) as RxStompConfig;

  beforeEach(async () => {
    router = createRouter({ history: createMemoryHistory(), routes: [{ path: '/:path(.*)*', component: { render: () => null } }] });
    await router.push('/');
    authenticated = ref(false);

    mockStomp = {
      publish: vi.fn(),
      watch: vi.fn(),
      configure: vi.fn(),
      activate: vi.fn(),
      deactivate: vi.fn(),
      connectionState$: new Subject<number>(),
    };
  });

  afterEach(() => {
    vi.restoreAllMocks();
    document.head.innerHTML = '';
<%_ if (authenticationTypeJwt) { _%>
    clearAuthenticationToken();
<%_ } _%>
  });

  it('Should send the page at every navigation', async () => {
    mountTracker();

    await router.push('/admin');

    expect(mockStomp.publish).toHaveBeenLastCalledWith({ destination: '/topic/activity', body: JSON.stringify({ page: '/admin' }) });
  });

  it('Should call activate on authenticated', () => {
    // WHEN
    authenticated.value = true;
    mountTracker();

    // THEN
    expect(mockStomp.activate).toHaveBeenCalledOnce();
  });

  it('Should send activity on connected', async () => {
    // GIVEN
    await router.push('/admin');
    mountTracker();

    // WHEN
    mockStomp.connectionState$.next(RxStompState.OPEN);
    await nextTick();

    // THEN
    expect(mockStomp.publish).toHaveBeenCalledExactlyOnceWith({ destination: '/topic/activity', body: JSON.stringify({ page: '/admin' }) });
  });

  it('Should follow the state of the connection', () => {
    mountTracker();

    for (const [state, status] of [
      [RxStompState.CONNECTING, 'connecting'],
      [RxStompState.OPEN, 'open'],
      [RxStompState.CLOSING, 'closing'],
      [RxStompState.CLOSED, 'closed'],
    ] as const) {
      mockStomp.connectionState$.next(state);
      expect(trackerService.status.value).toBe(status);
    }
  });

  it('Should disconnect on logout', async () => {
    // GIVEN
    authenticated.value = true;
    mountTracker();

    // WHEN
    authenticated.value = false;
    await nextTick();

    // THEN
    expect(mockStomp.deactivate).toHaveBeenCalledOnce();
  });

  it('Should log the debug messages of the connection', () => {
    const log = vi.spyOn(console, 'log').mockReturnValue(undefined);
    mountTracker();

    configured().debug!('message');

    expect(log).toHaveBeenCalledWith(expect.any(Date), 'message');
  });

  it('Should open the connection to the tracker', () => {
<%_ if (authenticationUsesCsrf) { _%>
    document.cookie = `${CSRF_TOKEN_COOKIE_NAME}=token`;
<%_ } _%>
    authenticated.value = true;
    mountTracker();

    configured().webSocketFactory!();

    expect(SockJS).toHaveBeenCalledWith(`//${window.location.host}/websocket/tracker`);
<%_ if (authenticationUsesCsrf) { _%>
    expect(configured().connectHeaders![CSRF_TOKEN_HEADER_NAME]).toMatch(/^[\w-]{14}$/);
<%_ } _%>
  });

  it('Should open the connection to the tracker under the base of the application', () => {
    document.head.innerHTML = '<base href="/app/" />';
    authenticated.value = true;
    mountTracker();

    configured().webSocketFactory!();

    expect(SockJS).toHaveBeenCalledWith(`//${window.location.host}/app/websocket/tracker`);
  });

<%_ if (authenticationTypeJwt) { _%>
  it('Should open the connection to the tracker with the authentication token', () => {
    storeAuthenticationToken('token');
    authenticated.value = true;
    mountTracker();

    configured().webSocketFactory!();

    expect(SockJS).toHaveBeenCalledWith(`//${window.location.host}/websocket/tracker?access_token=token`);
  });

<%_ } _%>
  it('Should give the activities of the tracker', () => {
    const activity: TrackerActivity = { sessionId: '1', userLogin: 'user', ipAddress: '127.0.0.1', page: 'home', time: '2026-01-02' };
    mockStomp.watch.mockReturnValue(of({ body: JSON.stringify(activity) }));
    mountTracker();
    const observer = vi.fn();

    trackerService.subscribe(observer);

    expect(mockStomp.watch).toHaveBeenCalledWith('/topic/tracker');
    expect(observer).toHaveBeenCalledWith(activity);
  });

  it('Should create its own connection', () => {
    // The debug messages of the connection it deactivates.
    vi.spyOn(console, 'log').mockReturnValue(undefined);
    mountTracker({});

    expect(trackerService.stomp).toBeInstanceOf(RxStomp);
  });
});
