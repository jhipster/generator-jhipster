<template>
  <div class="modal-body">
    <span
      v-for="filter of details.filters"
      :key="filter.value ?? 'all'"
      class="badge hand me-1"
      :class="`bg-${filter.status}`"
      @click="selectedValue = filter.value"
    >
      {{ labelText(filter.label) }}&nbsp;<span class="badge rounded-pill">{{ filter.count }}</span>
    </span>
    <div class="mt-2">&nbsp;</div>
    Filter
    <input type="text" v-model="term" class="form-control" />
    <div class="pad" v-for="item of filteredItems" :key="item.title">
      <h6>
        <span class="badge" :class="`bg-${item.status}`">{{ item.value }}</span
        >&nbsp;{{ item.title }}
        <a v-if="item.lines.length > 0" @click="toggle(item.title)" href="javascript:void(0);">
          {{ labelText(shownItems.has(item.title) ? details.hideLines : details.showLines) }}
        </a>
      </h6>
      <div v-if="shownItems.has(item.title)" class="card">
        <div class="card-body">
          <div v-for="(line, lineIndex) of item.lines" :key="lineIndex" class="break">
            <samp>{{ line }}</samp>
          </div>
        </div>
      </div>
      <table class="table table-sm table-responsive" aria-describedby="showMetricsLabel">
        <thead>
          <tr>
            <th v-for="(column, columnIndex) of details.columns" :key="columnIndex" scope="col">{{ labelText(column) }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td v-for="(cell, cellIndex) of item.cells" :key="cellIndex">{{ cell }}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue';
<%_ if (enableTranslation) { _%>
import { useI18n } from 'vue-i18n';
<%_ } _%>

import { type Label } from '@/shared/jhipster/label';
import { type MetricDetails } from '@/shared/jhipster/metrics';

defineOptions({ name: '<%- jhiPrefixCapitalized %>MetricsModal' });

const props = defineProps<{ details: MetricDetails }>();

<%_ if (enableTranslation) { _%>
const { t: t$, te } = useI18n();

const labelText = ({ text, translationKey }: Label): string => (translationKey && te(translationKey) ? t$(translationKey) : text);
<%_ } else { _%>
const labelText = ({ text }: Label): string => text;
<%_ } _%>

const selectedValue = ref<string>();
const term = ref('');
const shownItems = ref(new Set<string>());

const filteredItems = computed(() =>
  props.details.items.filter(
    ({ title, value }) =>
      (!selectedValue.value || value === selectedValue.value) && title.toLowerCase().includes(term.value.toLowerCase()),
  ),
);

const toggle = (title: string): void => {
  if (!shownItems.value.delete(title)) {
    shownItems.value.add(title);
  }
};
</script>
