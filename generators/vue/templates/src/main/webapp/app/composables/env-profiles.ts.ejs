import { inject, provide, ref } from 'vue';

import axios from 'axios';

import { type EnvProfiles, envProfilesKey } from '@/config/injection-keys';

/**
 * Loads the env profiles of the server, once, in the setup of the root of the application, and provides them to the
 * components.
 */
export const useEnvProfiles = (): EnvProfiles => {
  const activeProfiles = ref<string[]>([]);
  const ribbonOnProfiles = ref('');
  const envProfiles: EnvProfiles = { activeProfiles, ribbonOnProfiles };
  provide(envProfilesKey, envProfiles);

  axios
    .get<{ activeProfiles?: string[]; 'display-ribbon-on-profiles'?: string }>('management/info')
    .then(({ data }) => {
      if (data?.activeProfiles) {
        ribbonOnProfiles.value = data['display-ribbon-on-profiles'] ?? '';
        activeProfiles.value = data.activeProfiles;
      }
    })
    .catch(() => {
      // Without the env profiles, what depends on them stays hidden.
    });

  return envProfiles;
};

/**
 * The env profiles of the server, as the root of the application provides them.
 */
export const useCurrentEnvProfiles = (): EnvProfiles => {
  const envProfiles = inject(envProfilesKey, null);
  if (!envProfiles) {
    throw new Error('The env profiles are provided by useEnvProfiles, in the setup of the root of the application');
  }
  return envProfiles;
};
