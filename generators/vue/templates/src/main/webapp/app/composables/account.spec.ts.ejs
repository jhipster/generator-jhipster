import { beforeEach, describe, expect, it, vi } from 'vitest';
import { type Ref, defineComponent, inject } from 'vue';
import { type Router } from 'vue-router';

import { createTestingPinia } from '@pinia/testing';
import { mount } from '@vue/test-utils';
import axios from 'axios';

import { type default as AccountService, accountServiceKey } from '@/account/account.service';
<%_ if (authenticationUsesCsrf) { _%>
import LoginService, { loginServiceKey } from '@/account/login.service';
<%_ } _%>
import { authenticatedKey, currentUsernameKey } from '@/config/injection-keys';

import { useAccount } from './account';

describe('account', () => {
  let router: { beforeResolve: ReturnType<typeof vi.fn> };
  let account: ReturnType<typeof useAccount>;
  let injected: {
    accountService?: AccountService;
    authenticated?: Readonly<Ref<boolean>>;
    username?: Readonly<Ref<string | undefined>>;
<%_ if (authenticationUsesCsrf) { _%>
    loginService?: LoginService;
<%_ } _%>
  };

  beforeEach(() => {
    createTestingPinia({ stubActions: false });
    router = { beforeResolve: vi.fn() };
    vi.spyOn(axios.interceptors.request, 'use');
    vi.spyOn(axios.interceptors.response, 'use');

    const Child = defineComponent({
      setup() {
        injected = {
          accountService: inject(accountServiceKey),
          authenticated: inject(authenticatedKey),
          username: inject(currentUsernameKey),
<%_ if (authenticationUsesCsrf) { _%>
          loginService: inject(loginServiceKey),
<%_ } _%>
        };
        return () => null;
      },
    });
    mount(
      defineComponent({
        components: { Child },
        setup() {
          account = useAccount({ router: router as unknown as Router });
        },
        template: '<Child />',
      }),
    );
  });

  it('should guard the routes and handle the errors of the server', () => {
    expect(router.beforeResolve).toHaveBeenCalledExactlyOnceWith(expect.any(Function));
    expect(axios.interceptors.request.use).toHaveBeenCalledOnce();
    expect(axios.interceptors.response.use).toHaveBeenCalledOnce();
  });

  it('should provide the account service and the state of the user', () => {
    expect(injected.accountService).toBe(account.accountService);
    expect(injected.authenticated!.value).toBe(false);
    expect(injected.username!.value).toBeUndefined();
<%_ if (authenticationUsesCsrf) { _%>
    expect(injected.loginService).toBeInstanceOf(LoginService);
<%_ } _%>

    account.store.setAuthentication({ login: 'user' } as any);

    expect(injected.authenticated!.value).toBe(true);
    expect(account.authenticated.value).toBe(true);
    expect(injected.username!.value).toBe('user');
  });
});
