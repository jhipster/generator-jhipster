import { type Ref, computed, inject, provide } from 'vue';
import { type Router } from 'vue-router';

import { storeToRefs } from 'pinia';

import AccountService, { accountServiceKey } from '@/account/account.service';
<%_ if (authenticationUsesCsrf) { _%>
import LoginService, { loginServiceKey } from '@/account/login.service';
<%_ } _%>
import { createUnauthorizedHandler } from '@/account/unauthorized-handler';
import { setupAxiosInterceptors } from '@/config/axios-interceptor';
import { type CurrentAccount, currentAccountKey } from '@/config/injection-keys';
import { type IUser } from '@/entities/user/user.model';
import { createAuthorityGuard } from '@/router/authority-guard';
import { useStore } from '@/stores';

/**
 * Sets the account of the application up, once, in the setup of its root: the guard of the routes, what a 401 does to
 * the session, and what the components inject (the account service and the current account).
 */
export const useAccount = ({ router }: { router: Router }) => {
<%_ if (authenticationUsesCsrf) { _%>
  provide(loginServiceKey, new LoginService());
<%_ } _%>
  const store = useStore();
  const accountService = new AccountService(store);

  router.beforeResolve(createAuthorityGuard({ accountService, store }));

  setupAxiosInterceptors(createUnauthorizedHandler({ accountService<%- authenticationTypeOauth2 ? '' : ', router' %> }), error => Promise.reject(error));

  const currentAccount = createCurrentAccount(storeToRefs(store).account);
  provide(currentAccountKey, currentAccount);
  provide(accountServiceKey, accountService);

  return { store, accountService, authenticated: currentAccount.authenticated };
};

/**
 * The current account read from the account of the user signed in.
 */
const createCurrentAccount = (account: Readonly<Ref<IUser | null>>): CurrentAccount => ({
  account,
  authenticated: computed(() => !!account.value),
  username: computed(() => account.value?.login),
  hasAnyAuthority: authorities => [authorities].flat().some(authority => account.value?.authorities?.includes(authority) ?? false),
});

/**
 * The account of the user, as the root of the application provides it.
 */
export const useCurrentAccount = (): CurrentAccount => {
  const currentAccount = inject(currentAccountKey, null);
  if (!currentAccount) {
    throw new Error('The current account is provided by useAccount, in the setup of the root of the application');
  }
  return currentAccount;
};
