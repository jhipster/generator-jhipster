import { computed, provide } from 'vue';
import { type Router } from 'vue-router';

import { storeToRefs } from 'pinia';

import AccountService, { accountServiceKey } from '@/account/account.service';
<%_ if (authenticationUsesCsrf) { _%>
import LoginService, { loginServiceKey } from '@/account/login.service';
<%_ } _%>
import { createUnauthorizedHandler } from '@/account/unauthorized-handler';
import { setupAxiosInterceptors } from '@/config/axios-interceptor';
import { authenticatedKey, currentUsernameKey } from '@/config/injection-keys';
import { createAuthorityGuard } from '@/router/authority-guard';
import { useStore } from '@/stores';

/**
 * Sets the account of the application up, once, in the setup of its root: the guard of the routes, what a 401 does to
 * the session, and what the components inject (the account service, whether the user is authenticated and its name).
 */
export const useAccount = ({ router }: { router: Router }) => {
<%_ if (authenticationUsesCsrf) { _%>
  provide(loginServiceKey, new LoginService());
<%_ } _%>
  const store = useStore();
  const accountService = new AccountService(store);

  router.beforeResolve(createAuthorityGuard({ accountService, store }));

  setupAxiosInterceptors(createUnauthorizedHandler({ accountService<%- authenticationTypeOauth2 ? '' : ', router' %> }), error => Promise.reject(error));

  const { authenticated } = storeToRefs(store);
  provide(authenticatedKey, authenticated);
  provide(currentUsernameKey, computed(() => store.account?.login));
  provide(accountServiceKey, accountService);

  return { store, accountService, authenticated };
};
