import { type Ref, onScopeDispose, ref, shallowRef, watch } from 'vue';

import axios from 'axios';

/** The options of a request: its signal aborts it. */
export type RequestOptions = { signal?: AbortSignal };

export type UseControlledRequestOptions<T, P> = {
  /** The parameters of the load, reactive: a new value executes again, undefined gives the initial data. Without it, executes once. */
  params?: () => P | undefined;
  /** The data before a load, and when the parameters are undefined. */
  initialData: () => T;
  /** Called with the error of a failed load, an aborted one excepted. */
  onError?: (error: unknown) => void;
};

/**
 * Data loaded from the parameters, with the API of the useAxios of VueUse: an execution aborts the previous one, the
 * last one is aborted when the component unmounts, and an aborted load is not an error.
 */
export const useControlledRequest = <T, P = null>(
  loader: (params: P, request: { signal: AbortSignal }) => Promise<T>,
  { params, initialData, onError }: UseControlledRequestOptions<T, P>,
) => {
  const getParams = params ?? (() => null as P);
  const data = ref(initialData()) as Ref<T>;
  const isLoading = ref(false);
  const error = shallowRef<unknown>();
  let controller: AbortController | undefined;
  const abort = () => controller?.abort();
  onScopeDispose(abort);

  const execute = async (executeParams: P | undefined = getParams()): Promise<void> => {
    abort();
    const current = new AbortController();
    controller = current;
    error.value = undefined;
    if (executeParams === undefined) {
      data.value = initialData();
      isLoading.value = false;
      return;
    }
    isLoading.value = true;
    try {
      const loaded = await loader(executeParams, { signal: current.signal });
      if (!current.signal.aborted) {
        data.value = loaded;
      }
    } catch (loadError) {
      if (!current.signal.aborted && !axios.isCancel(loadError)) {
        error.value = loadError;
        onError?.(loadError);
      }
    } finally {
      if (controller === current) {
        isLoading.value = false;
      }
    }
  };

  watch(getParams, executeParams => execute(executeParams), { immediate: true });

  return { data, isLoading, error, execute, abort };
};
