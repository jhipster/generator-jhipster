import { beforeEach, describe, expect, it, vi } from 'vitest';
import { createApp, defineComponent } from 'vue';

import { flushPromises, mount } from '@vue/test-utils';
import axios from 'axios';

import { type EnvProfiles } from '@/config/injection-keys';

import { useCurrentEnvProfiles, useEnvProfiles } from './env-profiles';

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
};

describe('env profiles', () => {
  let injected: EnvProfiles;

  const mountWithEnvProfiles = () => {
    const Child = defineComponent({
      setup() {
        injected = useCurrentEnvProfiles();
        return () => null;
      },
    });
    mount(
      defineComponent({
        components: { Child },
        setup() {
          useEnvProfiles();
        },
        template: '<Child />',
      }),
    );
  };

  beforeEach(() => {
    axiosStub.get.mockReset();
  });

  it('should provide the env profiles of the server', async () => {
    axiosStub.get.mockResolvedValue({ data: { 'display-ribbon-on-profiles': 'dev', activeProfiles: ['dev', 'test'] } });

    mountWithEnvProfiles();
    expect(injected.activeProfiles.value).toEqual([]);
    await flushPromises();

    expect(axiosStub.get).toHaveBeenCalledExactlyOnceWith('management/info');
    expect(injected.activeProfiles.value).toEqual(['dev', 'test']);
    expect(injected.ribbonOnProfiles.value).toBe('dev');
  });

  it('should provide no env profile when the server does not tell them', async () => {
    axiosStub.get.mockRejectedValue(new Error());

    mountWithEnvProfiles();
    await flushPromises();

    expect(injected.activeProfiles.value).toEqual([]);
    expect(injected.ribbonOnProfiles.value).toBe('');
  });

  it('should throw out of an application loading the env profiles', () => {
    expect(() => createApp({}).runWithContext(() => useCurrentEnvProfiles())).toThrow('useEnvProfiles');
  });
});
