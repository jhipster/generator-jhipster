import { describe, expect, it } from 'vitest';

import router from './index';

describe('Router', () => {
  it('should load the component of every route', async () => {
    for (const route of router.getRoutes()) {
      for (const component of Object.values(route.components ?? {})) {
        // Lazy routes give a function importing the module of the component.
        const loaded = typeof component === 'function' ? (await (component as () => Promise<{ default: unknown }>)()).default : component;
        expect({ path: route.path, loaded }).toEqual({ path: route.path, loaded: expect.anything() });
      }
    }
  });

  it('should redirect an unknown route to the not found page', async () => {
    await router.push('/an-unknown-route');

    expect(router.currentRoute.value.name).toBe('NotFound');
  });
});
