import { type NavigationGuard, START_LOCATION } from 'vue-router';

import type AccountService from '@/account/account.service';
import { type AccountStore } from '@/stores';

/**
 * The guard of the routes: it loads the account on the first navigation, and lets the user in the routes that ask for
 * an authority the user has.
 */
export const createAuthorityGuard =
  ({ accountService, store }: { accountService: AccountService; store: AccountStore }): NavigationGuard =>
  async (to, from) => {
    // The account is loaded on the first navigation only: a login loads it again, a 401 logs out.
    if (from === START_LOCATION && !store.authenticated) {
      await accountService.update();
    }
    if (to.meta?.authorities && to.meta.authorities.length > 0) {
      const value = await accountService.hasAnyAuthorityAndCheckAuth(to.meta.authorities);
      if (!value && from.path !== '/forbidden') {
<%_ if (!authenticationTypeOauth2) { _%>
        if (!store.authenticated) {
          return { path: '/login', query: { redirect: to.fullPath } };
        }
<%_ } _%>
        return { path: '/forbidden' };
      }
    }
    return true;
  };
