import axios, { type AxiosError, type AxiosRequestConfig, type InternalAxiosRequestConfig } from 'axios';

<%_ if (authenticationTypeJwt) { _%>
import { getAuthenticationToken } from '@/account/authentication-token';
<%_ } _%>

<%_ if (enableTranslation) { _%>
import languages from '@/config/languages';

<%_ } _%>
const TIMEOUT = 1 * 60 * 1000;

/**
 * The language of the application before it sets the one of its calls: the one the user chose, else the one of the browser
 * or the native one.
 */
const initialLanguage = (): string =>
<%_ if (enableTranslation) { _%>
  [localStorage.getItem('currentLanguage'), navigator.language, '<%- nativeLanguage %>'].find(language => language && (languages() as Record<string, unknown>)[language])!;
<%_ } else { _%>
  '<%- nativeLanguage %>';
<%_ } _%>

const onRequestSuccess = (config: AxiosRequestConfig): AxiosRequestConfig => {
  config.headers ??= {};
  // The server answers in the language of the application, from the first call.
  config.headers['Accept-Language'] ??= initialLanguage();
<%_ if (authenticationTypeJwt) { _%>
  const token = getAuthenticationToken();
  if (token) {
    config.headers ??= {};
    config.headers.Authorization = `Bearer ${token}`;
  }
<%_ } _%>
  config.timeout = TIMEOUT;
  config.url = `${SERVER_API_URL}${config.url}`;
  return config;
};
const setupAxiosInterceptors = (onUnauthenticated: (error: AxiosError) => unknown, onServerError: (error: AxiosError) => unknown): void => {
  const onResponseError = (err: AxiosError) => {
    const status = err.status ?? err.response?.status;
    if (status === 403 || status === 401) {
      return onUnauthenticated(err);
    }
    if (status && status >= 500) {
      return onServerError(err);
    }
    return Promise.reject(err);
  };

  axios.interceptors.request.use(onRequestSuccess as (config: InternalAxiosRequestConfig) => InternalAxiosRequestConfig);
  axios.interceptors.response.use(res => res, onResponseError);
};

export { onRequestSuccess, setupAxiosInterceptors };
