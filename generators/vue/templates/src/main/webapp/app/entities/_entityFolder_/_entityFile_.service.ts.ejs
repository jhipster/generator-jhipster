import axios from 'axios';
<% if (!paginationNo) { %>
import buildPaginationQueryOpts from '@/shared/sort/sorts';
<% } %>
import { type I<%- entityAngularName %> } from '@/shared/model/<%- entityModelFileName %>.model';

const baseApiUrl = '<%- entityApi %>api/<%- entityApiUrl %>';
<%_ if (searchEngineAny) { _%>
const baseSearchApiUrl = '<%- entityApi %>api/<%- entityApiUrl %>/_search?query=';
<%_ } _%>

export default class <%- entityAngularName %>Service {
<%_ if (searchEngineAny) { _%>
  <%_ if (paginationNo) { _%>
  async search(query) : Promise<any> {
    const res = await axios.get(`${baseSearchApiUrl}${query}`);
    return res.data;
  }
  <%_ } else { _%>
  search(query, paginationQuery) : Promise<any> {
    return axios.get(`${baseSearchApiUrl}${query}&${buildPaginationQueryOpts(paginationQuery)}`);
  }
  <%_ } _%>
<%_ } _%>

  async find(<%- primaryKey.name %>: <%- primaryKey.tsType %>) : Promise<I<%- entityAngularName %>> {
    const res = await axios.get(`${baseApiUrl}/${<%- primaryKey.name %>}`);
    return res.data;
  }

  retrieve(<%- paginationNo ? '' : 'paginationQuery?: any' %>) : Promise<any> {
    return axios.get(baseApiUrl<%- paginationNo ? '' : ' + `?${buildPaginationQueryOpts(paginationQuery)}` ' %>);
  }
<%_ if (!readOnly) { _%>

  delete(<%- primaryKey.name %>: <%- primaryKey.tsType %>) : Promise<any> {
    return axios.delete(`${baseApiUrl}/${<%- primaryKey.name %>}`);
  }

  async create(entity: I<%- entityAngularName %>) : Promise<I<%- entityAngularName %>> {
    const res = await axios.post(baseApiUrl, entity);
    return res.data;
  }

  async update(entity: I<%- entityAngularName %>) : Promise<I<%- entityAngularName %>> {
    const res = await axios.put(`${baseApiUrl}/${entity.<%- primaryKey.name %>}`, entity);
    return res.data;
  }

  async partialUpdate(entity: I<%- entityAngularName %>) : Promise<I<%- entityAngularName %>> {
    const res = await axios.patch(`${baseApiUrl}/${entity.<%- primaryKey.name %>}`, entity);
    return res.data;
  }
<%_ } _%>
}
