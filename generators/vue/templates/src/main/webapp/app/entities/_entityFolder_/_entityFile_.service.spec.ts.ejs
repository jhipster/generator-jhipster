<%_ const tsKeyId = primaryKey.tsSampleValues[0]; _%>
import { beforeEach, describe, expect, it, vi } from 'vitest';

import axios from 'axios';

import { type I<%- entityAngularName %> } from './<%- entityFileName %>.model';
import <%- entityAngularName %>Service from './<%- entityFileName %>.service';

const sampleWithRequiredData: I<%- entityAngularName %> = <%- vueTsSampleWithRequiredData %>;

const sampleWithPartialData: I<%- entityAngularName %> = <%- vueTsSampleWithPartialData %>;

const sampleWithFullData: I<%- entityAngularName %> = <%- vueTsSampleWithFullData %>;

const error = {
  response: {
    status: null,
    data: {
      type: null,
    },
  },
};

const axiosStub = {
  get: vi.spyOn(axios, 'get'),
  post: vi.spyOn(axios, 'post'),
  put: vi.spyOn(axios, 'put'),
  patch: vi.spyOn(axios, 'patch'),
  delete: vi.spyOn(axios, 'delete'),
};

describe('Service Tests', () => {
  describe('<%- entityAngularName %> Service', () => {
    let service: <%- entityAngularName %>Service;

    beforeEach(() => {
      service = new <%- entityAngularName %>Service();
    });

    describe('Service methods', () => {
      it('should find an element', async () => {
        const returnedFromService = { ...sampleWithFullData };
        axiosStub.get.mockResolvedValue({ data: returnedFromService });

        const res = await service.find(<%- tsKeyId %>);

        expect(res).toEqual(returnedFromService);
      });

      it('should pass the signal of the request', async () => {
        const { signal } = new AbortController();
        axiosStub.get.mockResolvedValue({ data: {} });

        await service.find(<%- tsKeyId %>, { signal });
        expect(axiosStub.get).toHaveBeenLastCalledWith(expect.any(String), { signal });
        await service.retrieve({ signal });
        expect(axiosStub.get).toHaveBeenLastCalledWith(expect.any(String), { signal });
<%_ if (searchEngineAny) { _%>
        await service.search('query', { signal });
        expect(axiosStub.get).toHaveBeenLastCalledWith(expect.any(String), { signal });
<%_ } _%>
      });

      it('should not find an element', async () => {
        axiosStub.get.mockRejectedValue(error);
        await expect(service.find(<%- tsKeyId %>)).rejects.toMatchObject(error);
      });

<%_ if (!readOnly) { _%>
      it('should create a <%- entityAngularName %>', async () => {
        const returnedFromService = { ...sampleWithFullData };
        axiosStub.post.mockResolvedValue({ data: returnedFromService });

        const res = await service.create({ ...sampleWithRequiredData });

        expect(res).toEqual(returnedFromService);
      });

      it('should not create a <%- entityAngularName %>', async () => {
        axiosStub.post.mockRejectedValue(error);

        await expect(service.create({})).rejects.toMatchObject(error);
      });

      it('should update a <%- entityAngularName %>', async () => {
        const returnedFromService = { ...sampleWithRequiredData };
        axiosStub.put.mockResolvedValue({ data: returnedFromService });

        const res = await service.update({ ...sampleWithRequiredData });

        expect(res).toEqual(returnedFromService);
      });

      it('should not update a <%- entityAngularName %>', async () => {
        axiosStub.put.mockRejectedValue(error);

        await expect(service.update({})).rejects.toMatchObject(error);
      });

      it('should partial update a <%- entityAngularName %>', async () => {
        const patchObject = { ...sampleWithPartialData };
        const returnedFromService = { ...sampleWithFullData, ...patchObject };
        axiosStub.patch.mockResolvedValue({ data: returnedFromService });

        const res = await service.partialUpdate(patchObject);

        expect(res).toEqual(returnedFromService);
      });

      it('should not partial update a <%- entityAngularName %>', async () => {
        axiosStub.patch.mockRejectedValue(error);

        await expect(service.partialUpdate({})).rejects.toMatchObject(error);
      });

<%_ } _%>
      it('should return a list of <%- entityAngularName %>', async () => {
        const returnedFromService = [sampleWithRequiredData, sampleWithPartialData, sampleWithFullData];
        axiosStub.get.mockResolvedValue({ data: returnedFromService });

        const res = await service.retrieve(<%- paginationNo ? '' : '{ sort: {}, page: 0, size: 10 }' %>);

        expect(res.data).toEqual(returnedFromService);
      });

<%_ if (searchEngineAny) { _%>
      it('should search the <%- entityAngularName %>', async () => {
        axiosStub.get.mockResolvedValue({ data: [{ <%- primaryKey.name %>: <%- tsKeyId %> }] });

        const res = await service.search('query'<%- paginationNo ? '' : ', { sort: {}, page: 0, size: 10 }' %>);

        expect(res.data).toEqual([{ <%- primaryKey.name %>: <%- tsKeyId %> }]);
        expect(axiosStub.get).toHaveBeenCalledWith(expect.stringContaining('_search?query=query'), { signal: undefined });
      });

<%_ } _%>
      it('should not return a list of <%- entityAngularName %>', async () => {
        axiosStub.get.mockRejectedValue(error);

        await expect(service.retrieve()).rejects.toMatchObject(error);
      });

<%_ if (!readOnly) { _%>
      it('should delete a <%- entityAngularName %>', async () => {
        axiosStub.delete.mockResolvedValue({ ok: true });

        const res = await service.delete(<%- tsKeyId %>);

        expect(res).toEqual({ ok: true });
      });

      it('should not delete a <%- entityAngularName %>', async () => {
        axiosStub.delete.mockRejectedValue(error);

        await expect(service.delete(<%- tsKeyId %>)).rejects.toMatchObject(error);
      });
<%_ } _%>
    });
  });
});
