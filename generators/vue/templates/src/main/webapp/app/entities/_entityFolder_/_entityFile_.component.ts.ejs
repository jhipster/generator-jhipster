import { <%- builtInUserManagement ? 'type ComputedRef, ' : '' %>type Ref, <%- paginationNo ? '' : 'computed, ' %>defineComponent, inject, onMounted, ref, watch, watchEffect } from 'vue';
<%_ if (enableTranslation) { _%>
import { useI18n } from 'vue-i18n';
<%_ } _%>
<%_ if (!paginationNo) { _%>
import { useRoute, useRouter } from 'vue-router';
<%_ } _%>

<%_ if (paginationInfiniteScroll) { _%>
import { useIntersectionObserver } from '@vueuse/core';
<%_ } _%>

import { useAlertService } from '@/shared/alert/alert.service';
<%_ const composables = [...anyFieldIsDuration || anyFieldIsTimeDerived ? ['useDateFormat'] : [], ...readOnly ? [] : ['useEntityRemove']]; _%>
<%_ if (composables.length > 0) { _%>
import { <%- composables.join(', ') %> } from '@/shared/composables';
<%_ } _%>
<%_ if (anyFieldIsBlobDerived || paginationInfiniteScroll) { _%>
import useDataUtils from '@/shared/data/data-utils.service';
<%_ } _%>
import { type I<%- entityAngularName %> } from './<%- entityFileName %>.model';

import <%- entityAngularName %>Service from './<%- entityFileName %>.service';

export default defineComponent({
  name: '<%- entityAngularName %>',
  setup() {
<%_ if (enableTranslation) { _%>
    const { t: t$ } = useI18n();
<%_ } _%>
<%_ if (anyFieldIsDuration || anyFieldIsTimeDerived) { _%>
    const dateFormat = useDateFormat();
<%_ } _%>
<%_ if (anyFieldIsBlobDerived || paginationInfiniteScroll) { _%>
    const dataUtils = useDataUtils();
<%_ } _%>
    const <%- entityInstance %>Service = inject('<%- entityInstance %>Service', () => new <%- entityAngularName %>Service());
    const alertService = inject('alertService', () => useAlertService(), true);
<%_ if (builtInUserManagement) { _%>
    const username = inject<ComputedRef<string>>('currentUsername');
<%_ } _%>

<%_ if (searchEngineAny) { _%>
    const currentSearch = ref('');
<%_ } _%>
<%_ if (!paginationNo) { _%>
    const itemsPerPage = ref(20);
    const queryCount: Ref<number> = ref(null);
    const route = useRoute();
    const router = useRouter();
  <%_ if (paginationPagination) { _%>
    // The page and the sort of the list are kept in the query parameters of the route.
  <%_ } else { _%>
    // The sort of the list is kept in the query parameters of the route.
  <%_ } _%>
    const sortParam = computed(() => String(route.query.sort ?? 'id,asc').split(','));
    const propOrder = computed(() => sortParam.value[0]);
    const reverse = computed(() => sortParam.value[1] === 'desc');
  <%_ if (paginationPagination) { _%>
    const page = computed({
      get: () => Number(route.query.page ?? 1),
      set: (value: number) => {
        router.push({ query: { ...route.query, page: String(value) } });
      },
    });
  <%_ } else { _%>
    const page: Ref<number> = ref(1);
  <%_ } _%>
    const totalItems = ref(0);
<%_ } _%>
<%_ if (paginationInfiniteScroll) { _%>
    const links: Ref = ref({});
<%_ } _%>

    const <%- entityInstancePlural %>: Ref<I<%- entityAngularName %>[]> = ref([]);

    const isFetching = ref(false);

<%_ if (searchEngineAny || !paginationNo) { _%>
    const clear = () => {
  <%_ if (searchEngineAny) { _%>
      currentSearch.value = '';
  <%_ } _%>
  <%_ if (!paginationNo) { _%>
      page.value = 1;
  <%_ } _%>
  <%_ if (paginationInfiniteScroll) { _%>
      links.value = {};
      <%- entityInstancePlural %>.value = [];
  <%_ } _%>
    };
<%_ } _%>
<%_ if (!paginationNo) { _%>

    const sort = (): string[] => {
      const result = [propOrder.value + ',' + (reverse.value ? 'desc' : 'asc')];
      if (propOrder.value !== 'id') {
        result.push('id');
      }
      return result;
    };
<%_ } _%>

    const retrieve<%- entityAngularName %>s = async () => {
      isFetching.value = true;
      try {
<%_ if (!paginationNo) { _%>
        const paginationQuery = {
          page: page.value - 1,
          size: itemsPerPage.value,
          sort: sort(),
        };
<%_ } _%>
<%_ if (searchEngineAny) { _%>
        const res = currentSearch.value ?
          (await <%- entityInstance %>Service().search(
            currentSearch.value,
  <%_ if (!paginationNo) { _%>
            paginationQuery,
  <%_ } _%>
          )) :
          (await <%- entityInstance %>Service().retrieve(
  <%_ if (!paginationNo) { _%>
            paginationQuery
  <%_ } _%>
          ));
<%_ } else { _%>
        const res = await <%- entityInstance %>Service().retrieve(
  <%_ if (!paginationNo) { _%>
          paginationQuery,
  <%_ } _%>
        );
<%_ } _%>
<%_ if (!paginationNo) { _%>
        totalItems.value = Number(res.headers['x-total-count']);
        queryCount.value = totalItems.value;
<%_ } _%>
<%_ if (paginationInfiniteScroll) { _%>
        links.value = dataUtils.parseLinks(res.headers?.['link']);
        <%- entityInstancePlural %>.value.push(...(res.data ?? []));
<%_ } else { _%>
        <%- entityInstancePlural %>.value = res.data;
<%_ } _%>
      } catch (err) {
        alertService.showHttpError(err.response);
      } finally {
        isFetching.value = false;
      }
    };

    const handleSyncList = () => {
<%_ if (paginationInfiniteScroll) { _%>
      clear();
<%_ } else { _%>
      retrieve<%- entityAngularName %>s();
<%_ } _%>
    };

    onMounted(async () => {
      await retrieve<%- entityAngularName %>s();
    });

<%_ if (searchEngineAny) { _%>
    const search = (query) => {
      if (!query) {
        return clear();
      }
      currentSearch.value = query;
      retrieve<%- entityAngularName %>s();
    };
<%_ } _%>
<%_ if (!readOnly) { _%>

    const { removeId, removeEntity, prepareRemove, closeDialog, confirmRemove: remove<%- entityAngularName %> } = useEntityRemove({
      alertService,
      getId: (instance: I<%- entityAngularName %>) => instance.<%- primaryKey.name %>,
      remove: id => <%- entityInstance %>Service().delete(id),
  <%_ if (enableTranslation) { _%>
      removedMessage: id => t$('<%- i18nAlertHeaderPrefix %>.deleted', { param: id }).toString(),
  <%_ } else { _%>
      removedMessage: id => `A <%- entityAngularName %> is deleted with identifier ${id}`,
  <%_ } _%>
  <%_ if (paginationInfiniteScroll) { _%>
      onRemoved: () => clear(),
  <%_ } else { _%>
      onRemoved: () => retrieve<%- entityAngularName %>s(),
  <%_ } _%>
    });
<%_ } _%>
<%_ if (!paginationNo) { _%>

  <%_ if (builtInUserManagement) { _%>
    const setActive = async (<%- entityInstance %>: I<%- entityAngularName %>, activated: boolean) => {
      try {
        await <%- entityInstance %>Service().update({ ...<%- entityInstance %>, activated });
        handleSyncList();
      } catch (error) {
        alertService.showHttpError(error.response);
      }
    };

  <%_ } _%>
    const changeOrder = (newOrder: string) => {
      const descending = propOrder.value === newOrder && !reverse.value;
      router.push({ query: { ...route.query, <%- paginationPagination ? "page: '1', " : '' %>sort: `${newOrder},${descending ? 'desc' : 'asc'}` } });
    };
  <%_ if (paginationInfiniteScroll) { _%>

    // Whenever order changes, reset the pagination
    watch([propOrder, reverse], () => {
      clear();
    });

    // Whenever the data resets or page changes, switch to the new page.
    watch([<%- entityInstancePlural %>, page], async ([data, currentPage], [_prevData, prevPage]) => {
      if (data.length === 0 || currentPage !== prevPage) {
        await retrieve<%- entityAngularName %>s();
      }
    });

    const infiniteScrollEl = ref<HTMLElement>(null);
    const intersectionObserver = useIntersectionObserver(
      infiniteScrollEl,
      intersection => {
        if (intersection[0].isIntersecting && !isFetching.value) {
          page.value++;
        }
      },
      {
        threshold: 0.5,
        immediate: false,
      },
    );
    watchEffect(() => {
      if (links.value.next) {
        intersectionObserver.resume();
      } else if (intersectionObserver.isActive.value) {
        intersectionObserver.pause();
      }
    });
  <%_ } else { _%>

    // Whenever the page or the order changes, retrieve the new data.
    watch([page, propOrder, reverse], async () => {
      await retrieve<%- entityAngularName %>s();
    });
  <%_ } _%>
<%_ } _%>

    return {
<%_ if (builtInUserManagement) { _%>
      username,
      setActive,
<%_ } _%>
      <%- entityInstancePlural %>,
      handleSyncList,
      isFetching,
      retrieve<%- entityAngularName %>s,
<%_ if (searchEngineAny || !paginationNo) { _%>
      clear,
<%_ } _%>
<%_ if (anyFieldIsDuration || anyFieldIsTimeDerived) { _%>
      ...dateFormat,
<%_ } _%>
<%_ if (searchEngineAny) { _%>
      currentSearch,
      search,
<%_ } _%>
<%_ if (!readOnly) { _%>
      removeId,
      removeEntity,
      prepareRemove,
      closeDialog,
      remove<%- entityAngularName %>,
<%_ } _%>
<%_ if (!paginationNo) { _%>
      itemsPerPage,
      queryCount,
      page,
      propOrder,
      reverse,
      totalItems,
      changeOrder,
<%_ } _%>
<%_ if (paginationInfiniteScroll) { _%>
      infiniteScrollEl,
<%_ } _%>
<%_ if (enableTranslation) { _%>
      t$,
<%_ } _%>
<%_ if (anyFieldIsBlobDerived || paginationInfiniteScroll) { _%>
      ...dataUtils,
<%_ } _%>
    };
  },
});
