<%_ const formFields = fields.filter(field => (!field.id || builtInUserManagement || !field.autoGenerate) && !field.hidden && !(builtInUserManagement && field.readonly));
    // A primary key the user gives, like the name of an authority, is a field of the form, read only once created.
    const userProvidedPrimaryKey = !builtInUserManagement && formFields.some(field => field.id);
_%>
<template>
  <div class="d-flex justify-content-center">
    <div class="col-8">
      <form name="editForm" novalidate @submit.prevent="save()">
        <h2 id="<%- jhiPrefixDashed %>-<%- entityFileName %>-heading" data-cy="<%- entityNameCapitalized %>CreateUpdateHeading">{{ t$('<%- i18nKeyPrefix %>.home.createOrEditLabel') }}</h2>
        <div>
<%_ if (!builtInUserManagement && !userProvidedPrimaryKey) { _%>
          <div class="mb-3" v-if="<%- entityInstance %>.<%- primaryKey.name %>">
            <label class="form-label" for="id">{{ t$('global.field.id') }}</label>
            <input type="text" class="form-control" id="id" name="<%- primaryKey.name %>"
                v-model="<%- entityInstance %>.<%- primaryKey.name %>" readonly />
          </div>
<%_ } _%>
<%_ for (field of formFields) { _%>
  <%_ const { fieldName, fieldType, fieldTypeBlobContent } = field;
      const fieldInputClass = field.fieldTypeBoolean ? 'form-check-input' : 'form-control';
      const translationKey = `${i18nKeyPrefix}.${fieldName}`;
  _%>
          <div class="mb-3<%- field.fieldTypeBoolean ? ' form-check' : '' %>">
  <%_ if (!field.fieldTypeBoolean) { _%>
            <label class="form-label" for="<%- entityFileName %>-<%- fieldName %>">{{ t$('<%- translationKey %>') }}</label>
  <%_ } _%>
  <%_ if (field.clientConstantsAsValues) { _%>
            <select class="form-select" name="<%- fieldName %>" v-model="v$.<%- fieldName %>.$model" id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>"<%- field.collection ? ' multiple' : '' %>>
              <option v-for="value of <%- fieldName %>Values" :key="value" :value="value">{{ value }}</option>
            </select>
  <%_ } else if (field.fieldIsEnum) { _%>
            <select class="form-select" name="<%- fieldName %>" :class="{ 'is-valid': v$.<%- fieldName %>.$dirty && !v$.<%- fieldName %>.$invalid, 'is-invalid': v$.<%- fieldName %>.$dirty && v$.<%- fieldName %>.$invalid, 'is-touched': v$.<%- fieldName %>.$dirty }" @blur="v$.<%- fieldName %>.$touch()" v-model="v$.<%- fieldName %>.$model" id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>" <%- field.fieldValidate === true && field.fieldValidateRules.includes('required') ? ' required' : '' %>>
    <%_ const enumPrefix = `${frontendAppName}.${fieldType}`; _%>
              <option v-for="<%- field.enumInstance %> in <%- field.enumInstance %>Values" :key="<%- field.enumInstance %>" :value="<%- field.enumInstance %>" :label="t$('<%- enumPrefix %>.'+<%- field.enumInstance %>)">{{ <%- field.enumInstance %> }}</option>

            </select>
  <%_ } else { _%>
    <%_ if (field.fieldTypeBinary && !field.blobContentTypeText) { _%>
            <div>
      <%_ if (field.blobContentTypeImage) { _%>
              <img :src="'data:' + <%- entityInstance %>.<%- fieldName %>ContentType + ';base64,' + <%- entityInstance %>.<%- fieldName %>" style="max-height: 100px;" v-if="<%- entityInstance %>.<%- fieldName %>" alt="<%- entityInstance %>"/>
      <%_ } _%>
              <div v-if="<%- entityInstance %>.<%- fieldName %>" class="form-text text-danger clearfix">
      <%_ if (field.blobContentTypeAny) { _%>
                <a class="pull-start" @click="dataUtils.openFile(<%- entityInstance %>.<%- fieldName %>ContentType, <%- entityInstance %>.<%- fieldName %>)">{{ t$('entity.action.open') }}</a><br>
                <span class="pull-start">{{<%- entityInstance %>.<%- fieldName %>ContentType}}, {{dataUtils.byteSize(<%- entityInstance %>.<%- fieldName %>)}}</span>
      <%_ } else { _%>
                <span class="pull-start">{{<%- entityInstance %>.<%- fieldName %>ContentType}}, {{dataUtils.byteSize(<%- entityInstance %>.<%- fieldName %>)}}</span>
      <%_ } _%>
      <%_ if (field.blobContentTypeImage) { _%>
                <button type="button" @click="clearInputImage('<%- fieldName %>', '<%- fieldName %>ContentType', 'file_<%- fieldName %>')" class="btn btn-secondary btn-xs pull-end">
      <%_ } else { _%>
                <button type="button" @click="<%- entityInstance %>.<%- fieldName %>=undefined;<%- entityInstance %>.<%- fieldName %>ContentType=undefined;"
                    class="btn btn-secondary btn-xs pull-end">
      <%_ } _%>
                  <font-awesome-icon icon="times"></font-awesome-icon>
                </button>
              </div>
              <label for="file_<%- fieldName %>" class="btn btn-primary pull-end">{{ <%- fieldTypeBlobContent === 'image' ? 't$(\'entity.action.addimage\')' : 't$(\'entity.action.addblob\')' %> }}</label>
              <input type="file" ref="file_<%- fieldName %>" id="file_<%- fieldName %>" style="display: none;" data-cy="<%- fieldName %>" @change="dataUtils.setFileData($event, <%- entityInstance %>, '<%- fieldName %>', <%- fieldTypeBlobContent === 'image' ? 'true)" accept="image/*"' : 'false)"' %>/>
            </div>
    <%_ } _%>
    <%_ if (field.fieldTypeLocalDate) { _%>
            <b-input-group class="mb-3">
              <b-input-group-prepend>
                <b-form-datepicker
                  aria-controls="<%- entityFileName %>-<%- fieldName %>"
                  v-model="v$.<%- fieldName %>.$model"
                  name="<%- fieldName %>"
                  class="<%- fieldInputClass %>"
                  :locale="currentLanguage"
                  button-only
                  today-button
                  reset-button
                  close-button
                >
                </b-form-datepicker>
              </b-input-group-prepend>
              <b-form-input id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>" type="text" class="<%- fieldInputClass %>" name="<%- fieldName %>"  :class="{ 'is-valid': v$.<%- fieldName %>.$dirty && !v$.<%- fieldName %>.$invalid, 'is-invalid': v$.<%- fieldName %>.$dirty && v$.<%- fieldName %>.$invalid, 'is-touched': v$.<%- fieldName %>.$dirty }" @blur="v$.<%- fieldName %>.$touch()"
              v-model="v$.<%- fieldName %>.$model" <%- field.fieldValidate && field.fieldValidationRequired ? ' required' : '' %> />
            </b-input-group>
    <%_ } else if (field.fieldTypeInstant) { _%>
            <div class="d-flex">
              <input id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>" type="datetime-local" class="<%- fieldInputClass %>" name="<%- fieldName %>" :class="{ 'is-valid': v$.<%- fieldName %>.$dirty && !v$.<%- fieldName %>.$invalid, 'is-invalid': v$.<%- fieldName %>.$dirty && v$.<%- fieldName %>.$invalid, 'is-touched': v$.<%- fieldName %>.$dirty }" @blur="v$.<%- fieldName %>.$touch()"
              <%- field.fieldValidate && field.fieldValidationRequired ? ' required' : '' %>
              :value="dateFormat.convertDateTimeFromServer(v$.<%- fieldName %>.$model)"
              @change="dateFormat.updateInstantField('<%- fieldName %>', $event)"/>
            </div>
    <%_ } else if (field.fieldTypeZonedDateTime) { _%>
            <div class="d-flex">
              <input id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>" type="datetime-local" class="<%- fieldInputClass %>" name="<%- fieldName %>" :class="{ 'is-valid': v$.<%- fieldName %>.$dirty && !v$.<%- fieldName %>.$invalid, 'is-invalid': v$.<%- fieldName %>.$dirty && v$.<%- fieldName %>.$invalid, 'is-touched': v$.<%- fieldName %>.$dirty }" @blur="v$.<%- fieldName %>.$touch()"
              <%- field.fieldValidate && field.fieldValidationRequired ? ' required' : '' %>
              :value="dateFormat.convertDateTimeFromServer(v$.<%- fieldName %>.$model)"
              @change="dateFormat.updateZonedDateTimeField('<%- fieldName %>', $event)"/>
            </div>
    <%_ } else if (field.blobContentTypeText) { _%>
            <textarea class="<%- fieldInputClass %>" name="<%- fieldName %>" id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>"
              :class="{ 'is-valid': v$.<%- fieldName %>.$dirty && !v$.<%- fieldName %>.$invalid, 'is-invalid': v$.<%- fieldName %>.$dirty && v$.<%- fieldName %>.$invalid, 'is-touched': v$.<%- fieldName %>.$dirty }" @blur="v$.<%- fieldName %>.$touch()" v-model="v$.<%- fieldName %>.$model" <%- field.fieldValidate && field.fieldValidateRules.includes('required') ? ' required' : '' %>></textarea>
    <%_ } else { _%>
            <input type="<%- field.htmlInputType %>" class="<%- fieldInputClass %>" name="<%- fieldName %>" id="<%- entityFileName %>-<%- fieldName %>" data-cy="<%- fieldName %>"
              :class="{ 'is-valid': v$.<%- fieldName %>.$dirty && !v$.<%- fieldName %>.$invalid, 'is-invalid': v$.<%- fieldName %>.$dirty && v$.<%- fieldName %>.$invalid, 'is-touched': v$.<%- fieldName %>.$dirty }" @blur="v$.<%- fieldName %>.$touch()" v-model<%- field.htmlInputType === 'number' ? '.number' : '' %>="v$.<%- fieldName %>.$model" <%- field.fieldValidate && field.fieldValidateRules.includes('required') ? ' required' : '' %><%- (field.id && userProvidedPrimaryKey) ? ' :readonly="isUpdate"' : '' %>/>
      <%_ if (field.fieldTypeBinary) { _%>
            <input type="hidden" class="<%- fieldInputClass %>" name="<%- fieldName %>ContentType" id="<%- entityFileName %>-<%- fieldName %>ContentType"
              v-model="<%- entityInstance %>.<%- fieldName %>ContentType" />
      <%_ } _%>
    <%_ } _%>
  <%_ } _%>
  <%_ if (field.fieldTypeBoolean) { _%>
            <label class="form-check-label" for="<%- entityFileName %>-<%- fieldName %>">{{ t$('<%- translationKey %>') }}</label>
  <%_ } _%>
  <%_ if (field.vueClientValidation) { _%>
            <div v-if="v$.<%- fieldName %>.$anyDirty && v$.<%- fieldName %>.$invalid">
              <small
                class="form-text text-danger"
                v-for="error of v$.<%- fieldName %>.$errors"
                :key="error.$uid"
              >{{ error.$message }}</small>
            </div>
  <%_ } _%>
          </div>
<%_ } _%>
<%_ for (relationship of relationships.filter(rel => !rel.otherEntity.embedded)) { _%>
  <%_ const { otherEntityName, relationshipName, relationshipFieldName, relationshipFieldNamePlural, otherEntityField, relationshipRequired } = relationship;
      const translationKey = relationship.propertyTranslationKey;
  _%>
  <%_ if (!relationship.collection && relationship.persistableRelationship) { _%>
          <div class="mb-3">
            <label class="form-label" for="<%- entityFileName %>-<%- relationshipName %>">{{ t$('<%- translationKey %>') }}</label>
            <select class="form-select" id="<%- entityFileName %>-<%- relationshipName %>" data-cy="<%- relationshipFieldName %>" name="<%- relationshipName %>" v-model="<%- entityInstance %>.<%- relationshipFieldName %>"<%- relationshipRequired ? ' required' : '' %>>
    <%_ if (relationshipRequired) { _%>
              <option v-if="!<%- entityInstance %>.<%- relationshipName %>" :value="null" selected></option>
    <%_ } else { _%>
              <option :value="null"></option>
    <%_ } _%>
              <option :value="<%- entityInstance %>.<%- relationshipFieldName %> && <%- otherEntityName %>Option.<%- relationship.otherEntity.primaryKey.name %> === <%- entityInstance %>.<%- relationshipFieldName %>.<%- relationship.otherEntity.primaryKey.name %> ? <%- entityInstance %>.<%- relationshipFieldName %> : <%- otherEntityName %>Option" v-for="<%- otherEntityName %>Option in <%- relationship.otherEntity.entityInstancePlural %>" :key="<%- otherEntityName %>Option.<%- relationship.otherEntity.primaryKey.name %>">{{<%- otherEntityName %>Option.<%- otherEntityField %>}}</option>
            </select>
          </div>
  <%_ } else if (relationship.persistableRelationship) { _%>
          <div class="mb-3">
            <label class="form-label" for="<%- entityFileName %>-<%- relationshipFieldNamePlural %>">{{ t$('<%- translationKey %>') }}</label>
            <select class="form-select" id="<%- entityFileName %>-<%- relationshipFieldNamePlural %>" data-cy="<%- relationshipFieldName %>" multiple name="<%- relationshipName %>" v-if="<%- entityInstance %>.<%- relationshipFieldNamePlural %> !== undefined" v-model="<%- entityInstance %>.<%- relationshipFieldNamePlural %>"<%- relationshipRequired ? ' required' : '' %>>
              <option :value="<% if (relationship.relationshipSerializePrimaryKeyOnly) { %><%- otherEntityName %>Option.<%- relationship.otherEntity.primaryKey.name %><% } else { %>getSelected(<%- entityInstance %>.<%- relationshipFieldNamePlural %>, <%- otherEntityName %>Option, '<%- relationship.otherEntity.primaryKey.name %>')<% } %>" v-for="<%- otherEntityName %>Option in <%- relationship.otherEntity.entityInstancePlural %>" :key="<%- otherEntityName %>Option.<%- relationship.otherEntity.primaryKey.name %>">{{<%- otherEntityName %>Option.<%- otherEntityField %>}}</option>
            </select>
          </div>
  <%_ } _%>
  <%_ if (relationship.relationshipValidate) { _%>
          <div v-if="v$.<%- relationship.collection ? relationshipFieldNamePlural : relationshipFieldName %>.$anyDirty && v$.<%- relationship.collection ? relationshipFieldNamePlural : relationshipFieldName %>.$invalid">
            <small
              class="form-text text-danger"
              v-for="error of v$.<%- relationship.collection ? relationshipFieldNamePlural : relationshipFieldName %>.$errors"
              :key="error.$uid"
            >{{ error.$message }}</small>
          </div>
  <%_ } _%>
<%_ } _%>
        </div>
        <div>
          <button type="button" id="cancel-save" data-cy="entityCreateCancelButton" class="btn btn-info" @click="previousState()">
            <font-awesome-icon icon="arrow-left"></font-awesome-icon>&nbsp;<span>{{ t$('entity.action.back') }}</span>
          </button>
          <button type="submit" id="save-entity" data-cy="entityCreateSaveButton" :disabled="isSaving || isLoading" class="btn btn-primary">
            <font-awesome-icon icon="save"></font-awesome-icon>&nbsp;<span>{{ t$('entity.action.save') }}</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</template>

<script setup lang="ts">
<%_ const allRelationshipsThatNeedSelectOptions = Object
      .values(relationshipsByOtherEntity)
      .map(relationships => relationships.filter(rel => rel.persistableRelationship && !rel.otherEntity.embedded))
      .filter(relationships => relationships.length > 0);
    const relationshipsContainManyToOne = relationships.some(rel => !rel.otherEntity.embedded && rel.collection && rel.persistableRelationship);
    const clientConstantFields = formFields.filter(field => field.clientConstantsAsValues);
    const usesGetSelected = relationships.some(rel => !rel.otherEntity.embedded && rel.collection && rel.persistableRelationship && !rel.relationshipSerializePrimaryKeyOnly);
_%>
import { <%- [...anyFieldIsLocalDate || userProvidedPrimaryKey ? ['computed'] : [], 'inject', ...enumTypeFields.length > 0 ? ['ref'] : []].join(', ') %> } from 'vue';
<%_ if (enableTranslation) { _%>
import { useI18n } from 'vue-i18n';
<%_ } _%>
import { useRoute, useRouter } from 'vue-router';

import { type AxiosError } from 'axios';

import { alertServiceKey, useAlertService } from '@/shared/alert/alert.service';
<%_ const composables = ['useControlledRequest', ...vueFormTimeFields ? ['useDateFormat'] : [], ...allRelationshipsThatNeedSelectOptions.length > 0 ? ['useEntityOptions'] : [], 'useEntitySave', 'useEntityValidation']; _%>
import { <%- composables.join(', ') %> } from '@/composables';
<%_ if (anyFieldIsLocalDate) { _%>
import { currentLanguageKey } from '@/config/injection-keys';
<%_ } _%>
<%_ if (anyFieldHasFileBasedContentType) { _%>
import useDataUtils from '@/composables/data-utils';
<%_ } _%>

<%_ for (const [relationship] of allRelationshipsThatNeedSelectOptions) { _%>
  <%_ if (relationship.otherEntity.builtInUser) { _%>
import UserService, { userServiceKey } from '@/entities/user/user.service';
  <%_ } else if (relationship.otherEntity.entityAngularName !== entityAngularName) { _%>
import <%- relationship.otherEntity.entityAngularName %>Service, { <%- relationship.otherEntity.entityInstance %>ServiceKey } from '@/entities/<%- relationship.otherEntity.entityClientRootFolder %><%- relationship.otherEntity.entityFolderName %>/<%- relationship.otherEntity.entityFileName %>.service';
  <%_ } _%>
<%_ } _%>
import { type I<%- entityAngularName %>, <%- entityAngularName %> } from './<%- entityFileName %>.model';
import <%- entityAngularName %>Service, { <%- entityInstance %>ServiceKey } from './<%- entityFileName %>.service';
<%_ for (const constantImport of new Set(clientConstantFields.map(field => field.vueFieldClientConstant.vueConstantImport))) { _%>
<%- constantImport %>
<%_ } _%>
<%_ const enumImports = entityClientEnumImports; _%>
<%_ for (const [importedType, importedPath] of enumImports) { _%>
import { <%- importedType %> } from '<%- importedPath %>';
<%_ } _%>

defineOptions({ name: '<%- entityAngularName %>Update' });

const <%- entityInstance %>Service = inject(<%- entityInstance %>ServiceKey, () => new <%- entityAngularName %>Service());
const alertService = inject(alertServiceKey, () => useAlertService(), true);
const showLoadError = (error: unknown) => alertService.showHttpError((error as AxiosError).response);

const new<%- entityAngularName %> = (): I<%- entityAngularName %> => {
  const entity = new <%- entityAngularName %>();
<%_ if (relationshipsContainManyToOne) { _%>
  <%_ for (const relationship of relationships.filter(relationship => relationship.collection && relationship.persistableRelationship)) { _%>
  entity.<%- relationship.relationshipFieldNamePlural %> = [];
  <%_ } _%>
<%_ } _%>
  return entity;
};
<%_ for (const [relationship] of allRelationshipsThatNeedSelectOptions) { _%>
  <%_ if (relationship.otherEntity.builtInUser) { _%>
const userService = inject(userServiceKey, () => new UserService());
const <%- relationship.otherEntity.entityInstancePlural %> = useEntityOptions(options => userService().retrieve(options), showLoadError);
  <%_ } else { _%>
    <%_ if (relationship.otherEntity.entityAngularName !== entityAngularName) { _%>

const <%- relationship.otherEntity.entityInstance %>Service = inject(<%- relationship.otherEntity.entityInstance %>ServiceKey, () => new <%- relationship.otherEntity.entityAngularName %>Service());
    <%_ } _%>

const <%- relationship.otherEntity.entityInstancePlural %> = useEntityOptions(options => <%- relationship.otherEntity.entityInstance %>Service().retrieve(options), showLoadError);
  <%_ } _%>
<%_ } _%>
<%_ for (const enumField of enumTypeFields) { _%>
const <%- enumField.enumInstance %>Values = ref<string[]>(Object.keys(<%- enumField.fieldType %>));
<%_ } _%>
<%_ for (const field of clientConstantFields) { _%>
const <%- field.fieldName %>Values: string[] = <%- field.vueFieldClientConstant.vueConstantValues %>;
<%_ } _%>
<%_ if (anyFieldIsLocalDate) { _%>
const currentLanguage = inject(currentLanguageKey, () => computed(() => navigator.language ?? '<%- nativeLanguage %>'), true);
<%_ } _%>

const route = useRoute();
const router = useRouter();
<%_ if (userProvidedPrimaryKey) { _%>
// The primary key is given by the user: an entity is updated when the route has it.
const isUpdate = computed(() => Boolean(route.params?.<%- entityInstance %>Id));
<%_ } _%>

const previousState = () => router.go(-1);

const { data: <%- entityInstance %>, isLoading } = useControlledRequest(
  (id, { signal }) => <%- entityInstance %>Service().find(id, { signal }),
  {
    // The router reuses the component when the id of the route changes, and an update without id is a new entity.
    params: () => route.params?.<%- entityInstance %>Id as string | undefined,
    initialData: new<%- entityAngularName %>,
    onError: showLoadError,
  },
);
<%_ if (vueFormTimeFields) { _%>
const dateFormat = useDateFormat({ entityRef: <%- entityInstance %> });
<%_ } _%>
<%_ if (anyFieldHasFileBasedContentType) { _%>
const dataUtils = useDataUtils();
<%_ } _%>

<%_ if (enableTranslation) { _%>
const { t: t$ } = useI18n();
<%_ } _%>
const v$ = useEntityValidation(<%- entityInstance %>, {
<%_ for (field of formFields) { _%>
  <%- field.fieldName %>: <%- field.vueValidationRules %>,
<%_ } _%>
<%_ for (relationship of relationships) { _%>
  <%- relationship.collection ? relationship.relationshipFieldNamePlural : relationship.relationshipFieldName %>: <%- relationship.relationshipValidate ? '{ required: true }' : '{}' %>,
<%_ } _%>
});

const { isSaving, save: saveEntity } = useEntitySave({
  alertService,
  isUpdate: () => <% if (userProvidedPrimaryKey) { %>isUpdate.value<% } else { %>Boolean(<%- entityInstance %>.value.<%- builtInUserManagement ? 'id' : primaryKey.name %>)<% } %>,
  create: () => <%- entityInstance %>Service().create(<%- entityInstance %>.value),
  update: () => <%- entityInstance %>Service().update(<%- entityInstance %>.value),
  getId: saved => saved.<%- primaryKey.name %>,
<%_ if (enableTranslation) { _%>
  createdMessage: id => t$('<%- i18nAlertHeaderPrefix %>.created', { param: id }).toString(),
  updatedMessage: id => t$('<%- i18nAlertHeaderPrefix %>.updated', { param: id }).toString(),
<%_ } else { _%>
  createdMessage: id => `A <%- entityAngularName %> is created with identifier ${id}`,
  updatedMessage: id => `A <%- entityAngularName %> is updated with identifier ${id}`,
<%_ } _%>
  onSaved: () => previousState(),
});

const save = async () => {
  if (v$.value.$invalid) {
    // The fields are marked and their errors shown, nothing is sent.
    v$.value.$touch();
    return;
  }
  await saveEntity();
};
<%_ if (anyFieldIsBlobDerived && anyFieldHasImageContentType) { _%>

const clearInputImage = (field: string, fieldContentType: string, idInput: string) => {
  (<%- entityInstance %>.value as Record<string, unknown>)[field] = null;
  (<%- entityInstance %>.value as Record<string, unknown>)[fieldContentType] = null;
  const input = document.getElementById(idInput) as HTMLInputElement | null;
  if (input) {
    input.value = '';
  }
};
<%_ } _%>
<%_ if (usesGetSelected) { _%>

// The server gives null for a collection without values.
const getSelected = <T extends object>(selectedVals: T[] | null | undefined, option: T, pkField = 'id'): T =>
  selectedVals?.find(value => (option as Record<string, unknown>)[pkField] === (value as Record<string, unknown>)[pkField]) ?? option;
<%_ } _%>

defineExpose({
  <%- entityInstance %>Service,
  alertService,
  <%- entityInstance %>,
  isLoading,
  isSaving,
  save,
  previousState,
  v$,
<%_ if (anyFieldIsLocalDate) { _%>
  currentLanguage,
<%_ } _%>
<%_ if (vueFormTimeFields) { _%>
  dateFormat,
<%_ } _%>
<%_ if (anyFieldIsBlobDerived && anyFieldHasImageContentType) { _%>
  clearInputImage,
<%_ } _%>
});
</script>
