        </b-modal>
<%_ } _%>
<%_ if (!databaseTypeCassandra) { _%>
  <%_ if (paginationPagination) { _%>
        <div v-show="<%- entityInstancePlural %>?.length > 0">
            <div class="d-flex justify-content-center">
