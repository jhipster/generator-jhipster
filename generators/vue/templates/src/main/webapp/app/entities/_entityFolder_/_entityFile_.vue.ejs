                </tbody>
<%_ if (!databaseTypeCassandra) { _%>
  <%_ if (paginationInfiniteScroll) { _%>
                <span ref="infiniteScrollEl"></span>
  <%_ } _%>
<%_ } _%>
            </table>
        </div>
<%_ if (!readOnly) { _%>
        <b-modal ref="removeEntity" id="removeEntity" title-tag="h4">
