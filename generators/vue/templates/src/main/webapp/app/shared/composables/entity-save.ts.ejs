import { ref } from 'vue';

import { type AxiosError } from 'axios';

import type AlertService from '@/shared/alert/alert.service';

/**
 * The save of the form of an entity: created or updated, with an alert of the saved one.
 */
export const useEntitySave = <T, K>({
  alertService,
  isUpdate,
  create,
  update,
  getId,
  createdMessage,
  updatedMessage,
  onSaved,
}: {
  alertService: AlertService;
  /** Whether the entity of the form exists, to update it, else to create it. */
  isUpdate: () => boolean;
  create: () => Promise<T>;
  update: () => Promise<T>;
  getId: (saved: T) => K;
  createdMessage: (id: K) => string;
  updatedMessage: (id: K) => string;
  onSaved: () => unknown;
}) => {
  const isSaving = ref(false);

  const save = async () => {
    isSaving.value = true;
    try {
      if (isUpdate()) {
        alertService.showInfo(updatedMessage(getId(await update())));
      } else {
        alertService.showSuccess(createdMessage(getId(await create())));
      }
      await onSaved();
    } catch (error) {
      alertService.showHttpError((error as AxiosError).response);
    } finally {
      isSaving.value = false;
    }
  };

  return { isSaving, save };
};
