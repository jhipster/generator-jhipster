import { afterEach, describe, expect, it, vi } from 'vitest';

import { byteSize, openFile, paddingSize, toBase64, toOpenableContentType } from './data-utils';

describe('data utils', () => {
  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('should compute the size of a base64 value', () => {
    expect(paddingSize('AA==')).toBe(2);
    expect(paddingSize('AAA=')).toBe(1);
    expect(paddingSize('AAAA')).toBe(0);
    expect(byteSize('AAAAAAAA')).toBe('6 bytes');
  });

  it('should read a file as base64', async () => {
    const base64Data = await new Promise(resolve => toBase64(new File(['jhipster'], 'file.txt', { type: 'text/plain' }), resolve));

    expect(base64Data).toBe(btoa('jhipster'));
  });

  it('should open only safe content types', () => {
    expect(toOpenableContentType('image/png; charset=utf-8', 'image')).toBe('image/png');
    expect(toOpenableContentType('image/svg+xml', 'image')).toBe('application/octet-stream');
    expect(toOpenableContentType('text/plain', 'text')).toBe('text/plain');
    expect(toOpenableContentType('text/html', 'text')).toBe('application/octet-stream');
    expect(toOpenableContentType(undefined)).toBe('application/octet-stream');
  });

  it('should open a file in a new window, revoking its url once loaded', () => {
    const win: { onload?: () => void } = {};
    const open = vi.spyOn(globalThis, 'open').mockReturnValue(win as unknown as Window);
    vi.spyOn(URL, 'createObjectURL').mockReturnValue('blob:file');
    const revokeObjectURL = vi.spyOn(URL, 'revokeObjectURL').mockImplementation(() => {});

    openFile(btoa('jhipster'), 'text/plain', 'text');
    win.onload!();
    open.mockReturnValue(null);
    openFile(btoa('jhipster'), 'text/plain', 'text');

    expect(open).toHaveBeenCalledWith('blob:file');
    expect(revokeObjectURL).toHaveBeenCalledOnce();
  });
});
