import { type Ref, ref } from 'vue';

import type AlertService from '@/shared/alert/alert.service';

/**
 * The removal of an entity behind a confirmation dialog, the `removeEntity` modal of the component.
 */
export const useEntityRemove = <T, K>({
  alertService,
  getId,
  remove,
  removedMessage,
  onRemoved,
}: {
  alertService: AlertService;
  getId: (instance: T) => K;
  remove: (id: K) => Promise<unknown>;
  removedMessage: (id: K) => string;
  onRemoved: () => unknown;
}) => {
  const removeId: Ref<K | null> = ref(null);
  const removeEntity = ref<{ show: () => void; hide: () => void } | null>(null);

  const prepareRemove = (instance: T) => {
    removeId.value = getId(instance);
    removeEntity.value?.show();
  };

  const closeDialog = () => {
    removeEntity.value?.hide();
  };

  const confirmRemove = async () => {
    try {
      await remove(removeId.value as K);
      alertService.showInfo(removedMessage(removeId.value as K), { variant: 'danger' });
      removeId.value = null;
      closeDialog();
      await onRemoved();
    } catch (error) {
      alertService.showHttpError(error.response);
    }
  };

  return { removeId, removeEntity, prepareRemove, closeDialog, confirmRemove };
};
