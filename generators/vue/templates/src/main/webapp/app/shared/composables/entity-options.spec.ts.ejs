import { describe, expect, it, vi } from 'vitest';
import { effectScope } from 'vue';

import { flushPromises } from '@vue/test-utils';

import { useEntityOptions } from './entity-options';

describe('useEntityOptions', () => {
  it('should load the options once, with the signal of the request', async () => {
    const retrieve = vi.fn().mockResolvedValue({ data: [{ id: 1 }] });
    const options = effectScope().run(() => useEntityOptions(retrieve))!;
    await flushPromises();

    expect(retrieve).toHaveBeenCalledExactlyOnceWith({ signal: expect.any(AbortSignal) });
    expect(options.value).toEqual([{ id: 1 }]);
  });

  it('should give the error of a failed load', async () => {
    const onError = vi.fn();
    const options = effectScope().run(() => useEntityOptions(vi.fn().mockRejectedValue('error'), onError))!;
    await flushPromises();

    expect(onError).toHaveBeenCalledWith('error');
    expect(options.value).toEqual([]);
  });
});
