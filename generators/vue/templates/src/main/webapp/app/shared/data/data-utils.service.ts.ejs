import { type BlobType, byteSize, openFile, toBase64 } from '@/shared/jhipster/data-utils';
import { getPageNumberFromLinkHeader } from '@/shared/jhipster/link-header';

/**
 * A composable utility for data.
 */
const useDataUtils = () => ({
  /**
   * Method to abbreviate the text given
   */
  abbreviate(text: string | null | undefined, append = '...'): string {
    if (!text) {
      return '';
    }
    if (text.length < 30) {
      return text;
    }
    return text.substring(0, 15) + append + text.slice(-10);
  },

  /**
   * Method to find the byte size of the string provides
   */
  byteSize(base64String: string): string {
    return byteSize(base64String);
  },

  /**
   * Method to open file
   */
  openFile(contentType: string | null | undefined, data: string, blobType?: BlobType): void {
    openFile(data, contentType, blobType);
  },

  setFileData(event: Event, entity: object, field: string, isImage: boolean): void {
    const file = (event?.target as HTMLInputElement | null)?.files?.[0];
    if (file) {
      if (isImage && !file.type.startsWith("image/")) {
        return;
      }
      toBase64(file, base64Data => {
        (entity as Record<string, unknown>)[field] = base64Data;
        (entity as Record<string, unknown>)[`${field}ContentType`] = file.type;
      });
    }
  },

  /**
   * Method to parse header links
   */
  parseLinks(header: string): Record<string, number> {
    try {
      return getPageNumberFromLinkHeader(header);
    } catch {
      return {};
    }
  },
});

export default useDataUtils;
