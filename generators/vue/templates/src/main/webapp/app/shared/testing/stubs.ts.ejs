/* eslint-disable vue/one-component-per-file */
import { type BaseWrapper, type DOMWrapper } from '@vue/test-utils';
import { defineComponent, h } from 'vue';

/** A b-modal rendering its title, body and footer, to test the dialogs of a view. */
export const bModalStub = defineComponent({
  setup(_props, { slots }) {
    return () => h('div', [slots.title?.(), slots.default?.(), slots.footer?.()]);
  },
  methods: {
    hide: () => {},
    show: () => {},
  },
});

/** A b-button rendering a button with its content. */
export const bButtonStub = defineComponent({
  setup(_props, { slots }) {
    return () => h('button', { type: 'button' }, slots.default?.());
  },
});

/** A router-link rendering its content, a custom one with a navigate doing nothing. */
export const routerLinkStub = defineComponent({
  setup(_props, { slots }) {
    return () => h('span', slots.default?.({ navigate: () => {} }));
  },
});

/** Triggers an event on every element of a view the selector matches, one at a time. */
export const triggerAll = async (wrapper: BaseWrapper<Node>, selector: string, event: string) => {
  for (const element of wrapper.findAll(selector) as DOMWrapper<Element>[]) {
    await element.trigger(event);
  }
};

/** Sets each value, in turn, on every input of a view the selector matches, rendering the validation of each one. */
export const setAllValues = async (wrapper: BaseWrapper<Node>, selector: string, values: string[]) => {
  for (const value of values) {
    for (const element of wrapper.findAll(selector) as DOMWrapper<HTMLInputElement>[]) {
      await element.setValue(value);
    }
  }
};

/** Values failing the required, the minimum length, the pattern, the email and the maximum length validations, then a valid one. */
export const formValues = ['', 'x', ' x', 'x'.repeat(300), 'jhi@pster.net'];

/** A component rendering all its slots, like a b-nav-item-dropdown with its button content. */
export const slotsStub = defineComponent({
  setup(_props, { slots }) {
    return () => h('div', Object.values(slots).map(slot => slot?.()));
  },
});

/** A b-form rendering a form with its content. */
export const bFormStub = defineComponent({
  setup(_props, { slots }) {
    return () => h('form', slots.default?.());
  },
});

/** A component rendering its content only, like a b-input-group. */
export const contentStub = defineComponent({
  setup(_props, { slots }) {
    return () => h('div', slots.default?.());
  },
});

/** An input bound by v-model, like a b-form-input or a b-form-datepicker. */
export const modelInputStub = defineComponent({
  props: { modelValue: { type: null, default: undefined } },
  emits: ['update:modelValue'],
  setup(props, { emit }) {
    return () =>
      h('input', { value: props.modelValue, onInput: (event: Event) => emit('update:modelValue', (event.target as HTMLInputElement).value) });
  },
});
