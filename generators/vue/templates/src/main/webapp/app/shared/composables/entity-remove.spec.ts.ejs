import { describe, expect, it, vi } from 'vitest';

import AlertService from '@/shared/alert/alert.service';

import { useEntityRemove } from './entity-remove';

describe('useEntityRemove', () => {
  const setup = (remove = vi.fn().mockResolvedValue({})) => {
    const alertService = new AlertService({ i18n: { t: vi.fn() } as any, toast: { create: vi.fn() } as any });
    vi.spyOn(alertService, 'showInfo').mockImplementation(() => {});
    vi.spyOn(alertService, 'showHttpError').mockImplementation(() => {});
    const onRemoved = vi.fn();
    const entityRemove = useEntityRemove({
      alertService,
      getId: (instance: { id: number }) => instance.id,
      remove,
      removedMessage: id => `removed ${id}`,
      onRemoved,
    });
    entityRemove.removeEntity.value = { show: vi.fn(), hide: vi.fn() };
    return { alertService, onRemoved, remove, ...entityRemove };
  };

  it('should open the dialog for the instance', () => {
    const { prepareRemove, removeId, removeEntity } = setup();

    prepareRemove({ id: 123 });

    expect(removeId.value).toBe(123);
    expect(removeEntity.value.show).toHaveBeenCalled();
  });

  it('should remove the instance', async () => {
    const { alertService, confirmRemove, onRemoved, prepareRemove, remove, removeEntity, removeId } = setup();
    prepareRemove({ id: 123 });

    await confirmRemove();

    expect(remove).toHaveBeenCalledWith(123);
    expect(alertService.showInfo).toHaveBeenCalledWith('removed 123', { variant: 'danger' });
    expect(removeId.value).toBeNull();
    expect(removeEntity.value.hide).toHaveBeenCalled();
    expect(onRemoved).toHaveBeenCalled();
  });

  it('should show the error of a failed removal', async () => {
    const { alertService, confirmRemove, onRemoved, prepareRemove } = setup(vi.fn().mockRejectedValue({ response: { status: 500 } }));
    prepareRemove({ id: 123 });

    await confirmRemove();

    expect(alertService.showHttpError).toHaveBeenCalledWith({ status: 500 });
    expect(onRemoved).not.toHaveBeenCalled();
  });
});
