import { type InjectionKey } from 'vue';
<%_ if (enableTranslation) { _%>
import { type Composer, useI18n } from 'vue-i18n';
<%_ } _%>

import { type BToastProps, useToast } from 'bootstrap-vue-next';

import { getMessageFromHeaders } from '@/shared/jhipster/headers';

/** An error of a field of the body, as the server gives it in a problem detail. */
type FieldError = { objectName: string; field: string; message: string; code: string };

export const useAlertService = () => {
  // Throws without the plugin of BootstrapVue.
  const toast = useToast();
<%_ if (enableTranslation) { _%>
  const i18n = useI18n();
<%_ } _%>
  return new AlertService({
    toast,
<%_ if (enableTranslation) { _%>
    i18n,
<%_ } _%>
  });
};

export default class AlertService {
  private readonly toast: Pick<ReturnType<typeof useToast>, 'create'>;
<%_ if (enableTranslation) { _%>
  private readonly i18n: Pick<Composer, 't'>;
<%_ } _%>

  constructor({
    toast,
<%_ if (enableTranslation) { _%>
    i18n,
<%_ } _%>
  }: {
    toast: Pick<ReturnType<typeof useToast>, 'create'>;
<%_ if (enableTranslation) { _%>
    i18n: Pick<Composer, 't'>,
<%_ } _%>
  }) {
    this.toast = toast;
<%_ if (enableTranslation) { _%>
    this.i18n = i18n;
<%_ } _%>
  }

  showInfo(toastMessage: string, props: BToastProps = {}) {
    this.toast.create({
      modelValue: 5000,
      position: 'top-end',
      title: 'Info',
      variant: 'info',
      solid: true,
      body: toastMessage,
      ...props,
    });
  }

  showSuccess(toastMessage: string) {
    this.showInfo(toastMessage, {
      title: 'Success',
      variant: 'success',
    });
  }

  showError(toastMessage: string) {
    this.showInfo(toastMessage, {
      title: 'Error',
      variant: 'danger',
    });
  }

  showHttpError(response?: { data?: unknown; status?: number; headers?: Record<string, unknown> }) {
    // Without a response, the server was not reached.
    const { data: body, status = 0, headers } = response ?? {};
    // The body of an error of the server, a problem detail.
    const data = body as { message?: string; fieldErrors?: unknown } | undefined;
    let errorMessage: string | null = null;
    switch (status) {
      case 401:
        // The login is asked for again.
        return;

      case 0:
        errorMessage = this.i18n.t('error.server.not.reachable').toString();
        break;

      case 400: {
        if (Array.isArray(data?.fieldErrors) && data.fieldErrors.length > 0) {
          for (const fieldError of data.fieldErrors as FieldError[]) {
            this.showError(this.getFieldErrorMessage(fieldError));
          }
          return;
        }
        const message = getMessageFromHeaders(headers!);
<%_ if (enableTranslation) { _%>
        if (message.errorKey && message.param) {
          errorMessage = this.i18n.t(message.errorKey, { entityName: this.i18n.t(`global.menu.entities.${message.param}`) }).toString();
        } else if (message.errorKey) {
          errorMessage = this.i18n.t(message.errorKey).toString();
        } else
<%_ } _%>
        if (message.errorMessage) {
          errorMessage = message.errorMessage;
        } else if (data?.message) {
<%_ if (enableTranslation) { _%>
          errorMessage = this.i18n.t(data.message).toString();
<%_ } else { _%>
          errorMessage = data.message;
<%_ } _%>
        }
        break;
      }

      case 404:
        errorMessage = this.i18n.t('error.http.404').toString();
        break;

      default:
<%_ if (enableTranslation) { _%>
        errorMessage = this.i18n.t(data?.message ?? 'error.http.500').toString();
<%_ } else { _%>
        errorMessage = data?.message ?? 'Internal server error.';
<%_ } _%>
    }
    this.showError(errorMessage!);
  }

  private getFieldErrorMessage({ <%- enableTranslation ? 'objectName, field, code' : 'field' %> }: FieldError): string {
    // convert 'something[14].other[4].id' to 'something[].other[].id' so translations can be written to it
    const convertedField = field.replace(/\[\d*\]/g, '[]');
<%_ if (enableTranslation) { _%>
    // The code of the constraint is the key of its translation.
    const errorKey = ['Min', 'Max', 'DecimalMin', 'DecimalMax'].includes(code) ? 'Size' : code;
    const fieldName = this.i18n.t(`<%- frontendAppName %>.${objectName}.${convertedField}`).toString();
    return this.i18n.t(`error.${errorKey}`, { fieldName }).toString();
<%_ } else { _%>
    const fieldName = convertedField.charAt(0).toUpperCase() + convertedField.slice(1);
    return `Error on field "${fieldName}"`;
<%_ } _%>
  }
}

export const alertServiceKey: InjectionKey<AlertService> = Symbol.for('jhipster:alertService');
