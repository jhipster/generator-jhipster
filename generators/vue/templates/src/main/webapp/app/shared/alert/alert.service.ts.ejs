import { type InjectionKey } from 'vue';
<%_ if (enableTranslation) { _%>
import { type Composer, useI18n } from 'vue-i18n';
<%_ } _%>

import { type BToastProps, useToast } from 'bootstrap-vue-next';

import { getMessageFromHeaders } from '@/shared/jhipster/headers';
import { type FieldErrorVM, getServerProblem, isConstraintViolation } from '@/shared/jhipster/problem-details';

export const useAlertService = () => {
  // Throws without the plugin of BootstrapVue.
  const toast = useToast();
<%_ if (enableTranslation) { _%>
  const i18n = useI18n();
<%_ } _%>
  return new AlertService({
    toast,
<%_ if (enableTranslation) { _%>
    i18n,
<%_ } _%>
  });
};

export default class AlertService {
  private readonly toast: Pick<ReturnType<typeof useToast>, 'create'>;
<%_ if (enableTranslation) { _%>
  private readonly i18n: Pick<Composer, 't'> & Partial<Pick<Composer, 'te'>>;
<%_ } _%>

  constructor({
    toast,
<%_ if (enableTranslation) { _%>
    i18n,
<%_ } _%>
  }: {
    toast: Pick<ReturnType<typeof useToast>, 'create'>;
<%_ if (enableTranslation) { _%>
    i18n: Pick<Composer, 't'> & Partial<Pick<Composer, 'te'>>,
<%_ } _%>
  }) {
    this.toast = toast;
<%_ if (enableTranslation) { _%>
    this.i18n = i18n;
<%_ } _%>
  }

  showInfo(toastMessage: string, props: BToastProps = {}) {
    this.toast.create({
      modelValue: 5000,
      position: 'top-end',
      title: 'Info',
      variant: 'info',
      solid: true,
      body: toastMessage,
      ...props,
    });
  }

  showSuccess(toastMessage: string) {
    this.showInfo(toastMessage, {
      title: 'Success',
      variant: 'success',
    });
  }

  showError(toastMessage: string) {
    this.showInfo(toastMessage, {
      title: 'Error',
      variant: 'danger',
    });
  }

  /**
   * The alert of an error of the server, the errors of the given fields left out: the form shows them next to the fields.
   */
  showHttpError(response?: { data?: unknown; status?: number; headers?: Record<string, unknown> }, shownFields: readonly string[] = []) {
    // Without a response, the server was not reached.
    const { data: body, status = 0, headers } = response ?? {};
    // The body of an error of the server, a problem detail, else nothing to read.
    const problem = getServerProblem(body);
    let errorMessage: string | null = null;
    switch (status) {
      case 401:
        // The login is asked for again.
        return;

      case 0:
<%_ if (enableTranslation) { _%>
        // The key has dots of its own.
        errorMessage = this.i18n.t("error['server.not.reachable']").toString();
<%_ } else { _%>
        errorMessage = 'Server not reachable';
<%_ } _%>
        break;

      // The security of the server denies the access without a body, a resource may tell why in a problem.
      case 403:
<%_ if (enableTranslation) { _%>
        errorMessage = this.i18n.t(problem?.message ?? 'error.http.403').toString();
<%_ } else { _%>
        errorMessage = problem?.message ?? 'You are not authorized to access this page.';
<%_ } _%>
        break;

      case 400: {
        if (isConstraintViolation(problem) && problem.fieldErrors.length > 0) {
          for (const fieldError of problem.fieldErrors.filter(({ field }) => !shownFields.includes(field))) {
            this.showError(this.getFieldErrorMessage(fieldError));
          }
          return;
        }
        const message = getMessageFromHeaders(headers!);
<%_ if (enableTranslation) { _%>
        if (message.errorKey && message.param) {
          errorMessage = this.i18n.t(message.errorKey, { entityName: this.i18n.t(`global.menu.entities.${message.param}`) }).toString();
        } else if (message.errorKey) {
          errorMessage = this.i18n.t(message.errorKey).toString();
        } else
<%_ } _%>
        if (message.errorMessage) {
          errorMessage = message.errorMessage;
        } else if (problem?.message) {
<%_ if (enableTranslation) { _%>
          errorMessage = this.i18n.t(problem.message).toString();
<%_ } else { _%>
          errorMessage = problem.message;
<%_ } _%>
        }
        break;
      }

      case 404:
        errorMessage = this.i18n.t('error.http.404').toString();
        break;

      default:
<%_ if (enableTranslation) { _%>
        errorMessage = this.i18n.t(problem?.message ?? 'error.http.500').toString();
<%_ } else { _%>
        errorMessage = problem?.message ?? 'Internal server error.';
<%_ } _%>
    }
    this.showError(errorMessage!);
  }

  /**
   * What is wrong with a field, named by its label<%- enableTranslation ? ': the translation of the code of its constraint when there is one, else' : ':' %> the
   * message of the server.
   */
  getFieldErrorMessage({ objectName, field, message<%- enableTranslation ? ', code' : '' %> }: FieldErrorVM): string {
    // convert 'something[14].other[4].id' to 'something[].other[].id' so translations can be written to it
    const convertedField = field.replaceAll(/\[\d*\]/g, '[]');
<%_ if (enableTranslation) { _%>
    // The keys of the users are not prefixed by the application.
    const labelKey = `${objectName === 'userManagement' ? 'userManagement' : `<%- frontendAppName %>.${objectName}`}.${convertedField}`;
    const fieldName = this.i18n.te?.(labelKey) ? this.i18n.t(labelKey).toString() : convertedField;
    const key = `error.${code}`;
    if (code && this.i18n.te?.(key)) {
      return this.i18n.t(key, { fieldName }).toString();
    }
<%_ } else { _%>
    const fieldName = convertedField.charAt(0).toUpperCase() + convertedField.slice(1);
<%_ } _%>
    return `${fieldName}: ${message}`;
  }
}

export const alertServiceKey: InjectionKey<AlertService> = Symbol.for('jhipster:alertService');
