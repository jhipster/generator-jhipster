import { type InjectionKey, type Ref } from 'vue';

// The keys of what the application provides. Registered symbols, like the keys of the services: a microfrontend, built
// apart, injects what the gateway provides.
export const authenticatedKey: InjectionKey<Readonly<Ref<boolean>>> = Symbol.for('jhipster:authenticated');
export const currentUsernameKey: InjectionKey<Readonly<Ref<string | undefined>>> = Symbol.for('jhipster:currentUsername');
export const currentLanguageKey: InjectionKey<Readonly<Ref<string>>> = Symbol.for('jhipster:currentLanguage');
export const changeLanguageKey: InjectionKey<(newLanguage?: string | null) => Promise<void>> = Symbol.for('jhipster:changeLanguage');
