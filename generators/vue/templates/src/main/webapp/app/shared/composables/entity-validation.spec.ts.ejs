import { describe, expect, it } from 'vitest';
import { defineComponent, ref } from 'vue';

import { flushPromises, mount } from '@vue/test-utils';

import { type PropertyRules, useEntityValidation } from './entity-validation';

// The validation of a form, mounted for the translations.
const mountValidation = (entity: Record<string, unknown>, rules: Record<string, PropertyRules>) => {
  let v$!: ReturnType<typeof useEntityValidation>;
  const entityRef = ref(entity);
  mount(
    defineComponent({
      setup() {
        v$ = useEntityValidation(entityRef, rules);
        return () => null;
      },
    }),
  );
  return { v$, entity: entityRef };
};

describe('useEntityValidation', () => {
  it('should validate each rule of the properties', async () => {
    const { v$ } = mountValidation(
      { name: '', email: 'a', short: 'a', long: 'abc', count: 1.5, small: 1, big: 3, code: 'b', login: 'b', free: 'any' },
      {
        name: { required: true },
        email: { email: true },
        short: { minLength: 2 },
        long: { maxLength: 2 },
        count: { integer: true },
        small: { min: 2 },
        big: { max: 2 },
        code: { pattern: { regex: /^a+$/, name: 'Code' } },
        login: { pattern: { regex: /^a+$/, name: 'Login', login: true } },
        free: {},
      },
    );
    await flushPromises();

    expect(v$.value.$errors.map(({ $property, $validator }) => [$property, $validator])).toEqual([
      ['name', 'required'],
      ['email', 'email'],
      ['short', 'minLength'],
      ['long', 'maxLength'],
      ['count', 'integer'],
      ['small', 'min'],
      ['big', 'max'],
      ['code', 'pattern'],
      ['login', 'pattern'],
    ]);
    expect(v$.value.$errors.every(({ $message }) => typeof $message === 'string' && $message.length > 0)).toBe(true);
  });

  it('should accept the valid values', async () => {
    const { v$ } = mountValidation({ name: 'name', count: 2, code: 'aa' }, { name: { required: true, maxLength: 4 }, count: { integer: true, min: 1, max: 2 }, code: { pattern: { regex: /^a+$/, name: 'Code' } } });
    await flushPromises();

    expect(v$.value.$invalid).toBe(false);
  });

  it('should validate the changes of the entity', async () => {
    const { v$, entity } = mountValidation({ name: 'name' }, { name: { required: true } });

    entity.value.name = '';
    await flushPromises();

    expect(v$.value.name.$invalid).toBe(true);
  });
});
