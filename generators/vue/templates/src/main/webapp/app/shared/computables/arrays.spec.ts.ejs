import { describe, expect, it } from 'vitest';

import { filterBy, orderBy } from './arrays';

describe('filterBy', () => {
  it('should filter the elements by their nested values', () => {
    const array = [{ name: 'foo', nested: { value: 'bar' } }, { name: 'baz' }];

    expect(filterBy(array, { filterByTerm: 'bar' })).toEqual([array[0]]);
  });

  it('should filter the elements with null values', () => {
    const array = [{ name: 'foo', nested: null }, { name: 'bar' }];

    expect(filterBy(array, { filterByTerm: 'foo' })).toEqual([array[0]]);
  });
});

describe('orderBy', () => {
  it('should order the elements by a string property', () => {
    const array = [{ name: 'b' }, { name: 'c' }, { name: 'a' }];

    expect(orderBy(array, { orderByProp: 'name' })).toEqual([{ name: 'a' }, { name: 'b' }, { name: 'c' }]);
  });

  it('should order the elements by a number property', () => {
    const array = [{ id: 2 }, { id: 3 }, { id: 1 }];

    expect(orderBy(array, { orderByProp: 'id' })).toEqual([{ id: 1 }, { id: 2 }, { id: 3 }]);
  });

  it('should order the elements in reverse', () => {
    const array = [{ id: 2 }, { id: 3 }, { id: 1 }];

    expect(orderBy(array, { orderByProp: 'id', reverse: true })).toEqual([{ id: 3 }, { id: 2 }, { id: 1 }]);
  });
});
