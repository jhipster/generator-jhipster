import { describe, expect, it } from 'vitest';
import { type Ref, defineComponent, ref } from 'vue';

import { mount } from '@vue/test-utils';
import dayjs from 'dayjs';

import { DATE_TIME_LONG_FORMAT, useDateFormat } from './date-format';

const withSetup = (entityRef?: Ref<Record<string, any>>) => {
  let dateFormat: ReturnType<typeof useDateFormat>;
  mount(
    defineComponent({
      setup() {
        dateFormat = useDateFormat({ entityRef });
        return () => null;
      },
    }),
  );
  return dateFormat!;
};

describe('useDateFormat', () => {
  it('should format the dates and the durations', () => {
    const dateFormat = withSetup();

    expect(dateFormat.formatDate('2019-10-15T11:42:00')).toBe('2019-10-15 11:42');
    expect(dateFormat.formatDate(undefined)).toBe('');
    expect(dateFormat.formatDuration('PT1H')).toBe('an hour');
    expect(dateFormat.formatDuration(undefined)).toBe('');
    expect(dateFormat.convertDateTimeFromServer(new Date(2019, 9, 15, 11, 42))).toBe('2019-10-15T11:42');
    expect(dateFormat.convertDateTimeFromServer(new Date('invalid'))).toBeNull();
<%_ if (enableTranslation) { _%>
    expect(dateFormat.formatDateShort('2019-10-15T11:42:00')).toEqual(expect.any(String));
    expect(dateFormat.formatDateLong('2019-10-15T11:42:00')).toEqual(expect.any(String));
    expect(dateFormat.formatDateI18N(undefined)).toBeNull();
<%_ } else { _%>
    expect(dateFormat.formatDateShort('2019-10-15T11:42:00')).toBe('2019-10-15 11:42');
    expect(dateFormat.formatDateLong('2019-10-15T11:42:00')).toBe('2019-10-15 11:42');
<%_ } _%>
  });

  it('should update the date time fields of an entity', () => {
    const entity = ref<Record<string, any>>({});
    const dateFormat = withSetup(entity) as any;

    dateFormat.updateInstantField('instant', { target: { value: '2019-10-15T11:42' } });
    dateFormat.updateZonedDateTimeField('zoned', { target: { value: '2019-10-15T11:42' } });
    expect(entity.value.instant).toEqual(dayjs('2019-10-15T11:42', DATE_TIME_LONG_FORMAT));
    expect(entity.value.zoned).toEqual(dayjs('2019-10-15T11:42', DATE_TIME_LONG_FORMAT));

    dateFormat.updateInstantField('instant', { target: { value: '' } });
    dateFormat.updateZonedDateTimeField('zoned', {});
    expect(entity.value.instant).toBeNull();
    expect(entity.value.zoned).toBeNull();
  });
});
