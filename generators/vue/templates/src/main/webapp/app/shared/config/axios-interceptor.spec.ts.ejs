import { beforeEach, describe, expect, it, vi } from 'vitest';

import axios from 'axios';
import MockAdapter from "axios-mock-adapter";

<%_ if (authenticationTypeJwt) { _%>
import { AUTHENTICATION_TOKEN_KEY } from '@/shared/jhipster/constants';
<%_ } _%>

import * as setupAxiosConfig from './axios-interceptor';

const mock = new MockAdapter(axios);

describe('Axios interceptor', () => {
  beforeEach(() => {
    axios.interceptors.request.clear();
    axios.interceptors.response.clear();
    localStorage.clear();
    sessionStorage.clear();
  });

  it('should use localStorage to provide bearer', () => {
<%_ if (authenticationTypeJwt) { _%>
    localStorage.setItem(AUTHENTICATION_TOKEN_KEY, 'auth');
<%_ } _%>
    const result = setupAxiosConfig.onRequestSuccess({});

<%_ if (authenticationTypeJwt) { _%>
    expect(result.headers.Authorization).toBe('Bearer auth');
<%_ } _%>
    expect(result.url.indexOf(SERVER_API_URL)).toBeGreaterThan(-1);
  });

  it('should use sessionStorage to provide bearer', () => {
<%_ if (authenticationTypeJwt) { _%>
    sessionStorage.setItem(AUTHENTICATION_TOKEN_KEY, 'auth');
<%_ } _%>
    const result = setupAxiosConfig.onRequestSuccess({});

<%_ if (authenticationTypeJwt) { _%>
    expect(result.headers.Authorization).toBe('Bearer auth');
<%_ } _%>
    expect(result.url.indexOf(SERVER_API_URL)).toBeGreaterThan(-1);
  });
<%_ if (authenticationTypeJwt) { _%>

  it('should not provide a bearer without a token', () => {
    const result = setupAxiosConfig.onRequestSuccess({ url: 'api/test' });

    expect(result.headers).toBeUndefined();
  });

  it('should add the bearer to the existing headers', () => {
    localStorage.setItem(AUTHENTICATION_TOKEN_KEY, 'auth');

    const result = setupAxiosConfig.onRequestSuccess({ url: 'api/test', headers: { Accept: 'application/json' } });

    expect(result.headers).toEqual({ Accept: 'application/json', Authorization: 'Bearer auth' });
  });
<%_ } _%>
});

describe('Axios errors interceptor', () => {
  beforeEach(() => {
    axios.interceptors.request.clear();
    axios.interceptors.response.clear();
  });

  it('should use callback on 401, 403 errors', async () => {
    const callback = vi.fn();

    setupAxiosConfig.setupAxiosInterceptors(callback, () => {});

    mock.onGet().reply(401);
    await axios('/api/test');
    expect(callback).toHaveBeenCalled();
  });
  it('should use callback on 50x errors', async () => {
    const callback = vi.fn();

    setupAxiosConfig.setupAxiosInterceptors(() => {}, callback);

    mock.onGet().reply(500);
    await axios('/api/test');
    expect(callback).toHaveBeenCalled();
  });
  it('should not use callback for errors different 50x, 401, 403', async () => {
    const callback = vi.fn();

    setupAxiosConfig.setupAxiosInterceptors(() => {}, callback);

    mock.onGet().reply(402);
    await expect(axios('/api/test')).rejects.toThrow();
    expect(callback).not.toHaveBeenCalled();
  });

  it('should pass the responses and the errors without a response', async () => {
    const callback = vi.fn();

    setupAxiosConfig.setupAxiosInterceptors(callback, callback);

    mock.reset();
    mock.onGet().replyOnce(200, 'ok');
    await expect(axios('/api/test')).resolves.toMatchObject({ data: 'ok' });
    mock.onGet().networkErrorOnce();
    await expect(axios('/api/test')).rejects.toThrow();
    expect(callback).not.toHaveBeenCalled();
  });
});
