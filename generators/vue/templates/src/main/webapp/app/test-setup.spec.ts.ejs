import { describe, expect, it, vi } from 'vitest';
import { defineComponent, h, inject } from 'vue';

import { mount } from '@vue/test-utils';

// Vue warns about the injection that nothing provides.
const WarningComponent = defineComponent({
  setup() {
    inject('not-provided');
    return () => h('div');
  },
});

describe('test setup', () => {
  it.fails('should fail the test that makes Vue print a warning', () => {
    expect(mount(WarningComponent).exists()).toBe(true);
  });

  it.fails('should fail the next test that makes Vue print a warning too', () => {
    expect(mount(WarningComponent).exists()).toBe(true);
  });

  it('should let the test that mocks the console expect a warning', () => {
    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});

    mount(WarningComponent);

    expect(warn.mock.calls[0][0]).toContain('injection "not-provided" not found');
  });
});
