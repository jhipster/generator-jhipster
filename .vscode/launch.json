  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "internalConsoleOptions": "neverOpen",
      "name": "update vscode launch.json",
      "program": "${workspaceFolder}/bin/jhipster.cjs",
      "args": ["update-vscode"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "internalConsoleOptions": "neverOpen",
      "name": "generate sample from angular workflow",
      "program": "${workspaceFolder}/bin/jhipster.cjs",
      "args": ["generate-sample", "${input:angularSample}", "--global"],
      "console": "integratedTerminal"
    },
