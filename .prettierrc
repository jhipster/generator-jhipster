# Prettier configuration

printWidth: 140
singleQuote: true
tabWidth: 2
useTabs: false
experimentalTernaries: true

# js and ts rules:
arrowParens: avoid

# jsx and tsx rules:
bracketSameLine: false

plugins:
  - prettier-plugin-packagejson

overrides:
  # xml rules:
  - files: '*.xml'
    options:
      tabWidth: 4
