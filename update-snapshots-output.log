        if (!Objects.equals(id, servicedChild.getId())) {
            throw BadRequestAlertException.idinvalid(ENTITY_NAME);
        }

        if (!servicedChildRepository.existsById(id)) {
            throw BadRequestAlertException.idnotfound(ENTITY_NAME);
        }

        servicedChild = servicedChildService.update(servicedChild);
