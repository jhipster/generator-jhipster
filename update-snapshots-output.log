        servicedChild = servicedChildService.save(servicedChild);
        return ResponseEntity.created(new URI("/api/serviced-children/" + servicedChild.getId()))
            .headers(HeaderUtil.createEntityCreationAlert(applicationName, true, ENTITY_NAME, servicedChild.getId().toString()))
