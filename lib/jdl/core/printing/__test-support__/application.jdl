application {
  config {
    baseName store
    applicationType gateway
    packageName com.mycompany.store
    buildTool gradle
    gradleDevelocityHost "https://develocity.example.com"
    serverPort 8080
    skipClient false
    languages [en, fr]
    blueprints [my-blueprint]
    clientFramework angular
  }
  config(my-blueprint) {
    flag true
    port 9000
    label "two words"
    items [a, b]
  }

  entities * except Audit

  readOnly Product
  dto * with mapstruct except Audit
  use serviceImpl, infinite-scroll for Product
}
application {
  config {
    baseName empty
  }
}

entity Product
entity Audit
