{
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "dist", "node_modules"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025"],
    "types": [],
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false
  }
}
